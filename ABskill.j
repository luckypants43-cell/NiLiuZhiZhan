    function HERO_10_TALENT_DAMAGED_TARGET_4 takes nothing returns nothing
        if (GetUnitState(damageTarget,UNIT_STATE_LIFE)-damageFinalDamage)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) < 0.3 then 
            set damageFinalDamage = damageFinalDamage*0.75
        endif 
    endfunction

    function EVIL_AURA_STATE_SET takes nothing returns nothing
        local mybuff bf = aura.modifingAuraBuff
        local aura this = aura.checkingAura
        if bf.buffSource == this.bindUnit then 
            set aura.modifingAuraBuff.bonusHaste = 800
            set aura.modifingAuraBuff.bonusMoveSpeed_P = 1600
        else 
            set aura.modifingAuraBuff.bonusHaste = 400
            set aura.modifingAuraBuff.bonusMoveSpeed_P = 800
        endif 
    endfunction
    function HERO_10_TALENT_LEARN_5 takes nothing returns nothing
        local aura ar = aura.create(currentTTOwner,"AURA_DK_EVIL",900,0,BUFFTYPE_DK_EVILAURA,"Abilities\\Spells\\Undead\\UnholyAura\\UnholyAura.mdl")
        call ar.addAllySet(function EVIL_AURA_STATE_SET)
    endfunction
    function HERO_10_TALENT_RESET_5 takes nothing returns nothing
        set aura.getAura(currentTTOwner,"AURA_DK_EVIL").DESTROY = true 
    endfunction

    function HERO_10_TALENT_RESET_6 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(currentTTOwner,BUFFTYPE_DK_BONEARMOR)
        if bf > 0 then 
            set bf.bonusLife_P = 0
            call bf.refreshStates()
        endif 
    endfunction
    function HERO_10_TALENT_LEARN_6 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(currentTTOwner,BUFFTYPE_DK_BONEARMOR)
        if bf > 0 then 
            set bf.bonusLife_P = 250*bf.intData
            call bf.refreshStates()
        endif 
    endfunction
    function A649_DOT takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*1.5/6*mybuff.buffTimeScale*I2R(bf.intData)
        set damageIsDOT = true 
        set damageTag_Cold = true 
        set damageFlag = 'A649'
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_10_TALENT_SPELLING_6 takes nothing returns nothing
        local integer maxStack = 3
        local mybuff bf
        if castingSpell == 'S038' then 
            set bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_DK_ICEPLAGUE,1800)
            set bf.intData = IMinBJ(maxStack,bf.intData+1)
            set bf.periodTime = 300
            set bf.hasteAble = true
            call bf.addPeriod(function A649_DOT)
            call bf.apply()
        endif 
    endfunction
            
    function HERO_10_TALENT_LEARN_7 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_LEECH,500)
    endfunction
    function HERO_10_TALENT_RESET_7 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_LEECH,-500)
    endfunction
    function HERO_10_TALENT_ATTACKING_7 takes nothing returns nothing
        local mybuff bf 
        if damageSource == damageMaster and GetUnitState(damageTarget,UNIT_STATE_LIFE)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE)-0.5 < 0 then 
            set bf = CreateBuff(damageSource,damageSource,BUFFTYPE_DK_BLOODSFEEL,800)
            set bf.bonusHaste = 1500
            set bf.bonusEvade = 500
            set bf.bonusImmune_Root = 1
            set bf.bonusImmune_Stun = 1
            set bf.bonusImmune_Snare = 1
            call bf.apply()
        endif 
    endfunction

    function HERO_10_TALENT_DAMAGING_SOURCE_11 takes nothing returns nothing
        if damageTag_Cold and ((mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_DEATHKNIGHTSMARK) > 0 and GetUnitAbilityLevel(damageMaster,'S036') > 0) or mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_FESTERINGPLAGUE) > 0 or mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_FESTERINGPLAGUE) > 0 or mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_VENOM) > 0 or mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_PLAGUESTRIKE) > 0 or mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_SCOURGEPLAGUE) > 0 or mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_ICEPLAGUE) > 0) then 
            set damageFinalDamage = damageFinalDamage*1.15
        endif 
        if damageTag_Shadow and mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_FROSTBITE) > 0 then 
            set damageFinalDamage = damageFinalDamage*1.15
        endif 
    endfunction

    function HERO_10_TALENT_DAMAGED_TARGET_9 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_DK_BONEARMOR)
        if bf > 0 and GetUnitState(damageTarget,UNIT_STATE_LIFE)-damageFinalDamage < 0.5 and bf.intData >= 1 then
            set bf.intData = IMaxBJ(0,bf.intData-3)
            if HeroHaveTalent(damageTarget,HERO_PRIVATE_TALENT,6) then 
                set bf.bonusLife_P = 250*bf.intData
                call bf.refreshStates()
            endif 
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif 
            call SetUnitState(damageTarget,UNIT_STATE_LIFE,1)
            set damageFinalDamage = 0
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl",damageTarget,"origin"))
        endif 
    endfunction 

    function A64B_DMGING_T takes nothing returns nothing
        set damageFinalDamage = damageFinalDamage*1.08
    endfunction
    function HERO_10_TALENT_AFTERDAMAGE_SOURCE_10 takes nothing returns nothing
        local mybuff bf 
        if damageFlag == 'A63Z' or damageFlag == 'A641' or damageFlag == 'A643' or damageFlag == 'A644' or damageFlag == 'A646' or damageFlag == 'A649' then 
            set bf = CreateBuff(damageMaster,damageTarget,BUFFTYPE_DK_WEAK,500)
            set bf.bonusAttack_P = -800
            call bf.addDmging_T(function A64B_DMGING_T)
            call bf.apply()
        endif 
    endfunction

    function HERO_10_TALENT_BEFOREDAMAGE_SOURCE_8 takes nothing returns nothing
        local integer AURA_TYPE = 0
        local integer DMG_TYPE = 0
        if GetUnitAbilityLevel(damageSource,'S034') > 0 then 
            set AURA_TYPE = 1
        elseif GetUnitAbilityLevel(damageSource,'S035') > 0 then 
            set AURA_TYPE = 2
        elseif GetUnitAbilityLevel(damageSource,'S036') > 0 then 
            set AURA_TYPE = 3
        endif 
        if damageTag_Cold then 
            set DMG_TYPE = 2
        endif 
        if damageTag_Shadow then 
            set DMG_TYPE = 3
        endif 
        if DMG_TYPE == 2 then 
            set damageTag_Shadow = true 
        endif 
        if DMG_TYPE == 3 then 
            set damageTag_Cold = true 
        endif 
        if DMG_TYPE == AURA_TYPE then 
            set damageDamage = damageDamage*1.08
        else 
            set damageAddCrit = damageAddCrit+0.08
        endif 
    endfunction

    function HERO_10_TALENT_ATTACKING_12 takes nothing returns nothing
        local delayedevent de
        local integer W = GetUnitAbility(spellCaster,ABILITY_W)

        if random.get(damageSource,0.15,'HTLC') then 
            if W == 'S034' or W == 'S035' or W == 'S036' then 
                set de = delayedevent.create(25,1,function HERO_10_MULTICAST)
                call de.saveUnit("CASTER",damageSource)
                call de.saveUnit("TARGET_U",damageTarget)
                call de.saveReal("TARGET_X",GetUnitX(damageTarget))
                call de.saveReal("TARGET_Y",GetUnitY(damageTarget))
                call de.saveInteger("SPELL",W)
            endif 
        endif 
    endfunction
    function HERO_10_TALENT_DAMAGING_SOURCE_12 takes nothing returns nothing
        if damageFlag == 'S034' or damageFlag == 'S035' or damageFlag == 'S036' then 
            set damageFinalDamage = damageFinalDamage*1.15
        endif 
    endfunction
