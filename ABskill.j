    function HERO_7_TALENT_SPELLING_10 takes nothing returns nothing
        local mybuff bf 
        local projectile proj 
        if castingSpell == 'S002' then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_MAGE_GLACIALSPIRE)
            set bf.lastTime = 6000
            set bf.intData = bf.intData+1
            call bf.apply() 
        endif 
    endfunction
    function HERO_7_TALENT_MISSILE_LAUNCH_10 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        local mybuff bf
        local real haste = 1
        local real Qcd = 8
        if proj.flag == 'S002' then 
            set bf = mybuff.getUnitBuff(proj.source,BUFFTYPE_MAGE_GLACIALSPIRE)
            if bf.intData > 5 then 
                if unitGetBonusState(proj.source,STATE_ATTACK_SPEED) >= 0 then 
                    set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(proj.source,STATE_ATTACK_SPEED)))
                else 
                    set haste = (10000-I2R(unitGetAllBonusStateValue(proj.source,STATE_ATTACK_SPEED)))/10000
                endif 
                set bf.DESTROY = true 
                if proj.tag_Fire then 
                    set proj.model_path = "war3campImported\\FrostFireBoltV1.mdx"
                else 
                    set proj.model_path = "war3campImported\\FrostBoltV1.mdx"
                endif 
                set proj.bonusDamage = 4*proj.bonusDamage
                call BlzStartUnitAbilityCooldown(proj.source,'S002',Qcd*haste)
            endif 
        endif 
    endfunction
    globals 
        unit MAGE_WATER_ELEMENT = null
        delayedevent MAGE_WATER_ELEMENT_RESUMMON = 0
    endglobals
    function MAGE_WATER_ELEMENT_RESUMMON_FUNC takes nothing returns nothing
        local minion mini
        if (MAGE_WATER_ELEMENT == null or alive(MAGE_WATER_ELEMENT) == false) and alive(hero[6]) and HeroHaveTalent(hero[6],HERO_ULTIMATE_TALENT,11) then 
            set mini = minion.create(hero[6],'nS0D',GetUnitX(hero[6])+150*Cos(GetUnitFacing(hero[6])/57.2956),GetUnitY(hero[6])+150*Sin(GetUnitFacing(hero[6])/57.2956))
            call unitCheckState.evaluate(mini.summon)
            set MAGE_WATER_ELEMENT = mini.summon
            call delayedPauseUnit(mini.summon,100)
            call delayedPlayAnimation(mini.summon,"birth",105)
        endif 
        set MAGE_WATER_ELEMENT_RESUMMON = 0
    endfunction
    function HERO_7_MINION_DEATH takes nothing returns nothing
        local mybuff bf 
        if eventDyingUnit == MAGE_WATER_ELEMENT and HeroHaveTalent(hero[6],HERO_ULTIMATE_TALENT,11) and alive(hero[6]) then 
            if MAGE_WATER_ELEMENT_RESUMMON > 0 then 
                call MAGE_WATER_ELEMENT_RESUMMON.destroy()
            endif
            if inCombat(hero[12]) then 
                set MAGE_WATER_ELEMENT_RESUMMON = delayedevent.create(2000,1,function MAGE_WATER_ELEMENT_RESUMMON_FUNC)
            else 
                set MAGE_WATER_ELEMENT_RESUMMON = delayedevent.create(200,1,function MAGE_WATER_ELEMENT_RESUMMON_FUNC)
            endif 
            set MAGE_WATER_ELEMENT = null 
        endif 
    endfunction
    function HERO_7_TALENT_LEARN_11 takes nothing returns nothing
        local minion mini = minion.create(currentTTOwner,'nS0D',GetUnitX(currentTTOwner)+150*Cos(GetUnitFacing(currentTTOwner)/57.2956),GetUnitY(currentTTOwner)+150*Sin(GetUnitFacing(currentTTOwner)/57.2956))
        call unitCheckState.evaluate(mini.summon)
        set MAGE_WATER_ELEMENT = mini.summon
        call delayedPauseUnit(mini.summon,100)
        call delayedPlayAnimation(mini.summon,"birth",105)
    endfunction
    function HERO_7_TALENT_RESET_11 takes nothing returns nothing
        call KillUnit(MAGE_WATER_ELEMENT)
    endfunction
    function HERO_7_TALENT_SPELLING_12 takes nothing returns nothing
        local mybuff bf
        if castingSpell == 'S004' then
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_MAGE_FROSTENCHANT)
            set bf.lastTime = 1000
            set bf.bonusHaste = 3000
            set bf.bonusCostReduce = 2000
            set bf.bonusImmune_Root = 1
            set bf.bonusImmune_Silence = 1
            set bf.bonusImmune_Snare = 1
            set bf.bonusImmune_Stun = 1
            call bf.apply()
        endif 
        if castingSpell == 'S002' then 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_FROSTENCHANT)
            if bf > 0 then 
                set bf.remainingTime = bf.remainingTime+50
            endif 
        endif
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_8
    //====================================================
    function ATONEMENT_DELAYED_HEAL takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local group pick = de.loadGroup("GROUP")
        local real heal = de.loadReal("HEAL")
        loop 
            exitwhen FirstOfGroup(pick) == null 
            set healFlag = 'A61D'
            set healIsAOE = true 
            set healIsExtra = true 
            set healAddCrit = -10000
            call UnitHealTarget(hero[7],FirstOfGroup(pick),heal)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",FirstOfGroup(pick),"origin"))
            call GroupRemoveFirstUnit(pick)
        endloop
        call DestroyGroup(pick)
        set pick = null 
    endfunction
    function HERO_8_TALENT_AFTERDAMAGE_SOURCE_1 takes nothing returns nothing
        local mybuff bf 
        local delayedevent de 
        local group pick = null 
        local group pick2 = null 
        local real param = 0.5
        if (damageTag_Shadow == true or damageTag_Divine == true) and ((damageIsAOE == true and unitCheckCooldown(damageMaster,'B61K')) or damageIsAOE == false) then 
            set pick = CreateGroup()
            set pick2 = CreateGroup()
        else 
            return 
        endif 
        call GroupEnumUnitsInRangeEx(pick,GetUnitX(damageSource),GetUnitY(damageSource),900,playerAlly)
        loop 
            exitwhen FirstOfGroup(pick) == null 
            set bf = mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_PRIEST_ATONEMENT)
            if bf > 0 then 
                call GroupAddUnit(pick2,FirstOfGroup(pick))
                if damageIfCrit then 
                    set bf.shieldBlockPercent = 1
                    set bf.shieldDestroy = false 
                    set bf.shieldMaxValue = bf.shieldMaxValue+damageDamage*param
                    set bf.addShield = true 
                    set bf.addShieldMaxValue = GetUnitState(FirstOfGroup(pick),UNIT_STATE_LIFE)*param
                endif 
            endif 
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call DestroyGroup(pick)
        if CountUnitsInGroup(pick2) > 0 then 
            set de = delayedevent.create(1,1,function ATONEMENT_DELAYED_HEAL)
            call de.saveGroup("GROUP",pick2)
            call de.saveReal("HEAL",param*damageDamage)
        endif 
        if damageIsAOE then 
            call unitStartCooldown(damageMaster,'B61K',1)
        endif 
        set pick = null 
        set pick2 = null 
    endfunction
    function A61D_DAMAGING_TARGET takes nothing returns nothing
        if damageSource != damageTarget then 
            set damageFinalDamage = damageFinalDamage*0.95
        endif 
    endfunction
    function HERO_8_TALENT_SPELLING_1 takes nothing returns nothing
        local mybuff bf 
        local group pick = null 
        local integer time = 1200
        if (castingSpell == 'S04T' or castingSpell == 'S04S' or castingSpell == 'S00P' or castingSpell == 'S00O' or castingSpell == 'S00T' or castingSpell == 'S00Q') and IsUnitAlly(spellTarget,GetOwningPlayer(spellCaster)) then 
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PRIEST_ATONEMENT)
            set bf.lastTime = time
            call bf.addDmging_T(function A61D_DAMAGING_TARGET)
            call bf.apply()
        elseif castingSpell == 'S006' or castingSpell == 'S00U' or castingSpell == 'S00V' or castingSpell == 'S00X' or castingSpell == 'S00S' then 
            set pick = CreateGroup()
            if castingSpell == 'S00X' or castingSpell == 'S006' then 
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),900,playerAlly)
            elseif castingSpell == 'S00S' then 
                call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,300,playerAlly)
            else 
                call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,250,playerAlly)
            endif 
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_PRIEST_ATONEMENT)
                set bf.lastTime = time
                call bf.addDmging_T(function A61D_DAMAGING_TARGET)
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endif 
    endfunction
    function HERO_8_TALENT_AFTERDAMAGE_SOURCE_2 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_PRIEST_DEVOURINGPLAGUE)
        if damageTag_Shadow and damageIsDOT == false and bf > 0 then 
            set bf.remainingTime = bf.remainingTime+75
        endif 
    endfunction
    function HERO_8_TALENT_SPELLING_2 takes nothing returns nothing
        local mybuff bf = 0
        if castingSpell == 'S04S' then 
            set bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_PRIEST_SHIELD,1500)
            set bf.shieldDestroy = true 
            set bf.shieldBlockPercent = 1
            set bf.shieldMaxValue = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*2.5
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,5) then 
                call bf.addEnding(function A60N_END)
            endif 
            if bf.shieldMaxValue > 0 then 
                call bf.apply()
            else 
                call bf.destroy()
            endif 
        endif 
    endfunction
    function HERO_8_TALENT_AFTERDAMAGE_SOURCE_3 takes nothing returns nothing
        local mybuff bf 
        if damageIfCrit and damageTag_Shadow then 
            set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_PRIEST_REPENTANCE)
            set bf.bonusAttack_P = -1500
            set bf.bonusAttackSpeed = -2000
            set bf.bonusMoveSpeed_P = -2000
            set bf.lastTime = 500
            call bf.apply()
        endif 
    endfunction
    function HERO_8_TALENT_DAMAGED_SOURCE_3 takes nothing returns nothing
        if damageTag_Shadow and damageIfCrit then 
            set damageFinalDamage = damageFinalDamage*1.1
        endif 
    endfunction
    function HERO_8_TALENT_MISSILE_LAUNCH_3 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        if proj.currentBounceCount == 0 and proj.TARGET_UNIT and proj.flag == 'Aatk' then 
            set proj.bounceRange = RMaxBJ(450,proj.bounceRange)
            set proj.maxBounceLimit = proj.maxBounceLimit+1
        endif 
    endfunction
    function HERO_8_TALENT_ATTACKED_SOURCE_3 takes nothing returns nothing
        set damageTag_Divine = true 
    endfunction
    function CHECK_STATE_nS08 takes nothing returns nothing
        call BlzSetUnitBaseDamage(checkingUnit,unitGetAllBonusStateValue(minion.getMinionByUnit(checkingUnit).mast.masterUnit,STATE_ABILITY_POWER)*3/4-1,0)
        call BlzSetUnitArmor(checkingUnit,2*GetUnitLevel(minion.getMinionByUnit(checkingUnit).mast.masterUnit)/5)
    endfunction
    function UNIT_nS08_ATTACKING takes nothing returns nothing
        set damageTag_Shadow = true 
        set damageTag_Attack = false 
        set damageFlag = 'nS08'
        set damageDamageType = DAMAGE_TYPE_MAGIC
        set damageAttackType = ATTACK_TYPE_NORMAL
        call AddUnitMana(damageMaster,0.0015*GetUnitState(damageMaster,UNIT_STATE_MAX_MANA))
    endfunction
    function HERO_8_TALENT_AFTERDAMAGE_SOURCE_9 takes nothing returns nothing
        local minion mini 
        local real x = GetUnitX(damageTarget)
        local real y = GetUnitY(damageTarget)
        local real a = GetRandomReal(0,6.283)
        local real d = 150
        if unitCheckCooldown(damageMaster,'HTL9') and damageTag_Shadow and ((damageIsDOT == true and random.get(damageMaster,0.1,'HTL9')) or (damageIsDOT == false and random.get(damageMaster,0.3,'HTL9'))) then 
            set mini = minion.create(damageSource,'nS08',x+d*Cos(a),y+d*Sin(a))
            set mini.aimTarget = damageTarget
            set mini.remove = true 
            set mini.deathSFX = "Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl"
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl",x+d*Cos(a),y+d*Sin(a)))
            call IssueTargetOrderById(mini.summon,ORDER_attack,damageTarget)
            call UnitApplyTimedLife(mini.summon,'BTLF',10)
            call unitAddState(mini.summon,STATE_LIFE,15*GetUnitLevel(damageTarget))
            call unitCheckState.evaluate(mini.summon)
            call unitStartCooldown(damageMaster,'HTL9',1000)
        endif 
    endfunction
    function HOLYFIRE_DOT takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = 1.2/4*I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*mybuff.buffTimeScale
        set damageTag_Divine = true 
        set damageTag_Ignite = true 
        set damageIsDOT = true 
        set damageFlag = 'A61F'
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_8_TALENT_AFTERHEAL_SOURCE_4 takes nothing returns nothing
        if healOverdoze > 0.1 and mybuff.getUnitBuff(healTarget,BUFFTYPE_PRIEST_SHADOWMENDING) != 0 then 
            set mybuff.getUnitBuff(healTarget,BUFFTYPE_PRIEST_SHADOWMENDING).realData = RMaxBJ(0,mybuff.getUnitBuff(healTarget,BUFFTYPE_PRIEST_SHADOWMENDING).realData-healOverdoze)
        endif   
    endfunction
    function FORTITUDE_DAMAGING_TARGET takes nothing returns nothing
        if damageSource != damageTarget then 
            set damageFinalDamage = damageFinalDamage*0.97
        endif 
    endfunction
    function FORTITUDE_AURA_STATE_SET takes nothing returns nothing
        local mybuff bf = aura.modifingAuraBuff
        set bf.bonusLife_P = 500
        set bf.bonusLifeRegen_P = 500
        call bf.addDmging_T(function FORTITUDE_DAMAGING_TARGET)
    endfunction
    function HERO_8_TALENT_LEARN_6 takes nothing returns nothing
        local aura ar = aura.create(currentTTOwner,"AURA_PRIEST_FORTITUDE",900,0,BUFFTYPE_PRIEST_FORTUTIDE,"war3campImported\\Fortitude Rune Aura.mdx")
        call ar.addAllySet(function FORTITUDE_AURA_STATE_SET)
    endfunction
    function HERO_8_TALENT_RESET_6 takes nothing returns nothing
        set aura.getAura(currentTTOwner,"AURA_PRIEST_FORTITUDE").DESTROY = true 
    endfunction
    function HERO_8_TALENT_PREDAMAGE_SOURCE_8 takes nothing returns nothing
        if GetUnitState(damageTarget,UNIT_STATE_LIFE)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) < 0.6 then 
            set damageAddCrit = damageAddCrit+0.1
            if GetUnitState(damageTarget,UNIT_STATE_LIFE)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) < 0.3 then 
                set damageAddCrit = damageAddCrit+0.1
            endif 
        endif 
    endfunction
    function HERO_8_TALENT_PREHEAL_SOURCE_8 takes nothing returns nothing
        if GetUnitState(healTarget,UNIT_STATE_LIFE)/GetUnitState(healTarget,UNIT_STATE_MAX_LIFE) < 0.6 then 
            set healAddCrit = healAddCrit+0.1
            if GetUnitState(healTarget,UNIT_STATE_LIFE)/GetUnitState(healTarget,UNIT_STATE_MAX_LIFE) < 0.3 then 
                set healAddCrit = healAddCrit+0.1
            endif 
        endif 
    endfunction
    globals 
        unit PRIEST_ANGEL_TARGET = null 
    endglobals 
    function GUARDIAN_ANGEL_DAMAGED_TARGET_DELAYED takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        set healFlag = 'A61H'
        set healAddCrit = -10000
        call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("HEAL"))
    endfunction
    function GUARDIAN_ANGEL_DAMAGED_TARGET takes nothing returns nothing
        local delayedevent de = 0
        local mybuff bf = mybuff.currentBuff
        if damageFinalDamage > GetUnitState(damageTarget,UNIT_STATE_LIFE)+0.5 then 
            call unitStartCooldown(bf.buffSource,'HTL7',12000)
            set bf.DESTROY = true 
            set damageFinalDamage = 0
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl",GetUnitX(damageTarget),GetUnitY(damageTarget)))
            call SetUnitState(damageTarget,UNIT_STATE_LIFE,1)
            set de = CreateDelayedEvent(1,1,function GUARDIAN_ANGEL_DAMAGED_TARGET_DELAYED)
            call de.saveUnit("CASTER",bf.buffSource)
            call de.saveUnit("TARGET",damageTarget)
            call de.saveReal("HEAL",0.4*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))
        endif 
    endfunction
    function GUARDIAN_ANGEL_HEALING_TARGET takes nothing returns nothing
        set healFinalHeal = healFinalHeal*1.2
    endfunction
    function HERO_8_TALENT_SPELLING_7 takes nothing returns nothing
        local mybuff bf 
        if castingSpell == 'S00T' or castingSpell == 'S00P' or castingSpell == 'S00Q' and IsUnitAlly(spellTarget,PLAYER) then 
            if unitCheckCooldown(spellCaster,'HTL7') then 
                if PRIEST_ANGEL_TARGET != spellTarget then 
                    set bf = mybuff.getUnitBuff(PRIEST_ANGEL_TARGET,BUFFTYPE_PRIEST_GUARDIANANGLE)
                    set bf.DESTROY = true 
                endif 
                set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PRIEST_GUARDIANANGLE)
                set bf.lastTime = 2000
                call bf.addHealing_T(function GUARDIAN_ANGEL_HEALING_TARGET)
                call bf.addDmged_T(function GUARDIAN_ANGEL_DAMAGED_TARGET)
                call bf.apply()
                set PRIEST_ANGEL_TARGET = spellTarget
            endif 
        endif 
    endfunction
    function HERO_8_TALENT_AFTERHEAL_SOURCE_10 takes nothing returns nothing
        local mybuff bf 
        if healOverdoze > 1 then
            set bf = mybuff.create(healSource,healTarget,BUFFTYPE_PRIEST_BOUNTIFULBARRIER)
            set bf.lastTime = 800
            set bf.shieldBlockPercent = 1
            set bf.shieldMaxValue = bf.shieldMaxValue+0.4*healOverdoze
            set bf.addShield = true 
            set bf.addShieldMaxValue = GetUnitState(healTarget,UNIT_STATE_MAX_LIFE)*0.3
            set bf.shieldDestroy = true 
            call bf.apply()
        endif 
    endfunction
    function HERETICAL_CREED_DEAL_AOE_DAMAGE takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local group pick = CreateGroup()
        local unit ds = de.loadUnit("SOURCE")
        local unit dt = de.loadUnit("TARGET")
        local real dmg = de.loadReal("DAMAGE")
        call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),225,playerEnemy)
        loop 
            exitwhen FirstOfGroup(pick) == null 
            if FirstOfGroup(pick) != dt then 
                set damageTag_Shadow = true 
                set damageIsAOE = true 
                set damageFlag = 'S00N'
                call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            endif 
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call DestroyGroup(pick)
        set ds = null 
        set dt = null 
        set pick = null 
    endfunction
    function HERO_8_TALENT_PREDAMAGE_SOURCE_11 takes nothing returns nothing
        local mybuff bf 
        local delayedevent de 
        if damageFlag == 'S00N' and damageIsAOE == false then 
            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_PRIEST_HERETICALCREED)
            if bf != 0 then 
                set bf.DESTROY = true 
                set de = delayedevent.create(5,1,function HERETICAL_CREED_DEAL_AOE_DAMAGE)
                set damageFinalDamage = damageFinalDamage*(1+0.02*I2R(bf.intData))
                set damageDamage = damageDamage*(1+0.02*I2R(bf.intData))
                call de.saveReal("DAMAGE",damageDamage*0.3)
                call de.saveUnit("TARGET",damageTarget)
                call de.saveUnit("SOURCE",damageSource)
            endif 
        endif 
    endfunction
    function HERETICAL_CREED_DEAL_AOE_HEAL takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local group pick = CreateGroup()
        local unit ds = de.loadUnit("SOURCE")
        local unit dt = de.loadUnit("TARGET")
        local real dmg = de.loadReal("HEAL")
        call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),225,playerAlly)
        loop 
            exitwhen FirstOfGroup(pick) == null 
            if FirstOfGroup(pick) != dt then 
                set healIsAOE = true 
                set healFlag = 'S00O'
                call UnitHealTarget(ds,FirstOfGroup(pick),dmg)
            endif 
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call DestroyGroup(pick)
        set ds = null 
        set dt = null 
        set pick = null 
    endfunction
    function HERO_8_TALENT_PREHEAL_SOURCE_11 takes nothing returns nothing
        local mybuff bf 
        local delayedevent de 
        if healFlag == 'S00O' and healIsAOE == false then 
            set bf = mybuff.getUnitBuff(healSource,BUFFTYPE_PRIEST_HERETICALCREED)
            if bf != 0 then 
                set bf.DESTROY = true 
                set de = delayedevent.create(5,1,function HERETICAL_CREED_DEAL_AOE_HEAL)
                set healFinalHeal = healFinalHeal*(1+0.02*I2R(bf.intData))
                set healHeal = healHeal*(1+0.02*I2R(bf.intData))
                call de.saveReal("HEAL",healHeal*0.3)
                call de.saveUnit("TARGET",healTarget)
                call de.saveUnit("SOURCE",healSource)
            endif 
        endif 
    endfunction
    function HERO_8_TALENT_SPELLING_11 takes nothing returns nothing
        local mybuff bf 
        if castingSpell != 'S00N' and castingSpell != 'S00O' then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_PRIEST_HERETICALCREED)
            set bf.lastTime = 2000
            set bf.intData = IMinBJ(250,bf.intData+R2I(2.5*spellCooldown))
            call bf.apply()
        endif 
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_9
    //====================================================
    function HERO_9_TALENT_DAMAGING_SOURCE_1 takes nothing returns nothing
        if damageFlag == 'A623' then
            set damageFinalDamage = damageFinalDamage*1.15
        endif 
        if damageFlag == 'S01Y' then
            set damageAddCrit = damageAddCrit+0.05
        endif 
    endfunction
 
    function HERO_9_TALENT_LEARN_1 takes nothing returns nothing
        call State.checkAll(currentTTOwner)
    endfunction
    function HERO_9_TALENT_RESET_1 takes nothing returns nothing
        local integer BONUSED_HASTE = GetHeroData(checkingUnit,"TALENT_1_BONUSED_HASTE")
        local integer BONUSED_LIFE = GetHeroData(checkingUnit,"TALENT_1_BONUSED_LIFE")
        local integer BONUSED_ARMOR = GetHeroData(checkingUnit,"TALENT_1_BONUSED_ARMOR")
        local integer BONUSED_CRIT = GetHeroData(checkingUnit,"TALENT_1_BONUSED_CRIT")
        local integer BONUSED_ABILITY_POWER = GetHeroData(checkingUnit,"TALENT_1_BONUSED_ABILITY_POWER")
        
        call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_HASTE)
        set BONUSED_HASTE = 0
        call ST_LIFE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_LIFE)
        call ST_ARMOR.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_ARMOR)
        set BONUSED_LIFE = 0
        set BONUSED_ARMOR = 0
        call ST_CRIT_CHANCE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_CRIT)
        set BONUSED_CRIT = 0
        call ST_ABILITY_POWER.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_ABILITY_POWER)
        set BONUSED_ABILITY_POWER = 0

        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_HASTE",BONUSED_HASTE)
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_LIFE",BONUSED_LIFE)
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_ARMOR",BONUSED_ARMOR)
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_CRIT",BONUSED_CRIT)
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_ABILITY_POWER",BONUSED_ABILITY_POWER)
    endfunction
    function HERO_9_TALENT_CHECK_STATE_1 takes nothing returns nothing
        local integer BONUSED_HASTE = GetHeroData(checkingUnit,"TALENT_1_BONUSED_HASTE")
        local integer BONUSED_LIFE = GetHeroData(checkingUnit,"TALENT_1_BONUSED_LIFE")
        local integer BONUSED_ARMOR = GetHeroData(checkingUnit,"TALENT_1_BONUSED_ARMOR")
        local integer BONUSED_CRIT = GetHeroData(checkingUnit,"TALENT_1_BONUSED_CRIT")
        local integer BONUSED_ABILITY_POWER = GetHeroData(checkingUnit,"TALENT_1_BONUSED_ABILITY_POWER")
        if heroNowForm[8] == FORM_DRUID_NORMAL then 
            if BONUSED_HASTE != 800 then 
                call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,800-BONUSED_HASTE)
                set BONUSED_HASTE = 800
            endif 
            call ST_LIFE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_LIFE)
            call ST_ARMOR.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_ARMOR)
            set BONUSED_LIFE = 0
            set BONUSED_ARMOR = 0
            call ST_CRIT_CHANCE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_CRIT)
            set BONUSED_CRIT = 0
            call ST_ABILITY_POWER.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_ABILITY_POWER)
            set BONUSED_ABILITY_POWER = 0
        elseif heroNowForm[8] == FORM_DRUID_BEAR then 
            if BONUSED_LIFE != 1000 then 
                call ST_LIFE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,1000-BONUSED_LIFE)
                set BONUSED_LIFE = 1000
            endif 
            if BONUSED_ARMOR != 1000 then 
                call ST_ARMOR.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,1000-BONUSED_ARMOR)
                set BONUSED_ARMOR = 1000
            endif 
            call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_HASTE)
            set BONUSED_HASTE = 0
            call ST_CRIT_CHANCE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_CRIT)
            set BONUSED_CRIT = 0
            call ST_ABILITY_POWER.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_ABILITY_POWER)
            set BONUSED_ABILITY_POWER = 0
        elseif heroNowForm[8] == FORM_DRUID_CAT then 
            if BONUSED_CRIT != 800 then 
                call ST_CRIT_CHANCE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,800-BONUSED_CRIT)
                set BONUSED_CRIT = 800
            endif 
            call ST_LIFE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_LIFE)
            call ST_ARMOR.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_ARMOR)
            set BONUSED_LIFE = 0
            set BONUSED_ARMOR = 0
            call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_HASTE)
            set BONUSED_HASTE = 0
            call ST_ABILITY_POWER.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_ABILITY_POWER)
            set BONUSED_ABILITY_POWER = 0
        elseif heroNowForm[8] == FORM_DRUID_MOONKIN then 
            if BONUSED_ABILITY_POWER != 1000 then 
                call ST_ABILITY_POWER.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,1000-BONUSED_ABILITY_POWER)
                set BONUSED_ABILITY_POWER = 1000
            endif 
            call ST_LIFE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_LIFE)
            call ST_ARMOR.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_ARMOR)
            set BONUSED_LIFE = 0
            set BONUSED_ARMOR = 0
            call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_HASTE)
            set BONUSED_HASTE = 0
            call ST_CRIT_CHANCE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUSED_CRIT)
            set BONUSED_CRIT = 0
        endif 
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_HASTE",BONUSED_HASTE)
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_LIFE",BONUSED_LIFE)
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_ARMOR",BONUSED_ARMOR)
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_CRIT",BONUSED_CRIT)
        call SetHeroData(checkingUnit,"TALENT_1_BONUSED_ABILITY_POWER",BONUSED_ABILITY_POWER)
    endfunction
    function HERO_9_TALENT_HEALING_SOURCE_3 takes nothing returns nothing
        local real p = 0.15*(1-RAbsBJ(GetUnitState(healTarget,UNIT_STATE_LIFE)/GetUnitState(healTarget,UNIT_STATE_MAX_LIFE)-0.5)*2)
        if heroNowForm[8] == FORM_DRUID_NORMAL then 
            set healFinalHeal = healFinalHeal*(1+p)
        endif 
    endfunction
    function HERO_9_TALENT_DAMAGING_SOURCE_3 takes nothing returns nothing
        local real pp = 0.1*(1-RAbsBJ(GetUnitState(damageSource,UNIT_STATE_MANA)/GetUnitState(damageSource,UNIT_STATE_MAX_MANA)-0.5)*2)
        local real p = 0.1*(1-RAbsBJ(GetUnitState(damageTarget,UNIT_STATE_LIFE)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE)-0.5)*2)
        if heroNowForm[8] == FORM_DRUID_CAT and damageDamageType == DAMAGE_TYPE_NORMAL then 
            set damageFinalDamage = damageFinalDamage*(1+p)
        endif 
        if heroNowForm[8] == FORM_DRUID_MOONKIN and damageAttackType == ATTACK_TYPE_NORMAL then 
            set damageFinalDamage = damageFinalDamage*(1+pp)
        endif 
    endfunction
    function HERO_9_TALENT_DAMAGING_TARGET_3 takes nothing returns nothing
        local real lifeRatio = GetUnitState(damageTarget, UNIT_STATE_LIFE) / GetUnitState(damageTarget, UNIT_STATE_MAX_LIFE)
        local real distanceFromHalf = RAbsBJ(lifeRatio - 0.5)
        local real p = 0.15 * (1 - distanceFromHalf * 2)
        if damageSource == damageTarget then 
            return 
        endif 
        if heroNowForm[8] == FORM_DRUID_BEAR then 
            set damageFinalDamage = damageFinalDamage * (1 - p)
        endif 
    endfunction
    function MOON_FIRE_DOT takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*1.2/6*mybuff.buffTimeScale
        local group pick 
        local unit healTar 
        set damageIsDOT = true 
        set damageFlag = 'A62M'
        set damageTag_Arcane = true 
        if bf.intData == FORM_DRUID_MOONKIN then 
            set dmg = dmg*2
        endif 
        if bf.intData == FORM_DRUID_CAT then 
            call AddUnitMana(bf.buffSource,0.015*GetUnitState(bf.buffSource,UNIT_STATE_MAX_MANA)*mybuff.buffTimeScale)
            set dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*1.2/6*mybuff.buffTimeScale*2
        endif 
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        if bf.intData == FORM_DRUID_NORMAL then 
            set pick = CreateGroup()
            set healTar = null 
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(bf.buffTarget),GetUnitY(bf.buffTarget),550,playerAlly)
            set healTar = GetUnitWithLowestHealthPct(pick)
            if healTar != null then 
                set healFlag = 'A62M'
                call UnitHealTarget(bf.buffSource,healTar,dmg*1)
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\VampiricAuraTargetBlue.mdx",healTar,"origin"))
            endif 
            call DestroyGroup(pick)
            set pick = null 
            set healTar = null 
        endif 
    endfunction
    function MOON_FIRE_DELAYED_DAMAGE takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        set damageFlag = 'B62T'
        set damageTag_Arcane = true 
        call UnitDamageTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("DAMAGE"),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_9_TALENT_ATTACKING_4 takes nothing returns nothing
        local mybuff bf 
        local delayedevent de
        local real dmg 
        if unitCheckCooldown(damageSource,'HTL4') and damageSource == damageMaster then 
            call unitStartCooldown(damageSource,'HTL4',1500)
            set dmg = I2R(unitGetAllBonusStateValue(damageSource,STATE_ABILITY_POWER))*1
            set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_DRUID_MOONFIRE)
            set bf.lastTime = 1200
            set bf.periodTime = 200
            set bf.intData = heroNowForm[8]
            set bf.hasteAble = true 
            call bf.addPeriod(function MOON_FIRE_DOT)
            call bf.apply()
            if heroNowForm[8] == FORM_DRUID_MOONKIN then 
                set dmg = dmg*2
            endif 
            set de = delayedevent.create(2,1,function MOON_FIRE_DELAYED_DAMAGE)
            call de.saveReal("DAMAGE",dmg)
            call de.saveUnit("CASTER",damageSource)
            call de.saveUnit("TARGET",damageTarget)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\MoonWrath.mdx",damageTarget,"origin"))
        endif 
    endfunction
    function HERO_9_TALENT_DAMAGING_TARGET_4 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_DRUID_MOONFIRE)
        if damageSource == damageTarget then 
            return 
        endif 
        if bf > 0 and bf.intData == FORM_DRUID_BEAR then 
            set damageFinalDamage = damageFinalDamage*0.92
        endif 
    endfunction
    function REJUVINATION_HOT takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = 1.5*I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))/4*mybuff.buffTimeScale
        set healIsDOT = true 
        set healFlag = 'A62N'
        call UnitHealTarget(bf.buffSource,bf.buffTarget,dmg)
        if bf.intData == FORM_DRUID_MOONKIN then
            call AddUnitMana(bf.buffSource,0.005*GetUnitState(bf.buffSource,UNIT_STATE_MAX_MANA)*mybuff.buffTimeScale)
        endif 
    endfunction
    function REJUVINATION_END takes nothing returns nothing
        local group pick  = CreateGroup()
        local unit healTar = null 
        local mybuff bf = mybuff.currentBuff
        local mybuff nbf 
        call GroupEnumUnitsInRangeEx(pick,GetUnitX(bf.buffTarget),GetUnitY(bf.buffTarget),500,playerAlly)
        call GroupRemoveUnit(pick,bf.buffTarget)
        set healTar = GetUnitWithLowestHealthPct(pick)
        if healTar != null then 
            set nbf = mybuff.create(bf.buffSource,healTar,BUFFTYPE_DRUID_REJUVINATION)
            set nbf.lastTime = 800
            set nbf.periodTime = 200
            set nbf.intData = 0 
            set nbf.hasteAble = true 
            call nbf.addPeriod(function REJUVINATION_HOT)
            call nbf.apply()
            //call BJDebugMsg(GetUnitName(nbf.buffSource)+"&&"+GetUnitName(nbf.buffTarget)+"&&"+I2S(nbf)+"from"+I2S(bf))
        endif 
        call DestroyGroup(pick)
        set pick = null 
        set healTar = null 
    endfunction
    function HERO_9_TALENT_SPELLING_7 takes nothing returns nothing
        local mybuff bf 
        if unitCheckCooldown(spellCaster,'HTL7') then 
            call unitStartCooldown(spellCaster,'HTL7',1200)
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_REJUVINATION)
            set bf.lastTime = 800
            set bf.periodTime = 200
            set bf.intData = heroNowForm[8]
            set bf.hasteAble = true 
            call bf.addPeriod(function REJUVINATION_HOT)
            call bf.addEnding(function REJUVINATION_END)
            if heroNowForm[8] == FORM_DRUID_NORMAL then 
                set bf.bonusHaste = 1500
            endif 
            call bf.apply()
        endif 
    endfunction
    function HERO_9_TALENT_DAMAGING_SOURCE_7 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_DRUID_REJUVINATION)
        if damageTag_Bleed and bf > 0 and bf.intData == FORM_DRUID_CAT then 
            set damageFinalDamage = damageFinalDamage*1.2
        endif 
    endfunction
    function HERO_9_TALENT_HEALING_TARGET_7 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(healTarget,BUFFTYPE_DRUID_REJUVINATION)
        if bf > 0 and bf.intData == FORM_DRUID_BEAR then 
            set healFinalHeal = healFinalHeal*1.2
        endif 
    endfunction
    function DRUID_STAR_SPIRIT_HIT takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        local real x = proj.x
        local real y = proj.y
        local minion mini = minion.create(proj.source,'nS0C',x,y)
        local projectile newproj = projectile.create(mini.summon)
        call unitAddState(mini.summon,STATE_ABILITY_POWER,3*unitGetAllBonusStateValue(proj.source,STATE_ABILITY_POWER)/4)
        call UnitApplyTimedLife(mini.summon,'BHwe',1)
        call delayedPlayAnimation(mini.summon,"birth",35)
        set newproj.LAUNCH_UNIT = true 
        set newproj.TARGET_UNIT = true 
        set newproj.target = proj.target 
        set newproj.model_path = "war3campImported\\moonspear.mdx"  
        set newproj.tag_Earth = true 
        set newproj.tag_Arcane = true 
        set newproj.curve = 0 
        set newproj.speed = 1000
        set newproj.flag = 'B626'
        call newproj.addOnHit(function B626_HIT)
        call newproj.launch()
    endfunction
    function HERO_9_TALENT_ATTACKING_8 takes nothing returns nothing
        local projectile proj 
        local real x 
        local real y 
        local real a 
        local real b
        local real c 
        local real d 
        local real X
        local real Y
        if DRUID_STAR_SURGE_CHARGE > 0 and damageSource == damageMaster then 
            set DRUID_STAR_SURGE_CHARGE = DRUID_STAR_SURGE_CHARGE-1
            call DruidCheckStarSurgeCharge.execute()
            set x = GetUnitX(damageSource)
            set y = GetUnitY(damageSource)
            set a = GetRandomReal(0,6.2832)
            set d = SquareRoot(GetRandomReal(22500,50625))
            set X = x+d*Cos(a)
            set Y = y+d*Sin(a)
            set proj = projectile.create(damageSource)
            set proj.target = damageTarget
            set proj.target_x = X
            set proj.target_y = Y
            set proj.LAUNCH_UNIT = true 
            set proj.TARGET_LOC = true 
            set a = GetRandomReal(60,90)
            if GetRandomReal(0,1) < 0.5 then 
                set a = 0-a
            endif 
            set b = GetRandomReal(100,150)
            set c = GetRandomReal(150,200)
            if a < 0 then 
                set c = 0-c
            endif 
            set d = GetRandomReal(200,300)
            set a = a+GetUnitFacing(damageSource)
            set c = c+GetUnitFacing(damageSource)
            set proj.model_path = "war3campImported\\star_spirit_smaller.mdx"
            set proj.speed = 350
            set proj.curve = GetRandomReal(0.05,0.15)
            set proj.bezier_points = 2
            set proj.bezier_x0 = x+b*Cos(a/57.2956)
            set proj.bezier_x1 = proj.bezier_x0+d*Cos(c/57.2956)
            set proj.bezier_y0 = y+b*Sin(a/57.2956)
            set proj.bezier_y1 = proj.bezier_y0+d*Cos(c/57.2956)
            call proj.addOnEnd(function DRUID_STAR_SPIRIT_HIT)
            call proj.launch()
        endif 
    endfunction
    function HERO_9_TALENT_SPELLING_8 takes nothing returns nothing
        if castingSpell == 'S02G' or castingSpell == 'S023' or castingSpell == 'S024' or castingSpell == 'S025' or castingSpell == 'S027' or castingSpell == 'S028' or castingSpell == 'S029' or castingSpell == 'S02A' or castingSpell == 'S02B' or castingSpell == 'S01Z' or castingSpell == 'S020' or castingSpell == 'S022' then
            set DRUID_STAR_SURGE_CHARGE = DRUID_STAR_SURGE_CHARGE+1
            call DruidCheckStarSurgeCharge.execute()
        endif 
    endfunction
    function HERO_9_TALENT_LEARN_8 takes nothing returns nothing
        call DruidCheckStarSurgeCharge.execute()
    endfunction
    function HERO_9_TALENT_RESET_8 takes nothing returns nothing
        call DruidCheckStarSurgeCharge.execute()
    endfunction
    function HERO_9_TALENT_SPELLING_5 takes nothing returns nothing
        local mybuff bf 
        local delayedevent de 
        if mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_SPIRITOFFOREST) > 0 then 
            if castingSpell == 'S02G' or castingSpell == 'S01Z' or castingSpell == 'S020' or castingSpell == 'S021' or castingSpell == 'S022' or castingSpell == 'S023' or castingSpell == 'S024' or castingSpell == 'S025' or castingSpell == 'S026' or castingSpell == 'S027' or castingSpell == 'S028' then
                set mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_SPIRITOFFOREST).DESTROY = true 
                set de = delayedevent.create(5,1,function DELAYED_RESET_SPELL_COOLDOWN)
                call de.saveUnit("CASTER",spellCaster)
                call de.saveInteger("CODE",castingSpell)
                call de.saveReal("COOLDOWN",0)
            endif 
        endif 
        if castingSpell == 'S029' then
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_BARSKIN)
            set bf.lastTime = 1000
            set bf.realData = 1
            call bf.addDmging_T(function BARSKIN_DAMAGING_TARGET)
            call bf.apply()
        endif 
        if castingSpell == 'S02C' then
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_SPIRITOFFOREST)
            set bf.lastTime = 3000
            call bf.apply()
        endif 
    endfunction
    function HERO_9_TALENT_DAMAGING_SOURCE_5 takes nothing returns nothing
        local real dmgRate = 1 
        local boolean add = false 
        if damageFlag == 'S02B' then
            if mybuff.getUnitBuff(damageSource,'A626') > 0 then
                set dmgRate = dmgRate+0.2
                set add = true 
            endif 
            if mybuff.getUnitBuff(damageSource,'A623') > 0 then
                set dmgRate = dmgRate+0.2
                set add = true 
            endif 
            if mybuff.getUnitBuff(damageSource,'A62C') > 0 then
                set dmgRate = dmgRate+0.2
                set add = true 
            endif 
            if add then 
                set dmgRate = dmgRate+0.4
            endif 
            set damageFinalDamage = damageFinalDamage*dmgRate
        endif 
    endfunction
    function HERO_9_ASTRAL_BURN_DAMAGE takes nothing returns nothing
        local real dmg = mybuff.currentBuff.realData*I2R(mybuff.currentBuff.periodTime)/I2R(mybuff.currentBuff.remainingTime+mybuff.currentBuff.periodTime)
        set mybuff.currentBuff.realData = mybuff.currentBuff.realData-dmg
        set damageTag_Ignite = true 
        set damageTag_Arcane = true 
        set damageTag_Earth = true 
        set damageIsDOT = true 
        set damageIsExtra = true 
        set damageFlag = 'A62Q'
        call UnitDamageTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_9_STAR_FALL_DAMAGE takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local real dmg = de.loadReal("DAMAGE")
        set damageTag_Arcane = true 
        set damageTag_Earth = true 
        set damageFlag = 'B62X'
        call UnitDamageTarget(de.loadUnit("SOURCE"),de.loadUnit("TARGET"),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_9_TALENT_AFTERDAMAGE_SOURCE_6 takes nothing returns nothing
        local mybuff bf 
        local delayedevent de 
        if damageIsDOT == false and (damageTag_Arcane or damageTag_Earth) and random.get(damageSource,0.35,'HTL6') and unitCheckCooldown(damageSource,'HTL6') then 
            call unitStartCooldown(damageSource,'HTL6',5)
            set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_DRUID_ASTRALBURN)
            set bf.lastTime = 600
            set bf.periodTime = 200
            set bf.addTime = false 
            set bf.hasteAble = false 
            call bf.addPeriod(function HERO_9_ASTRAL_BURN_DAMAGE)
            set bf.realData = bf.realData+0.4*damageDamage
            call bf.apply()
        endif 
        if damageIsDOT and random.get(damageSource,0.08,'A62Q') and unitCheckCooldown(damageSource,'A62Q') then 
            call unitStartCooldown(damageSource,'A62Q',5)
            set de = delayedevent.create(75,1,function HERO_9_STAR_FALL_DAMAGE)
            call de.saveUnit("SOURCE",damageSource)
            call de.saveUnit("TARGET",damageTarget)
            call de.saveReal("DAMAGE",I2R(unitGetAllBonusStateValue(damageSource,STATE_ABILITY_POWER))*1.8)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdl",damageTarget,"origin"))
            call AddUnitMana(damageSource,0.01*GetUnitState(damageSource,UNIT_STATE_MAX_MANA))
        endif 
    endfunction
    function HERO_9_TALENT_DAMAGING_SOURCE_10 takes nothing returns nothing
        if damageTag_Arcane then 
            set damageFinalDamage = damageFinalDamage*1.2
            set eventBonusLeech = eventBonusLeech+0.15
            if damageIsDOT and unitCheckCooldown(damageSource,'HTLA') then
                call unitStartCooldown(damageSource,'HTLA',1)
                call AddUnitMana(damageSource,0.01*GetUnitState(damageSource,UNIT_STATE_MAX_MANA))
            endif 
        endif 
    endfunction
    function HERO_9_TALENT_RESET_12 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(currentTTOwner,BUFFTYPE_DRUID_WILDSCHOSEN)
        set bf.DESTROY = true 
    endfunction
    function HERO_9_TALENT_SPELLING_12 takes nothing returns nothing
        local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_WILDSCHOSEN)
        set bf.lastTime = 6000
        set bf.intData = bf.intData+R2I(spellCooldown)
        call bf.apply()
        if castingSpell == 'S00Z' and bf.intData >= 120 then 
            set bf.intData = bf.intData-120
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif   
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_AVATAR)
            set bf.lastTime = 900
            call bf.apply()
            call DruidRefreshAvatar.evaluate(spellCaster)
        endif 
    endfunction

    globals
        delayedevent HERO_9_TALENT_9_DE = 0
        integer HERO_9_TALENT_9_LAST_ADD = 0
    endglobals
    function HERO_9_TALENT_9_CHANGE_MOON_PHASE takes nothing returns nothing
        if heroNowForm[8] != FORM_DRUID_MOONKIN and inCombat(hero[8]) then 
            set HERO_9_TALENT_9_LAST_ADD = HERO_9_TALENT_9_LAST_ADD+10
            if HERO_9_TALENT_9_LAST_ADD >= 1000 then 
                set HERO_9_TALENT_9_LAST_ADD = 0
                call DruidChangeMoonPhase.execute()
            endif 
        endif 
    endfunction
    function HERO_9_TALENT_LEARN_9 takes nothing returns nothing
        if HERO_9_TALENT_9_DE == 0 then 
            set HERO_9_TALENT_9_DE = delayedevent.create(10,0,function HERO_9_TALENT_9_CHANGE_MOON_PHASE)
            set HERO_9_TALENT_9_LAST_ADD = 0
        endif 
    endfunction
    function HERO_9_TALENT_RESET_9 takes nothing returns nothing
        if HERO_9_TALENT_9_DE != 0 then
            set HERO_9_TALENT_9_DE.DESTROY = true 
        endif 
    endfunction
