    function PUBLIC_TALENT_DAMAGING_TARGET_11 takes nothing returns nothing
        if damageSource == damageTarget then 
            return 
        endif 
        if GetUnitState(damageTarget,UNIT_STATE_LIFE)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) < 0.4 then 
            set damageFinalDamage = damageFinalDamage*0.85
        endif 
    endfunction

