    function HERO_10_TALENT_SPELLING_1 takes nothing returns nothing
        local delayedevent de 
        if castingSpell == 'S033' then 
            set de = delayedevent.create(1,1,function HERO_10_TALENT_1_DELAYED_HEAL)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("HEAL",RMaxBJ(deathStrikeSavedDamage*0.3,GetUnitState(spellCaster,UNIT_STATE_MAX_LIFE)*0.07))
        endif 
    endfunction
    function HERO_10_TALENT_1_REMOVE_SAVED takes nothing returns nothing
