    function SPELL_ATAL takes nothing returns nothing
        if currentTTOwner == spellCaster then 
            set currentTTOwner = null 
            call BlzFrameSetVisible(TalentBackground,false)
        else 
            set currentTTOwner = spellCaster
            call BlzFrameSetVisible(TalentBackground,true)
            call MultiboardMinimize(damageMeter,true)
            call TTUpdate()
        endif 
    endfunction

endlibrary

library talentlib requires spelllib
