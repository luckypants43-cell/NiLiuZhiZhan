    // endregion 

    // region demonhunter 恶魔猎手
    ////////////////
    //HEROID = 13(14)
    ////////////////
        function DH_FORM_END takes nothing returns nothing
            local effect sfx = null 
            if mybuff.currentBuff.boolData == false then 
                return 
            endif 
            call heroDefaultForm[13].transform(mybuff.currentBuff.buffTarget)
            set sfx = AddSpecialEffectTargetEX("war3campImported\\xieshenbianshen.mdx",mybuff.currentBuff.buffTarget,"origin")
            call BlzSetSpecialEffectTime(sfx,1.3)
            call BlzSetSpecialEffectTimeScale(sfx,2)
            call DestroyEffectEX(sfx)
            set sfx = null 
        endfunction
        function DemonHunterTransforming takes unit whichUnit returns nothing
            
        endfunction
        function DemonHunterTransformToDemon takes unit whichUnit,integer time returns nothing
            local effect sfx = null 
            local mybuff bf 
            set bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_DH_DEMONFORM,time)
            if GetUnitAbilityLevel(whichUnit,'S056') > 0 then 
                call BlzEndUnitAbilityCooldown(whichUnit,'S056')
                set bf.bonusHaste = 3000
                set bf.intData = 1
            elseif GetUnitAbilityLevel(whichUnit,'S057') > 0 then 
                call BlzEndUnitAbilityCooldown(whichUnit,'S057')
                set bf.bonusLife_P = 5000
                set bf.bonusArmor_P = 20000
                set bf.intData = 2
            endif 
            set bf.boolData = true
            call bf.addEnding(function DH_FORM_END)
            call bf.apply()
            if FORM_DEMON_HUNTER_DEMON.transform(whichUnit) == true then 
                set sfx = AddSpecialEffectTargetEX("war3campImported\\xieshen.mdx",whichUnit,"origin")
                call BlzSetSpecialEffectTime(sfx,1.3)
                call BlzSetSpecialEffectTimeScale(sfx,2)
                call DestroyEffectEX(sfx)
                set sfx = AddSpecialEffectTargetEX("war3campImported\\xieshenbianshen.mdx",whichUnit,"origin")
                call BlzSetSpecialEffectTime(sfx,1.3)
                call BlzSetSpecialEffectTimeScale(sfx,2)
                call DestroyEffectEX(sfx)
                call DemonHunterTransforming.evaluate(whichUnit)
                set sfx = null 
            endif 
        endfunction

        function S057_HEAL takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local real heal = GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.05
            set healFlag = 'S057'
            set healIsExtra = true 
            set healAddCrit = -10000
            call UnitHealTarget(caster,caster,heal)
            set caster = null 
        endfunction
        function HERO_14_ATTACKING takes nothing returns nothing
            local mybuff bf = 0
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 0
            local integer Qid = 0
            local delayedevent de = 0 
            local mybuff dbf = mybuff.getUnitBuff(damageSource,BUFFTYPE_DH_DEMONFORM)

            if GetUnitAbilityLevel(dt,'B67K') > 0 then 
                set Qid = 'S056'
                set Qcd = 3.8

                call UnitRemoveAbility(dt,'B67K')

                if dbf > 0 and dbf.intData == 1 then 
                    set Qcd = Qcd*2
                    set damageDamage = damageDamage*2
                    call enableAllElements()
                endif 

                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S056'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageDamage = damageDamage*1.3
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\BackStab_Cast_Base.mdx",damageSource,"origin"))
                set damageFlag = 'S056'
                set bf = CreateBuff(damageSource,damageSource,BUFFTYPE_DH_BLADEDANCE,500)
                if bf.intData == 0 then 
                    set bf.intData = 1
                    set Qcd = 0
                    set damageDamage = damageDamage*1.3
                endif 
                set bf.bonusAttackSpeed = 2000
                call bf.apply()
            endif

            if GetUnitAbilityLevel(dt,'B67T') > 0 then 
                set Qid = 'S057'
                set Qcd = 5.7

                call UnitRemoveAbility(dt,'B67T')

                if dbf > 0 and dbf.intData == 2 then 
                    set Qcd = 0
                    call enableAllElements()
                endif 

                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S057'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageDamage = damageDamage*1.4
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\Cleave_Envenom.mdx",damageSource,"origin"))
                set damageFlag = 'S057'

                call Taunt(damageSource,damageTarget)

                set de = CreateDelayedEvent(1,1,function S057_HEAL)
                call de.saveUnit("CASTER",damageSource)
            endif

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
            call BlzStartUnitAbilityCooldown(ds,Qid,Qcd*haste-0.01)
                
            set ds = null 
            set dt = null 
        endfunction

        function HERO_14_SPELLING takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction

        globals
            real S05C_DATA = 0
        endglobals
        function S05C_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local real dmg = 1*I2R(GetUnitMaxAttack(caster,0))
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(caster),GetUnitY(caster),250,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'S05C'
                set damageIsAOE = true 
                call UnitDamageTarget(caster,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\ThornsAuraDamageOnce.mdx",FirstOfGroup(pick),"head"),53)
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\ThornsAuraOnce.mdx",caster,"origin"))
        endfunction
        function HERO_14_DAMAGING_TARGET takes nothing returns nothing
            local delayedevent de = 0
            if GetUnitAbilityLevel(damageTarget,'S05C') > 0 then 
                set S05C_DATA = S05C_DATA+damageDamage
                set damageFinalDamage = damageFinalDamage*0.85
                if S05C_DATA > 0.5*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) then
                    set S05C_DATA = S05C_DATA-0.5*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE)
                    set de = CreateDelayedEvent(1,1,function S05C_DELAYED)
                    call de.saveUnit("CASTER",damageTarget)
                endif 
            endif 
        endfunction

        function A67W_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitAttack(bf.buffSource,0))*1.2/6*mybuff.buffTimeScale
            set damageTag_Fire = true 
            set damageTag_Ignite = true 
            set damageFlag = 'A67W'
            set damageIsDOT = true 
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S058_DELAY takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local real dmg = I2R(GetUnitAttack(caster,0))*1.2
            local integer period = 100
            local mybuff bf = 0
            local boolean mode = de.loadBoolean("MODE")
            local real range = 250
            if HeroHaveTalent(caster,HERO_PRIVATE_TALENT,4) then 
                set range = range*1.5
                set dmg = dmg*1.5
            endif 
            if mode then 
                set period = period/2
            endif 
            call GroupEnumUnitsInRangeEx(pick,x,y,range,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'S058'
                set damageTag_Fire = true 
                set damageIsAOE = true 
                call UnitDamageTarget(caster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\Immolation\\ImmolationDamage.mdl",FirstOfGroup(pick),"chest"))
                if GetUnitAbilityLevel(caster,'S057') > 0 then 
                    call Taunt(caster,FirstOfGroup(pick))
                endif 
                set bf = CreateBuff(caster,FirstOfGroup(pick),BUFFTYPE_DH_FELFIRERUNEIGNIT,600)
                set bf.periodTime = period
                call bf.addPeriod(function A67W_DOT)
                call bf.apply()
                call GroupRemoveFirstUnit(pick)
            endloop
            set caster = null 
            set pick = null 
        endfunction
        function SPELL_S058 takes nothing returns nothing   //烈焰咒符
            local delayedevent de
            local integer delay = 200
            local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_DH_BLADEDANCE)
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) then 
                set delay = delay/2
            endif 
            set de = CreateDelayedEvent(delay,1,function S058_DELAY)
            if bf.DESTROY == false and bf > 0 then 
                if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) == false then 
                    set bf.DESTROY = true 
                endif 
                call de.saveBoolean("MODE",true)
            else 
                call de.saveBoolean("MODE",false)
            endif 
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call delayedDestroyEffect(AddSpecialEffectEX("war3campImported\\RuneFelFire.mdx",spellTargetX,spellTargetY),delay)
        endfunction
        
        function S059_END takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            call applyRoot(proj.target,proj.source,'AET1')
        endfunction
        function S059_DELAY takes nothing returns nothing
            local projectile proj = 0
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local real dmg = I2R(GetUnitAttack(caster,0))*1.5
            local boolean mode = de.loadBoolean("MODE")
            local real range = 250
            local mybuff bf = 0
            if HeroHaveTalent(caster,HERO_PRIVATE_TALENT,4) then 
                set range = range*1.5
            endif 
            if mode then 
                set dmg = dmg*2.5
            endif 
            call GroupEnumUnitsInRangeEx(pick,x,y,range,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'S059'
                set damageIsAOE = true 
                call UnitDamageTarget(caster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                if IsUnitElite(FirstOfGroup(pick)) == false and IsUnitBoss(FirstOfGroup(pick)) == false and GetUnitDefaultMoveSpeed(FirstOfGroup(pick)) > 1 then 
                    set proj = KnockbackLocEx(FirstOfGroup(pick),x,y,900,0.5)
                    call proj.addOnEnd(function S059_END)
                    set proj.target = caster 
                else 
                    call applyRoot(caster,FirstOfGroup(pick),'AET1')
                endif 
                if GetUnitAbilityLevel(caster,'S057') > 0 then 
                    call Taunt(caster,FirstOfGroup(pick))
                endif 
                if HeroHaveTalent(caster,HERO_PRIVATE_TALENT,4) then 
                    set bf = CreateBuff(caster,FirstOfGroup(pick),BUFFTYPE_DH_SHACKLE,800)
                    set bf.bonusAttackSpeed = -4000
                    set bf.bonusMoveSpeed_P = -4000
                    call bf.apply()
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            set caster = null 
            set pick = null 
        endfunction
