
library initSkillDatas requires basic
        //天赋注册
    function initTalentDatas takes nothing returns nothing
        local integer heroId 
        local integer index 

        /*
        call SetTalentArt(1,0,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNHumanArmorUpOne.blp")
        call SetTalentArt(1,0,true,"ReplaceableTextures\\CommandButtons\\BTNHumanArmorUpOne.blp")
        call SetTalentName(1,0,"熟练格挡")
        call SetTalentDescription(1,0,"先锋精研格挡的技巧。\n\n|cffffcc00等级 1|r - 提高4点格挡\n|cffffcc00等级 2|r - 提高8点格挡\n|cffffcc00等级 3|r - 提高12点格挡")
        */
        ///////////////////////////
        //通用基础天赋/////////////////////
        //ID = 0
        ///////////////////////////
        if true then 
            set heroId = 0

            set index = 1
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNMassTeleport.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNMassTeleport.blp")
            call SetTalentName(heroId,index,"娴熟")
            call SetTalentDescription(heroId,index,"力量、敏捷和智力提高|cff20c0005%%|r；\n主属性提高|cff20c0005%%|r")

            set index = 2
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_20.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_20.blp")
            call SetTalentName(heroId,index,"强心")
            call SetTalentDescription(heroId,index,"生命上限和护甲提高|cff20c00010%%|r")

            set index = 3
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNNeutralManaShield.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNNeutralManaShield.blp")
            call SetTalentName(heroId,index,"平和")
            call SetTalentDescription(heroId,index,"法力上限提高|cff20c00010%%|r，\n法术抗性提高|cff20c0005%%|r")
        
            set index = 4
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNManaBurn.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNManaBurn.blp")
            call SetTalentName(heroId,index,"节能施法")
            call SetTalentDescription(heroId,index,"施法消耗的法力值降低|cff20c00015%%|r")

            set index = 5
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNCriticalStrike.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNCriticalStrike.blp")
            call SetTalentName(heroId,index,"致命一击")
            call SetTalentDescription(heroId,index,"暴击提高|cff20c0004%%|r，\n暴击伤害提高|cff20c0008%%|r")

            set index = 6
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNEvasion.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNEvasion.blp")
            call SetTalentName(heroId,index,"高速反射")
            call SetTalentDescription(heroId,index,"急速提高|cff20c0005%%|r，\n闪避提高|cff20c0005%%|r，\n攻击速度提高|cff20c0005%%|r")

            set index = 7
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNMarksmanship.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNMarksmanship.blp")
            call SetTalentName(heroId,index,"弹跃飞矢")
            call SetTalentDescription(heroId,index,"投射物额外弹射|cff20c0001|r次\n\n投射物击中敌人或盟友时，若有剩余的弹射次数，将向附近的同类目标弹射。弹射的投射物具有原本的所有能力。除特殊说明外，无法重复弹射已被弹射过的目标")

            set index = 8
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNCrystalBall.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNCrystalBall.blp")
            call SetTalentName(heroId,index,"洞悉")
            call SetTalentDescription(heroId,index,"造成伤害前，忽略目标|cff20c00030%%|r[x]的护甲与抗性")

            set index = 9
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNPriestMaster.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNPriestMaster.blp")
            call SetTalentName(heroId,index,"法术强效")
            call SetTalentDescription(heroId,index,"法术强度提高|cff20c00010%%|r")

            set index = 10
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNClawsOfAttack.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNClawsOfAttack.blp")
            call SetTalentName(heroId,index,"强攻")
            call SetTalentDescription(heroId,index,"攻击力提高|cff20c0008%%|r，\n命中提高|cff20c0005%%|r")

            set index = 11
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNHelmutPurple.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNHelmutPurple.blp")
            call SetTalentName(heroId,index,"钢铁意志")
            call SetTalentDescription(heroId,index,"生命低于|cff20c00040%%|r时，英雄受到的伤害\n降低|cff20c00015%%|r[x]")

            set index = 12
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNBootsOfSpeed.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNBootsOfSpeed.blp")
            call SetTalentName(heroId,index,"飞驰")
            call SetTalentDescription(heroId,index,"移动速度提高|cff20c00045|r点")

            set index = 13
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNVampiricAura.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNVampiricAura.blp")
            call SetTalentName(heroId,index,"生命汲取")
            call SetTalentDescription(heroId,index,"吸血提高|cff20c0007%%|r")

            set index = 14
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNMagicImmunity.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\commandButtons\\BTNMagicImmunity.blp")
            call SetTalentName(heroId,index,"充沛活力")
            call SetTalentDescription(heroId,index,"生命恢复速度提高|cff20c0000.4|r再提高|cff20c00015%%|r\n法力恢复速度提高|cff20c0000.2|r再提高|cff20c00010%%|r")

            set index = 15
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNUltravision.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNUltravision.blp")
            call SetTalentName(heroId,index,"浑然天成")
            call SetTalentDescription(heroId,index,"造成的治疗与护盾效果提高|cff20c00011%%|r[+]")

            set index = 16
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISbtnarcaneblast.blp")
            call SetTalentArt(heroId,index,true,"replaceabletextures\\commandbuttons\\mage_ability\\btnarcaneblast.blp")
            call SetTalentName(heroId,index,"玻璃大炮")
            call SetTalentDescription(heroId,index,"造成的伤害提高|cff20c00011%%|r[+]，\n受到的伤害提高|cffff000010%%|r[x]")

            set index = 17
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNThorns.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNThorns.blp")
            call SetTalentName(heroId,index,"荆棘")
            call SetTalentDescription(heroId,index,"受到攻击伤害后，对目标造成|cff20c000攻击力×0.1|r的物理伤害。\n额外将你格挡伤害的|cff20c00033%%|r加成至总伤害")

            set index = 18
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNHumanArmorUpTwo.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNHumanArmorUpTwo.blp")
            call SetTalentName(heroId,index,"坚盾")
            call SetTalentDescription(heroId,index,"格挡提高|cff20c00010%%|r；\n格挡上限提高|cff20c0005%%|r")

            set index = 19
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNEnchantedGemstone.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNEnchantedGemstone.blp")
            call SetTalentName(heroId,index,"启迪")
            call SetTalentDescription(heroId,index,"团队击杀敌人获取的经验提高|cff20c00015%%|r")

            set index = 20
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNTransmute.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNTransmute.blp")
            call SetTalentName(heroId,index,"搜索")
            call SetTalentDescription(heroId,index,"团队获得战利品的几率提高|cff20c00015%%|r")

            set index = 21
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNdruid_icon_30.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\Druid\\BTNdruid_icon_30.blp")
            call SetTalentName(heroId,index,"甘霖")
            call SetTalentDescription(heroId,index,"受到超过生命上限|cff20c00012%%|r的伤害后，立即治疗自己|cff20c00010%%|r的生命值，每|cff20c00030|r秒内只能触发一次")

            set index = 22
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNdruid_icon_6.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\Druid\\BTNdruid_icon_6.blp")
            call SetTalentName(heroId,index,"和谐")
            call SetTalentDescription(heroId,index,"造成的伤害提高|cff20c0008%%|r[+]\n造成的治疗和护盾效果提高|cff20c0008%%|r[+]")

            set index = 23
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNAdvancedStrengthOfTheMoon.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNAdvancedStrengthOfTheMoon.blp")
            call SetTalentName(heroId,index,"平衡")
            call SetTalentDescription(heroId,index,"攻击力提高|cff20c0006%%|r\n法术强度提高|cff20c0006%%|r\n暴击提高|cff20c0003%%|r")

            set index = 24
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNdruid_icon_18.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\Druid\\BTNdruid_icon_18.blp")
            call SetTalentName(heroId,index,"戒卫")
            call SetTalentDescription(heroId,index,"法术抗性提高|cff20c0008%%|r，并能免疫沉默效果")

            set index = 25
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNdruid_icon_15.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\Druid\\BTNdruid_icon_15.blp")
            call SetTalentName(heroId,index,"壮美")
            call SetTalentDescription(heroId,index,"生命和法力上限提高|cff20c00010%%|r")

            set index = 26
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISbtnbladedance.blp")
            call SetTalentArt(heroId,index,true,"replaceabletextures\\commandbuttons\\fromDOTA\\btnbladedance.blp")
            call SetTalentName(heroId,index,"游斗")
            call SetTalentDescription(heroId,index,"未装备盾牌时，提高|cff20c00010%%|r的急速和闪避，并提高|cff20c0003%%|r的闪避上限")

            set index = 27
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNScout.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNScout.blp")
            call SetTalentName(heroId,index,"多才多艺")
            call SetTalentDescription(heroId,index,"提高|cff20c0007%%|r的全能")
        endif   

        ///////////////////////////
        //先锋/////////////////////
        //HERO[0]
        //ID = 1
        ///////////////////////////
        if true then 

            set heroId = 1

            set index = 1 
            call SetHeroTypePublicTalent(heroId,index,2)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNDefend.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNDefend.blp")
            call SetTalentName(heroId,index,"格挡箭矢")
            call SetTalentDescription(heroId,index,"对于远程攻击，有额外|cff20c00010%%|r的闪避和格挡，并在闪避失败后再次进行闪避判定，若成功，则该伤害被偏转，降低|cff20c00030%%|r[x]")

            set index = 2
            call SetHeroTypePublicTalent(heroId,index,11)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_11.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_11.blp")
            call SetTalentName(heroId,index,"战争艺术")
            call SetTalentDescription(heroId,index,"英勇打击振奋附近的盟友，使他们的下一次攻击额外造成|cff20c00015%%|r[x]的伤害并有额外|cff20c0005%%|r的吸血")

            set index = 3
            call SetHeroTypePublicTalent(heroId,index,12)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_03.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_03.blp")
            call SetTalentName(heroId,index,"防御姿态")
            call SetTalentDescription(heroId,index,"受到和造成的伤害降低|cff20c00010%%|r[x]；\n生命值低于|cff20c00050%%|r时，加强至|cff20c00015%%|r[x]")

            set index = 4
            call SetHeroTypePublicTalent(heroId,index,13)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_13.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_13.blp")
            call SetTalentName(heroId,index,"举盾防御")
            call SetTalentDescription(heroId,index,"冲锋与嘲讽也会使你举盾，提高|cff20c000100%%|r的格挡和格挡上限(举盾的次数上限可以叠加)\n\n|cffffcc00冲锋：|r持续|cff20c0008|r秒或抵挡|cff20c0004|r次攻击\n\n|cffffcc00嘲讽：|r持续|cff20c0004|r秒或抵挡|cff20c0002|r次攻击")

            set index = 5
            call SetHeroTypePublicTalent(heroId,index,17)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_05.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_05.blp")
            call SetTalentName(heroId,index,"不屈")
            call SetTalentDescription(heroId,index,"|cffffcc00[不屈之力]|r或|cffffcc00[坚毅]|r可以被消耗来为你抵抗一次致命伤害，并将生命值恢复到|cff20c00010%%|r")

            set index = 6
            call SetHeroTypePublicTalent(heroId,index,18)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_17.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_17.blp")
            call SetTalentName(heroId,index,"尖刺盾牌")
            call SetTalentDescription(heroId,index,"提高|cff20c00010%%|r的格挡和|cff20c0005%%|r的格挡上限；\n被击中时有|cff20c00020%%|r的几率使敌人流血，在|cff20c00012|r秒内造成|cffffcc00攻击×1.5+护甲+格挡|r的物理伤害")

            set index = 7
            call SetHeroTypePublicTalent(heroId,index,24)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_00.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_00.blp")
            call SetTalentName(heroId,index,"援护")
            call SetTalentDescription(heroId,index,"光环，附近盟友所受伤害的|cff20c00010%%|r转为由先锋承受")

            set index = 8
            call SetHeroTypePublicTalent(heroId,index,27)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_09.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_09.blp")
            call SetTalentName(heroId,index,"无畏")
            call SetTalentDescription(heroId,index,"每缺失|cff20c00015%%|r的生命值，受到的伤害就降低|cff20c0004%%|r，最多降低|cff20c00020%%|r[x]")
            
            set index = 9
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNAvatarOn.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNAvatarOn.blp")
            call SetTalentName(heroId,index,"天神下凡")
            call SetTalentDescription(heroId,index,"获得山丘之王的传承：\n英勇打击有|cff20c00030%%|r的几率升华为闪电打击，召唤一道闪电劈向目标，使其造成闪电伤害且伤害提高|cff20c000100%%|r\n不在|cffffcc00[觉醒]|r中时，闪电打击有|cff20c00010%%|r的几率使你立即觉醒，持续|cff20c0004|r秒")
            
            set index = 10
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_14.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_14.blp")
            call SetTalentName(heroId,index,"战场指挥官")
            call SetTalentDescription(heroId,index,"施放英勇怒吼或命令怒吼时，也会以|cff20c00050%%|r的效果和持续时间施加另一种怒吼\n终极技能(|cffffcc00F|r)的冷却时间缩短|cff20c00030|r秒")
            
            set index = 11
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_21.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_21.blp")
            call SetTalentName(heroId,index,"不朽壁垒")
            call SetTalentDescription(heroId,index,"受到的非攻击伤害减免相当于格挡|cff20c00050%%|r的数额，不超过伤害的|cff20c00050%%|r。伤害至少为|cff20c0001|r")

            set index = 12
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNability_18.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\warrior\\BTNability_18.blp")
            call SetTalentName(heroId,index,"崩破烙印")
            call SetTalentDescription(heroId,index,"英勇打击对敌人施加|cffffcc00[崩破烙印]|r，每层使其护甲降低|cff20c0006%%|r，闪避降低|cff20c0003%%|r\n至多叠加|cff20c0003|r层，持续|cff20c0008|r秒")
            
        endif 

        ///////////////////////////
        //圣骑士////////////////////
        //HERO[1]
        //ID = 2
        ///////////////////////////
        if true then 

            set heroId = 2

            set index = 1 
            call SetHeroTypePublicTalent(heroId,index,1)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNpaladin_20.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\paladin\\BTNpaladin_20.blp")
            call SetTalentName(heroId,index,"信念")
            call SetTalentDescription(heroId,index,"生命低于|cff20c00035%%|r或所受伤害将使你的生命降至|cff20c00035%%|r以下时，受到的伤害降低|cff20c00015%%|r[x]\n\n你的神圣道标也会享受这个效果")

            set index = 2
            call SetHeroTypePublicTalent(heroId,index,2)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNpaladin_12.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\paladin\\BTNpaladin_12.blp")
            call SetTalentName(heroId,index,"生命圣印")
            call SetTalentDescription(heroId,index,"激活生命圣印，使圣光闪现的冷却时间降低|cff20c0000.5|r秒，并在击中时有|cff20c00015%%|r的几率为自己治疗|cffffcc00法术强度×0.5|r的生命值\n\n十字军打击必定触发圣印效果")

            set index = 3
            call SetHeroTypePublicTalent(heroId,index,3)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNpaladin_6.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\paladin\\BTNpaladin_6.blp")
            call SetTalentName(heroId,index,"牺牲祝福")
            call SetTalentDescription(heroId,index,"受你祝福的盟友所受伤害的|cff20c00020%%|r由你承担，并降低|cff20c00050%%|r[x]\n\n作为法术伤害")

            set index = 4
            call SetHeroTypePublicTalent(heroId,index,11)
            call SetTalentArt(heroId,index,false,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNpaladin_19.blp")
            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\paladin\\BTNpaladin_19.blp")
            call SetTalentName(heroId,index,"炽热防御者")
