    function PUBLIC_TALENT_21_DELAYED_HEAL takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        set healIsExtra = true 
        set healFlag = 'PT21'
        call UnitHealTarget(de.loadUnit("SOURCE"),de.loadUnit("SOURCE"),de.loadReal("HEAL"))
    endfunction
    function PUBLIC_TALENT_AFTERDAMAGE_TARGET_21 takes nothing returns nothing
        local delayedevent de 
        if unitCheckCooldown(damageTarget,'PT21') and damageFinalDamage > 0.12*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) then 
            set de = delayedevent.create(1,1,function PUBLIC_TALENT_21_DELAYED_HEAL)
            call de.saveUnit("SOURCE",damageTarget)
            call de.saveReal("HEAL",0.1*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\Healing Surge.mdx",damageTarget,"origin"),100)
            call unitStartCooldown(damageTarget,'PT21',3000)
        endif 
    endfunction

    function PUBLIC_TALENT_17_DELAYED_DAMAGE takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        set damageTag_Earth = true 
        set damageIsExtra = true 
        set damageFlag = 'AEah' 
        call UnitDamageTarget(de.loadUnit("SOURCE"),de.loadUnit("TARGET"),de.loadReal("DAMAGE"),false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        //call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\ThornsAura\\ThornsAuraDamage.mdl",de.loadUnit("TARGET"),"head"))
    endfunction
    function PUBLIC_TALENT_AFTERDAMAGE_TARGET_17 takes nothing returns nothing
        local delayedevent de 
        if damageTag_Attack then 
            set de = delayedevent.create(1,1,function PUBLIC_TALENT_17_DELAYED_DAMAGE)
            call de.saveUnit("SOURCE",damageTarget)
            call de.saveUnit("TARGET",damageSource)
            call de.saveReal("DAMAGE",0.1*I2R(GetUnitMaxAttack(damageTarget,0))+0.33*damageBlockDamage)
        endif 
    endfunction

    function PUBLIC_TALENT_LEARN_18 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_BLOCK_P,1000)
        call unitAddState(currentTTOwner,STATE_MAX_BLOCK,500)
    endfunction
    function PUBLIC_TALENT_RESET_18 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_BLOCK_P,-1000)
        call unitAddState(currentTTOwner,STATE_MAX_BLOCK,-500)
    endfunction

    function PUBLIC_TALENT_RESET_26 takes nothing returns nothing
        local integer addedEvade = GetHeroData(currentTTOwner,"PUBLIC_TALENT_ADDED_EVADE_26")
        local integer addedHaste = GetHeroData(currentTTOwner,"PUBLIC_TALENT_ADDED_HASTE_26")
        local integer addedMaxEvade = GetHeroData(currentTTOwner,"PUBLIC_TALENT_ADDED_MAX_EVADE_26")
        local boolean added = false 

        if addedEvade > 0 then 
            call ST_EVADE.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-addedEvade)
            call SetHeroData(currentTTOwner,"PUBLIC_TALENT_ADDED_EVADE_26",0)
            set added = true 
        endif 
        if addedHaste > 0 then 
            call ST_HASTE.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-addedHaste)
            call SetHeroData(currentTTOwner,"PUBLIC_TALENT_ADDED_HASTE_26",0)
            set added = true 
        endif 
        if addedMaxEvade > 0 then 
            call ST_MAX_EVADE.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-addedMaxEvade)
            call SetHeroData(currentTTOwner,"PUBLIC_TALENT_ADDED_MAX_EVADE_26",0)
            set added = true 
        endif 
        if added then 
            set doNotCheck = true 
            call State.checkAll(currentTTOwner)
            set doNotCheck = false
        endif 
    endfunction
    function PUBLIC_TALENT_CHECK_STATE_26 takes nothing returns nothing
        local integer addedEvade = GetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_EVADE_26")
        local integer addedHaste = GetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_HASTE_26")
        local integer addedMaxEvade = GetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_MAX_EVADE_26")
        local boolean added = false 

        //call BJDebugMsg("CHECK 26")

        if GetEquipedItem(checkingUnit,1).type.class > 2 then 
            if addedEvade > 0 then 
                call ST_EVADE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-addedEvade)
                call SetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_EVADE_26",0)
                set added = true 
            endif 
            if addedHaste > 0 then 
                call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-addedHaste)
                call SetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_HASTE_26",0)
                set added = true 
            endif 
            if addedMaxEvade > 0 then 
                call ST_MAX_EVADE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-addedMaxEvade)
                call SetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_MAX_EVADE_26",0)
                set added = true 
            endif 
            if added then 
                set doNotCheck = true 
                call State.checkAll(checkingUnit)
                set doNotCheck = false
            endif 
        else 
            if addedEvade != 1000 then 
                call ST_EVADE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,1000-addedEvade)
                call SetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_EVADE_26",1000)
                set added = true 
            endif 
            if addedHaste != 1000 then 
                call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,1000-addedHaste)
                call SetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_HASTE_26",1000)
                set added = true 
            endif 
            if addedMaxEvade != 300 then 
                call ST_MAX_EVADE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,300-addedMaxEvade)
                call SetHeroData(checkingUnit,"PUBLIC_TALENT_ADDED_MAX_EVADE_26",300)
                set added = true 
            endif 
            if added then 
                set doNotCheck = true 
                call State.checkAll(checkingUnit)
                set doNotCheck = false
            endif 
        endif 
    endfunction

    
    function PUBLIC_TALENT_LEARN_27 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_VERSATILITY,700)
    endfunction
    function PUBLIC_TALENT_RESET_27 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_VERSATILITY,-700)
    endfunction

    //====================================================
    // endregion 
    //====================================================

    //====================================================
    // region hero_1
    //====================================================        
    function HERO_1_TALENT_ATTACKED_TARGET_1 takes nothing returns nothing
        if damageTag_Attack and damageIsMelee == false then 
            if random.get(damageTarget,RMinBJ(damageMaxEvadeChance,damageEvade)-damageAccuracy-damageAddAccuracy,'AEev') then 
                set damageFinalDamage = 0.7*damageFinalDamage
            endif 
        endif
    endfunction
    function HERO_1_TALENT_PREDAMAGE_TARGET_1 takes nothing returns nothing
        if damageTag_Attack and damageIsMelee == false then 
            set damageBlock = damageBlock*1.1
            set damageEvade = damageEvade+0.1
        endif 
    endfunction
    function HERO_1_TALENT_DAMAGING_SOURCE_3 takes nothing returns nothing
        if GetUnitLifePercent(damageSource) < 0.5 then 
            set damageFinalDamage = damageFinalDamage*0.85
        else 
            set damageFinalDamage = damageFinalDamage*0.9
        endif 
    endfunction
    function HERO_1_TALENT_DAMAGING_TARGET_3 takes nothing returns nothing
        if damageSource == damageTarget then 
            return 
        endif 
        if GetUnitLifePercent(damageTarget) < 0.5 then 
            set damageFinalDamage = damageFinalDamage*0.85
        else 
            set damageFinalDamage = damageFinalDamage*0.9
        endif 
    endfunction
    function BATTLE_ART_ATTACKING takes nothing returns nothing
        if mybuff.currentBuff.lastTime != mybuff.currentBuff.remainingTime then 
            set mybuff.currentBuff.DESTROY = true 
            set damageDamage = damageDamage*1.15
            set eventBonusLeech = eventBonusLeech+0.05
        endif 
    endfunction
    function HERO_1_TALENT_SPELLING_2 takes nothing returns nothing
        local mybuff bf 
        local group pick
        if castingSpell == 'S001' then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),900,playerAlly)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_VANGUARD_BATTLEART)
                set bf.lastTime = 1000
                call bf.addAtking(function BATTLE_ART_ATTACKING)
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
        endif 
    endfunction
    function HERO_1_TALENT_SPELLING_4 takes nothing returns nothing
        local mybuff bf 
        if castingSpell == 'S000' or castingSpell == 'S01O' then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_VANGUARD_SHIELDBARRIER)
            set bf.bonusBlock_P = 10000
            if castingSpell == 'S000' then 
                set bf.lastTime = 800
                set bf.intData = 4+bf.intData
            else 
                set bf.lastTime = 400
                set bf.intData = 2+bf.intData
            endif 
            set bf.bonusMaxBlock = 10000
            call bf.addAtked_T(function SHIELD_BASH_ATTACKED_TARGET)
            call bf.addEnding(function SHIELD_BASH_END)
            call bf.apply()
            call AddUnitAnimationProperties(spellCaster,"defend",true)
        endif 
    endfunction
    function HERO_1_TALENT_DAMAGED_TARGET_5 takes nothing returns nothing
        local mybuff bf1 = mybuff.getUnitBuff(damageTarget,BUFFTYPE_VANGUARD_INDOMITABLESTRENGTH)
        local mybuff bf2 = mybuff.getUnitBuff(damageTarget,BUFFTYPE_VANGUARD_TENACITY)
        if ((bf1 > 0 and bf1.DESTROY == false) or (bf2 > 0 and bf2.DESTROY == false)) and damageFinalDamage > GetUnitState(damageTarget,UNIT_STATE_LIFE)-0.5 then 
            if bf1 > 0 then 
                set bf1.DESTROY = true 
            else 
                set bf2.DESTROY = true 
            endif 
            call SetUnitState(damageTarget,UNIT_STATE_LIFE,0.1*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))
            set damageFinalDamage = 0
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl",damageTarget,"origin"))
        endif 
    endfunction
    function VANGUARD_BLEED_PERIOD takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = (1.5*I2R(GetUnitMaxAttack(bf.buffSource,0))+I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_BLOCK))+BlzGetUnitArmor(bf.buffSource))/6*mybuff.buffTimeScale
        set damageTag_Bleed = true 
        set damageFlag = 'A61X'
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_1_TALENT_LEARN_6 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_BLOCK_P,1000)
        call unitAddState(currentTTOwner,STATE_MAX_BLOCK,500)
    endfunction
    function HERO_1_TALENT_RESET_6 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_BLOCK_P,-1000)
        call unitAddState(currentTTOwner,STATE_MAX_BLOCK,-500)
    endfunction
    function HERO_1_TALENT_ATTACKED_TARGET_6 takes nothing returns nothing
        local mybuff bf 
        if GetRandomReal(0,1) < 0.2 then 
            set bf = mybuff.create(damageTarget,damageSource,BUFFTYPE_VANGUARD_BLEED)
            set bf.lastTime = 1200
            set bf.periodTime = 200
            set bf.hasteAble = true 
            call bf.addPeriod(function VANGUARD_BLEED_PERIOD)
            call bf.apply()
        endif 
    endfunction
    function INTERVENE_DELAYED_DAMAGE takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local integer AT = de.loadInteger("ATTACK_TYPE")
        local integer DT = de.loadInteger("DAMAGE_TYPE")
        local real dmg = de.loadReal("DAMAGE")
        set damageFlag = de.loadInteger("DAMAGE_FLAG")
        call UnitDamageTarget(de.loadUnit("SOURCE"),de.loadUnit("TARGET"),dmg,false,true,ConvertAttackType(AT),ConvertDamageType(DT),WEAPON_TYPE_WHOKNOWS)
    endfunction
    function INTERVENE_DAMAGING_TARGET takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local delayedevent de
        if damageSource == damageTarget then 
            return 
        endif 
        if damageSource != bf.buffSource and damageSource != bf.buffTarget then 
            set de = delayedevent.create(2,1,function INTERVENE_DELAYED_DAMAGE)
            call de.saveUnit("SOURCE",damageSource)
            call de.saveUnit("TARGET",bf.buffSource)
            call de.saveInteger("ATTACK_TYPE",AttackType2I(damageAttackType))
            call de.saveInteger("DAMAGE_TYPE",DamageType2I(damageDamageType))
            call de.saveInteger("DAMAGE_FLAG",damageFlag)
            call de.saveReal("DAMAGE",0.1*damageDamage)
        endif 
        set damageFinalDamage = damageFinalDamage*0.9
    endfunction
    function INTERVENE_AURA_STATE_SET takes nothing returns nothing
        call aura.modifingAuraBuff.addDmging_T(function INTERVENE_DAMAGING_TARGET)
    endfunction
    function INTERVENE_AURA_ALLY_CHECK takes nothing returns nothing
        set aura.able = true 
        if aura.filterUnit == aura.checkingAura.bindUnit then 
            set aura.able = false 
        endif 
    endfunction
    function HERO_1_TALENT_LEARN_7 takes nothing returns nothing
        local aura ar = aura.create(currentTTOwner,"AURA_VANGUARD_INTERVENE",450,0,BUFFTYPE_VANGUARD_INTERVENE,"")
        call ar.addAllySet(function INTERVENE_AURA_STATE_SET)
        call ar.addAllyChk(function INTERVENE_AURA_ALLY_CHECK)
    endfunction
    function HERO_1_TALENT_RESET_7 takes nothing returns nothing
        set aura.getAura(currentTTOwner,"AURA_VANGUARD_INTERVENE").DESTROY = true 
    endfunction
    function HERO_1_TALENT_DAMAGING_TARGET_8 takes nothing returns nothing
        local real reduce = 0.04*I2R(IMinBJ(5,R2I((GetUnitLostLife(damageTarget)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))/0.15)))
        if damageSource == damageTarget then 
            return 
        endif 
        set damageFinalDamage = damageFinalDamage*(1-reduce)
    endfunction
    function HERO_1_TALENT_ATTACKED_SOURCE_9 takes nothing returns nothing
        local mybuff bf 
        if damageFlag == 'S001' and random.get(damageSource,0.3,'HTL9') then 
            set damageTag_Lightning = true 
            set damageFinalDamage = damageFinalDamage*2
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",damageTarget,"origin"))
            if mybuff.getUnitBuff(damageSource,BUFFTYPE_VANGUARD_AVATAR) == 0 and random.get(damageSource,0.1,'B61V') and unitCheckCooldown(damageSource,'B61V') then 
                call unitStartCooldown(damageSource,'B61V',20)
                set bf = mybuff.create(damageSource,damageSource,BUFFTYPE_VANGUARD_AVATAR)
                set bf.lastTime = 400
                set bf.bonusArmor_P = 2000
                set bf.bonusLife_P = 2000
                set bf.bonusAttack_P = 2000
                set bf.bonusResistance = 5000
                set bf.bonusImmune_Root = 1
                set bf.bonusImmune_Silence = 1
                set bf.bonusImmune_Snare = 1
                set bf.bonusImmune_Stun = 1
                set bf.bonusMaxArmor = 1500
                set bf.bonusMaxResistance = 1500
                call bf.apply()
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Avatar\\AvatarCaster.mdl",damageSource,"origin"))
            endif 
        endif 
    endfunction
    function HERO_1_TALENT_SPELLING_10 takes nothing returns nothing
        local group pick 
        local mybuff bf
        if castingSpell == 'S01T' or castingSpell == 'S01U' then 
            set pick = CreateGroup()
            if castingSpell == 'S01U' then 
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),350,playerEnemy)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    call Taunt(spellCaster,FirstOfGroup(pick))
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),450,playerAlly)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_VANGUARD_HEROICSHOUT)
                    set bf.lastTime = 400
                    set bf.realData = 0.5
                    call bf.addDmging_T(function HEROIC_SHOUT_DAMAGING_TARGET)
                    call bf.apply()
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
            else
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),450,playerAlly)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_VANGUARD_BATTLESHOUT)
                    set bf.lastTime = 750
                    set bf.realData = 0.5
                    call bf.addDmging_S(function BATTLE_SHOUT_DAMAGING_SOURCE)
                    call bf.apply()
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
            endif 
            call DestroyGroup(pick)
            set pick = null 
        endif 
    endfunction
    function HERO_1_TALENT_BEFOREDAMAGE_TARGET_11 takes nothing returns nothing
        if damageTag_Attack == false then 
            set damageDamage = RMaxBJ(1,RMaxBJ(damageDamage-0.5*damageBlock,damageDamage*0.5))
        endif 
    endfunction
    function HERO_1_TALENT_AFTERDAMAGE_SOURCE_12 takes nothing returns nothing
        local mybuff bf 
        if damageFlag == 'S001' then 
            set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_VANGUARD_SUNDERBRAND)
            set bf.intData = IMinBJ(3,bf.intData+1)
            set bf.bonusArmor_P = 0-600*bf.intData
            set bf.bonusEvade = 0-300*bf.intData
            set bf.lastTime = 800
            call bf.apply()
        endif 
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_2
    //====================================================
    function HERO_2_TALENT_DAMAGED_TARGET_1 takes nothing returns nothing
        if (GetUnitState(damageTarget,UNIT_STATE_LIFE)-damageFinalDamage)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) < 0.35 then 
            set damageFinalDamage = damageFinalDamage*0.85
        endif 
    endfunction
    function HERO_2_TALENT_2_DELAYED_HEAL takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        set healFlag = 'SZ2R'
        call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("HEAL"))
        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",de.loadUnit("TARGET"),"origin"))
    endfunction
    function HERO_2_TALENT_ATTACKED_SOURCE_2 takes nothing returns nothing
        local delayedevent de 
        if random.get(damageSource,0.15,'HTL2') or damageFlag == 'S02R' then 
            set de = delayedevent.create(10,1,function HERO_2_TALENT_2_DELAYED_HEAL)
            call de.saveReal("HEAL",0.5*I2R(unitGetAllBonusStateValue(damageSource,STATE_ABILITY_POWER)))
            call de.saveUnit("CASTER",damageSource)
            call de.saveUnit("TARGET",damageSource)
        endif 
    endfunction
    function HERO_2_TALENT_DAMAGING_TARGET_1 takes nothing returns nothing
        if damageSource == damageTarget then 
            return 
        endif 
        set damageFinalDamage = damageFinalDamage*(1-RMinBJ(0.15,0.5*(I2R(unitGetAllBonusStateValue(hero[1],STATE_CRIT))/10000)))
    endfunction
    function HERO_2_TALENT_RESET_5 takes nothing returns nothing
        call removeBlessSfx() 
    endfunction
    function HERO_2_TALENT_HEALING_SOURCE_7 takes nothing returns nothing
        set healAddCrit = healAddCrit+0.1
    endfunction
    function HERO_2_TALENT_AFTERDAMAGE_SOURCE_7 takes nothing returns nothing
        local mybuff bf 
        local real maxShield 
        local real bonusShield
        if damageFlag == 'S02T' or damageFlag == 'S02R' then 
            set maxShield = GetUnitState(damageSource,UNIT_STATE_MAX_LIFE)*0.25
            set bonusShield = damageFinalDamage
            set bf = CreateBuff(damageSource,damageSource,BUFFTYPE_PALADIN_HOLYSHIELD,1000)
            set bf.shieldBlockPercent = 1
            set bf.shieldMaxValue = bonusShield
            set bf.addShield = true 
            set bf.addShieldMaxValue = maxShield
            set bf.shieldDestroy = true 
            call bf.apply()
        endif 
    endfunction
    globals 
        private delayedevent paladinConsecration = 0
    endglobals
    function CONSECRATION_PERIOD takes nothing returns nothing
        local real x = paladinConsecration.loadReal("X")
        local real y = paladinConsecration.loadReal("Y")
        local real heal = 0.2*I2R(unitGetAllBonusStateValue(hero[1],STATE_ABILITY_POWER))
        local real dmg = 0.15*I2R(unitGetAllBonusStateValue(hero[1],STATE_ABILITY_POWER))
        local group pick = CreateGroup()
        local mybuff bf 
        call GroupEnumUnitsInRangeEx(pick,x,y,300,playerEnemy)
        loop 
            exitwhen FirstOfGroup(pick) == null 
            set damageFlag = 'SZ2W'
            set damageIsAOE = true 
            set damageTag_Divine = true 
            call UnitDamageTarget(hero[1],FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call GroupEnumUnitsInRangeEx(pick,x,y,300,playerAlly)
        loop 
            exitwhen FirstOfGroup(pick) == null 
            set healFlag = 'SZ2W'
            set healIsAOE = true 
            call UnitHealTarget(hero[1],FirstOfGroup(pick),heal)
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call DestroyGroup(pick)
        set pick = null 
        if DisByUnXY(hero[1],x,y) < 300 then 
            set bf = CreateBuff(hero[1],hero[1],BUFFTYPE_PALADIN_CONSECRATION,202)
            set bf.bonusBlock = 2*UnitLevel(hero[1])
            set bf.bonusBlock_P = 1000
            call bf.apply()
        endif 
    endfunction
    function HERO_2_TALENT_SPELLING_8 takes nothing returns nothing
        if castingSpell == 'S02T' or castingSpell == 'S02U' then 
            if paladinConsecration > 0 and paladinConsecration.loadInteger("FLAG") == 'H2T8' then 
                call DestroyEffectEX(paladinConsecration.loadEffect("SFX"))
                set paladinConsecration.DESTROY = true 
            endif 
            set paladinConsecration = delayedevent.create(200,30,function CONSECRATION_PERIOD)
            call paladinConsecration.saveReal("X",GetUnitX(spellCaster))
            call paladinConsecration.saveReal("Y",GetUnitY(spellCaster))
            call paladinConsecration.saveInteger("FLAG",'H2T8')
            call paladinConsecration.saveEffect("SFX",AddSpecialEffectEX("war3campImported\\fengxian.mdx",GetUnitX(spellCaster),GetUnitY(spellCaster)))
            call delayedDestroyEffect(paladinConsecration.loadEffect("SFX"),6003)
        endif 
    endfunction
    
    function A63X_DELAYED_HEAL takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        set healFlag = 'A63X'
        set healIsAOE = true 
        call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("HEAL"))
    endfunction
    function HERO_2_TALENT_AFTERHEAL_SOURCE_9 takes nothing returns nothing
        local delayedevent de 
        local mybuff beacon = mybuff.getUnitBuff(paladinVirtueBeaconTarget,BUFFTYPE_PALADIN_VIRTUEBEACON)
        local group pick = null 
        if beacon == 0 and paladinVirtueBeaconTarget != null then 
            set paladinVirtueBeaconTarget = null
        endif 
        if beacon > 0 and healIsAOE == false and healTarget != paladinVirtueBeaconTarget then 
            set de = delayedevent.create(1,1,function A63X_DELAYED_HEAL)
            call de.saveReal("HEAL",healHeal)
            call de.saveUnit("CASTER",healSource)
            call de.saveUnit("TARGET",paladinVirtueBeaconTarget)
        endif 
        if beacon > 0 and healIsAOE == false and healTarget == paladinVirtueBeaconTarget then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(paladinVirtueBeaconTarget),GetUnitY(paladinVirtueBeaconTarget),900,playerAlly)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if FirstOfGroup(pick) != paladinVirtueBeaconTarget then 
                set de = delayedevent.create(1,1,function A63X_DELAYED_HEAL)
                call de.saveReal("HEAL",healHeal*0.25)
                call de.saveUnit("CASTER",healSource)
                call de.saveUnit("TARGET",FirstOfGroup(pick))
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endif 
    endfunction
    function HERO_2_TALENT_SPELLING_9 takes nothing returns nothing
        local mybuff bf
        if castingSpell == 'S02V' or castingSpell == 'S02W' or castingSpell == 'S02X' then 
            if mybuff.getUnitBuff(spellTarget,BUFFTYPE_PALADIN_DIVINEBEACON) > 0 then 
                return 
            endif 
            call removeVirtueBeaconSfx()
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PALADIN_VIRTUEBEACON)
            set bf.lastTime = 60000
            call bf.apply()
            set paladinVirtueBeaconTarget = spellTarget
        endif 
    endfunction
    function HERO_2_TALENT_DAMAGED_TARGET_10 takes nothing returns nothing
        local mybuff bf 
        if unitCheckCooldown(damageTarget,'HTLA') and damageFinalDamage-GetUnitState(damageTarget,UNIT_STATE_LIFE) > 1 then
            call unitStartCooldown(damageTarget,'HTLA',18000)
            set damageFinalDamage = RMaxBJ(0,damageFinalDamage-100000)
            set bf = mybuff.create(damageTarget,damageTarget,BUFFTYPE_PALADIN_DIVINEINTERVENTION)
            set bf.lastTime = 600
            set bf.shieldBlockPercent = 1
            set bf.shieldMaxValue = 1000000
            set bf.shieldDestroy = true 
            set bf.bonusImmune_Cold = 1
            set bf.bonusImmune_Root = 1
            set bf.bonusImmune_Silence = 1
            set bf.bonusImmune_Snare = 1
            set bf.bonusImmune_Stun = 1
            call bf.apply()
            call removeAllDisabilities(damageTarget)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",damageTarget,"origin"))
        endif 
    endfunction
    function HERO_2_TALENT_SPELLING_11 takes nothing returns nothing
        local mybuff bf 
        if castingSpell == 'S02V' then 
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PALADIN_BLESSOFLIFE)
            set bf.lastTime = 60000
            call bf.addAtking(function A63Q_ATKING)
            call bf.addHealing_T(function A63Q_HEALING_T)
            call bf.apply()
        elseif castingSpell == 'S02W' then 
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PALADIN_BLESSOFSTRENGTH)
            set bf.lastTime = 60000
            set bf.bonusAttack_P = 2000
            set bf.bonusAbilityPower_P = 2000
            call bf.apply()
        elseif castingSpell == 'S02X' then 
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PALADIN_BLESSOFPROTECTION)
            set bf.lastTime = 60000
            set bf.bonusArmor_P = 1500
            call bf.addDmging_T(function A63P_DMGING_T)
            call bf.apply()
        endif 
    endfunction
    //====================================================
    // endregion
    //====================================================

    

    //====================================================
    // region hero_3
    //====================================================

    function HERO_3_TALENT_DAMAGING_SOURCE_1 takes nothing returns nothing
        if IsUnitEnemy(damageTarget,GetOwningPlayer(damageSource)) and GetUnitLifePercent(damageTarget) < 35 then 
            set damageAddCrit = damageAddCrit+0.15
            set damageAddCritPower = damageAddCritPower+0.3
        endif 
    endfunction

    function HERO_3_TALENT_AFTERDAMAGE_SOURCE_2 takes nothing returns nothing
        local mybuff bf 
        if damageTag_Bleed then 
            set bf = CreateBuff(damageSource,damageSource,BUFFTYPE_BERSERKER_BLOODLUST,400)
            set bf.bonusAttackSpeed = 1500
            set bf.bonusArmorPenetration_P = 2500
            call bf.apply()
        endif 
    endfunction

    globals
        integer H_3_T_6_COUNT = 0
    endglobals
    function HERO_3_TALENT_ATTACKED_SOURCE_6 takes nothing returns nothing
        local mybuff bf 
        set H_3_T_6_COUNT = H_3_T_6_COUNT+1
        if damageFlag == 'Aatk' and H_3_T_6_COUNT >= 6 then 
            set damageFinalDamage = damageFinalDamage*2.2
            set H_3_T_6_COUNT = 0
            
            call HERO_3_SUPPRESS(damageSource,1)

            call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",damageTarget,"origin"))
        endif 
    endfunction

    function HERO_3_TALENT_DAMAGING_SOURCE_7 takes nothing returns nothing
        if damageArmor <= 1 then 
            set damageAddCrit = damageAddCrit+0.1
            set damageAddCritPower = damageAddCritPower+0.2
        endif 
    endfunction
    function HERO_3_TALENT_LEARN_7 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_ARMOR_PENETRATION_P,2000)
    endfunction
    function HERO_3_TALENT_RESET_7 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_ARMOR_PENETRATION_P,-2000)
    endfunction

    function HERO_3_TALENT_PREDAMAGE_SOURCE_9 takes nothing returns nothing
        if damageFlag == 'S03L' or damageFlag == 'S02L' or damageFlag == 'S03I' or (damageFlag == 'S03J' and damageIsAOE == false) then 
            set damageTag_Bleed = true 
        endif 
        if damageTag_Bleed then 
            set damageTag_Ignite = true 
            set damageTag_Fire = true 
        endif 
    endfunction
    function HERO_3_TALENT_DAMAGING_SOURCE_9 takes nothing returns nothing
        local real haste = I2R(unitGetAllBonusStateValue(damageSource,STATE_HASTE))/10000
        if damageTag_Fire then 
            set damageFinalDamage = damageFinalDamage*1.1
            set damageFinalDamage = damageFinalDamage*(1+RMinBJ(0.3,haste*0.25))
        endif 
    endfunction

    function HERO_3_TALENT_DAMAGED_SOURCE_11 takes nothing returns nothing
        local real cc = RMinBJ(0.5,damageCritChance+damageAddCrit)
        local real cp = (damageCritPower+damageAddCritPower)/2
        if damageIfCrit then 
            if random.get(damageSource,cc,damageFlag) then 
                set damageFinalDamage = damageFinalDamage*(1+cp)
            endif 
        endif 
    endfunction

    function A659_PreDmg_S takes nothing returns nothing
        set damageArmor = 0
    endfunction
    function HERO_3_TALENT_SPELLING_12 takes nothing returns nothing
        local mybuff bf
        if castingSpell == 'S03K' then 
            call BlzEndUnitAbilityCooldown(spellCaster,'S02L')
            call BlzEndUnitAbilityCooldown(spellCaster,'S03I')
            call BlzEndUnitAbilityCooldown(spellCaster,'S03J')
            call BlzEndUnitAbilityCooldown(spellCaster,'S02J')
            call unitFlushCooldown(spellCaster,'S02K')
        endif 
        if castingSpell == 'S03M' then 
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_BERSERKER_ARMORPENETRATION,1500)
            call bf.addPreDmg_S(function A659_PreDmg_S)
            call bf.apply()
        endif 
    endfunction
    function HERO_3_TALENT_DAMAGING_SOURCE_12 takes nothing returns nothing
        if damageFlag == 'S03M' then 
            set damageFinalDamage = damageFinalDamage*1.5
        endif 
    endfunction
    function HERO_3_TALENT_AFTERDAMAGE_SOURCE_12 takes nothing returns nothing
        local mybuff bf
        if damageFlag == 'S03L' then
            set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_BERSERKER_RENDER,800)
            set bf.bonusArmor = 0-UnitLevel(damageSource)/2
            set bf.periodTime = 200
            set bf.hasteAble = true 
            set bf.realData = 0.3+bf.realData*bf.remainingTime/bf.lastTime
            call bf.addPeriod(function S02I_DOT)
            call bf.apply()
            if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,3) and unitCheckCooldown(damageSource,'HTLC') then
                call unitStartCooldown(damageSource,'HTLC',2) 
                call HERO_3_SUPPRESS(damageSource,1)
            endif 
        endif 
    endfunction
    function HERO_3_TALENT_DAMAGING_SOURCE_4 takes nothing returns nothing
        if mybuff.getUnitBuff(damageSource,BUFFTYPE_BERSERKER_BERSERK) != 0 then 
            set damageFinalDamage = damageFinalDamage*1.05
        endif   
    endfunction

    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_4
    //====================================================
    function HERO_4_TALENT_SPELLING_2 takes nothing returns nothing    
        local mybuff bf = 0 
        if castingSpell == 'S04X' or castingSpell == 'S04Y' or castingSpell == 'S04Z' or castingSpell == 'S051' or castingSpell == 'S052' then
            call TinkerApplyLockAndLoad(spellCaster,R2I(spellCooldown/15+0.5))
        endif 
    endfunction

    function HERO_4_TALENT_SPELLING_3 takes nothing returns nothing    
        local mybuff bf = 0 
        if castingSpell == 'S04X' then
            call TINKER_LOAD_RUNESHELL(spellCaster,BUFFTYPE_TINKER_LOADRUNESHELL_LIGHTNING,2)
        endif 
    endfunction
    function HERO_4_TALENT_AFTERDAMAGE_SOURCE_3 takes nothing returns nothing    
        if damageIfCrit and damageTag_Attack then 
            if GetUnitAbilityLevel(damageSource,'S04Y') > 0 and BlzGetUnitAbilityCooldownRemaining(damageSource,'S04Y') > 5 then 
                call BlzStartUnitAbilityCooldown(damageSource,'S04Y',RMaxBJ(BlzGetUnitAbilityCooldownRemaining(damageSource,'S04Y')-1,5))
            endif 
        endif 
    endfunction

    function HERO_4_TALENT_SPELLING_4 takes nothing returns nothing    
        local mybuff bf = 0 
        if castingSpell == 'S04Z' then
            call TINKER_LOAD_RUNESHELL(spellCaster,BUFFTYPE_TINKER_LOADRUNESHELL_FIRE,2)
        endif 
    endfunction
    function HERO_4_TALENT_AFTERDAMAGE_SOURCE_4 takes nothing returns nothing    
        if GetUnitAbilityLevel(damageSource,'S050') > 0 and damageIfCrit and damageTag_Attack then 
            if GetUnitAbilityLevel(damageSource,'S04W') > 0 and BlzGetUnitAbilityCooldownRemaining(damageSource,'S04W') > 0.01 then 
                call BlzStartUnitAbilityCooldown(damageSource,'S04W',RMaxBJ(BlzGetUnitAbilityCooldownRemaining(damageSource,'S04W')-1,0.01))
            endif 
        endif 
    endfunction

    globals
        real HERO_4_TALENT_5_CHANCE = 0
        real HERO_4_TALENT_6_CHANCE = 0
    endglobals
    function HERO_4_TALENT_MISSILE_LAUNCH_5 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        if proj.flag == 'S04W' and random.get(proj.source,HERO_4_TALENT_5_CHANCE,'HTL5') then 
            set HERO_4_TALENT_5_CHANCE = 0
            call TINKER_LOAD_RUNESHELL(proj.source,BUFFTYPE_TINKER_LOADRUNESHELL_NUKE,1)
        else 
            set HERO_4_TALENT_5_CHANCE = RMinBJ(0.3,HERO_4_TALENT_5_CHANCE+0.05)
        endif 
    endfunction

    function HERO_4_TALENT_DAMAGING_SOURCE_6 takes nothing returns nothing
        if unitCheckCooldown(damageSource,'HTL6') == false or damageTag_Attack == false or damageSource != damageMaster then 
            return 
        endif 
        if damageArmor <= 1 then 
            if random.get(damageSource,HERO_4_TALENT_6_CHANCE,'HTL6') then 
                set HERO_4_TALENT_6_CHANCE = 0
                if GetRandomReal(0,1) < 0.01 then 
                    call TINKER_LOAD_RUNESHELL(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_NUKE,1)
                else 
                    if GetRandomReal(0,1) < 0.2 then 
                        call TINKER_LOAD_RUNESHELL(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_FIRE,1)
                    elseif GetRandomReal(0,1) < 0.25 then 
                        call TINKER_LOAD_RUNESHELL(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_COLD,1)
                    elseif GetRandomReal(0,1) < 0.33 then 
                        call TINKER_LOAD_RUNESHELL(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_ACID,1)
                    elseif GetRandomReal(0,1) < 0.5 then 
                        call TINKER_LOAD_RUNESHELL(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_DARK,1)
                    else 
                        call TINKER_LOAD_RUNESHELL(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_LIGHTNING,1)
                    endif 
                endif 
                call unitStartCooldown(damageSource,'HTL6',50)
            else 
                set HERO_4_TALENT_6_CHANCE = RMinBJ(0.15,HERO_4_TALENT_6_CHANCE+0.05)
            endif 
        endif 
    endfunction
    function HERO_4_TALENT_LEARN_6 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_ARMOR_PENETRATION_P,2000)
    endfunction
    function HERO_4_TALENT_RESET_6 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_ARMOR_PENETRATION_P,-2000)
    endfunction

    function TINKER_SUMMON_WINGMAN takes unit whichUnit returns minion
        local minion mini = minion.create(whichUnit,'nS0T',GetUnitX(whichUnit)+150*Cos(GetUnitFacing(whichUnit)/57.2956),GetUnitY(whichUnit)+150*Sin(GetUnitFacing(whichUnit)/57.2956))
        call unitCheckState.evaluate(mini.summon)
        set TINKER_WINGMAN = mini.summon
        return mini
    endfunction
    function CHECK_STATE_nS0T takes nothing returns nothing
        local master owner = minion.getMinionByUnit(checkingUnit).mast
        call BlzSetUnitBaseDamage(checkingUnit,2*GetUnitLevel(owner.masterUnit)/7+1+R2I(I2R(GetUnitMaxAttack(owner.masterUnit,0))*0.15),0)
    endfunction
    globals 
        unit TINKER_WINGMAN = null
        delayedevent TINKER_WINGMAN_RESUMMON = 0
    endglobals
    function HERO_4_TALENT_LEARN_7 takes nothing returns nothing
        local minion mini
        if TINKER_WINGMAN == null or alive(TINKER_WINGMAN) == false then 
            set mini = TINKER_SUMMON_WINGMAN(currentTTOwner)
        endif 
    endfunction
    function HERO_4_TALENT_RESET_7 takes nothing returns nothing
        call KillUnit(TINKER_WINGMAN)
        set TINKER_WINGMAN = null 
    endfunction
    function HERO_4_TALENT_SPELLING_7 takes nothing returns nothing    
        local integer i = R2I(spellCooldown/15+0.5)
        local mybuff bf = 0 
        if castingSpell == 'S04X' or castingSpell == 'S04Y' or castingSpell == 'S04Z' then
            if alive(TINKER_WINGMAN) and TINKER_WINGMAN != null then 
                loop
                    exitwhen i <= 0 
                    if GetRandomReal(0,1) < 0.33 then 
                        call TINKER_LOAD_RUNESHELL(TINKER_WINGMAN,BUFFTYPE_TINKER_LOADRUNESHELL_COLD,1)
                    elseif GetRandomReal(0,1) < 0.5 then 
                        call TINKER_LOAD_RUNESHELL(TINKER_WINGMAN,BUFFTYPE_TINKER_LOADRUNESHELL_ACID,1)
                    else 
                        call TINKER_LOAD_RUNESHELL(TINKER_WINGMAN,BUFFTYPE_TINKER_LOADRUNESHELL_DARK,1)
                    endif 
                    set i = i-1
                endloop
            endif 
        endif 
    endfunction

    globals
        integer HERO_4_LAST_CASTING_ABILITY = 0
    endglobals
    function HERO_4_TALENT_SPELLING_8 takes nothing returns nothing
        local integer i = 0
        if castingSpell == 'S04X' or castingSpell == 'S04Y' or castingSpell == 'S04Z' then
            set HERO_4_LAST_CASTING_ABILITY = castingSpell
        endif 
        if castingSpell == 'S051' then
            if HERO_4_LAST_CASTING_ABILITY != 0 then 
                if GetUnitAbilityLevel(spellCaster,HERO_4_LAST_CASTING_ABILITY) > 0 then 
                    if BlzGetUnitAbilityCooldownRemaining(spellCaster,HERO_4_LAST_CASTING_ABILITY) > 0.01 then
                        call BlzStartUnitAbilityCooldown(spellCaster,HERO_4_LAST_CASTING_ABILITY,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,HERO_4_LAST_CASTING_ABILITY)-15))
                    endif 
                endif 
            endif 
        endif 
        if castingSpell == 'S052' then
            loop
                exitwhen i > 1
                if random.get(spellCaster,0.05,'HTL8') then 
                    call TINKER_LOAD_RUNESHELL(spellCaster,BUFFTYPE_TINKER_LOADRUNESHELL_NUKE,1)
                else 
                    if GetRandomReal(0,1) < 0.2 then 
                        call TINKER_LOAD_RUNESHELL(spellCaster,BUFFTYPE_TINKER_LOADRUNESHELL_FIRE,1)
                    elseif GetRandomReal(0,1) < 0.25 then 
                        call TINKER_LOAD_RUNESHELL(spellCaster,BUFFTYPE_TINKER_LOADRUNESHELL_COLD,1)
                    elseif GetRandomReal(0,1) < 0.33 then 
                        call TINKER_LOAD_RUNESHELL(spellCaster,BUFFTYPE_TINKER_LOADRUNESHELL_ACID,1)
                    elseif GetRandomReal(0,1) < 0.5 then 
                        call TINKER_LOAD_RUNESHELL(spellCaster,BUFFTYPE_TINKER_LOADRUNESHELL_DARK,1)
                    else 
                        call TINKER_LOAD_RUNESHELL(spellCaster,BUFFTYPE_TINKER_LOADRUNESHELL_LIGHTNING,1)
                    endif 
                endif 
                set i = i+1
            endloop
        endif 
    endfunction

    globals 
        integer HERO_4_TALENT_9_POS = 0
        group HERO_4_TALENT_9_MIRRORIMAGES = CreateGroup()
    endglobals
    function CHECK_STATE_nS0U takes nothing returns nothing
        local master owner = minion.getMinionByUnit(checkingUnit).mast
        call BlzSetUnitBaseDamage(checkingUnit,R2I(I2R(GetUnitMaxAttack(owner.masterUnit,0))*0.33),0)
    endfunction
    function HERO_4_TALENT_9_SUMMON takes unit owner returns nothing
        local minion mini 
        local integer mini_ID = 'nS0U'
        local real x 
        local real y 
        if HERO_4_TALENT_9_POS < 3 then 
            set y = 75
        elseif HERO_4_TALENT_9_POS < 6 then 
            set y = 0
        else 
            set y = -75
        endif 
        if ModuloInteger(HERO_4_TALENT_9_POS,3) == 0 then
            set x = -75
        elseif ModuloInteger(HERO_4_TALENT_9_POS,3) == 1 then
            set x = 0
        else
            set x = 75
        endif 
        set mini = minion.create(owner,mini_ID,GetUnitX(owner)+x,GetUnitY(owner)+y)
        set mini.remove = true 
        set mini.deathSFX = "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl"
        call UnitApplyTimedLife(mini.summon,'BTLF',8)
        call unitCheckState.evaluate(mini.summon)
        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl",owner,"origin"))
        call SetUnitVertexColor(mini.summon,0,0,255,125)
        call GroupAddUnit(HERO_4_TALENT_9_MIRRORIMAGES,mini.summon)
        set HERO_4_TALENT_9_POS = ModuloInteger(HERO_4_TALENT_9_POS+1,9)
        if HERO_4_TALENT_9_POS == 4 then 
            set HERO_4_TALENT_9_POS = 5
        endif 
    endfunction
    function HERO_4_TALENT_ATTACKING_9 takes nothing returns nothing
        local minion mini 
        local integer mini_ID = 'nS0U'
        local real x 
        local real y 
        if random.get(damageSource,0.15,'HTL9') then 
            call HERO_4_TALENT_9_SUMMON(damageSource)
        endif 
    endfunction
    function HERO_4_TALENT_SPELLING_9 takes nothing returns nothing    
        local integer i = 0
        local integer imax = 0
        local group pick = null 
        if castingSpell == 'S04X' or castingSpell == 'S04Y' or castingSpell == 'S04Z' or castingSpell == 'S051' or castingSpell == 'S052' then
            call HERO_4_TALENT_9_SUMMON(spellCaster)
            set imax = R2I(spellCooldown/15+0.5)
            set pick = CreateGroup()
            call GroupAddGroup(HERO_4_TALENT_9_MIRRORIMAGES,pick)
            loop
                exitwhen FirstOfGroup(pick) == null 
                if alive(FirstOfGroup(pick)) then 
                    set i = 0
                    loop
                        exitwhen i > 1
                        if random.get(FirstOfGroup(pick),0.05,'HTL9') then
                            call TINKER_LOAD_RUNESHELL(FirstOfGroup(pick),BUFFTYPE_TINKER_LOADRUNESHELL_NUKE,1)
                        else 
                            if GetRandomReal(0,1) < 0.33 then 
                                call TINKER_LOAD_RUNESHELL(FirstOfGroup(pick),BUFFTYPE_TINKER_LOADRUNESHELL_COLD,1)
                            elseif GetRandomReal(0,1) < 0.5 then 
                                call TINKER_LOAD_RUNESHELL(FirstOfGroup(pick),BUFFTYPE_TINKER_LOADRUNESHELL_ACID,1)
                            else
                                call TINKER_LOAD_RUNESHELL(FirstOfGroup(pick),BUFFTYPE_TINKER_LOADRUNESHELL_DARK,1)
                            endif 
                        endif 
                        set i = i+1
                    endloop
                else 
                    call GroupRemoveUnit(HERO_4_TALENT_9_MIRRORIMAGES,FirstOfGroup(pick))
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endif 
    endfunction

    function HERO_4_TALENT_CHECK_STATE_10 takes nothing returns nothing
        local integer BONUS_ATTACK_SPEED = GetHeroData(checkingUnit,"TINKER_TALENT_10_BONUS_ATTACK_SPEED")
        local integer BONUS_ATTACK = GetHeroData(checkingUnit,"TINKER_TALENT_10_BONUS_ATTACK")
        local integer OTHER_ATTACK_SPEED = ST_ATTACK_SPEED.getTotalState(checkingUnit)-BONUS_ATTACK_SPEED
        local boolean needCheck = false 

        if BONUS_ATTACK_SPEED != 0-OTHER_ATTACK_SPEED then 
            call ST_ATTACK_SPEED.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_ATTACK_SPEED)
            set BONUS_ATTACK_SPEED = 0-OTHER_ATTACK_SPEED
            call ST_ATTACK_SPEED.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,BONUS_ATTACK_SPEED)
            call SetHeroData(checkingUnit,"TINKER_TALENT_10_BONUS_ATTACK_SPEED",BONUS_ATTACK_SPEED)
            set needCheck = true 
        endif 
        if BONUS_ATTACK != OTHER_ATTACK_SPEED then
            call ST_ATTACK.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_ATTACK)
            set BONUS_ATTACK = OTHER_ATTACK_SPEED
            call ST_ATTACK.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,BONUS_ATTACK)
            call SetHeroData(checkingUnit,"TINKER_TALENT_10_BONUS_ATTACK",BONUS_ATTACK)
            set needCheck = true 
        endif 
        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(checkingUnit)
            set doNotCheck = false
        endif 
    endfunction
    function HERO_4_TALENT_RESET_10 takes nothing returns nothing
        local integer BONUS_ATTACK_SPEED = GetHeroData(currentTTOwner,"TINKER_TALENT_10_BONUS_ATTACK_SPEED")
        local integer BONUS_ATTACK = GetHeroData(currentTTOwner,"TINKER_TALENT_10_BONUS_ATTACK")

        local integer OTHER_ATTACK_SPEED = ST_ATTACK_SPEED.getTotalState(currentTTOwner)-BONUS_ATTACK_SPEED

        local delayedevent de = 0

        local boolean needCheck = false 

        if BONUS_ATTACK_SPEED != 0 then 
            call ST_ATTACK_SPEED.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_ATTACK_SPEED)
            set BONUS_ATTACK_SPEED = 0
            call SetHeroData(currentTTOwner,"TINKER_TALENT_10_BONUS_ATTACK_SPEED",BONUS_ATTACK_SPEED)
            set needCheck = true 
        endif 
        if BONUS_ATTACK != 0 then 
            call ST_ATTACK.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_ATTACK)
            set BONUS_ATTACK = 0
            call SetHeroData(currentTTOwner,"TINKER_TALENT_10_BONUS_ATTACK",BONUS_ATTACK)
            set needCheck = true 
        endif 
        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(currentTTOwner)
            set doNotCheck = false
        endif 
    endfunction

    globals
        integer HERO_4_TALENT_12_COUNT = 0
    endglobals
    function HERO_4_TALENT_RESET_12 takes nothing returns nothing
        set runeShellCooldownCount = 0
        set HERO_4_TALENT_12_COUNT = 0
    endfunction
    function HERO_4_TALENT_SPELLING_12 takes nothing returns nothing
        local mybuff bf = 0
        local integer i = 0
        if castingSpell == 'S04W' or castingSpell == 'S04X' or castingSpell == 'S04Y' or castingSpell == 'S04Z' or castingSpell == 'S051' or castingSpell == 'S052' then
            set i = R2I(spellCooldown+0.5)
            set HERO_4_TALENT_12_COUNT = HERO_4_TALENT_12_COUNT+i 
            if HERO_4_TALENT_12_COUNT >= 60 then 
                set HERO_4_TALENT_12_COUNT = HERO_4_TALENT_12_COUNT-60
                set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_TINKER_FULLSALVO,1000)
                call bf.addAtking(function S052_ATTACKING)
                set bf.intData = bf.intData+1
                call bf.apply()
            endif 
        endif 
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_5
    //====================================================
    function HERO_5_TALENT_ATTACKING_1 takes nothing returns nothing
        local integer heroId = GetHeroIndex(damageSource)-1
        local projectile proj
        if random.get(damageSource,0.25,'HTL1') then 
            set proj = CreateProjectileToUnit(damageSource,damageTarget,heroNowForm[heroId].attackMissileSpeed,heroNowForm[heroId].attackMissileArc,heroNowForm[heroId].attackMissilePath,function AttackMissileHit,null)
            set proj.flag = 'Aatk'
            call delayedLaunchMissile(proj,25)
        endif 
    endfunction
    function HERO_5_TALENT_2_MSL_LNCH takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local projectile proj = projectile.currentProjectile
        if proj.flag == 'S015' or proj.flag == 'Aatk' or proj.flag == 'S017' then 
            if proj.currentBounceCount == 0 and proj.TARGET_UNIT then 
                set proj.maxBounceLimit = proj.maxBounceLimit+bf.intData
                set proj.bounceMultiplier = RMinBJ(proj.bounceMultiplier,1)
                set proj.bounceRange = RMaxBJ(proj.bounceRange,350)
            endif 
        endif 
    endfunction
    function HERO_5_TALENT_SPELLING_2 takes nothing returns nothing
        local mybuff bf
        if castingSpell == 'S016' or castingSpell == 'S01C' or castingSpell == 'S02M' or castingSpell == 'S05X' or castingSpell == 'S018' or castingSpell == 'S01A' or castingSpell == 'S02P' or castingSpell == 'S01D' or castingSpell == 'S02N' then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_RANGER_TECHSHOT)
            set bf.intData = IMinBJ(3,bf.intData+1*R2I(spellCooldown/15+0.5))
            set bf.bonusAttackSpeed = 1000*bf.intData
            set bf.bonusArmorPenetration_P = 1000*bf.intData
            set bf.lastTime = 600
            set bf.addTime = false 
            call bf.addMslLnch(function HERO_5_TALENT_2_MSL_LNCH)
            call bf.apply()
        endif 
    endfunction
    function HERO_5_TALENT_DAMAGING_SOURCE_4 takes nothing returns nothing
        if GetUnitAbilityLevel(damageMaster,'S02P') == 0 then 
            set damageFinalDamage = damageFinalDamage*1.06
        endif 
        if GetUnitAbilityLevel(damageMaster,'S01C') == 0 then 
            set damageFinalDamage = damageFinalDamage*1.06
        endif 
    endfunction
    function A63M_END takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = I2R(GetUnitAttack(bf.buffSource,0))*2*bf.realData*(1+0.2*I2R(bf.intData))
        set damageTag_Bleed = true 
        set damageFlag = 'A63M'
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_5_TALENT_AFTERDAMAGE_SOURCE_4 takes nothing returns nothing
        local mybuff bf
        if damageFlag == 'S01C' or damageFlag == 'S02P' then 
            set bf = mybuff.create(damageMaster,damageTarget,BUFFTYPE_RANGER_WOUND)
            set bf.addTime = false 
            set bf.realData = bf.realData+1
            set bf.lastTime = 500
            call bf.addEnding(function A63M_END)
            call bf.apply()
        endif 
    endfunction
    function HERO_5_TALENT_ATTACKED_SOURCE_4 takes nothing returns nothing
        local mybuff bf
        if damageSource == damageMaster then 
            set bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_RANGER_WOUND)
            if bf > 0 then 
                set bf.intData = IMinBJ(10,bf.intData+1)
            endif 
        endif 
    endfunction
    function TRUESHOT_PREDAMAGE_SOURCE takes nothing returns nothing
        set damageArmor = damageArmor*0.9
        set damageResistance = damageResistance*0.9
    endfunction
    function TRUESHOT_AURA_STATE_SET takes nothing returns nothing
        local mybuff bf = aura.modifingAuraBuff
        set bf.bonusCrit = 500
        call bf.addPreDmg_S(function TRUESHOT_PREDAMAGE_SOURCE)
    endfunction
    function HERO_5_TALENT_LEARN_5 takes nothing returns nothing
        local aura ar = aura.create(currentTTOwner,"AURA_RANGER_TRUESHOT",900,0,BUFFTYPE_RANGER_TRUESHOT,"Abilities\\Spells\\NightElf\\TrueshotAura\\TrueshotAura.mdl")
        call ar.addAllySet(function TRUESHOT_AURA_STATE_SET)
    endfunction
    function HERO_5_TALENT_RESET_5 takes nothing returns nothing
        set aura.getAura(currentTTOwner,"AURA_RANGER_TRUESHOT").DESTROY = true 
    endfunction
    function HERO_5_TALENT_DAMAGING_SOURCE_6 takes nothing returns nothing
        if damageFlag == 'S018' or damageFlag == 'S02P' then 
            set damageFinalDamage = damageFinalDamage*1.5
        endif 
        if damageFlag == 'nS0E' or damageFlag == 'S01A' then 
            set damageFinalDamage = damageFinalDamage*1.3
        endif 
    endfunction
    function HERO_5_TALENT_AFTERDAMAGE_SOURCE_6 takes nothing returns nothing
        if damageFlag == 'S018' then 
            call applySilence(damageSource,damageTarget,'ASI0')
        elseif damageFlag == 'S02P' then 
            call applyStun(damageSource,damageTarget,'ATB0')
        endif 
    endfunction
    function HERO_5_TALENT_SPELLING_6 takes nothing returns nothing
        local group pick = null 
        if castingSpell == 'S01A' then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,250,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                call applySnare(spellCaster,FirstOfGroup(pick),'ASN2')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endif 
    endfunction
    function HERO_5_TALENT_ATTACKED_SOURCE_7 takes nothing returns nothing
        if GetUnitState(damageSource,UNIT_STATE_MANA) < 0.6*GetUnitState(damageSource,UNIT_STATE_MAX_MANA) then 
            call AddUnitMana(damageSource,0.01*GetUnitState(damageSource,UNIT_STATE_MAX_MANA))
        endif 
        if GetUnitState(damageSource,UNIT_STATE_MANA) > 0.4*GetUnitState(damageSource,UNIT_STATE_MAX_MANA) then 
            set damageDamage = damageDamage*1.1
        endif 
    endfunction
    function HERO_5_TALENT_MISSILE_LAUNCH_9 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        if proj.flag == 'Aatk' or proj.flag == 'S017' or proj.flag == 'S019' then 
            if proj.bindSFX_5 != null then 
                call DestroyEffectEX(proj.bindSFX_5)
            endif 
            set proj.bindSFX_5 = AddSpecialEffectTargetEX("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",proj.dummy,"chest")
            set proj.tag_Shadow = true 
            set proj.bonusArmorPenetration = 100000
            if GetUnitState(proj.target,UNIT_STATE_LIFE) > 0.8*GetUnitState(proj.target,UNIT_STATE_MAX_LIFE) or GetUnitState(proj.target,UNIT_STATE_LIFE) < 0.2*GetUnitState(proj.target,UNIT_STATE_MAX_LIFE) then
                set proj.bonusCrit = proj.bonusCrit+0.15
                set proj.bonusCritPower = proj.bonusCritPower+0.3
            endif
        endif  
    endfunction
    function HERO_5_TALENT_ATTACKING_10 takes nothing returns nothing
        local real rate = RMinBJ((GetUnitLostLife(damageTarget)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))/0.7,1)
        local mybuff bf = mybuff.create(damageSource,damageSource,BUFFTYPE_RANGER_BLOODSEEKER)
        set bf.lastTime = 300
        set bf.bonusHaste = IMaxBJ(bf.bonusHaste,1500+R2I(3000*rate))
        call bf.apply()
    endfunction
    function HERO_5_TALENT_MISSILE_LAUNCH_11 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        if proj.currentBounceCount == 0 and proj.TARGET_UNIT then 
            set proj.maxBounceLimit = proj.maxBounceLimit+1
            set proj.bounceMultiplier = RMinBJ(proj.bounceMultiplier,0.5)
            set proj.bounceRange = RMaxBJ(proj.bounceRange,350)
        endif 
    endfunction
    function HERO_5_TALENT_MISSILE_HIT_SOURCE_11 takes nothing returns nothing
        local projectile nowP = projectile.currentProjectile
        set nowP.bonusDamage = nowP.bonusDamage*(1+0.1*I2R(IMinBJ(5,nowP.maxBounceLimit-nowP.currentBounceCount)))
    endfunction
    //====================================================
    // endregion
    //====================================================

    
    //====================================================
    // region hero_6
    //====================================================
    globals
        unit heroAssassin = null 
        trigger trigAssassinBlink = CreateTrigger()
        timer heroAssassin_Talent9_Timer = CreateTimer()
        boolean heroAssassin_Talent10_Able = true 
    endglobals

    function A65K_DOT takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = I2R(bf.intData*GetUnitAttack(bf.buffSource,0))*1.5/5*mybuff.buffTimeScale
        set damageTag_Shadow = true 
        set damageTag_Posion = true 
        set damageIsDOT = true 
        set damageFlag = 'A65K'
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function A65J_MISSILE_HIT takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        local mybuff bf 
        local real dmg = I2R(GetUnitAttack(proj.source,0))*1.5
        set damageTag_Shadow = true 
        set damageFlag = 'A65J'
        call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)

        set bf = CreateBuff(proj.source,proj.target,BUFFTYPE_ASSASSIN_TOXINKNIFE,1000)
        set bf.addTime = false 
        set bf.hasteAble = true 
        set bf.periodTime = 200
        set bf.intData = IMinBJ(3,bf.intData+1)
        call bf.addPeriod(function A65K_DOT)
        call bf.apply()

        call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\shadowstrike\\shadowstrike.mdl",proj.target,"overhead"),100)
    endfunction
    function A65J_ENDING takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local unit ds = bf.buffSource
        local unit dt = null 
        local projectile proj 
        local group pick = null 
        if bf.intData > 0 then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(ds),GetUnitY(ds),600,playerEnemy)
            set dt = GetClosestUnit(ds,pick)
            call DestroyGroup(pick)
            set pick = null 
            if dt != null then 
                set proj = CreateProjectileToUnit(ds,dt,1200,0,"Abilities\\Spells\\NightElf\\shadowstrike\\ShadowStrikeMissile.mdl",function A65J_MISSILE_HIT,null)
                set proj.flag = 'A65J'
                set proj.tag_Shadow = true 
                call proj.launch()
                if bf.intData > 1 then 
                    loop
                        exitwhen bf.intData <= 1 
                        set bf.intData = bf.intData-1
                        set proj = CreateProjectileToUnit(ds,dt,1200,0,"Abilities\\Spells\\NightElf\\shadowstrike\\ShadowStrikeMissile.mdl",function A65J_MISSILE_HIT,null)
                        set proj.flag = 'A65J'
                        set proj.tag_Shadow = true 
                        call delayedLaunchMissile(proj,25*bf.intData)
                    endloop
                endif 
            endif 
        endif 
        set ds = null 
        set dt = null 
    endfunction
    function HERO_6_BLINK takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(GetTriggerUnit(),BUFFTYPE_ASSASSIN_PHANTOMSTRIKE)
        local real maxD = 450
        local real x = GetOrderPointX()
        local real y = GetOrderPointY() 
        local real a = AngleByUnXY(GetTriggerUnit(),x,y)/57.2956
        local real d 
        local unit ds = bf.buffSource
        local unit dt = null 
        local projectile proj 
        local group pick = null 
        if bf > 0 and bf.DESTROY == false then 
            if GetIssuedOrderId() == ORDER_AImove or GetIssuedOrderId() == ORDER_smart or GetIssuedOrderId() == ORDER_move then 
                if bf.intData > 0 then 
                    call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())))
                    set maxD = RMinBJ(DisByUnXY(ds,x,y),maxD)
                    loop
                        exitwhen maxD <= 0.5
                        set d = RMinBJ(maxD,RMinBJ(16,DisByUnXY(GetTriggerUnit(),x,y)))
                        if PathCheck(GetUnitX(GetTriggerUnit())+d*Cos(a),GetUnitY(GetTriggerUnit())+d*Sin(a)) then 
                            call SetUnitX(GetTriggerUnit(),GetUnitX(GetTriggerUnit())+d*Cos(a))
                            call SetUnitY(GetTriggerUnit(),GetUnitY(GetTriggerUnit())+d*Sin(a))
                            set maxD = maxD-d
                        else 
                            set maxD = -1
                        endif 
                    endloop
                    call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())))
                    
                    set pick = CreateGroup()
                    call GroupEnumUnitsInRangeEx(pick,GetUnitX(ds),GetUnitY(ds),600,playerEnemy)
                    set dt = GetClosestUnit(ds,pick)
                    call DestroyGroup(pick)
                    set pick = null 
                    if dt != null then 
                        set proj = CreateProjectileToUnit(ds,dt,1200,0,"Abilities\\Spells\\NightElf\\shadowstrike\\ShadowStrikeMissile.mdl",function A65J_MISSILE_HIT,null)
                        set proj.flag = 'A65J'
                        set proj.tag_Shadow = true 
                        call proj.launch()
                    endif 
                    set bf.intData = bf.intData-1

                    if bf.intData <= 0 then 
                        set bf.DESTROY = true 
                    endif 
                else 
                    set bf.DESTROY = true 
                endif 
            endif 
        endif 
        set ds = null 
        set dt = null 
    endfunction

    function HERO_6_TALENT_DAMAGING_SOURCE_1 takes nothing returns nothing
        if isBackStab(damageSource,damageTarget,60) and damageIsDOT == false then 
            set damageFinalDamage = damageFinalDamage*1.12
        endif 
    endfunction
    function A65I_DMGING_S takes nothing returns nothing
        if damageFlag == 'S03S' or damageFlag == 'S03R' then 
            set mybuff.currentBuff.DESTROY = true 
            set damageFinalDamage = damageFinalDamage*(1+0.07*I2R(mybuff.currentBuff.intData))
        endif 
    endfunction
    function HERO_6_TALENT_SPELLING_2 takes nothing returns nothing
        local mybuff bf 
        if castingSpell == 'S03G' or castingSpell == 'S03N' or castingSpell == 'S03O' or castingSpell == 'S03P' or castingSpell == 'S03Q' then 
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_ASSASSIN_COMBO,1000)
            set bf.addTime = false 
            set bf.intData = IMinBJ(5,bf.intData+1)
            set bf.bonusAttack_P = 300*bf.intData
            call bf.addDmging_S(function A65I_DMGING_S)
            call bf.apply()
        endif 
    endfunction

    function HERO_6_ADD_PHANTOM_STRIKE takes unit whichUnit returns nothing
        local unit ds = whichUnit
        local unit dt = null 
        local projectile proj 
        local group pick = null
        local mybuff bf  = CreateBuff(ds,ds,BUFFTYPE_ASSASSIN_PHANTOMSTRIKE,1500)
        set bf.addTime = false 
        if bf.intData == 3 then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(ds),GetUnitY(ds),600,playerEnemy)
            set dt = GetClosestUnit(ds,pick)
            call DestroyGroup(pick)
            set pick = null 
            if dt != null then 
                set proj = CreateProjectileToUnit(ds,dt,1200,0,"Abilities\\Spells\\NightElf\\shadowstrike\\ShadowStrikeMissile.mdl",function A65J_MISSILE_HIT,null)
                set proj.flag = 'A65J'
                set proj.tag_Shadow = true 
                call proj.launch()
            endif 
        endif 
        set bf.intData = IMaxBJ(1,IMinBJ(3,bf.intData+1))
        call bf.addEnding(function A65J_ENDING)
        call bf.apply()

        set ds = null 
        set dt = null 
    endfunction
    function HERO_6_TALENT_SPELLING_3 takes nothing returns nothing
        if castingSpell == 'S03P' or castingSpell == 'S03Q' then 
            call HERO_6_ADD_PHANTOM_STRIKE(spellCaster)
        endif 
    endfunction
    function HERO_6_TALENT_LEARN_3 takes nothing returns nothing
        if heroAssassin == null then 
            set heroAssassin = currentTTOwner
            call TriggerRegisterUnitEvent(trigAssassinBlink,heroAssassin,EVENT_UNIT_ISSUED_POINT_ORDER)
            call TriggerAddAction(trigAssassinBlink,function HERO_6_BLINK)
        endif 
    endfunction
    function HERO_6_TALENT_LEARN_8 takes nothing returns nothing
        if heroAssassin == null then 
            set heroAssassin = currentTTOwner
            call TriggerRegisterUnitEvent(trigAssassinBlink,heroAssassin,EVENT_UNIT_ISSUED_POINT_ORDER)
            call TriggerAddAction(trigAssassinBlink,function HERO_6_BLINK)
        endif 
    endfunction

    function HERO_6_TALENT_PREDAMAGE_SOURCE_4 takes nothing returns nothing
        if damageFlag == 'S03G' then 
            if GetUnitState(spellCaster,UNIT_STATE_MANA) >= I2R(BlzGetUnitAbilityManaCost(spellCaster,'S03G',0))*0.5 then 
                call AddUnitMana(spellCaster,0-I2R(BlzGetUnitAbilityManaCost(spellCaster,'S03G',0))*0.5)
                set damageFinalDamage = damageFinalDamage*1.5
            endif 
        endif 
    endfunction

    function A65L_DOT takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = I2R(bf.intData*GetUnitAttack(bf.buffSource,0))*0.5/4*mybuff.buffTimeScale
        set damageTag_Earth = true 
        set damageTag_Posion = true 
        set damageIsDOT = true 
        set damageFlag = 'A65L'
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_6_TALENT_ATTACKED_SOURCE_5 takes nothing returns nothing
        local mybuff bf
        if random.get(damageSource,0.2,'HTL5') then 
            set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_ASSASSIN_POISONDAGGER,1200)
            set bf.hasteAble = true 
            set bf.intData = IMinBJ(10,bf.intData+1)
            set bf.periodTime = 300
            call bf.addPeriod(function A65L_DOT)
            call bf.apply()
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\OrbVenom\\OrbVenomMissile.mdl",damageTarget,"chest"))
        endif 
    endfunction

    function HERO_6_TALENT_DAMAGING_SOURCE_6 takes nothing returns nothing
        if haveCold(damageTarget) or unitGetAllBonusStateValue(damageTarget,STATE_ATTACK_SPEED) < 0 or unitGetAllBonusStateValue(damageTarget,STATE_MOVE_SPEED_P) < 0 or unitGetAllBonusStateValue(damageTarget,STATE_MOVE_SPEED) < 0 then 
            set damageFinalDamage = damageFinalDamage*1.1
        endif 
    endfunction

    function heroAssassin_Talent9_Timer_TimeOut takes nothing returns nothing
        if alive(heroAssassin) and heroAssassin != null then 
            call HERO_6_ADD_PHANTOM_STRIKE(heroAssassin)
        endif 
    endfunction
    function HERO_6_TALENT_LEARN_9 takes nothing returns nothing
        call TimerStart(heroAssassin_Talent9_Timer,20,true,function heroAssassin_Talent9_Timer_TimeOut)
        if heroAssassin == null then 
            set heroAssassin = currentTTOwner
            call TriggerRegisterUnitEvent(trigAssassinBlink,heroAssassin,EVENT_UNIT_ISSUED_POINT_ORDER)
            call TriggerAddAction(trigAssassinBlink,function HERO_6_BLINK)
        endif 
    endfunction
    function HERO_6_TALENT_RESET_9 takes nothing returns nothing
        call PauseTimer(heroAssassin_Talent9_Timer)
    endfunction
    function HERO_6_TALENT_SPELLING_9 takes nothing returns nothing
        if castingSpell == 'S03T' or castingSpell == 'S03U' or castingSpell == 'S03V' then 
            call HERO_6_ADD_PHANTOM_STRIKE(spellCaster)
        endif 
    endfunction

    function HERO_6_TALENT_SPELLING_10_DELAY takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        call BlzEndUnitAbilityCooldown(de.loadUnit("CASTER"),de.loadInteger("SPELL"))
    endfunction
    function HERO_6_TALENT_SPELLING_10 takes nothing returns nothing
        local delayedevent de 
        if (castingSpell == 'S03N' or castingSpell == 'S03O' or castingSpell == 'S03P' or castingSpell == 'S03Q' or castingSpell == 'S03R' or castingSpell == 'S03S') then
            if heroAssassin_Talent10_Able then 
                if BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03N') == 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03O') == 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03P') == 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03Q') == 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03R') == 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03S') == 0 then
                    set de = delayedevent.create(1,1,function HERO_6_TALENT_SPELLING_10_DELAY)
                    call de.saveInteger("SPELL",castingSpell)
                    call de.saveUnit("CASTER",spellCaster)
                    set heroAssassin_Talent10_Able = false 
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl",spellCaster,"origin"))
                endif 
            else 
                set heroAssassin_Talent10_Able = true 
            endif 
        endif 
    endfunction

    function HERO_6_TALENT_DAMAGING_SOURCE_12 takes nothing returns nothing
        if damageTag_Bleed then 
            set damageFinalDamage = damageFinalDamage*1.1
        endif 
    endfunction
    function A65M_DOT takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*7.5/6*mybuff.buffTimeScale
        set damageIsDOT = true 
        set damageTag_Bleed = true 
        set damageFlag = 'A65M'
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_6_TALENT_AFTERDAMAGE_SOURCE_12 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_ASSASSIN_BLEED)
        if damageIsDOT == false and (bf == 0 or bf.boolData) then 
            set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_ASSASSIN_BLEED,1000)
            set bf.boolData = true 
            set bf.realData = bf.realData+damageFinalDamage
            if bf.realData >= I2R(GetUnitMaxAttack(damageSource,0))*20 then 
                set bf.realData = bf.realData-I2R(GetUnitMaxAttack(damageSource,0))*20
                set bf.hasteAble = true 
                set bf.boolData = false 
                set bf.lastTime = 500
                set bf.remainingTime = 500
                set bf.periodTime = 100
                call bf.addPeriod(function A65M_DOT)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Orc\\OrcLargeDeathExplode\\OrcLargeDeathExplode.mdl",damageTarget,"origin"))
            endif 
            call bf.apply()
        endif 
    endfunction

    
    function CHECK_STATE_nS0J takes nothing returns nothing
        local master owner = minion.getMinionByUnit(checkingUnit).mast
        local integer miniBonusLife = unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)
        call BlzSetUnitBaseDamage(checkingUnit,GetUnitMaxAttack(owner.masterUnit,0),0)
        call BlzSetUnitArmor(checkingUnit,BlzGetUnitArmor(owner.masterUnit))
        call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
        call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
    endfunction
    function HERO_6_TALENT_SPELLING_7 takes nothing returns nothing
        local minion mini 
        local integer mini_ID = 'nS0J'
        if castingSpell == 'S03R' or castingSpell == 'S03S' then 
            set mini = minion.create(spellCaster,mini_ID,GetUnitX(spellCaster),GetUnitY(spellCaster))
            set mini.remove = true 
            set mini.deathSFX = "Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl"
            call IssueTargetOrderById(mini.summon,ORDER_attack,spellTarget)
            call UnitApplyTimedLife(mini.summon,'BTLF',8)
            call unitCheckState.evaluate(mini.summon)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl",spellCaster,"origin"))
            call SetUnitVertexColor(mini.summon,0,0,0,125)
        endif 
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_7
    //====================================================
    function HERO_7_TALENT_MISSILE_LAUNCH_1 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        if proj.flag == 'S002' then 
            set proj.model_path = "war3campImported\\Frostfirebolt.mdx"
            set proj.tag_Fire = true 
        endif 
    endfunction
    function HERO_7_TALENT_DAMAGING_SOURCE_1 takes nothing returns nothing
        if damageFlag == 'S002' then 
            set damageFinalDamage = damageFinalDamage*1.3
        endif 
    endfunction
    function HERO_7_TALENT_SPELLING_2 takes nothing returns nothing
        local mybuff bf
        if castingSpell == 'S007' then
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_MAGE_COLDRAIN)
            set bf.lastTime = 1500
            set bf.intData = 50
            set bf.realData = 0.3
            call bf.apply()
        elseif castingSpell == 'S009' then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_MAGE_COLDRAIN)
            set bf.lastTime = 1500
            set bf.intData = 100
            set bf.realData = 0.3
            call bf.apply()
        endif 
    endfunction
    function HERO_7_TALENT_DAMAGING_SOURCE_3 takes nothing returns nothing
        local mybuff bf 
        if damageFlag == 'S002' then 
            set bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_MAGE_HOARFROST)
            if bf > 0 then 
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
                set damageAddCrit = damageAddCrit+0.5
            endif 
        endif 
        if damageFlag == 'S00A' or damageFlag == 'S04U' then 
            set bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_MAGE_WINTERSCHILL)
            if bf > 0 then 
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
                set damageFinalDamage = damageFinalDamage*1.3
            endif 
        endif 
    endfunction
    function HERO_7_TALENT_AFTERDAMAGE_SOURCE_3 takes nothing returns nothing
        local mybuff bf 
        if damageFlag == 'S002' then 
            set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_MAGE_WINTERSCHILL)
            set bf.lastTime = 3000
            set bf.intData = IMinBJ(bf.intData+2,12)
            call bf.apply()
        endif 
        if damageFlag == 'S00A' or damageFlag == 'S04U' then 
            set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_MAGE_HOARFROST)
            set bf.lastTime = 3000
            set bf.intData = IMinBJ(bf.intData+1,12)
            call bf.apply()
        endif 
    endfunction
