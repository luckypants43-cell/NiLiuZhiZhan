        function LIFE_HEALING_TARGET takes nothing returns nothing
            if hero[1] == healTarget then 
                set healFinalHeal = healFinalHeal*1.24
            else 
                set healFinalHeal = healFinalHeal*1.12
            endif 
        endfunction
        function LIFE_AURA_STATE_SET takes nothing returns nothing
            local mybuff bf = aura.modifingAuraBuff
            call bf.addHealing_T(function LIFE_HEALING_TARGET)
