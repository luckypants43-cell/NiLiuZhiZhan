        endfunction
        function S01A_HIT takes nothing returns nothing
            local real dmg = I2R(GetUnitAttack(projectile.currentProjectile.source,0))*1.5
            call projectile.currentProjectile.applyDamageSet()
            set damageIsAOE = true 
            set damageFlag = 'S01A'
            call UnitDamageTarget(projectile.currentProjectile.source,projectile.currentProjectile.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction

        function SPELL_S01A takes nothing returns nothing   //流矢风暴
            local projectile proj 
            local delayedevent de 
            local integer delay = 0
            local real radius = 250
            local real d 
            local real a
            local boolean noUnit = false 
            local integer times = 0
            local integer maxtime = 3
            local group pick = CreateGroup()
            call sort.clear()
            loop 
                exitwhen delay > 150
                call sort.add(delay)
                set delay = delay+10
            endloop
            call sort.shuffle()
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,radius,playerEnemy)
            set delay = 0 
            loop 
                exitwhen delay > 15
                set proj = projectile.create(spellCaster)
                set proj.model_path = "Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl"
                if noUnit == false then 
                    if FirstOfGroup(pick) == null then 
                        if times < maxtime then 
                            set times = times+1
                            call GroupClear(pick)
                            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,radius,playerEnemy)
                        else 
                            set noUnit = true 
                        endif 
                    endif 
                endif 
                if FirstOfGroup(pick) == null and noUnit == false then 
                    set noUnit = true 
                endif 
                if noUnit then 
                    set d = SquareRoot(GetRandomReal(0,radius*radius))
                    set a = GetRandomReal(0,6.2832)
                    set proj.target_x = spellTargetX+d*Cos(a)
                    set proj.target_y = spellTargetY+d*Sin(a)
                    set proj.TARGET_LOC = true 
                else 
                    set proj.target = GroupPickRandomUnitEx(pick)
                    call GroupRemoveUnit(pick,proj.target)
                    call proj.addOnHit(function S01A_HIT)
                    set proj.TARGET_UNIT = true 
                endif 
                set proj.speed = 1100
                set proj.curve = 0.2
                set proj.flag = 'S01A'
                set proj.LAUNCH_UNIT = true 
                set de = delayedevent.create(sort.arr[delay],1,function DELAYED_MISSILE_LAUNCH)
                call de.saveInteger("MISSILE",proj)
                set delay = delay+1
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S01B takes nothing returns nothing   //猎人印记
            local mybuff bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_RANGER_HUNTERSMARK)
            set bf.lastTime = 1000
            call bf.apply()
        endfunction
        function CHECK_STATE_nS04 takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 20*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/2
            call BlzSetUnitBaseDamage(checkingUnit,3*GetUnitLevel(owner.masterUnit)/7+1+R2I(I2R(GetUnitMaxAttack(owner.masterUnit,0))*0.3),0)
            call BlzSetUnitArmor(checkingUnit,3+4*GetUnitLevel(owner.masterUnit)/5)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function UNIT_nS04_ATTACKING takes nothing returns nothing
            local mybuff bf = 0
            if GetUnitUserData(damageSource) > 0 then 
                call SetUnitUserData(damageSource,0)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",damageTarget,"chest"))
                set damageTag_Attack = false 
                set damageAddAccuracy = 1000
                set damageFlag = 'S01C'
                if HeroHaveTalent(damageMaster,HERO_PRIVATE_TALENT,8) then 
                    set damageDamage = damageDamage*11
                    call applyStun(damageSource,damageTarget,'ATB0')
                    set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_RANGER_ARMORBREAK,1000)
                    set bf.bonusArmor_P = -1500
                    call bf.apply()
                endif 
            endif   
        endfunction
        function SPELL_S01C takes nothing returns nothing   //自然盟友
            local minion mini 
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetRandomReal(-1.0472,1.0472)+GetUnitFacing(spellCaster)/57.2958
            local real d = 125
            local group pick = CreateGroup()
            local integer count = 0
            local integer maxcount = 1
            local mybuff bf 
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS04' then 
                    set count = count+1
                    set mini = minion.getMinionByUnit(FirstOfGroup(pick))
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            if count >= maxcount then 
                set bf = mybuff.create(spellCaster,mini.summon,BUFFTYPE_RANGER_BEAST_RAGE)
                set bf.lastTime = 1000
                set bf.bonusAttackSpeed = 5000
                call bf.apply()
                set healFlag = 'S01C'
                call UnitHealTarget(spellCaster,mini.summon,0.2*GetUnitState(mini.summon,UNIT_STATE_MAX_LIFE))
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",mini.summon,"origin"))
                call SetUnitUserData(mini.summon,1)
            else 
                set mini = minion.create(spellCaster,'nS04',x+d*Cos(a),y+d*Sin(a))
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl",x+d*Cos(a),y+d*Sin(a)))
                set mini.deathSFX = "Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl"
                set mini.remove = true 
                call unitAddState(mini.summon,STATE_RESISTANCE,2000)
                call unitCheckState.evaluate(mini.summon)
                call delayedPauseUnit(mini.summon,200)
                call delayedPlayAnimation(mini.summon,"birth",233)
            endif 
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function S02M_HIT takes nothing returns nothing
            local real dmg = I2R(GetUnitAttack(projectile.currentProjectile.source,0))*0.8
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Attack = true 
            set damageFlag = 'S02M'
            call UnitDamageTarget(projectile.currentProjectile.source,projectile.currentProjectile.target,dmg,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S02M takes nothing returns nothing   //急速射击
            local projectile proj 
            local integer i = 0
            local integer imax = 5
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,8) then
                set imax = 8
            endif 
            loop 
                set proj = projectile.create(spellCaster)
                set proj.model_path = "Abilities\\Spells\\Other\\BlackArrow\\BlackArrowMissile.mdl"
                set proj.speed = 1300
                set proj.curve = 0
                set proj.target = spellTarget 
                set proj.flag = 'S02M'
                set proj.TARGET_UNIT = true 
                set proj.LAUNCH_UNIT = true 
                call proj.addOnHit(function S02M_HIT)
                call delayedLaunchMissile(proj,1+15*i)
                set i = i+1
                exitwhen i == imax
            endloop
        endfunction
        function SPELL_S02N takes nothing returns nothing   //速射
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_RANGER_HASTE)
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,3) then 
                set bf.bonusHaste = 7500
            else 
                set bf.bonusHaste = 5000
            endif 
            set bf.lastTime = 1200
            call bf.apply()
        endfunction
        function S02O_HIT takes nothing returns nothing
            local real dmg = 3.5*GetUnitMaxAttack(waveCaster,0)
            local real dmgMultiple = 1
            if IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) then 
                set damageFlag = 'S02O'
                set damageIsAOE = true 
                set damageTag_Fire = true 
                if GetUnitState(waveTarget,UNIT_STATE_LIFE) < GetUnitState(waveTarget,UNIT_STATE_MAX_LIFE)*0.3 then 
                    set dmgMultiple = 2
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl",waveTarget,"chest"))
                else 
                    set dmgMultiple = 1
                endif 
                call UnitDamageTarget(waveCaster,waveTarget,dmg*dmgMultiple,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            endif 
        endfunction
        function SPELL_S02O takes nothing returns nothing   //凤凰箭
            local real a = AngleByUnXY(spellCaster,spellTargetX,spellTargetY)/57.2956
            local real x = GetUnitX(spellCaster)+700*Cos(a)
            local real y = GetUnitY(spellCaster)+700*Sin(a)
            local projectile proj = CreateWave(spellCaster,x,y,1200,175,0,"units\\human\\phoenix\\phoenix.mdl",function S02O_HIT,null)
            call proj.launch()
        endfunction 

        function nS0E_RESET takes nothing returns nothing
            local minion mini = delayedevent.currentEvent.loadInteger("MINI")
            set mini.lastOrderTime = 0
        endfunction 
        function nS0E_SET_HEIGHT takes nothing returns nothing
            local minion mini = delayedevent.currentEvent.loadInteger("MINI")
            call SetUnitFlyHeight(mini.summon,GetUnitFlyHeight(mini.summon)+(200-GetUnitFlyHeight(mini.summon))/delayedevent.currentEvent.loopCount,0)
        endfunction
        function nS0E_ATTACKED takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = GetUnitX(proj.target)
            local real y = GetUnitY(proj.target)
            local real d = GetRandomReal(250,350)
            local real a = AngleByUnits(proj.source,proj.target)/57.2956+GetRandomReal(0,0.314)
            local delayedevent de = delayedevent.create(125,1,function nS0E_RESET)
            call de.saveInteger("MINI",minion.getMinionByUnit(proj.source))
            set x = x+d*Cos(a)
            set y = y+d*Sin(a)
            call PauseUnit(proj.source,false)
            set minion.getMinionByUnit(proj.source).lastOrderTime = -65535
            call IssuePointOrderById(proj.source,ORDER_move,x,y)
            set de = delayedevent.create(2,50,function nS0E_SET_HEIGHT)
            call de.saveInteger("MINI",minion.getMinionByUnit(proj.source))
        endfunction
        function nS0E_ATTACKING takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(minion.getMinionByUnit(proj.source).mast.masterUnit,0))*0.5
            local mybuff bf
            if GetUnitUserData(proj.source) > 0 then 
                call SetUnitUserData(proj.source,0)
                set bf = mybuff.create(proj.source,proj.target,BUFFTYPE_RANGER_BLIND)
                set bf.bonusAccuracy = -500
                set bf.lastTime = 800
                call bf.apply()
                call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",proj.target,"head"))
                set dmg = dmg*3
                set damageFlag = 'S02P'
            else  
                set damageFlag = 'nS0E'
            endif   
            call UnitDamageTarget(proj.source,proj.target,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_LIGHT_BASH)
        endfunction
        function UNIT_nS0E_ATTACKING takes nothing returns nothing
            local projectile proj = ChargeUnit(damageSource,damageTarget,1000,0,25,false,function nS0E_ATTACKING,function nS0E_ATTACKED)
            call PauseUnit(damageSource,true)
            call SetUnitAnimation(damageSource,"attack")
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\Sweep_Lightning_Small.mdx",damageSource,"hand left")
            set proj.bindSFX_1 = AddSpecialEffectTargetEX("war3campImported\\Sweep_Lightning_Small.mdx",damageSource,"hand right")
            set proj.resetHeight = false 
            set damageDamage = 0    
        endfunction
        function SPELL_S02P takes nothing returns nothing   //渡鸦
            local minion mini 
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetRandomReal(-1.0472,1.0472)+GetUnitFacing(spellCaster)/57.2958
            local real d = 125
            local group pick = CreateGroup()
            local integer count = 0
            local integer maxcount = 1
            local mybuff bf 
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS0E' then 
                    set count = count+1
                    set mini = minion.getMinionByUnit(FirstOfGroup(pick))
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            if count >= maxcount then 
                call SetUnitUserData(mini.summon,1)
            else 
                set mini = minion.create(spellCaster,'nS0E',x+d*Cos(a),y+d*Sin(a))
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl",x+d*Cos(a),y+d*Sin(a)))
                set mini.deathSFX = "Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl"
                set mini.remove = true 
                call SetUnitAcquireRange(mini.summon,10)
            endif 
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function S02Q_ATKED_T takes nothing returns nothing
            local mybuff bf = mybuff.create(damageSource,damageSource,BUFFTYPE_RANGER_KILLCOMMAND)
            set bf.bonusAttackSpeed = 2000
            set bf.lastTime = 500
            call bf.apply()
        endfunction
        function S02Q_HIT takes nothing returns nothing
            local mybuff bf
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))*4.5
            call proj.applyDamageSet()
            set damageFlag = 'S02Q'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",proj.target,"chest"))
            set bf = mybuff.create(proj.source,proj.target,BUFFTYPE_RANGER_KILLMARK)
            set bf.lastTime = 1500
            set bf.bonusArmor_P = -2000
            call bf.addAtked_T(function S02Q_ATKED_T)
            call bf.apply()
        endfunction
        function SPELL_S02Q takes nothing returns nothing   //杀戮射击
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1200,0,"war3campImported\\Bloodstone Arrow.mdx",function S02Q_HIT,null)
            set proj.flag = 'S02Q'
            call proj.launch()
        endfunction

        
        function S05X_DOT takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local real dmg = I2R(GetUnitMaxAttack(ds,0))*0.5
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,x,y,200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageIsDOT = true 
                set damageTag_Lightning = true 
                set damageFlag = 'S05X'
                call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveFirstUnit(pick)
            endloop 
            call DestroyGroup(pick)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\LightningNova.mdx",x,y))
            set ds = null 
            set pick = null 
        endfunction
        function S05X_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = proj.target_x
            local real y = proj.target_y
            local integer haste = 0
            local integer period = 200
            local integer times = 4
            local delayedevent de = 0
            local group pick = CreateGroup()
            local real dmg = I2R(GetUnitMaxAttack(proj.source,0))*3
            call SetUnitX(proj.dummy,x)
            call SetUnitY(proj.dummy,y)
            call GroupEnumUnitsInRangeEx(pick,x,y,200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageTag_Lightning = true 
                set damageFlag = 'S05X'
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call applyStun(proj.source,FirstOfGroup(pick),'ATB1')
                call GroupRemoveFirstUnit(pick)
            endloop 
            call DestroyGroup(pick)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\LightningNova.mdx",x,y))
            set haste = ST_HASTE.getTotalState(spellCaster)
            if HeroHaveTalent(proj.source,HERO_PRIVATE_TALENT,8) then 
                set period = period/2
                set times = times+4
            endif 
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            set de = CreateDelayedEvent(period,times,function S05X_DOT)
            call de.saveUnit("CASTER",proj.source)
            call de.saveReal("X",x)
            call de.saveReal("Y",y)
            call UnitApplyTimedLife(proj.dummy,'BHwe',I2R(period*times+1)/100)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\shandianjian.mdx",proj.dummy,"origin"),period*times+1)
            set pick = null 
        endfunction
        function SPELL_S05X takes nothing returns nothing   //岚祸箭
            local projectile proj = CreateProjectileToLoc(spellCaster,spellTargetX,spellTargetY,1000,2.5,"war3campImported\\shandianjian.mdx",null,function S05X_HIT)
            set proj.flag = 'S05X'
            set proj.ifDestroy = false 
            set proj.model_attach = "origin"
            call proj.launch()
            call SetUnitScale(proj.dummy,2,2,2)
        endfunction
    // endregion

    // region mage 魔法师
    ////////////////
    //HEROID = 6(7)
    ////////////////
        function S002_HIT takes nothing returns nothing
            local projectile proj 
            local unit ds = projectile.currentProjectile.source
            local unit dt = projectile.currentProjectile.target
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Cold = true 
            set damageFlag = 'S002'
            call UnitDamageTarget(ds,dt,I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call applyCold(ds,dt,'ACO0')
            set ds = null 
            set dt = null 
        endfunction
        function HERO_7_ATTACKING takes nothing returns nothing
             local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            if GetUnitAbilityLevel(dt,'B600') > 0 then 
                call UnitRemoveAbility(dt,'B600')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S002'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = BlzGetUnitAbilityCooldown(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set attackingMissile.model_path = "war3campImported\\FrostboltX2.mdx"  
                set attackingMissile.curve = 0 
                set attackingMissile.speed = 900
                set attackingMissile.tag_Cold = true 
                set attackingMissile.flag = 'S002'
                call attackingMissile.addOnHit(function S002_HIT)

                
            endif 
            set ds = null 
            set dt = null 
        endfunction
        function BLIZZARD_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit ds = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local real dmg = I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*9/12*de.loadReal("DAMAGE")
            call GroupEnumUnitsInRangeEx(pick,x,y,300,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Cold = true 
                set damageIsAOE = true 
                set damageFlag = 'S00A'
                call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applyCold(ds,FirstOfGroup(pick),'ACO1')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            set ds = null 
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function BLIZZARD_SFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local integer i = 0
            local real a
            local real d 
            local delayedevent dede 
            local location loc = Location(x,y)
            set dede = delayedevent.create(75,1,function BLIZZARD_DAMAGE)
            call dede.saveUnit("CASTER",de.loadUnit("CASTER"))
            call dede.saveReal("X",x)
            call dede.saveReal("Y",y)
            call dede.saveReal("DAMAGE",de.loadReal("DAMAGE"))
            loop 
                exitwhen i > 7
                set d = SquareRoot(GetRandomReal(2500,62500))
                set a = GetRandomReal(0.7854*I2R(i),0.7854*I2R(i+1))
                call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Blizzard II.mdx",x+d*Cos(a),y+d*Sin(a)))
                set i = i+1
            endloop
            call Play3DSndEx(SND_BLIZZARD,x,y,GetLocationZ(loc))
            call RemoveLocation(loc)
            set loc = null 
            //call BJDebugMsg(I2S(globalNowtime))
        endfunction
        function SPELL_S00A takes nothing returns nothing
            local integer haste
            local integer period = 100
            local integer waveCount = 12
            local delayedevent de 
            local real dmgamount = 1
            local mybuff bf
            set haste = unitGetAllBonusStateValue(spellCaster,STATE_HASTE)
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_ICESHIELD)
            if bf > 0 then 
                set haste = haste+R2I(10000*bf.realData)
            endif 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_FLIPPERICE)
            if bf > 0 then 
                set haste = haste+500*bf.intData
            endif 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_COLDRAIN)
            if bf > 0 then 
                set bf.DESTROY = true 
                set haste = haste+100*bf.intData
                set dmgamount = dmgamount*(1+bf.realData)
            endif 
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            set de = delayedevent.create(period,waveCount-1,function BLIZZARD_SFX)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveReal("DAMAGE",dmgamount)
            call SetHeroData(spellCaster,"BLIZZARD_EVENT",de)
            set de = delayedevent.create(1,1,function BLIZZARD_SFX)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveReal("DAMAGE",dmgamount)
            call BlzSetAbilityRealLevelField(BlzGetUnitAbility(spellCaster,'S00A'),ABILITY_RLF_CASTING_TIME,0,I2R(period)/100+0.002)
        endfunction
        function SPELL_STOP_S00A takes nothing returns nothing
            local delayedevent de = GetHeroData(spellCaster,"BLIZZARD_EVENT")
            set de.DESTROY = true 
        endfunction
        function SPELL_S00C takes nothing returns nothing   //暴风雪（脱手）
            local integer haste
            local integer period = 100
            local integer waveCount = 8
            local delayedevent de 
            local real dmgamount = 0.5
            local mybuff bf
            set haste = unitGetAllBonusStateValue(spellCaster,STATE_HASTE)
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_ICESHIELD)
            if bf > 0 then 
                set haste = haste+R2I(10000*bf.realData)
            endif 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_FLIPPERICE)
            if bf > 0 then 
                set haste = haste+500*bf.intData
            endif 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_COLDRAIN)
            if bf > 0 then 
                set bf.DESTROY = true 
                set haste = haste+100*bf.intData
                set dmgamount = dmgamount*(1+bf.realData)
            endif 
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            set de = delayedevent.create(period,waveCount-1,function BLIZZARD_SFX)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveReal("DAMAGE",dmgamount)
            set de = delayedevent.create(1,1,function BLIZZARD_SFX)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveReal("DAMAGE",dmgamount)
        endfunction

        function S04U_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = proj.realData*I2R(ST_ABILITY_POWER.getTotalState(proj.source))
            call proj.applyDamageSet()
            set damageTag_Cold = true 
            set damageFlag = 'S04U'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call applyCold(proj.source,proj.target,'ACO0')
        endfunction
        function S04U_MISSILE_REFRESH takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local projectile proj = de.loadInteger("PROJ")
            set proj.speed = 1200
        endfunction
        function S04U_MISSILE_LAUNCH takes nothing returns nothing
            local delayedevent de2 = 0
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local integer loopC = de.loadInteger("LOOP")
            local real dmg = de.loadReal("DAMAGE")
            local real x 
            local real y 
            local real a
            local real d 
            local real h 
            local projectile proj = 0
            //call BJDebugMsg("LAUNCH !")
            loop
                exitwhen loopC == 0
                //call BJDebugMsg(I2S(loopC))
                set a = AngleByUnits(ds,dt)
                set d = 25*(I2R((loopC+1)/2))-12.5
                set h = 100-(6.25*I2R((loopC+1)/2)*I2R((loopC+1)/2))
                if ModuloInteger(loopC,2) == 1 then 
                    set a = (a+90)/57.2956
                else 
                    set a = (a-90)/57.2956
                endif 
                set x = GetUnitX(ds)+d*Cos(a)
                set y = GetUnitY(ds)+d*Sin(a)
                set proj = CreateProjectileToUnit(ds,dt,5,0,"Abilities\\Weapons\\LichMissile\\LichMissile.mdl",function S04U_HIT,null)
                set proj.LAUNCH_LOC = true 
                set proj.LAUNCH_UNIT = false 
                set proj.source_x = x 
                set proj.source_y = y 
                set proj.start_z = h
                set proj.realData = dmg 
                call proj.launch()
                set proj.bindSFX_0 = AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\FrostBolt\\FrostBoltMissile.mdl",proj.dummy,"chest")
                call SetUnitScale(proj.dummy,0.5,0.5,0.5)
                set de2 = CreateDelayedEvent((loopC-1)*7+1,1,function S04U_MISSILE_REFRESH)
                call de2.saveInteger("PROJ",proj)
                call DestroyEffectEX(de.loadEffect("SFX_"+I2S(loopC)))
                set loopC = loopC-1
            endloop
            set ds = null 
            set dt = null   
        endfunction
        function S04U_CHECK takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local integer loopC = de.loadInteger("LOOP")
            local real dmg = de.loadReal("DAMAGE")
            local real remainingTime = BlzGetUnitAbilityCooldownRemaining(ds,'S04U')
            local real x 
            local real y 
            local real a
            local real d 
            local real h 
            local effect sfx 
            set loopC = loopC+1
            if alive(ds) and GetUnitCurrentOrder(ds) == ORDER_blizzard then 
                set a = AngleByUnits(ds,dt)
                set d = 25*(I2R((loopC+1)/2))-12.5
                set h = 100-(6.25*I2R((loopC+1)/2)*I2R((loopC+1)/2))+50
                if ModuloInteger(loopC,2) == 1 then 
                    set a = (a+90)/57.2956
                else 
                    set a = (a-90)/57.2956
                endif 
                set x = GetUnitX(ds)+d*Cos(a)
                set y = GetUnitY(ds)+d*Sin(a)
                set sfx = AddSpecialEffectEX("Abilities\\Weapons\\LichMissile\\LichMissile.mdl",x,y)
                call BlzSetSpecialEffectOrientation(sfx,AngleByXYnU(x,y,dt)/57.2956,0,0)
                call BlzSetSpecialEffectHeightEX(sfx,h)
                call BlzSetSpecialEffectScale(sfx,0.5)
                call de.saveEffect("SFX_"+I2S(loopC),sfx)
                if loopC >= 8 then 
                    call UnitRemoveAbility(ds,'S04U')
                    call UnitAddAbility(ds,'S04U')
                    call BlzStartUnitAbilityCooldown(ds,'S04U',remainingTime)
                    call State.checkAll(ds)
                    set de.DESTROY = true 
                    //call BJDebugMsg("END EVENT = "+I2S(de))
                endif 
            else 
                set de.DESTROY = true 
                    //call BJDebugMsg("END EVENT = "+I2S(de))
            endif 
            call de.saveInteger("LOOP",loopC)
            set ds = null 
            set dt = null   
            set sfx = null 
        endfunction
        function S04U_FACE_TAR takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local delayedevent de2 = de.loadInteger("DE")
            local integer loopC = de2.loadInteger("LOOP")
            local real x 
            local real y 
            local real a
            local real d 
            local real h 
            if GetUnitCurrentOrder(ds) == ORDER_blizzard then 
                call SetUnitFacingToFaceUnitTimed(ds,dt,0)
            else 
                set de.DESTROY = true 
                set de2.DESTROY = true 
            endif 
            if de2 > 0 and loopC > 0 then 
                loop
                    exitwhen loopC == 0
                    set a = AngleByUnits(ds,dt)
                    set d = 25*(I2R((loopC+1)/2))-12.5
                    set h = 100-(6.25*I2R((loopC+1)/2)*I2R((loopC+1)/2))+50
                    if ModuloInteger(loopC,2) == 1 then 
                        set a = (a+90)/57.2956
                    else 
                        set a = (a-90)/57.2956
                    endif 
                    set x = GetUnitX(ds)+d*Cos(a)
                    set y = GetUnitY(ds)+d*Sin(a)
                    call BlzSetSpecialEffectX(de2.loadEffect("SFX_"+I2S(loopC)),x)
                    call BlzSetSpecialEffectY(de2.loadEffect("SFX_"+I2S(loopC)),y)
                    call BlzSetSpecialEffectOrientation(de2.loadEffect("SFX_"+I2S(loopC)),AngleByXYnU(x,y,dt)/57.2956,0,0)
                    call BlzSetSpecialEffectHeightEX(de2.loadEffect("SFX_"+I2S(loopC)),h)
                    call BlzSetSpecialEffectScale(de2.loadEffect("SFX_"+I2S(loopC)),0.5)
                    set loopC = loopC-1
                endloop
            endif 
            set ds = null 
            set dt = null   
        endfunction
        function SPELL_S04U takes nothing returns nothing   //冰风暴
            local delayedevent de
            local delayedevent de2
            local integer haste
            local mybuff bf
            local real dmgamount = 0.75
            local integer period = 50
            set haste = ST_HASTE.getTotalState(spellCaster)
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_ICESHIELD)
            if bf > 0 then 
                set haste = haste+R2I(10000*bf.realData)
            endif 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_FLIPPERICE)
            if bf > 0 then 
                set haste = haste+500*bf.intData
            endif 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_COLDRAIN)
            if bf > 0 then 
                set bf.DESTROY = true 
                set haste = haste+100*bf.intData
                set dmgamount = dmgamount*(1+bf.realData)
            endif 
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            set de = delayedevent.create(period,8,function S04U_CHECK)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveInteger("LOOP",0)
            call de.saveReal("DAMAGE",dmgamount)
            call de.addOnEnd(function S04U_MISSILE_LAUNCH)
            set de2 = delayedevent.create(1,2000,function S04U_FACE_TAR)
            call de2.saveUnit("CASTER",spellCaster)
            call de2.saveUnit("TARGET",spellTarget)
            call de2.saveInteger("DE",de)
        endfunction 
        function SPELL_READY_S04U takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0)
        endfunction
        function SPELL_STOP_S04U takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function SPELL_END_S04U takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function HERO_7_SPELLING takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction

        function SPELL_S007 takes nothing returns nothing
            local group pick = CreateGroup()
            local real dmg = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*2.5
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\icenova.mdx",x,y))
            call GroupEnumUnitsInRangeEx(pick,x,y,700,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if inCombat(FirstOfGroup(pick)) or DisByUnXY(FirstOfGroup(pick),x,y) < 450+BlzGetUnitCollisionSize(spellCaster)+BlzGetUnitCollisionSize(FirstOfGroup(pick)) then
                    set damageTag_Cold = true 
                    set damageIsAOE = true 
                    set damageFlag = 'S007'
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                    call applySnare(spellCaster,FirstOfGroup(pick),'ASN0')
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function FROZEN_ORB_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit ds = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local real dmg = I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1.5
            call GroupEnumUnitsInRangeEx(pick,x,y,200,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Cold = true 
                set damageIsAOE = true 
                set damageFlag = 'S009'
                call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applyCold(ds,FirstOfGroup(pick),'ACO1')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            set ds = null 
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function FROZEN_ORB_HIT takes nothing returns nothing
            local real dmg = I2R(unitGetAllBonusStateValue(waveCaster,STATE_ABILITY_POWER))*2.5
            if IsUnitEnemy(waveTarget,PLAYER) then 
                set damageTag_Cold = true 
                set damageIsAOE = true 
                set damageFlag = 'S009'
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            endif 
        endfunction
        function FROZEN_ORB_DEATH takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local delayedevent de = delayedevent.create(proj.intData,4,function FROZEN_ORB_DAMAGE)
            call de.saveReal("X",GetUnitX(proj.dummy))
            call de.saveReal("Y",GetUnitY(proj.dummy))
            call de.saveUnit("CASTER",proj.source)
            call UnitApplyTimedLife(proj.dummy,'BHwe',I2R(proj.intData*4)/100)
            call delayedDestroyEffect(proj.model,proj.intData*4)
        endfunction
        function SPELL_S009 takes nothing returns nothing
            local projectile proj = projectile.create(spellCaster)
            local integer period = 200
            local integer haste = ST_HASTE.getTotalState(spellCaster)
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            set proj.LAUNCH_UNIT = true 
            set proj.TARGET_LOC = true 
            set proj.target_x = spellTargetX
            set proj.target_y = spellTargetY
            set proj.speed = 600
            set proj.model_path = "war3campImported\\hanbingbaozhu.mdl"
            set proj.model_attach = "origin" 
            set proj.IS_WAVE = true 
            set proj.Wave_Radius_Add = 0
            set proj.Wave_Radius_Start = 175 
            set proj.intData = period
            call proj.addOnHit(function FROZEN_ORB_HIT) 
            call proj.addOnEnd(function FROZEN_ORB_DEATH)  
            set proj.ifDestroy = false 
            set proj.destroyAttach = false 
            call proj.launch()
        endfunction
        function ICE_SHIELD_DAMAGING_SOURCE takes nothing returns nothing
            if damageTag_Cold then 
                set damageFinalDamage = damageFinalDamage*1.1*(1+mybuff.currentBuff.realData)
            endif 
        endfunction
        function SPELL_S00D takes nothing returns nothing
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_MAGE_ICESHIELD)
            set bf.lastTime = 6000
            set bf.realData = bf.realData
            set bf.shieldBlockPercent = 1
            set bf.shieldDestroy = true 
            set bf.shieldMaxValue = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*3.5
            set bf.bonusManaRegen = GetUnitLevel(spellCaster)*2+50
            call bf.addDmging_S(function ICE_SHIELD_DAMAGING_SOURCE)
            call bf.apply()
        endfunction
        function COMET_STORM_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit ds = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local real dmg = I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1.5
            call GroupEnumUnitsInRangeEx(pick,x,y,150,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Cold = true 
                set damageIsAOE = true 
                set damageFlag = 'S004'
                call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applyCold(ds,FirstOfGroup(pick),'ACO1')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            set ds = null 
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",x,y))
        endfunction
        function COMET_STORM_SFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local delayedevent dede = delayedevent.create(75,1,function COMET_STORM_DAMAGE)
            local real x = GetUnitX(de.loadUnit("TARGET"))
            local real y = GetUnitY(de.loadUnit("TARGET"))
            local integer count = de.loadInteger("COUNT")
            local real a = GetRandomReal(0.8976*I2R(count),0.8976*I2R(count+1))
            local real d = SquareRoot(GetRandomReal(5625,15625))
            call dede.saveReal("X",x+d*Cos(a))
            call dede.saveReal("Y",y+d*Sin(a))
            call dede.saveUnit("CASTER",de.loadUnit("CASTER"))
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Comet_kuai.mdx",x+d*Cos(a),y+d*Sin(a)))
            call de.saveInteger("COUNT",count+1)
        endfunction
        function SPELL_S004 takes nothing returns nothing
            local delayedevent de = delayedevent.create(20,7,function COMET_STORM_SFX)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveInteger("COUNT",0)
        endfunction
        function CHECK_STATE_nS0D takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 8*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/5
            call BlzSetUnitBaseDamage(checkingUnit,1*GetUnitLevel(owner.masterUnit)/5+2+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER))*0.3),0)
            call BlzSetUnitArmor(checkingUnit,3+2*GetUnitLevel(owner.masterUnit)/6)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function UNIT_nS0D_ATTACKING takes nothing returns nothing
            set damageTag_Cold = true 
            set damageAddAccuracy = 1000
            set damageFlag = 'nS0D'
            set damageDamageType = DAMAGE_TYPE_MAGIC
            set damageAttackType = ATTACK_TYPE_NORMAL
        endfunction
        function SPELL_S003 takes nothing returns nothing
            local minion mini
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetRandomReal(-1.0472,1.0472)+GetUnitFacing(spellCaster)/57.2958
            local real d = 125
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_MAGE_FROSTENCHANT)
            set bf.lastTime = 2000
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,12) then 
                set bf.bonusHaste = 3000
            else 
                set bf.bonusHaste = 2000
            endif 
            set bf.bonusCostReduce = 2000
            set bf.bonusImmune_Root = 1
            set bf.bonusImmune_Silence = 1
            set bf.bonusImmune_Snare = 1
            set bf.bonusImmune_Stun = 1
            call bf.apply()
            set mini = minion.create(spellCaster,'nS0D',x+d*Cos(a),y+d*Sin(a))
            call unitAddState(mini.summon,STATE_RESISTANCE,3000)
            call unitCheckState.evaluate(mini.summon)
            call delayedPauseUnit(mini.summon,100)
            call delayedPlayAnimation(mini.summon,"birth",105)
            call UnitApplyTimedLife(mini.summon,'BHwe',20)
        endfunction
    // endregion

    // region berserk 角斗士
    ////////////////
    //HEROID = 2(3)
    ////////////////
        function A657_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if bf.intData > 1 then 
                set bf.intData = bf.intData - 1
                set bf.bonusAttack_P = 1000*bf.intData
                call bf.refreshStates()
            else 
                set bf.DESTROY = true 
            endif 
        endfunction

        function HERO_3_SHOCKWAVE takes nothing returns nothing
            local mybuff bf
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local real dmg = 0.65*I2R(GetUnitAttack(ds,0))
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(ds),GetUnitY(ds),300,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageFlag = 'B65F'
                set damageTag_Fire = true 
                call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                set bf = CreateBuff(ds,FirstOfGroup(pick),BUFFTYPE_BERSERKER_SHOCKWAVE,500)
                set bf.intData = bf.intData+1
                set bf.bonusArmor_P = -2500*bf.intData
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Explosion.mdx",GetUnitX(ds),GetUnitY(ds)))
            set pick = null
            set ds = null 
        endfunction

        function HERO_3_SUPPRESS takes unit whichUnit,integer count returns mybuff
            local integer eff = 750
            local integer maxCount = 4
            local boolean applyBerserk = false 
            local mybuff bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_BERSERKER_SUPPRESS,360000)

            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,6) then 
                set eff = eff+150
            endif 
            if HeroHaveTalent(whichUnit,HERO_ULTIMATE_TALENT,10) then 
                set eff = eff-200
                set maxCount = maxCount+4
                if bf.intData >= maxCount then 
                    set bf.intData = bf.intData-maxCount
                    set applyBerserk = true 
                endif 
            endif 
            
            set bf.addTime = false 
            set bf.hasteAble = false 
            if bf.intData < maxCount then
                set bf.lastTriggerTime = globalNowtime 
            endif 
            set bf.intData = IMinBJ(maxCount,bf.intData+count)
            set bf.bonusAttack_P = IMaxBJ(0,eff*bf.intData)
            set bf.periodTime = 400
            call bf.addPeriod(function A657_PERIOD)
            call bf.apply()

            if applyBerserk then 
                set bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_BERSERKER_BERSERK,600)
                set bf.bonusHaste = 5000
                set bf.intData = IMaxBJ(bf.intData,0)
                call bf.apply()
            endif 
            return bf 
        endfunction

        function HERO_3_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 6
            local real a 
            local real d 
            local boolean noCD = false 
            local real damageMultiple

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B635') > 0 then 
                call UnitRemoveAbility(dt,'B635')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S02H'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageMultiple = GetRandomReal(1,2)
                if GetUnitAbilityLevel(damageSource,'A652') > 0 and mybuff.getUnitBuff(damageSource,BUFFTYPE_BERSERKER_BERSERK).intData > 0 then 
                    set noCD = true 
                endif 
                if GetUnitLifePercent(damageTarget) < 35 and HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,1) then 
                    set noCD = true 
                    set damageMultiple = RMaxBJ(damageMultiple,GetRandomReal(1,2))
                endif 
                if GetUnitLifePercent(damageSource) > 90 and HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,5) then
                    call AddUnitLife(damageSource,0-0.05*GetUnitState(damageSource,UNIT_STATE_MAX_LIFE))
                    set Qcd = 4
                    set damageMultiple = RMaxBJ(damageMultiple,GetRandomReal(1,2))
                endif 
                if not noCD then  
                    call BlzStartUnitAbilityCooldown(ds,'S02H',Qcd*haste-0.01)
                endif 
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\phoenix_missile_smaller.mdx",damageSource,"weapon"))

                set damageDamage = damageDamage*damageMultiple
                set damageFlag = 'S02H'
                set damageTag_Fire = true 
                
                if HeroHaveTalent(damageSource,HERO_ULTIMATE_TALENT,10) then 
                    call HERO_3_SUPPRESS(damageSource,1)
                endif 
            endif
            
            if GetUnitAbilityLevel(damageSource,'S03I') > 0 and BlzGetUnitAbilityCooldownRemaining(damageSource,'S03I') == 0 then 
                call IssueImmediateOrderById(damageSource,ORDER_fanofknives)
                call IssueTargetOrderById(damageSource,ORDER_attack,damageTarget)
            endif 
            set ds = null 
            set dt = null 
        endfunction

        function S02I_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*1.6*bf.realData/4*mybuff.buffTimeScale
            set damageTag_Bleed = true
            set damageFlag = 'A650'
            set damageIsDOT = true 
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function HERO_3_ATTACKED_SOURCE takes nothing returns nothing
            local mybuff bf 
            if GetUnitAbilityLevel(damageSource,'S02I') > 0 and random.get(damageSource,0.25,'S02I') then 
                if mybuff.getUnitBuff(damageTarget,BUFFTYPE_BERSERKER_RENDER) > 0 then 
                    if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,3) and GetRandomReal(0,1) < 0.5 then 
                        call HERO_3_SUPPRESS(damageSource,1)
                    endif 
                endif 
                set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_BERSERKER_RENDER,800)
                set bf.bonusArmor = 0-UnitLevel(damageSource)/2
                set bf.periodTime = 200
                set bf.hasteAble = true 
                set bf.realData = 1+bf.realData*bf.remainingTime/bf.lastTime
                call bf.addPeriod(function S02I_DOT)
                call bf.apply()
            endif
        endfunction
        
        function S02K_HIT takes nothing returns nothing
            local real dmg = 1*I2R(GetUnitAttack(waveCaster,0))
            if IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) then 
                set damageIsAOE = true 
                set damageFlag = 'S02K'
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            endif 
        endfunction
        function HERO_3_AFTERDAMAGE_SOURCE takes nothing returns nothing
            local real haste = 1
            local projectile proj 
            local real x 
            local real y 
            local mybuff bf 
            if damageTag_Attack and GetUnitAbilityLevel(damageSource,'S02K') > 0 and damageIfCrit and unitCheckCooldown(damageSource,'S02K') then 
                if unitGetBonusState(damageSource,STATE_ATTACK_SPEED) >= 0 then 
                    set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(damageSource,STATE_ATTACK_SPEED)))
                else 
                    set haste = (10000-I2R(unitGetAllBonusStateValue(damageSource,STATE_ATTACK_SPEED)))/10000
                endif 
                call unitStartCooldown(damageSource,'S02K',R2I(400*haste)-1)
                set x = GetUnitX(damageSource)+600*Cos(AngleByUnits(damageSource,damageTarget)/57.2956)
                set y = GetUnitY(damageSource)+600*Sin(AngleByUnits(damageSource,damageTarget)/57.2956)
                set proj = CreateWave(damageSource,x,y,1000,100,0,"Abilities\\Spells\\Orc\\Shockwave\\ShockwaveMissile.mdl",function S02K_HIT,null)
                call proj.launch()
                if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,4) then 
                    set bf = CreateBuff(damageSource,damageSource,BUFFTYPE_BERSERKER_BERSERK,100)
                    set bf.bonusHaste = 5000
                    set bf.intData = IMaxBJ(bf.intData,0)
                    call bf.apply()
                endif 
            endif 
        endfunction

        function S02J_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = GetUnitX(proj.source)
            local real y = GetUnitY(proj.source)
            local real dmg = 2.5*I2R(GetUnitMaxAttack(proj.source,0))
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,x,y,175,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageFlag = 'S02J'
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call applyStun(proj.source,FirstOfGroup(pick),'ATB1')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y)) 
        endfunction
        function SPELL_S02J takes nothing returns nothing   //英勇跃击
            local mybuff bf 
            local projectile proj = KnockbackLocEx(spellCaster,spellTargetX,spellTargetY,1.8*DisByUnXY(spellCaster,spellTargetX,spellTargetY),0.2)
            call proj.addOnEnd(function S02J_HIT)
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl",spellCaster,"hand left")
            set proj.bindSFX_1 = AddSpecialEffectTargetEX("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl",spellCaster,"hand right")
            call SetUnitAnimation(spellCaster,"attack slam")
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,3) then 
                call HERO_3_SUPPRESS(spellCaster,2)
            endif 
        endfunction

        function S02L_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*2/5*mybuff.buffTimeScale
            set damageTag_Bleed = true
            set damageIsDOT = true 
            set damageFlag = 'A651'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S02L takes nothing returns nothing   //横扫攻击
            local mybuff bf 
            local real dmg = 1.5*I2R(GetUnitAttack(spellCaster,0))
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),400,playerEnemy)
            call GroupAddUnit(pick,spellTarget)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if FirstOfGroup(pick) == spellTarget or Cos((AngleByUnits(spellCaster,FirstOfGroup(pick))-AngleByUnits(spellCaster,spellTarget))/57.2956) > 0.5 then 
                    set damageIsAOE = true 
                    set damageFlag = 'S02L'
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_MEDIUM_BASH)
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",FirstOfGroup(pick),"chest"))
                    set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_BERSERKER_SLASH,1000)
                    set bf.periodTime = 200
                    call bf.addPeriod(function S02L_DOT)
                    call bf.apply()
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\BloodStrikeLarge.mdx",spellCaster,"origin"))
            
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) then 
                set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_BERSERKER_BERSERK,400)
                set bf.bonusHaste = 5000
                set bf.intData = IMaxBJ(bf.intData,0)
                call bf.apply()
            endif 
        endfunction
        
        function SPELL_S03I takes nothing returns nothing   //旋风斩
            local real haste = 1
            local real cd = 10
            local real dmg = 1.5*I2R(GetUnitAttack(spellCaster,0))
            local group pick = CreateGroup()
            if unitGetBonusState(spellCaster,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))/10000
            endif 
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),300,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Attack = true 
                set damageIsAOE = true 
                set damageFlag = 'S03I'
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_MEDIUM_BASH)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",FirstOfGroup(pick),"chest"))
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null
            call BlzSetUnitAbilityCooldown(spellCaster,'S03I',0,cd*haste-0.01)
            call delayedPlayAnimation(spellCaster,"spin",40)
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,8) then 
                call delayedevent.create(30,1,function HERO_3_SHOCKWAVE).saveUnit("CASTER",spellCaster)
            endif 
        endfunction

        function A653_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitAttack(bf.buffSource,0))*2/4*mybuff.buffTimeScale
            set damageTag_Bleed = true 
            set damageIsDOT = true 
            set damageFlag = 'A653'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S03J_CHECK takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local real haste = de.loadReal("HASTE")
            local real loopC = de.loadReal("LOOP")
            local integer anim = de.loadInteger("ANIM")
            local real dmg = I2R(GetUnitAttack(ds,0))
            local mybuff bf 
            local real remainingTime = BlzGetUnitAbilityCooldownRemaining(ds,'S03J')
            local group pick = null 
            set loopC = loopC+1
            if GetUnitCurrentOrder(ds) == ORDER_blizzard then 
                if anim == 0 and 22*haste-loopC < 0 then 
                    set anim = 1
                    set damageFlag = 'S03J'
                    call UnitDamageTarget(ds,dt,1.5*dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_CHOP)
                    set bf = CreateBuff(ds,dt,BUFFTYPE_BERSERKER_SUNDERARMOR,1000)
                    set bf.bonusArmor_P = -1500
                    call bf.apply()
                endif 
                if anim == 1 and 40*haste-loopC < 0 then 
                    set anim = 2 
                    call SetUnitAnimationByIndex(ds,12)
                endif 
                if anim == 2 and 62*haste-loopC < 0 then 
                    set anim = 3
                    set damageFlag = 'S03J'
                    call UnitDamageTarget(ds,dt,1*dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
                    set bf = CreateBuff(ds,dt,BUFFTYPE_BERSERKER_BLEED,1200)
                    set bf.periodTime = 300
                    set bf.hasteAble = true 
                    call bf.addPeriod(function A653_PERIOD)
                    call bf.apply()
                endif 
                if anim == 3 and 102*haste-loopC < 0 then 
                    set anim = 4
                    call SetUnitAnimationByIndex(ds,14)
                    call SetUnitTimeScale(ds,1/haste)
                    call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl",ds,"weapon"),R2I(66*haste))
                endif 
                if anim == 4 and 166*haste-loopC < 0 then 
                    set anim = 5
                    set pick = CreateGroup()
                    call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),250,playerEnemy)
                    loop
                        exitwhen FirstOfGroup(pick) == null
                        set damageFlag = 'S03J'
                        set damageIsAOE = true 
                        call UnitDamageTarget(ds,FirstOfGroup(pick),2*dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_HEAVY_BASH)
                        call GroupRemoveUnit(pick,FirstOfGroup(pick))
                    endloop
                    call DestroyGroup(pick)
                    call applyStun(ds,dt,'ATB1')
                    call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(dt),GetUnitY(dt)))
                    if HeroHaveTalent(ds,HERO_PRIVATE_TALENT,8) then 
                        call delayedevent.create(30,2,function HERO_3_SHOCKWAVE).saveUnit("CASTER",ds)
                    endif 
                endif 
                if anim == 5 and 200*haste-loopC < 0 then 
                    call UnitRemoveAbility(ds,'S03J')
                    call UnitAddAbility(ds,'S03J')
                    call BlzStartUnitAbilityCooldown(ds,'S03J',remainingTime)
                    call SetUnitTimeScale(ds,1)
                    call State.checkAll(ds)
                    set de.DESTROY = true 
                endif 
            else 
                call SetUnitTimeScale(ds,1)
                set de.DESTROY = true 
            endif 
            call de.saveReal("LOOP",loopC)
            call de.saveInteger("ANIM",anim)
            set pick = null 
            set ds = null 
            set dt = null   
        endfunction
        function SPELL_S03J takes nothing returns nothing
            local delayedevent de
            local real haste = 1
            if unitGetBonusState(spellCaster,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))/10000
            endif 
            set de = delayedevent.create(1,500,function S03J_CHECK)
            call SetUnitAnimationByIndex(spellCaster,13)
            call SetUnitTimeScale(spellCaster,1.5/haste)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveReal("HASTE",haste)
            call de.saveReal("LOOP",0)
            call de.saveInteger("ANIM",0)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\Sweep_Blood_Medium.mdx",spellCaster,"hand right"),R2I(166*haste))
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\Sweep_TeamColor_Small.mdx",spellCaster,"weapon"),R2I(166*haste))
        endfunction 

        function SPELL_S03K takes nothing returns nothing
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_BERSERKER_BERSERK,1200)
            set bf.bonusHaste = 5000
            set bf.intData = 1
            call bf.apply()
            call BlzEndUnitAbilityCooldown(spellCaster,'S02H')
        endfunction

        function S03L_CHECK takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local integer loopC = de.loadInteger("LOOP")
            local real dmg = 5*I2R(GetUnitAttack(ds,0))/8
            local group pick = null 
            set loopC = loopC+1
            if GetUnitCurrentOrder(ds) == ORDER_cannibalize then 
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(ds),GetUnitY(ds),350,playerEnemy)
                loop
                    exitwhen FirstOfGroup(pick) == null
                    set damageFlag = 'S03L'
                    set damageIsAOE = true 
                    call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
                call DestroyGroup(pick)
            else 
                set loopC = 9999
            endif 
            if loopC >= 8 then 
                set de.DESTROY = true 
            endif 
            call de.saveInteger("LOOP",loopC)
            set pick = null 
        endfunction
        function S03L_ANIM_CHECK takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            if GetUnitCurrentOrder(ds) == ORDER_cannibalize then 
                call SetUnitAnimation(ds,"spin")
            else 
                set de.DESTROY = true 
            endif 
        endfunction
        function A655_DMGING_T takes nothing returns nothing
            if damageAttackType == ATTACK_TYPE_NORMAL then 
                set damageFinalDamage = damageFinalDamage*0.01
            endif 
        endfunction
        function SPELL_S03L takes nothing returns nothing
            local delayedevent de
            local real haste = 1
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_BERSERKER_SPELLIMMUNITY,3600)
            if unitGetBonusState(spellCaster,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))/10000
            endif 
            set de = delayedevent.create(R2I(50*haste),8,function S03L_CHECK)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveInteger("LOOP",0)
            set de = delayedevent.create(43,10,function S03L_ANIM_CHECK)
            call de.saveUnit("CASTER",spellCaster)
            call BlzSetAbilityRealLevelField(BlzGetUnitAbility(spellCaster,'S03L'),ABILITY_RLF_FOLLOW_THROUGH_TIME,0,400*haste/100+0.03)
            //call BlzSetAbilityRealLevelField(BlzGetUnitAbility(spellCaster,'S03L'),ABILITY_RLF_ART_DURATION,0,400*haste/100+0.03)
            call bf.addDmging_T(function A655_DMGING_T)
            call bf.apply()
        endfunction
        function SPELL_STOP_S03L takes nothing returns nothing
            local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_BERSERKER_SPELLIMMUNITY)
            set bf.DESTROY = true 
        endfunction

        function S03M_DELAY takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real dmg = 4*I2R(GetUnitAttack(de.loadUnit("CASTER"),0))
            local mybuff bf
            set damageFlag = 'S03M'
            call UnitDamageTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_HEAVY_CHOP)
            call HERO_3_SUPPRESS(de.loadUnit("CASTER"),4)
        endfunction
        function SPELL_S03M takes nothing returns nothing
            local delayedevent de = delayedevent.create(50,1,function S03M_DELAY)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\Devastate_RED.mdx",spellTarget,"origin"))
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
        endfunction
    // endregion

    // region druid 德鲁伊
    ////////////////
    //HEROID = 8(9)
    ////////////////
        globals 
            integer DRUID_STAR_SURGE_CHARGE = 0
            integer DRUID_MOON_PHASE = 0
            string array DRUID_ICON_PATH_STAR_SURGE_Q [9]
            string array DRUID_ICON_PATH_MOON_PHASE_W [6]
            string array DRUID_ICON_PATH_MOON_PHASE_E [6]
            string array DRUID_ICON_PATH_MOON_PHASE_R [6]
        endglobals
        function DruidRefreshAvatar takes unit whichUnit returns nothing
            local mybuff bf = mybuff.getUnitBuff(whichUnit,BUFFTYPE_DRUID_AVATAR)
            local integer iiii 
            if bf > 0 then 
                if bf.intData != heroNowForm[8] then 
                    set bf.intData = heroNowForm[8]
                    set bf.addTime = false 
                    set bf.lastTime = bf.lastTime
                    set iiii = bf.remainingTime
                    call DestroyEffectEX(bf.bindSFX)
                    if bf.intData == FORM_DRUID_NORMAL then 
                        set bf.bonusHeal = 3000
                        set bf.bonusCostReduce = 5000
                        set bf.bindSFX = AddSpecialEffectTargetEX("war3campImported\\Treeoflife.mdx",whichUnit,"origin")
                    elseif bf.intData == FORM_DRUID_BEAR then 
                        set bf.bonusLife_P = 3000
                        set bf.bindSFX = AddSpecialEffectTargetEX("war3campImported\\FurbolgTracker.mdx",whichUnit,"origin")
                    elseif bf.intData == FORM_DRUID_CAT then 
                        set bf.bonusCrit = 1500
                        set bf.bonusCritPower = 3000
                        set bf.bonusArmorPenetration = 10000
                        set bf.bindSFX = AddSpecialEffectTargetEX("war3campImported\\sabera.mdx",whichUnit,"origin")
                    elseif bf.intData == FORM_DRUID_MOONKIN then 
                        set bf.bonusCostReduce = 5000
                        set bf.bindSFX = AddSpecialEffectTargetEX("war3campImported\\ArakkoaF.mdx",whichUnit,"origin")
                    endif 
                    call bf.apply()
                    set bf.remainingTime = iiii 
                endif 
            endif 
        endfunction
        function DruidFormClear takes unit whichUnit,form whichForm returns nothing
            if whichForm != FORM_DRUID_BEAR then 
                set mybuff.getUnitBuff(whichUnit,BUFFTYPE_DRUID_BEARFORM).boolData = false 
                set mybuff.getUnitBuff(whichUnit,BUFFTYPE_DRUID_BEARFORM).DESTROY = true
                //call BJDebugMsg("BEAR_FORM_CLEAR")
            endif 
            if whichForm != FORM_DRUID_CAT then 
                set mybuff.getUnitBuff(whichUnit,BUFFTYPE_DRUID_CATFORM).boolData = false 
                set mybuff.getUnitBuff(whichUnit,BUFFTYPE_DRUID_CATFORM).DESTROY = true
                //call BJDebugMsg("BEAR_FORM_CLEAR")
            endif 
            if whichForm != FORM_DRUID_MOONKIN then 
                set mybuff.getUnitBuff(whichUnit,BUFFTYPE_DRUID_MOONKINFORM).boolData = false
                set mybuff.getUnitBuff(whichUnit,BUFFTYPE_DRUID_MOONKINFORM).DESTROY = true
                //call BJDebugMsg("BEAR_FORM_CLEAR")
            endif 
        endfunction
        function DRUID_FORM_END takes nothing returns nothing
            if mybuff.currentBuff.boolData == false then 
                return 
            endif 
            call heroDefaultForm[8].transform(mybuff.currentBuff.buffTarget)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\bianshen_deluyi.mdx",mybuff.currentBuff.buffTarget,"origin"))
            //call BJDebugMsg("BEAR_FORM_END")
        endfunction
        function DruidTransforming takes unit whichUnit returns nothing
            local mybuff bf 
            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,2) then 
                set bf = mybuff.create(whichUnit,whichUnit,BUFFTYPE_DRUID_FASTTRANSFORM)
                set bf.lastTime = 1200
                set bf.addTime = false 
                set bf.intData = IMinBJ(3,bf.intData+1)
                set bf.bonusStr_P = 500*bf.intData
                set bf.bonusAgi_P = 500*bf.intData
                set bf.bonusInt_P = 500*bf.intData
                call bf.apply()
                set bf = mybuff.create(whichUnit,whichUnit,BUFFTYPE_DRUID_TRANSFORMMASTER)
                set bf.lastTime = 3000
                call bf.apply()
            endif 
            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,6) then 
                
            endif 
        endfunction
        function DruidTransformToBear takes unit whichUnit returns nothing
            local mybuff bf 
            call DruidFormClear.evaluate(whichUnit,FORM_DRUID_BEAR)
            set bf = mybuff.create(whichUnit,whichUnit,BUFFTYPE_DRUID_BEARFORM)
            set bf.bonusLife_P = 5000
            set bf.bonusArmor_P = 10000
            set bf.lastTime = 2000
            call bf.addEnding(function DRUID_FORM_END)
            set bf.boolData = true 
            call bf.apply()
            if FORM_DRUID_BEAR.transform(whichUnit) == true then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\bianshen_deluyi.mdx",whichUnit,"origin"))
                call DruidTransforming.evaluate(whichUnit)
                call BlzSetUnitIntegerField(whichUnit,UNIT_IF_FORMATION_RANK,0)
            endif 
            call DruidRefreshAvatar.evaluate(whichUnit)
        endfunction
        function DruidTransformToCat takes unit whichUnit returns nothing
            local mybuff bf 
            call DruidFormClear.evaluate(whichUnit,FORM_DRUID_CAT)
            set bf = mybuff.create(whichUnit,whichUnit,BUFFTYPE_DRUID_CATFORM)
            set bf.bonusAttack_P = 1000
            set bf.lastTime = 2000
            call bf.addEnding(function DRUID_FORM_END)
            set bf.boolData = true 
            call bf.apply()
            if FORM_DRUID_CAT.transform(whichUnit) == true then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\bianshen_deluyi.mdx",whichUnit,"origin"))
                call DruidTransforming.evaluate(whichUnit)
                call BlzSetUnitIntegerField(whichUnit,UNIT_IF_FORMATION_RANK,1)
            endif 
            call DruidRefreshAvatar.evaluate(whichUnit)
        endfunction
        function MOONKIN_FORM_DAMAGING_SOURCE takes nothing returns nothing
            if damageAttackType == ATTACK_TYPE_NORMAL then 
                set damageFinalDamage = damageFinalDamage*1.1
            endif 
        endfunction
        function DruidTransformToMoonkin takes unit whichUnit returns nothing
            local mybuff bf 
            call DruidFormClear.evaluate(whichUnit,FORM_DRUID_MOONKIN)
            set bf = mybuff.create(whichUnit,whichUnit,BUFFTYPE_DRUID_MOONKINFORM)
            call bf.addDmging_S(function MOONKIN_FORM_DAMAGING_SOURCE)
            set bf.lastTime = 2000
            call bf.addEnding(function DRUID_FORM_END)
            set bf.boolData = true 
            call bf.apply()
            if FORM_DRUID_MOONKIN.transform(whichUnit) == true then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\bianshen_deluyi.mdx",whichUnit,"origin"))
                call DruidTransforming.evaluate(whichUnit)
                call BlzSetUnitIntegerField(whichUnit,UNIT_IF_FORMATION_RANK,2)
            endif 
            call DruidRefreshAvatar.evaluate(whichUnit)
            call DruidCheckMoonPhase.execute()
        endfunction
        function DruidTransformToOrigin takes unit whichUnit returns nothing
            call DruidFormClear.evaluate(whichUnit,0)
            call BlzSetUnitIntegerField(whichUnit,UNIT_IF_FORMATION_RANK,2)
            if FORM_DRUID_NORMAL.transform(whichUnit) == true then 
                call DruidTransforming.evaluate(whichUnit)
            endif 
            call DruidRefreshAvatar.evaluate(whichUnit)
        endfunction
        function DruidCheckStarSurgeCharge takes nothing returns nothing
            if DRUID_STAR_SURGE_CHARGE > 0 and heroNowForm[8] == FORM_DRUID_MOONKIN and HeroHaveTalent(hero[8],HERO_PRIVATE_TALENT,8) == false then 
                call BlzSetAbilityTooltip('S01Y',"星涌术",0)
                call BlzSetAbilityExtendedTooltip('S01Y',"|cffadadff可在攻击时自动释放\n取消攻击|r\n释放涌动的星辰能量，对目标造成|cffffcc00法术强度×2|r的法术伤害。\n|cff888888自然、奥术|r",0)
                call BlzSetAbilityActivatedIcon('S01Y',DRUID_ICON_PATH_STAR_SURGE_Q[DRUID_STAR_SURGE_CHARGE])
            else 
                call BlzSetAbilityTooltip('S01Y',"愤怒",0)
                call BlzSetAbilityExtendedTooltip('S01Y',"|cffadadff可在攻击时自动释放\n取消攻击|r\n变为枭兽，释放自然能量打击目标，对目标造成|cffffcc00法术强度×1|r的法术伤害。\n如果因此从其他形态变为枭兽，愤怒会进入|cff1eff006秒|r的冷却时间。\n|cff888888变形、枭兽、自然|r",0)
                call BlzSetAbilityActivatedIcon('S01Y',"ReplaceableTextures\\CommandButtonsAuto\\BTNwrath.blp")
            endif 
        endfunction
        function DruidCheckMoonPhase takes nothing returns nothing
            local mybuff bf = mybuff.getUnitBuff(hero[8],BUFFTYPE_DRUID_MOONKINFORM)
            if DRUID_MOON_PHASE > 5 then 
                set DRUID_MOON_PHASE = 0
            endif 
            call BlzSetAbilityIcon('S021',DRUID_ICON_PATH_MOON_PHASE_W[DRUID_MOON_PHASE])
            call BlzSetAbilityIcon('S026',DRUID_ICON_PATH_MOON_PHASE_E[DRUID_MOON_PHASE])
            call BlzSetAbilityIcon('S02C',DRUID_ICON_PATH_MOON_PHASE_R[DRUID_MOON_PHASE])
            if bf == 0 then 
                return 
            endif 
            if mybuff.getUnitBuff(hero[8],BUFFTYPE_DRUID_AVATAR) > 0 then 
                set bf.bonusManaRegen = 10*UnitLevel(hero[8])+100
                set bf.bonusCrit = 1500
            else 
                if DRUID_MOON_PHASE == 0 or DRUID_MOON_PHASE == 4 then 
                    set bf.bonusManaRegen = 3*UnitLevel(hero[8])+33
                    set bf.bonusCrit = 1000
                endif 
                if DRUID_MOON_PHASE == 1 or DRUID_MOON_PHASE == 3 then 
                    set bf.bonusManaRegen = 6*UnitLevel(hero[8])+66
                    set bf.bonusCrit = 500
                endif 
                if DRUID_MOON_PHASE == 2 then 
                    set bf.bonusManaRegen = 10*UnitLevel(hero[8])+100
                endif 
                if DRUID_MOON_PHASE == 5 then 
                    set bf.bonusCrit = 1500
                endif 
            endif 
            set bf.needRefreshState = true 
        endfunction
        function DruidChangeMoonPhase takes nothing returns nothing
            local mybuff bf
            
            set DRUID_MOON_PHASE = DRUID_MOON_PHASE+1

            if DRUID_MOON_PHASE == 2 then 
                set DRUID_STAR_SURGE_CHARGE = DRUID_STAR_SURGE_CHARGE+3
                call DruidCheckStarSurgeCharge.execute()
            endif 
            if DRUID_MOON_PHASE == 5 then 
                set DRUID_STAR_SURGE_CHARGE = DRUID_STAR_SURGE_CHARGE+3
                call DruidCheckStarSurgeCharge.execute()
            endif
            call DruidCheckMoonPhase.execute()

            if (DRUID_MOON_PHASE == 0 or DRUID_MOON_PHASE == 4) and HeroHaveTalent(hero[8],HERO_ULTIMATE_TALENT,9) then
                set bf = mybuff.create(hero[8],hero[8],BUFFTYPE_DRUID_CMOON)
                set bf.bonusHaste = 30000
                set bf.lastTime = 300
                call bf.apply()
            endif 
        endfunction
        function S01V_AOE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),175,playerEnemy)
            call GroupRemoveUnit(pick,dt)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'S01V'
                set damageIsAOE = true 
                call UnitDamageTarget(ds,FirstOfGroup(pick),I2R(GetUnitAttack(ds,0))*1.8,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_HEAVY_BASH)
                call Taunt(ds,FirstOfGroup(pick))
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(dt),GetUnitY(dt)))
            call DestroyGroup(pick)
            set pick = null 
            set ds = null 
            set dt = null 
        endfunction
        function S01V_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local delayedevent de 
            set damageFlag = 'S01V'
            call UnitDamageTarget(proj.source,proj.target,I2R(GetUnitAttack(proj.source,0))*1.4,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_HEAVY_BASH)
            call Taunt(proj.source,proj.target)
            call SetUnitAnimation(proj.source,"stand")
            call SetUnitTimeScale(proj.source,1)
            if mybuff.getUnitBuff(proj.source,BUFFTYPE_DRUID_TRANSFORMMASTER) > 0 then 
                set mybuff.getUnitBuff(proj.source,BUFFTYPE_DRUID_TRANSFORMMASTER).DESTROY = true 
                set de = delayedevent.create(1,1,function S01V_AOE)
                call de.saveUnit("CASTER",proj.source)
                call de.saveUnit("TARGET",proj.target)
            endif 
        endfunction
        function RAKE_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*0.6/3*mybuff.buffTimeScale*bf.realData
            set damageTag_Bleed = true 
            set damageIsDOT = true 
            set damageFlag = 'A623'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S01X_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local mybuff bf 
            set damageFlag = 'S01X'
            call UnitDamageTarget(proj.source,proj.target,I2R(GetUnitAttack(proj.source,0))*1.1,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_MEDIUM_BASH)
            set bf = mybuff.create(proj.source,proj.target,BUFFTYPE_DRUID_RAKE)
            set bf.lastTime = 600
            set bf.periodTime = 200
            call bf.addPeriod(function RAKE_DOT)
            set bf.hasteAble = true 
            set bf.realData = 1+bf.realData*(I2R(bf.remainingTime)/I2R(bf.lastTime))
            if mybuff.getUnitBuff(proj.source,BUFFTYPE_DRUID_TRANSFORMMASTER) > 0 then 
                set mybuff.getUnitBuff(proj.source,BUFFTYPE_DRUID_TRANSFORMMASTER).DESTROY = true 
                set bf.realData = bf.realData+1
            endif 
            call bf.apply()
        endfunction
        function S01Y_HIT takes nothing returns nothing
            local projectile proj 
            local unit ds = projectile.currentProjectile.source
            local unit dt = projectile.currentProjectile.target
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Earth = true 
            set damageFlag = 'S01Y'
            call UnitDamageTarget(ds,dt,I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            set ds = null 
            set dt = null 
        endfunction
        function DRUID_WITHERBLOOM_HEAL takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            call proj.applyHealSet()
            set healIsDOT = true 
            set healFlag = 'S02G'
            call UnitHealTarget(proj.source,proj.target,I2R(unitGetAllBonusStateValue(proj.source,STATE_ABILITY_POWER))*0.5*proj.realData)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\NatureHeal017.mdx",proj.target,"origin"))
        endfunction
        function DRUID_WITHERBLOOM_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*2/8*mybuff.buffTimeScale*bf.realData
            local group pick 
            local unit healTar 
            local projectile proj 
            local real x 
            local real y 
            local real X 
            local real Y
            local real a 
            local real b 
            local real c 
            local real d 
            set damageIsDOT = true 
            set damageFlag = 'A624'
            set damageTag_Earth = true 
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            set pick = CreateGroup()
            set healTar = null 
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(bf.buffTarget),GetUnitY(bf.buffTarget),900,playerAlly)
            set healTar = GetUnitWithLowestHealthPct(pick)
            if healTar != null then 
                set proj = projectile.create(bf.buffSource)
                set proj.LAUNCH_LOC = true 
                set proj.TARGET_UNIT = true 
                set x = GetUnitX(bf.buffTarget)
                set y = GetUnitY(bf.buffTarget)
                set proj.source_x = x
                set proj.source_y = y 
                set proj.start_z = GetUnitFlyHeight(bf.buffTarget)
                set X = GetUnitX(healTar)
                set Y = GetUnitY(healTar)
                set a = GetRandomReal(60,90)
                if GetRandomReal(0,1) < 0.5 then 
                    set a = 0-a
                endif 
                set b = GetRandomReal(150,200)
                set c = GetRandomReal(200,250)
                if a < 0 then 
                    set c = 0-c
                endif 
                set d = RMinBJ(GetRandomReal(300,400),DisByXY(x,y,X,Y))
                set a = a+GetUnitFacing(bf.buffTarget)
                set c = c+GetUnitFacing(bf.buffTarget)
                set proj.model_path = "war3campImported\\leechseed_missle_straight_smaller.mdx"
                set proj.speed = 550
                set proj.curve = GetRandomReal(0.1,0.2)
                set proj.bezier_points = 2
                set proj.bezier_x0 = x+b*Cos(a/57.2956)
                set proj.bezier_x1 = proj.bezier_x0+d*Cos(c/57.2956)
                set proj.bezier_y0 = y+b*Sin(a/57.2956)
                set proj.bezier_y1 = proj.bezier_y0+d*Cos(c/57.2956)
                set proj.target = healTar
                call proj.addOnHit(function DRUID_WITHERBLOOM_HEAL)
                set proj.flag = 'S01W'
                set proj.realData = mybuff.buffTimeScale*bf.realData
                call proj.launch()
            endif 
            call DestroyGroup(pick)
            set pick = null 
            set healTar = null
        endfunction
        function S02G_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local mybuff bf 
            local unit ds = proj.source
            local unit dt = proj.target
            call proj.applyDamageSet()
            set damageTag_Earth = true 
            set damageFlag = 'S02G'
            call UnitDamageTarget(ds,dt,I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1.2,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            set bf = mybuff.create(ds,dt,BUFFTYPE_DRUID_WITHERBLOOM)
            set bf.lastTime = 800
            set bf.periodTime = 100
            call bf.addPeriod(function DRUID_WITHERBLOOM_DOT)
            set bf.realData = proj.bounceMultiplier
            set bf.hasteAble = true 
            call bf.apply()
            set ds = null 
            set dt = null 
        endfunction
        function B626_HIT takes nothing returns nothing
            local projectile proj 
            local unit ds = projectile.currentProjectile.source
            local unit dt = projectile.currentProjectile.target
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Earth = true 
            set damageTag_Arcane = true 
            set damageFlag = 'B626'
            call UnitDamageTarget(ds,dt,I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*2,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            set ds = null 
            set dt = null 
        endfunction
        function HERO_9_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 5.4
            local real a 
            local real d 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B623') > 0 then 
                call UnitRemoveAbility(dt,'B623')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S01V'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                call DruidTransformToBear.evaluate(spellCaster)
                if DisByUnits(spellCaster,spellTarget) > 101+BlzGetUnitCollisionSize(spellCaster)+BlzGetUnitCollisionSize(spellTarget) then 
                    //call BJDebugMsg("DASH")
                    set damageDamage = 0
                    call BlzSetEventWeaponType(WEAPON_TYPE_WHOKNOWS)
                    set proj = projectile.create(spellCaster)
                    set proj.target = spellTarget
                    set proj.speed = 1200
                    set proj.TARGET_UNIT = true 
                    set proj.LAUNCH_UNIT = true 
                    call proj.addOnHit(function S01V_HIT)
                    set proj.attachDistance = 100
                    set proj.ifCheckPath = true 
                    call proj.launchWithDummy(spellCaster,false)
                    call SetUnitAnimationByIndex(spellCaster,2)
                    call SetUnitTimeScale(spellCaster,1.5)
                else 
                    if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,1) then 
                        set damageAddAccuracy = damageAddAccuracy+0.3
                    endif 
                    set damageDamage = damageDamage*1.4
                    set damageFlag = 'S01V'
                    call BlzSetEventWeaponType(WEAPON_TYPE_WOOD_HEAVY_BASH)
                    call Taunt(spellCaster,spellTarget)
                    if mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_TRANSFORMMASTER) > 0 then 
                        set mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_TRANSFORMMASTER).DESTROY = true 
                        set de = delayedevent.create(1,1,function S01V_AOE)
                        call de.saveUnit("CASTER",spellCaster)
                        call de.saveUnit("TARGET",spellTarget)
                    endif 
                endif 
                if damageIsMelee == false then 
                    set attackingMissile.DESTROY = true 
                endif 
                call AddUnitMana(spellCaster,0.01*GetUnitState(spellCaster,UNIT_STATE_MAX_MANA))

                if mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_AVATAR) == 0 then 
                    call BlzStartUnitAbilityCooldown(spellCaster,'S01V',Qcd*haste-0.01)
                endif 

                
            endif
            if GetUnitAbilityLevel(dt,'B628') > 0 then 
                call UnitRemoveAbility(dt,'B628')
                set Qcd = 4.8
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S01X'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                call DruidTransformToCat.evaluate(spellCaster)
                if DisByUnits(spellCaster,spellTarget) > 101+BlzGetUnitCollisionSize(spellCaster)+BlzGetUnitCollisionSize(spellTarget) then 
                    //call BJDebugMsg("DASH")
                    set damageDamage = 0
                    call BlzSetEventWeaponType(WEAPON_TYPE_WHOKNOWS)
                    set proj = projectile.create(spellCaster)
                    set proj.target = spellTarget
                    set proj.speed = 1200
                    set proj.TARGET_UNIT = true 
                    set proj.LAUNCH_UNIT = true 
                    call proj.addOnHit(function S01X_HIT)
                    set proj.curve = 0.15
                    set proj.ifCheckPath = true 
                    set proj.attachDistance = 100
                    call proj.launchWithDummy(spellCaster,false)
                    call SetUnitAnimation(spellCaster,"attack slam")
                else 
                    set damageDamage = damageDamage*1.1
                    set damageFlag = 'S01X'
                    call BlzSetEventWeaponType(WEAPON_TYPE_WOOD_MEDIUM_BASH)
                    set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_DRUID_RAKE)
                    set bf.lastTime = 600
                    set bf.periodTime = 200
                    call bf.addPeriod(function RAKE_DOT)
                    set bf.hasteAble = true 
                    set bf.realData = 1+bf.realData*(I2R(bf.remainingTime)/I2R(bf.lastTime))
                    if mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_TRANSFORMMASTER) > 0 then 
                        set mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_TRANSFORMMASTER).DESTROY = true 
                        set bf.realData = bf.realData+1
                    endif 
                    call bf.apply()
                endif 
                if damageIsMelee == false then 
                    set attackingMissile.DESTROY = true 
                endif 

                call BlzStartUnitAbilityCooldown(spellCaster,'S01X',Qcd*haste-0.01)

                
            endif
            if GetUnitAbilityLevel(dt,'B629') > 0 then 
                call UnitRemoveAbility(dt,'B629')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S01Y'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = 0
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                set Qcd = 6
                
                call Cast.execute()

                if heroNowForm[8] != FORM_DRUID_MOONKIN then 
                    call BlzStartUnitAbilityCooldown(spellCaster,'S01Y',Qcd*haste-0.01)
                endif 
                call DruidTransformToMoonkin.evaluate(spellCaster)
                if damageIsMelee == true then 
                    set damageTag_Attack = false
                    set damageFlag = 'S01Y'
                    set damageTag_Arcane = true 
                    set damageTag_Earth = true 
                    set damageDamage = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*1
                    call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\MoonWrath.mdx",spellTarget,"origin"))
                else 
                    if DRUID_STAR_SURGE_CHARGE > 0 and heroNowForm[8] == FORM_DRUID_MOONKIN and HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,8) == false then 
                        set attackingMissile.model_path = "war3campImported\\moonspear.mdx"  
                        set attackingMissile.tag_Earth = true 
                        set attackingMissile.tag_Arcane = true 
                        set attackingMissile.curve = 0 
                        set attackingMissile.speed = 1000
                        set attackingMissile.flag = 'B626'
                        call attackingMissile.addOnHit(function B626_HIT)
                        set DRUID_STAR_SURGE_CHARGE = DRUID_STAR_SURGE_CHARGE-1
                        call DruidCheckStarSurgeCharge.execute()
                    else 
                        set attackingMissile.model_path = "war3campImported\\fennu_smaller.mdx"  
                        set attackingMissile.tag_Earth = true 
                        set attackingMissile.curve = 0 
                        set attackingMissile.speed = 1000
                        set attackingMissile.flag = 'S01Y'
                        call attackingMissile.addOnHit(function S01Y_HIT)
                    endif 
                endif 
                if mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_TRANSFORMMASTER) > 0 then 
                    set mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_TRANSFORMMASTER).DESTROY = true 
                    set DRUID_STAR_SURGE_CHARGE = DRUID_STAR_SURGE_CHARGE+1
                    call DruidCheckStarSurgeCharge.execute()
                endif 

                
            endif

            set ds = null 
            set dt = null 
        endfunction
        function BARSKIN_DAMAGING_TARGET takes nothing returns nothing
            if damageSource == damageTarget then 
                return 
            endif 
            set damageFinalDamage = damageFinalDamage*(1-0.2*mybuff.currentBuff.realData)
        endfunction
        function SPELL_S01Z takes nothing returns nothing       //树甲
            local mybuff bf
            if spellTarget == null then 
                set spellTarget = spellCaster
            endif 
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_DRUID_BARSKIN)
            set bf.lastTime = 2000
            set bf.realData = 1
            call bf.addDmging_T(function BARSKIN_DAMAGING_TARGET)
            call bf.apply()
        endfunction
        function S020_HIT_1 takes nothing returns nothing
            local mybuff bf
            local projectile proj = projectile.currentProjectile
            set bf = mybuff.create(proj.source,proj.target,BUFFTYPE_DRUID_BARSKIN)
            set bf.lastTime = 2000
            set bf.realData = 0.5
            call bf.addDmging_T(function BARSKIN_DAMAGING_TARGET)
            call bf.apply()
            set bf = mybuff.create(proj.source,proj.source,BUFFTYPE_DRUID_BARSKIN)
            set bf.lastTime = 2000
            set bf.realData = 0.5
            call bf.addDmging_T(function BARSKIN_DAMAGING_TARGET)
            call bf.apply()
        endfunction
        function S020_HIT_2 takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            set damageFlag = 'S020'
            call UnitDamageTarget(proj.source,proj.target,I2R(GetUnitAttack(proj.source,0))*1.8,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_HEAVY_BASH)
            call Taunt(proj.source,proj.target)
            call SetUnitAnimation(proj.source,"stand")
            call SetUnitTimeScale(proj.source,1)
            call applySnare(proj.source,proj.target,'ASN1')
        endfunction
        function WILD_RUSH_BLEED_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*3/10*mybuff.buffTimeScale
            set damageTag_Bleed = true 
            set damageIsDOT = true 
            set damageFlag = 'A626'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S020_HIT_3 takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local mybuff bf 
            set damageFlag = 'S020'
            call UnitDamageTarget(proj.source,proj.target,I2R(GetUnitAttack(proj.source,0))*2,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_MEDIUM_BASH)
            set bf = mybuff.create(proj.source,proj.target,BUFFTYPE_DRUID_WILDRUSHBLEED)
            set bf.lastTime = 2000
            set bf.periodTime = 200
            call bf.addPeriod(function WILD_RUSH_BLEED_DOT)
            set bf.hasteAble = true 
            call bf.apply()
            call applySilence(proj.source,proj.target,'ASI0')
        endfunction
        function SPELL_S020 takes nothing returns nothing       //野性冲锋
            local projectile proj 
            if heroNowForm[8] == FORM_DRUID_NORMAL then 
                set proj = projectile.create(spellCaster)
                set proj.speed = 1200
                set proj.LAUNCH_UNIT = true 
                set proj.TARGET_UNIT = true 
                set proj.target = spellTarget
                call proj.addOnHit(function S020_HIT_1)
                set proj.ifFaceTarget = false 
                set proj.ifCheckPath = true 
                set proj.attachDistance = 30
                set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\yexingchongfeng.mdx",spellCaster,"chest")
                call proj.launchWithDummy(spellCaster,false)
                call BlzSetSpecialEffectTimeScale(proj.bindSFX_0,1.5)
            elseif heroNowForm[8] == FORM_DRUID_BEAR then 
                set proj = projectile.create(spellCaster)
                set proj.target = spellTarget
                set proj.speed = 1200
                set proj.TARGET_UNIT = true 
                set proj.LAUNCH_UNIT = true 
                call proj.addOnHit(function S020_HIT_2)
                set proj.attachDistance = 100
                set proj.ifCheckPath = true 
                call proj.launchWithDummy(spellCaster,false)
                call SetUnitAnimationByIndex(spellCaster,2)
                call SetUnitTimeScale(spellCaster,1.5)
            elseif heroNowForm[8] == FORM_DRUID_CAT then 
                set proj = projectile.create(spellCaster)
                set proj.target = spellTarget
                set proj.speed = 1200
                set proj.TARGET_UNIT = true 
                set proj.LAUNCH_UNIT = true 
                call proj.addOnHit(function S020_HIT_3)
                set proj.curve = 0.15
                set proj.ifCheckPath = true 
                set proj.attachDistance = 100
                call proj.launchWithDummy(spellCaster,false)
                call SetUnitAnimation(spellCaster,"attack slam")
            elseif heroNowForm[8] == FORM_DRUID_MOONKIN then 
                set proj = projectile.create(spellCaster)
                set proj.speed = 1200
                set proj.LAUNCH_UNIT = true 
                set proj.TARGET_UNIT = true 
                set proj.target = spellTarget
                set proj.ifFaceTarget = false 
                set proj.ifCheckPath = true 
                set proj.attachDistance = 30
                call proj.launchWithDummy(spellCaster,false)
                set DRUID_STAR_SURGE_CHARGE = IMinBJ(9,DRUID_STAR_SURGE_CHARGE+3)
                set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\yexingchongfeng.mdx",spellCaster,"chest")
                call DruidCheckStarSurgeCharge.execute()
                call BlzSetSpecialEffectTimeScale(proj.bindSFX_0,1.5)
            endif
        endfunction
        function STAR_FIRE_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*2.7/9*mybuff.buffTimeScale
            set damageIsDOT = true 
            set damageFlag = 'A627'
            set damageTag_Arcane = true 
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S021 takes nothing returns nothing       //星火术
            local group pick 
            local real dmg = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*3.5
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,10) and (heroNowForm[8] == FORM_DRUID_BEAR or heroNowForm[8] == FORM_DRUID_CAT) then 
                if heroNowForm[8] == FORM_DRUID_BEAR then 
                    call DruidTransformToBear.evaluate(spellCaster)
                else 
                    call DruidTransformToCat.evaluate(spellCaster)
                endif 
            else 
                call DruidTransformToMoonkin.evaluate(spellCaster)
            endif 
            set damageTag_Arcane = true 
            set damageFlag = 'S021'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DruidChangeMoonPhase.execute()
            call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\Starfall\\StarfallCaster.mdl",spellTarget,"origin"),150)
        endfunction
        function SPELL_S022 takes nothing returns nothing       //横扫
            local group pick = CreateGroup()
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real dmg = I2R(GetUnitMaxAttack(spellCaster,0))
            if heroNowForm[8] == FORM_DRUID_CAT then
                call DruidTransformToCat.evaluate(spellCaster)
                call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\deluyiCATSlamSFX.mdx",spellCaster,"origin"),88)
                call GroupEnumUnitsInRangeEx(pick,x,y,400,playerEnemy)
                call GroupAddUnit(pick,spellTarget)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    if FirstOfGroup(pick) == spellTarget or Cos((AngleByUnits(spellCaster,FirstOfGroup(pick))-AngleByUnits(spellCaster,spellTarget))/57.2956) > 0.5 then 
                        set damageIsAOE = true 
                        set damageFlag = 'S022'
                        call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg*3,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_MEDIUM_BASH)
                        call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",FirstOfGroup(pick),"chest"))
                    endif 
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
            else 
                call DruidTransformToBear.evaluate(spellCaster)
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\zhuaji.mdx",spellCaster,"origin"))
                call GroupEnumUnitsInRangeEx(pick,x,y,250,playerEnemy)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    set damageIsAOE = true 
                    set damageFlag = 'S022'
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg*2,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_HEAVY_BASH)
                    call Taunt(spellCaster,FirstOfGroup(pick))
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",FirstOfGroup(pick),"chest"))
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
            endif 
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S023 takes nothing returns nothing       //铁鬃
            local mybuff bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_DRUID_IRONFUR)
            set bf.lastTime = 800
            set bf.bonusArmor = 2*GetUnitLevel(spellCaster)
            set bf.bonusMaxArmor = 1000
            call bf.apply()
            call DruidTransformToBear.evaluate(spellCaster)
        endfunction
        function REGROWTH_HOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = bf.realData*2.7*I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))/9*mybuff.buffTimeScale
            set healIsDOT = true 
            set healFlag = 'A629'
            call UnitHealTarget(bf.buffSource,bf.buffTarget,dmg)
        endfunction
        function SPELL_S024 takes nothing returns nothing       //愈合
            local mybuff bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_DRUID_REGROWTH)
            set bf.realData = 1
            set bf.lastTime = 1800
            set bf.periodTime = 200
            call bf.addPeriod(function REGROWTH_HOT)
            call bf.apply()
            call DruidTransformToOrigin.evaluate(spellCaster)
            set healFlag = 'S024'
            call UnitHealTarget(spellCaster,spellTarget,2*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER)))
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\NatureHeal017.mdx",spellTarget,"origin"))
            call bufflist.listUnitBuffs(spellTarget,false,true,true)
            call bufflist.dispelMultiBuffs(1)
        endfunction
        function SPELL_S025 takes nothing returns nothing       //咆哮
            local group pick = CreateGroup()
            local mybuff bf
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),450,playerAlly)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_DRUID_ROAR)
                set bf.lastTime = 800
                set bf.bonusMoveSpeed_P = 2500
                set bf.bonusAttack_P = 2500
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            if heroNowForm[8] == FORM_DRUID_BEAR then 
                call DruidTransformToBear.evaluate(spellCaster)
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),450,playerEnemy)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    call Taunt(spellCaster,FirstOfGroup(pick))
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
            else 
                call DruidTransformToCat.evaluate(spellCaster)
            endif 
            call DestroyGroup(pick)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl",spellCaster,"origin"))
            set pick = null 
        endfunction
        function S026_HIT takes nothing returns nothing
            local real dmg = I2R(unitGetAllBonusStateValue(waveCaster,STATE_ABILITY_POWER))*3
            if IsUnitEnemy(waveTarget,PLAYER) then 
                set damageTag_Arcane = true 
                set damageIsAOE = true 
                set damageFlag = 'S026'
                set damageAddCrit = damageAddCrit+waveWave.realData
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            endif 
        endfunction
        function S026_DEATH takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            call delayedDestroyEffect(AddSpecialEffectEX(proj.model_path,GetUnitX(proj.dummy),GetUnitY(proj.dummy)),60)
        endfunction
        function SPELL_S026 takes nothing returns nothing       //月之怒
            local projectile proj = projectile.create(spellCaster)
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real X = spellTargetX
            local real Y = spellTargetY
            local real a = AngleByXY(x,y,X,Y)/57.2956
            set proj.LAUNCH_UNIT = true 
            set proj.TARGET_LOC = true 
            set proj.IS_WAVE = true 
            set proj.model_path = "war3campImported\\yueguangshexian.mdl"
            set proj.Wave_Radius_Start = 150
            set proj.realData = 0
            set proj.Wave_Radius_Add = 0
            set proj.speed = 900
            set proj.model_attach = "origin" 
            set proj.target_x = x+700*Cos(a)
            set proj.target_y = y+700*Sin(a)
            call proj.addOnHit(function S026_HIT)
            call proj.addOnEnd(function S026_DEATH)
            call proj.launch()
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,10) and (heroNowForm[8] == FORM_DRUID_BEAR or heroNowForm[8] == FORM_DRUID_CAT) then 
                if heroNowForm[8] == FORM_DRUID_BEAR then 
                    call DruidTransformToBear.evaluate(spellCaster)
                else 
                    call DruidTransformToCat.evaluate(spellCaster)
                endif 
            else 
                call DruidTransformToMoonkin.evaluate(spellCaster)
            endif 
            call DruidChangeMoonPhase.execute()
        endfunction
        function ENTANGLINGROOT_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*3.2/4*mybuff.buffTimeScale*bf.realData
            set damageTag_Earth = true 
            set damageIsDOT = true 
            set damageFlag = 'A62B'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S027 takes nothing returns nothing       //纠缠根须
            local mybuff bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_DRUID_ENTANGLINGROOT)
            set bf.lastTime = 800
            set bf.periodTime = 200
            call bf.addPeriod(function ENTANGLINGROOT_DOT)
            set bf.bonusMoveSpeed_P = -3000
            set bf.hasteAble = true 
            set bf.realData = 1
            call bf.apply()
            call applyRoot(spellCaster,spellTarget,'AET0')
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,10) and (heroNowForm[8] == FORM_DRUID_BEAR or heroNowForm[8] == FORM_DRUID_CAT) then 
                if heroNowForm[8] == FORM_DRUID_BEAR then 
                    call DruidTransformToBear.evaluate(spellCaster)
                else 
                    call DruidTransformToCat.evaluate(spellCaster)
                endif 
            else 
                if heroNowForm[8] != FORM_DRUID_NORMAL and heroNowForm[8] != FORM_DRUID_MOONKIN then 
                    call DruidTransformToOrigin.evaluate(spellCaster)
                endif 
            endif 
        endfunction
        function DRUID_TEAR_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*4.8/12*mybuff.buffTimeScale*bf.realData
            set damageTag_Bleed = true 
            set damageIsDOT = true 
            set damageFlag = 'A62C'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S028 takes nothing returns nothing       //撕裂
            local mybuff bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_DRUID_TEAR)
            local integer iiii = bf.remainingTime
            set bf.lastTime = 2400
            set bf.periodTime = 200
            set bf.hasteAble = true 
            call bf.addPeriod(function DRUID_TEAR_DOT)
            call bf.apply()
            set bf.realData = 1+bf.realData*(I2R(iiii)/I2R(bf.lastTime))
            call DruidTransformToCat.evaluate(spellCaster)
        endfunction
        function FRENZIED_REGENERATION_HOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = 0.3*GetUnitState(bf.buffTarget,UNIT_STATE_MAX_LIFE)/6*mybuff.buffTimeScale*bf.realData
            set healIsDOT = true 
            set healFlag = 'A62D'
            call UnitHealTarget(bf.buffSource,bf.buffTarget,dmg)
        endfunction
        function SPELL_S029 takes nothing returns nothing       //狂暴回复
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_FRENZIEDREGENERATION)
            set bf.lastTime = 300
            set bf.periodTime = 50
            set bf.realData = 1
            set bf.hasteAble = true 
            call bf.addPeriod(function FRENZIED_REGENERATION_HOT)
            call bf.apply()
            call DruidTransformToBear.evaluate(spellCaster)
        endfunction
        function WILD_GROWTH_HOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = 1.6*I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))/7*mybuff.buffTimeScale*bf.realData
            set healIsDOT = true 
            set healFlag = 'A62E'
            call UnitHealTarget(bf.buffSource,bf.buffTarget,dmg)
            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,5) then 
                set bf.realData = RMaxBJ(0.4,bf.realData-0.15)
            else 
                set bf.realData = RMaxBJ(0.4,bf.realData-0.2)
            endif 
        endfunction
        function SPELL_S02A takes nothing returns nothing       //野性成长
            local mybuff bf 
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,250,playerAlly)
            loop 
                exitwhen FirstOfGroup(pick) == null
                set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_DRUID_WILDGROWTH)
                set bf.lastTime = 700
                set bf.periodTime = 100
                set bf.realData = 1.6
                set bf.hasteAble = true 
                call bf.addPeriod(function WILD_GROWTH_HOT)
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DruidTransformToOrigin.evaluate(spellCaster)
        endfunction
        function SPELL_S02B takes nothing returns nothing       //凶残撕咬
            local real dmg = I2R(GetUnitAttack(spellCaster,0))*4
            set damageFlag = 'S02B'
            if mybuff.getUnitBuff(spellTarget,BUFFTYPE_DRUID_RAKE) > 0 or mybuff.getUnitBuff(spellTarget,BUFFTYPE_DRUID_TEAR) > 0 or mybuff.getUnitBuff(spellTarget,BUFFTYPE_DRUID_WILDRUSHBLEED) > 0 then 
                set damageAddCrit = damageAddCrit+0.3
            endif 
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_MEDIUM_BASH)
            call DruidTransformToCat.evaluate(spellCaster)
        endfunction
        function STAR_FALL_DELAYED_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit source = de.loadUnit("SOURCE")
            local real dmg = de.loadReal("DAMAGE")
            local real crit = de.loadReal("CRIT")
            local group pick = de.loadGroup("GROUP")
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'S02C'
                set damageIsAOE = true 
                set damageTag_Arcane = true 
                set damageTag_Earth = true 
                set damageAddCrit = damageAddCrit+crit 
                call UnitDamageTarget(source,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set source = null 
            set pick = null 
        endfunction
        function STAR_FALL_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local group pick = CreateGroup()
            local group pick2 = CreateGroup()
            local delayedevent de = delayedevent.create(75,1,function STAR_FALL_DELAYED_DAMAGE)
            local real dmg = I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*4.5/4*mybuff.buffTimeScale
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(bf.buffSource),GetUnitY(bf.buffSource),900,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if inCombat(FirstOfGroup(pick)) or DisByUnits(FirstOfGroup(pick),bf.buffSource) < 450+BlzGetUnitCollisionSize(bf.buffSource)+BlzGetUnitCollisionSize(FirstOfGroup(pick)) then
                    call GroupAddUnit(pick2,FirstOfGroup(pick))
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdl",FirstOfGroup(pick),"origin"))
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            call de.saveGroup("GROUP",pick2)
            call de.saveReal("DAMAGE",dmg)
            call de.saveReal("CRIT",0)
            call de.saveUnit("SOURCE",bf.buffSource)
            set pick = null 
            set pick2 = null 
        endfunction
        function SPELL_S02C takes nothing returns nothing       //星辰坠落
            local mybuff bf 
            local group pick 
            local group pick2
            local delayedevent de 
            local real dmg 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_STARFALL)
            set bf.lastTime = 800
            set bf.periodTime = 200
            set bf.hasteAble = true 
            call bf.addPeriod(function STAR_FALL_PERIOD)
            set bf.realData = 1
            call bf.apply()
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,10) and (heroNowForm[8] == FORM_DRUID_BEAR or heroNowForm[8] == FORM_DRUID_CAT) then 
                if heroNowForm[8] == FORM_DRUID_BEAR then 
                    call DruidTransformToBear.evaluate(spellCaster)
                else 
                    call DruidTransformToCat.evaluate(spellCaster)
                endif 
            else 
                call DruidTransformToMoonkin.evaluate(spellCaster)
            endif 
            call DruidChangeMoonPhase.execute()
        endfunction
        function SPELL_S02D takes nothing returns nothing       //化身
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_AVATAR)
            local group pick 
            set bf.lastTime = 1500+750*spellAbilityLevel/5
            call bf.addEnding(function DruidCheckMoonPhase)
            call bf.apply()
            call DruidRefreshAvatar.evaluate(spellCaster)
            if heroNowForm[8] == FORM_DRUID_NORMAL then 
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),900,playerAlly)
                loop 
                    exitwhen FirstOfGroup(pick) == null
                    set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_DRUID_WILDGROWTH)
                    set bf.lastTime = 700
                    set bf.periodTime = 100
                    set bf.realData = 1.6
                    set bf.hasteAble = true 
                    call bf.addPeriod(function WILD_GROWTH_HOT)
                    call bf.apply()
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
                call DestroyGroup(pick)
                set pick = null 
            elseif heroNowForm[8] == FORM_DRUID_BEAR then 
                set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_FRENZIEDREGENERATION)
                set bf.lastTime = 300
                set bf.periodTime = 50
                set bf.realData = 1
                set bf.hasteAble = true 
                call bf.addPeriod(function FRENZIED_REGENERATION_HOT)
                call bf.apply()
                call DruidTransformToBear.evaluate(spellCaster)
            elseif heroNowForm[8] == FORM_DRUID_CAT then 
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),450,playerAlly)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_DRUID_ROAR)
                    set bf.lastTime = 1500
                    set bf.bonusMoveSpeed_P = 4000
                    set bf.bonusAttack_P = 1500
                    call bf.apply()
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
                call DestroyGroup(pick)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl",spellCaster,"origin"))
                set pick = null 
            elseif heroNowForm[8] == FORM_DRUID_MOONKIN then
                set DRUID_STAR_SURGE_CHARGE = DRUID_STAR_SURGE_CHARGE+3
                call DruidCheckStarSurgeCharge.execute() 
                call DruidCheckMoonPhase.execute()
            endif 
        endfunction
        function TRANQUILITY_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if GetUnitCurrentOrder(bf.buffSource) == ORDER_cloudoffog then 
                call IssueImmediateOrderById(bf.buffSource,ORDER_stop)
            endif 
        endfunction
        function TRANQUILITY_HOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*0.24/4*mybuff.buffTimeScale*bf.realData
            set healFlag = 'A62I'
            set healIsAOE = true 
            set healIsDOT = true 
            call UnitHealTarget(bf.buffSource,bf.buffTarget,dmg)
        endfunction
        function TRANQUILITY_HEAL takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local mybuff bf 
            local real dmg = I2R(unitGetAllBonusStateValue(caster,STATE_ABILITY_POWER))*3.6/8
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(caster),GetUnitY(caster),900,playerAlly)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(caster,FirstOfGroup(pick),BUFFTYPE_DRUID_TRANQUILITY)
                set bf.lastTime = 800
                set bf.periodTime = 200
                set bf.hasteAble = true 
                call bf.addPeriod(function TRANQUILITY_HOT)
                set bf.realData = 1+bf.realData
                call bf.apply()
                set healFlag = 'S02E'
                set healIsAOE = true 
                call UnitHealTarget(caster,FirstOfGroup(pick),dmg)
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
        endfunction
        function SPELL_S02E takes nothing returns nothing       //宁静
            local mybuff bf
            local integer haste
            local integer period = 75
            local integer waveCount = 4+4*spellAbilityLevel
            local delayedevent de 
            call DruidTransformToOrigin.evaluate(spellCaster)
            set haste = unitGetAllBonusStateValue(spellCaster,STATE_HASTE)
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            set de = delayedevent.create(period,waveCount,function TRANQUILITY_HEAL)
            call de.saveUnit("CASTER",spellCaster)
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_DRUID_CHANNELTRANQUILITY)
            set bf.lastTime = period*waveCount+1
            set bf.bonusImmune_Root = 1
            set bf.bonusImmune_Silence = 1
            set bf.bonusImmune_Snare = 1
            set bf.bonusImmune_Stun = 1
            set bf.boolData = true 
            set bf.intData = de
            call bf.addEnding(function TRANQUILITY_END)
            call bf.apply()
        endfunction
        function SPELL_STOP_S02E takes nothing returns nothing
            local delayedevent de
            if mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_CHANNELTRANQUILITY) > 0 then 
                set de = mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_CHANNELTRANQUILITY).intData
                set de.DESTROY = true 
                set mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_CHANNELTRANQUILITY).DESTROY = true 
            endif 
        endfunction
        function S02F_DOT takes nothing returns nothing     
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*0.6
            set damageIsDOT = true 
            set damageIsAOE = true 
            set damageTag_Arcane = true 
            set damageFlag = 'S02F'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S02F_HOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = 0.9*I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))
            set healIsDOT = true 
            set healFlag = 'S02F'
            call UnitHealTarget(bf.buffSource,bf.buffTarget,dmg)
        endfunction
        function S02F_PERIOD takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local mybuff bf 
            if DisByUnXY(caster,x,y) < 250 then 
                set bf = mybuff.create(caster,caster,BUFFTYPE_DRUID_MOONLIGHT_POS)
                set bf.fromAura = true 
                set bf.endTick = false 
                set bf.lastTime = 9
                set bf.periodTime = 200
                call bf.addPeriod(function S02F_HOT)
                set bf.bonusHaste = 2500
                call bf.apply()
            endif 
            call GroupEnumUnitsInRangeEx(pick,x,y,250,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(caster,FirstOfGroup(pick),BUFFTYPE_DRUID_MOONLIGHT_NEG)
                set bf.fromAura = true 
                set bf.endTick = false 
                set bf.lastTime = 9
                set bf.periodTime = 200
                call bf.addPeriod(function S02F_DOT)
                set bf.bonusAccuracy = -1000
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
        endfunction
        function SPELL_S02F takes nothing returns nothing       //明月普照
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local effect sfx = AddSpecialEffectEX("war3campimported\\yueguang.mdx",x,y)
            local delayedevent de = delayedevent.create(8,300+300*spellAbilityLevel,function S02F_PERIOD)
            call de.saveReal("X",x)
            call de.saveReal("Y",y)
            call de.saveUnit("CASTER",spellCaster)
            call BlzSetSpecialEffectScale(sfx,0.55)
            call delayedDestroyEffect(sfx,3000)
            set sfx = null 
        endfunction
        function S01W_HEAL takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            set healFlag = 'S01W'
            set healAddCrit = de.loadReal("CRIT")
            call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("HEAL"))
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\NatureHeal017.mdx",de.loadUnit("TARGET"),"origin"))
        endfunction
        function S01W_RESET takes nothing returns nothing
            local real haste = 1
            local real Qcd = 3
            if HeroHaveTalent(hero[8],HERO_PRIVATE_TALENT,1) then 
                set Qcd = Qcd-0.5
            endif 
            if unitGetBonusState(hero[8],STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetBonusState(hero[8],STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetBonusState(hero[8],STATE_HASTE)))/10000
            endif 
            call BlzStartUnitAbilityCooldown(hero[8],'S01W',RMaxBJ(0.52,Qcd*haste))
        endfunction
        function SPELL_S01W takes nothing returns nothing    //治疗之触
            local delayedevent de
            local real haste = 1
            local integer delay = 100
            local real heal = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*1.3
            local real addCrit = 0
            if mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_TRANSFORMMASTER) > 0 then 
                set mybuff.getUnitBuff(spellCaster,BUFFTYPE_DRUID_TRANSFORMMASTER).DESTROY = true 
                set delay = 1
                set addCrit = 1
            endif 
            call DruidTransformToOrigin.evaluate(spellCaster)
            if unitGetBonusState(spellCaster,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetBonusState(spellCaster,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetBonusState(spellCaster,STATE_HASTE)))/10000
            endif 
            set de = delayedevent.create(R2I(delay*haste),1,function S01W_HEAL)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveReal("HEAL",heal)
            call de.saveReal("CRIT",addCrit)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\AncestralSpiritCasterGreen.mdx",spellTarget,"chest"),IMaxBJ(50,delay))
            call delayedevent.create(1,1,function S01W_RESET)
        endfunction
        function SPELL_S02G takes nothing returns nothing   //枯荣
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,700,0,"war3campImported\\leechseed_missle_straight.mdx",function S02G_HIT,null)
            set proj.flag = 'S02G'
            call proj.launch()
            call DruidTransformToOrigin.evaluate(spellCaster)
        endfunction 
    //endregion

    // region monk 武僧
    ////////////////
    //HEROID = 14(15)
    ////////////////
        globals 
            delayedevent MONK_CHI_CHECKER = 0
            delayedevent MONK_DEFLECT_CHECKER = 0
            effect MONK_CHI_SFX = null
        endglobals
        function FistStanceDecrease takes mybuff bf returns integer
            local integer i = 0
            local integer decrease = 0
            local integer result = 0
            if mybuff.getUnitBuff(bf.buffTarget,BUFFTYPE_MONK_FIRMSTANCE) != 0 then 
                return 0
            endif 
            set decrease = bf.intData/2
            set result = decrease
            if HeroHaveTalent(bf.buffTarget,HERO_ULTIMATE_TALENT,9) then 
                set i = decrease
                loop
                    exitwhen i <= 0
                    if GetRandomReal(0,1) < 0.25 then 
                        set decrease = decrease-1
                    endif 
                    set i = i-1
                endloop
            endif 
            set decrease = IMaxBJ(1,decrease)
            set bf.intData = bf.intData-decrease
            if bf.intData < 1 then
                set bf.DESTROY = true 
            endif  
            set bf.bonusCrit = 500*bf.intData 
            if GetUnitAbilityLevel(bf.buffTarget,'S04B') > 0 then 
                set bf.bonusEvade = 200*bf.intData
            endif 
            set bf.needRefreshState = true 
            if HeroHaveTalent(bf.buffTarget,HERO_PRIVATE_TALENT,1) then 
                call MonkApplyMistHaze.evaluate(bf.buffTarget,bf.buffTarget)
            endif 
            return result
        endfunction

        function S046_RESET takes nothing returns nothing
            local real haste = 1
            if ST_HASTE.getTotalState(hero[14]) >= 0 then 
                set haste = 10000/(10000+I2R(ST_HASTE.getTotalState(hero[14])))
            else 
                set haste = (10000-I2R(ST_HASTE.getTotalState(hero[14])))/10000
            endif 
            call BlzStartUnitAbilityCooldown(hero[14],'S046',RMaxBJ(0.52,3*haste))
        endfunction
        function SPELL_S046 takes nothing returns nothing    //活血术
            local delayedevent de = delayedevent.create(1,1,function S046_RESET)
            local real heal = I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*1
            if GetUnitLifePercent(spellTarget) <= 50 then 
                set heal = heal*1.5
            endif 
            set healFlag = 'S046'
            call UnitHealTarget(spellCaster,spellTarget,heal)
        endfunction

        function CheckDeflectSFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local mybuff bf = de.loadInteger("BUFF")

            if bf.realData > 0.667*GetUnitState(bf.buffTarget,UNIT_STATE_LIFE) then 
                call SetUnitVertexColor(bf.buffTarget,255,50,50,255)
            elseif bf.realData > 0.334*GetUnitState(bf.buffTarget,UNIT_STATE_LIFE) then 
                call SetUnitVertexColor(bf.buffTarget,255,255,75,255)
            else 
                call SetUnitVertexColor(bf.buffTarget,255,255,255,255)
            endif 
        endfunction
        function A65W_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call MONK_DEFLECT_CHECKER.destroy()
            set MONK_DEFLECT_CHECKER = 0
            call SetUnitVertexColor(bf.buffTarget,255,255,255,255)
        endfunction
        function A65W_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local integer remaining = bf.remainingTime
            local real ticks = I2R(remaining)/50+1
            local real dmg = bf.realData/ticks 
            set bf.realData = bf.realData-dmg 
            if inCombat(bf.buffTarget) == false then 
                set dmg = RMinBJ(GetUnitState(bf.buffTarget,UNIT_STATE_LIFE)-1,dmg)
            endif 
            set damageFlag = 'A65W'
            set damageIsExtra = true 
            call UnitDamageTarget(bf.buffTarget,bf.buffTarget,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function A65U_DAMAGED_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real absorb = RMinBJ(bf.realData,damageFinalDamage)
            if damageFlag == 'A65W' then 
                return 
            endif 
            set bf.realData = bf.realData-absorb 
            if bf.realData <= 0.5 then 
                set bf.DESTROY = true 
            endif 
            set damageFinalDamage = damageFinalDamage-absorb
            if HeroHaveTalent(bf.buffTarget,HERO_PRIVATE_TALENT,7) then 
                set absorb = absorb*0.9
            endif 
            set bf = CreateBuff(damageTarget,damageTarget,BUFFTYPE_MONK_DEFLECT,400)
            if HeroHaveTalent(bf.buffTarget,HERO_ULTIMATE_TALENT,10) then 
                set bf.lastTime = 500
            endif
            set bf.addTime = false 
            set bf.realData = bf.realData+absorb*0.9
            set bf.periodTime = 50
            call bf.addEnding(function A65W_END)
            call bf.addPeriod(function A65W_PERIOD)
            call bf.apply()
            if MONK_DEFLECT_CHECKER == 0 then 
                set MONK_DEFLECT_CHECKER = delayedevent.create(5,0,function CheckDeflectSFX)
            endif 
            call MONK_DEFLECT_CHECKER.saveInteger("BUFF",bf)
        endfunction
        function A65V_DAMAGED_SOURCE takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if mybuff.getUnitBuff(damageTarget,BUFFTYPE_MONK_DRUNK) != 0 or healSource != healMaster then 
                return 
            endif 
            if unitCheckCooldown(bf.buffTarget,'A65V') and damageIfCrit then 
                set damageFinalDamage = damageFinalDamage*(1+0.05*I2R(FistStanceDecrease(bf)))
                call unitStartCooldown(bf.buffTarget,'A65V',1)
            endif 
        endfunction
        function A65V_HEALED_SOURCE takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if healSource != healMaster then 
                return 
            endif 
            if unitCheckCooldown(bf.buffTarget,'A65V') and healIfCrit then 
                call FistStanceDecrease(bf)
                call unitStartCooldown(bf.buffTarget,'A65V',1)
            endif 
        endfunction

        function GainFistStance takes unit whichUnit,integer value returns nothing
            local integer max = 20
            local mybuff bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_MONK_FISTSTANCE,360000)
            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,7) then 
                set value = value+1
                set max = 10
            endif 
            set bf.intData = IMinBJ(max,bf.intData+value)
            set bf.bonusCrit = 500*bf.intData
            if GetUnitAbilityLevel(whichUnit,'S04B') > 0 then 
                set bf.bonusEvade = 200*bf.intData
            endif 
            call bf.addDmged_S(function A65V_DAMAGED_SOURCE)
            call bf.addHealed_S(function A65V_HEALED_SOURCE)
            call bf.apply()
        endfunction

        function ChiEndDestroySFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            if MONK_CHI_SFX != null then 
                call DestroyEffectEX(MONK_CHI_SFX)
            endif 
        endfunction
        function CheckChiSFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local mybuff bf = de.loadInteger("BUFF")
            local integer i = IMinBJ(4,1+IMaxBJ(0,R2I(bf.realData/(0.25*GetUnitState(bf.buffTarget,UNIT_STATE_MAX_LIFE))-0.5)))
            if bf.intData != i then 
                set bf.intData = i
                if MONK_CHI_SFX != null then 
                    call DestroyEffectEX(MONK_CHI_SFX)
                endif 
                if i >= 4 then 
                    set MONK_CHI_SFX = AddSpecialEffectTargetEX("war3campImported\\MonkChiorbit04.mdx",bf.buffTarget,"origin")
                elseif i >= 3 then 
                    set MONK_CHI_SFX = AddSpecialEffectTargetEX("war3campImported\\MonkChiorbit03.mdx",bf.buffTarget,"origin")
                elseif i >= 2 then 
                    set MONK_CHI_SFX = AddSpecialEffectTargetEX("war3campImported\\MonkChiorbit02.mdx",bf.buffTarget,"origin")
                else
                    set MONK_CHI_SFX = AddSpecialEffectTargetEX("war3campImported\\MonkChiorbit01.mdx",bf.buffTarget,"origin")
                endif 
            endif 
        endfunction
        function A65U_END takes nothing returns nothing
            call MONK_CHI_CHECKER.destroy()
            set MONK_CHI_CHECKER = 0
        endfunction
        function GainChi takes unit whichUnit,real value returns nothing
            local real max = 1
            local mybuff bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_MONK_CHI,360000)
            if mybuff.getUnitBuff(whichUnit,BUFFTYPE_MONK_VAJRAZEN) > 0 then 
                set max = max+1
            endif 
            if HeroHaveTalent(whichUnit,HERO_ULTIMATE_TALENT,10) then 
                set value = value*1.2
            endif 
            set bf.realData = RMaxBJ(RMinBJ(bf.realData+value*GetUnitState(whichUnit,UNIT_STATE_MAX_LIFE),GetUnitState(whichUnit,UNIT_STATE_MAX_LIFE))*max,bf.realData)
            call bf.addDmged_T(function A65U_DAMAGED_TARGET)
            set bf.checkStateWhenDestroy = true 
            call bf.addEnding(function A65U_END)
            call bf.apply()
            if MONK_CHI_CHECKER == 0 then 
                set MONK_CHI_CHECKER = delayedevent.create(5,0,function CheckChiSFX)
                call MONK_CHI_CHECKER.addOnEnd(function ChiEndDestroySFX)
            endif 
            call MONK_CHI_CHECKER.saveInteger("BUFF",bf)
            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,1) then 
                if R2I(value/0.125+0.1) >= 1 then 
                    call GainFistStance.evaluate(whichUnit,R2I(value/0.125+0.1))
                endif 
            endif 
            call State.checkAll(whichUnit)
        endfunction
        function HERO_15_ATTACKED_TARGET takes nothing returns nothing
            local mybuff bf 
            if GetUnitAbilityLevel(damageTarget,'S04B') > 0 then 
                if random.get(damageTarget,RMinBJ(damageMaxEvadeChance,damageEvade)-damageAccuracy-damageAddAccuracy,'AEev') then 
                    set damageFinalDamage = 0.7*damageFinalDamage
                else
                    set bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_MONK_FISTSTANCE)
                    if bf > 0 then 
                        if mybuff.getUnitBuff(bf.buffTarget,BUFFTYPE_MONK_FIRMSTANCE) != 0 then 
                            return 
                        endif 
                        call FistStanceDecrease(bf)
                    endif 
                endif 
            endif 
        endfunction
        function HERO_15_RETRAIN takes nothing returns nothing
            if mybuff.getUnitBuff(hero[14],BUFFTYPE_MONK_FISTSTANCE) > 0 then 
                set mybuff.getUnitBuff(hero[14],BUFFTYPE_MONK_FISTSTANCE).DESTROY = true 
            endif 
            if mybuff.getUnitBuff(hero[14],BUFFTYPE_MONK_CHI) > 0 then 
                set mybuff.getUnitBuff(hero[14],BUFFTYPE_MONK_CHI).DESTROY = true 
            endif 
        endfunction
        function HERO_15_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 5.4
            local real a 
            local real d 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B661') > 0 then 
                call UnitRemoveAbility(dt,'B661')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S045'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageDamage = damageDamage*1.5
                set damageFlag = 'S045'
                call BlzStartUnitAbilityCooldown(ds,'S045',Qcd*haste-0.01)
                call Taunt(damageSource,damageTarget)

                call GainChi(damageSource,0.25)
            endif

            if GetUnitAbilityLevel(dt,'B662') > 0 then 
                set Qcd = 3.6
                call UnitRemoveAbility(dt,'B662')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S047'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageDamage = damageDamage*1.2
                set damageFlag = 'S047'
                call BlzStartUnitAbilityCooldown(ds,'S047',Qcd*haste-0.01)

                call GainFistStance(damageSource,1)
            endif
            set ds = null 
            set dt = null 
        endfunction
        function A65Z_BEFOREDAMAGE_SOURCE takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local integer max = 4
            if bf.buffSource != damageMaster then 
                return 
            endif 
            if HeroHaveTalent(damageMaster,HERO_ULTIMATE_TALENT,12) then 
                set max = max-1
            endif 
            if bf.intData >= max then 
                set damageAddAccuracy = 100
                set damageDamage = damageDamage*1.75
            endif 
        endfunction
        function MonkApplyAcupointSeal takes unit caster,unit target returns nothing
            local integer eff = -500
            local integer max = 4
            local mybuff bf = 0
            if HeroHaveTalent(caster,HERO_ULTIMATE_TALENT,12) then 
                set max = max-1
                set eff = eff*2
            endif 
            if mybuff.getUnitBuff(target,BUFFTYPE_MONK_ACUPOINTSEAL) > 0 and mybuff.getUnitBuff(target,BUFFTYPE_MONK_ACUPOINTSEAL).intData >= max then 
                return 
            endif 
            set bf = CreateBuff(caster,target,BUFFTYPE_MONK_ACUPOINTSEAL,1000)
            set bf.intData = IMinBJ(bf.intData+1,max)
            set bf.bonusAttackSpeed = eff*bf.intData
            set bf.bonusMoveSpeed_P = eff*bf.intData
            call bf.addBefDmg_S(function A65Z_BEFOREDAMAGE_SOURCE)
            call bf.apply() 
        endfunction
        function HERO_15_ATTACKED_SOURCE takes nothing returns nothing
            local mybuff bf 
            local integer max = 4
            if damageSource != damageMaster then 
                return 
            endif 
            if HeroHaveTalent(damageSource,HERO_ULTIMATE_TALENT,12) then 
                set max = max-1
            endif 
            if GetUnitAbilityLevel(damageSource,'S04G') > 0 then 
                set bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_MONK_ACUPOINTSEAL)
                if bf > 0 and bf.intData >= max then 
                    call GainFistStance(damageSource,1)
                elseif random.get(damageSource,0.25,'S04G') then 
                    call MonkApplyAcupointSeal(damageSource,damageTarget)
                endif 
            endif 
        endfunction

        function S048_PROJ takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = proj.target_x
            local real y = proj.target_y 
            local real dmg = I2R(GetUnitMaxAttack(proj.source,0))*1.5
            local mybuff bf 
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,x,y,200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'S048'
                set damageIsAOE = true 
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                set bf = CreateBuff(proj.source,FirstOfGroup(pick),BUFFTYPE_MONK_DRUNK,500)
                set bf.bonusAttackSpeed = -2500
                set bf.bonusAccuracy = -2500
                call bf.apply()
                call applyStun(proj.source,FirstOfGroup(pick),'ATB1')
                if (HeroHaveTalent(proj.source,HERO_PRIVATE_TALENT,2) == false or GetUnitAbilityLevel(proj.source,'S047') == 0) then 
                    call Taunt(proj.source,FirstOfGroup(pick))
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S048 takes nothing returns nothing   //酩酊酒
            local projectile proj = CreateProjectileToLoc(spellCaster,spellTargetX,spellTargetY,700,0.25,"Abilities\\Spells\\Other\\StrongDrink\\BrewmasterMissile.mdl",null,function S048_PROJ)
            set proj.model_attach = "origin"
            call proj.launch()
            call SetUnitScale(proj.dummy,2,2,2)
        endfunction

        function A65Y_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = 0.4*I2R(ST_ABILITY_POWER.getTotalState(bf.buffSource))*mybuff.buffTimeScale
            set healFlag = 'A65Y'
            set healIsDOT = true 
            call UnitHealTarget(bf.buffSource,bf.buffTarget,dmg)
        endfunction
        function A65Y_HEALING_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if bf.buffSource == healSource then 
                set healFinalHeal = healFinalHeal*1.1
            endif 
        endfunction
        function A65Y_AFTERHEAL_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local unit targetA = null               //血量最低
            local unit targetB = null               //buff持续时间最短
            local integer lowestRemaining = 999999
            local group pickA = null       //原始组
            local group pickB = null       //不含buff的组
            local group pickC = null       //全部组
            if healIsDOT or healIsExtra then 
                return 
            endif 
            set pickA = CreateGroup()  
            set pickB = CreateGroup()  
            set pickC = CreateGroup()     
            call GroupEnumUnitsInRangeEx(pickA,GetUnitX(bf.buffTarget),GetUnitY(bf.buffTarget),750,playerAlly)
            call GroupRemoveUnit(pickA,bf.buffTarget)
            loop
                exitwhen FirstOfGroup(pickA) == null 
                if IsUnitType(FirstOfGroup(pickA),UNIT_TYPE_HERO) then 
                    if mybuff.getUnitBuff(FirstOfGroup(pickA),BUFFTYPE_MONK_MISTYHAZE) == 0 and GetUnitAbilityLevel(FirstOfGroup(pickA),'A665') == 0 then 
                        call GroupAddUnit(pickB,FirstOfGroup(pickA))
                    endif 
                    call GroupAddUnit(pickC,FirstOfGroup(pickA))
                endif 
                call GroupRemoveFirstUnit(pickA)
            endloop
            set targetA = GetUnitWithLowestHealthPct(pickB)
            loop
                exitwhen FirstOfGroup(pickC) == null 
                if mybuff.getUnitBuff(FirstOfGroup(pickC),BUFFTYPE_MONK_MISTYHAZE).remainingTime <= lowestRemaining then 
                    set lowestRemaining = mybuff.getUnitBuff(FirstOfGroup(pickC),BUFFTYPE_MONK_MISTYHAZE).remainingTime
                    set targetB = FirstOfGroup(pickC)
                endif 
                call GroupRemoveFirstUnit(pickC)
            endloop
            if targetA == null then 
                set targetA = targetB
            endif 
            if targetA == null then 
                call GroupEnumUnitsInRangeEx(pickA,GetUnitX(bf.buffTarget),GetUnitY(bf.buffTarget),750,playerAlly)
                call GroupRemoveUnit(pickA,bf.buffTarget)
                set targetA = GroupPickRandomUnitEx(pickA)
            endif 
            if targetA != null then 
                call A65Y_MIST_HAZE_PROJ.evaluate(bf.buffSource,bf.buffTarget,targetA)
            endif 
            call DestroyGroup(pickA)
            call DestroyGroup(pickB)
            call DestroyGroup(pickC)
            set pickA = null 
            set pickB = null 
            set pickC = null 
            set targetA = null 
            set targetB = null 
        endfunction
        function MonkApplyMistHaze takes unit caster,unit target returns nothing
            local mybuff bf = CreateBuff(caster,target,BUFFTYPE_MONK_MISTYHAZE,1200)
            set bf.periodTime = 200
            set bf.hasteAble = true 
            call bf.addPeriod(function A65Y_PERIOD)
            call bf.addHealing_T(function A65Y_HEALING_TARGET)
            call bf.addAftHeal_T(function A65Y_AFTERHEAL_TARGET)
            call bf.apply()

            if HeroHaveTalent(caster,HERO_ULTIMATE_TALENT,10) then 
                set healFlag = 'A65Y'
                set healIsExtra = true 
                call UnitHealTarget(caster,target,0.25*I2R(ST_ABILITY_POWER.getTotalState(caster)))
            endif 
        endfunction
        function A65Y_MSL_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            call MonkApplyMistHaze(proj.source,proj.target)
            if GetUnitAbilityLevel(proj.target,'A665') > 0 then 
                call UnitRemoveAbility(proj.target,'A665')
            endif 
        endfunction
        function A65Y_MIST_HAZE_PROJ takes unit source,unit startUnit,unit target returns nothing
            local projectile proj = CreateProjectileToUnit(source,target,750,0,"war3campImported\\MistHaze.mdx",function A65Y_MSL_HIT,null)
            set proj.LAUNCH_UNIT = false 
            set proj.LAUNCH_LOC = true 
            set proj.source_x = GetUnitX(startUnit)
            set proj.source_y = GetUnitY(startUnit)
            call proj.launch()
            if GetUnitAbilityLevel(target,'A665') == 0 then 
                call UnitAddAbility(target,'A665')
            endif 
        endfunction
        function SPELL_S049 takes nothing returns nothing   //氤氲之雾
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,750,0,"war3campImported\\MistHaze.mdx",function A65Y_MSL_HIT,null)
            call proj.launch()
            if GetUnitAbilityLevel(spellTarget,'A665') == 0 then 
                call UnitAddAbility(spellTarget,'A665')
            endif 
        endfunction

        
        function S04A_CHECK takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local real haste = de.loadReal("HASTE")
            local real loopC = de.loadReal("LOOP")
            local integer anim = de.loadInteger("ANIM")
            local real dmg = I2R(GetUnitAttack(ds,0))
            local group pick = null 
            local real remainingTime = BlzGetUnitAbilityCooldownRemaining(ds,'S04A')
            set loopC = loopC+1
            if GetUnitCurrentOrder(ds) == ORDER_cannibalize then 
                call SetUnitFacingToFaceUnitTimed(ds,dt,0)
                if anim == 0 and 20*haste-loopC < 0 then 
                    set anim = 1
                    set damageFlag = 'S04A'
                    set damageTag_Lightning = true 
                    call UnitDamageTarget(ds,dt,1*dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_MEDIUM_BASH)
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",dt,"origin"))
                endif 
                if anim == 1 and 30*haste-loopC < 0 then 
                    set anim = 2 
                    call SetUnitAnimationByIndex(ds,6)
                endif 
                if anim == 2 and 50*haste-loopC < 0 then 
                    set anim = 3
                    set damageFlag = 'S04A'
                    set damageTag_Lightning = true 
                    call UnitDamageTarget(ds,dt,1*dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_MEDIUM_BASH)
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",dt,"origin"))
                endif 
                if anim == 3 and 60*haste-loopC < 0 then 
                    set anim = 4
                    call SetUnitAnimationByIndex(ds,3)
                    call SetUnitTimeScale(ds,1/haste)
                endif 
                if anim == 4 and 160*haste-loopC < 0 then 
                    set anim = 5
                    set pick = CreateGroup()
                    call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),250,playerEnemy)
                    loop
                        exitwhen FirstOfGroup(pick) == null
                        set damageFlag = 'S04A'
                        set damageIsAOE = true 
                        set damageTag_Lightning = true 
                        call UnitDamageTarget(ds,FirstOfGroup(pick),2*dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_HEAVY_BASH)
                        call applyStun(ds,FirstOfGroup(pick),'ATB1')
                        if (HeroHaveTalent(ds,HERO_PRIVATE_TALENT,2) == false or GetUnitAbilityLevel(ds,'S047') == 0) and mybuff.getUnitBuff(ds,BUFFTYPE_MONK_CHI) > 0 then 
                            call Taunt(ds,FirstOfGroup(pick))
                        endif 
                        call GroupRemoveUnit(pick,FirstOfGroup(pick))
                    endloop
                    call DestroyGroup(pick)
                    call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(dt),GetUnitY(dt)))
                endif 
                if anim == 5 and 200*haste-loopC < 0 then 
                    call UnitRemoveAbility(ds,'S04A')
                    call UnitAddAbility(ds,'S04A')
                    call BlzStartUnitAbilityCooldown(ds,'S04A',remainingTime)
                    call SetUnitTimeScale(ds,1)
                    call State.checkAll(ds)
                    set de.DESTROY = true 
                endif 
            else 
                call SetUnitTimeScale(ds,1)
                set de.DESTROY = true 
            endif 
            call de.saveReal("LOOP",loopC)
            call de.saveInteger("ANIM",anim)
            set pick = null 
            set ds = null 
            set dt = null   
        endfunction
        function SPELL_S04A takes nothing returns nothing   //怒雷破
            local delayedevent de
            local real haste = 1
            if unitGetBonusState(spellCaster,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))/10000
            endif 
            set de = delayedevent.create(1,500,function S04A_CHECK)
            call SetUnitAnimationByIndex(spellCaster,5)
            call SetUnitTimeScale(spellCaster,2/haste)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveReal("HASTE",haste)
            call de.saveReal("LOOP",0)
            call de.saveInteger("ANIM",0)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\OrbOfLightning.mdx",spellCaster,"hand right"),R2I(160*haste))
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\OrbOfLightning.mdx",spellCaster,"weapon"),R2I(160*haste))
        endfunction 
        function SPELL_READY_S04A takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0)
        endfunction
        function SPELL_STOP_S04A takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function SPELL_END_S04A takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function HERO_15_SPELLING takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction

        function SPELL_S04C takes nothing returns nothing   //活血酒
            local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MONK_DEFLECT)
            if bf > 0 then 
                set bf.realData = RMinBJ(bf.realData/2,bf.realData-0.1*GetUnitState(spellCaster,UNIT_STATE_MAX_LIFE))
                if bf.realData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            call GainChi(spellCaster,0.5)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\furionteleporttarget.mdx",spellCaster,"origin"))
        endfunction

        function S04D_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))*1.75*proj.realData
            local real heal = I2R(ST_ABILITY_POWER.getTotalState(proj.source))*2*proj.realData
            if IsUnitEnemy(proj.target,GetOwningPlayer(proj.source)) then 
                call proj.applyDamageSet()
                call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call bufflist.listUnitBuffs(proj.target,true,false,true)
                call bufflist.dispelMultiBuffs(1)
                call bufflist.flush()
                set proj.bounceCheckGroup = true 
                set proj.TARGET_ALLY = true 
                set proj.TARGET_ENEMY = false
            else 
                call proj.applyHealSet()
                call UnitHealTarget(proj.source,proj.target,heal)
                call bufflist.listUnitBuffs(proj.target,false,true,true)
                call bufflist.dispelMultiBuffs(1)
                call bufflist.flush()
                set proj.bounceCheckGroup = false 
                set proj.TARGET_ENEMY = true 
                set proj.TARGET_ALLY = false
            endif 
        endfunction
        function SPELL_S04D takes nothing returns nothing   //真气波
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1000,0,"war3campImported\\mysticsnake_fx_v1.mdx",function S04D_HIT,null)
            set proj.flag = 'S04D'
            set proj.tag_Earth = true 
            set proj.realData = 1
            set proj.maxBounceLimit = proj.maxBounceLimit+6
            set proj.bounceMultiplier = RMinBJ(proj.bounceMultiplier,0.75)
            set proj.bounceRange = RMaxBJ(600,proj.bounceRange)
            call proj.launch()
        endfunction

        function S04E_CHECK takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local real loopC = de.loadReal("LOOP")
            local real heal = I2R(ST_ABILITY_POWER.getTotalState(ds))*0.7
            local real remainingTime = BlzGetUnitAbilityCooldownRemaining(ds,'S04E')
            local Lightning lt = de.loadInteger("LIGHTNING")
            set loopC = loopC+1
            if GetUnitCurrentOrder(ds) == ORDER_carrionscarabsoff then 
                set healFlag = 'S04E'
                call UnitHealTarget(ds,dt,heal)
                call bufflist.flush()
                call bufflist.listUnitBuffs(dt,false,true,true)
                call bufflist.dispelMultiBuffs(1)
                if loopC >= 8 then 
                    call UnitRemoveAbility(ds,'S04E')
                    call UnitAddAbility(ds,'S04E')
                    call BlzStartUnitAbilityCooldown(ds,'S04E',remainingTime)
                    call SetUnitTimeScale(ds,1)
                    call State.checkAll(ds)
                    set de.DESTROY = true 
                    set lt.DESTROY = true 
                endif 
                if loopC == 1 then 
                    set de.timePeriod = de.timePeriod*2
                endif 
            else 
                call SetUnitTimeScale(ds,1)
                set de.DESTROY = true 
                set lt.DESTROY = true 
            endif 
            call de.saveReal("LOOP",loopC)
            set ds = null 
            set dt = null   
        endfunction
        function S04E_FACE_TAR takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            if GetUnitCurrentOrder(ds) == ORDER_carrionscarabsoff then 
                call SetUnitFacingToFaceUnitTimed(ds,dt,0)
            else 
                set de.DESTROY = true 
            endif 
            set ds = null 
            set dt = null   
        endfunction
        function SPELL_S04E takes nothing returns nothing   //抚慰之雾
            local delayedevent de
            local Lightning lt = Lightning.createU2U(spellCaster,spellTarget,"SPLK",30,-15,30,0,0,50,1000,50,true)
            local real haste = 1
            if unitGetBonusState(spellCaster,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(spellCaster,STATE_ATTACK_SPEED)))/10000
            endif 
            set de = delayedevent.create(R2I(100*haste)/2,8,function S04E_CHECK)
            call SetUnitTimeScale(spellCaster,0.967/haste)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveReal("LOOP",0)
            call de.saveInteger("LIGHTNING",lt)
            set de = delayedevent.create(1,2000,function S04E_FACE_TAR)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call lt.setColor(0.3,1,1,0.75)
        endfunction 
        function SPELL_READY_S04E takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0)
        endfunction
        function SPELL_STOP_S04E takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function SPELL_END_S04E takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction

        function S04F_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(waveCaster,0))*2.5
            if IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) and waveTarget != proj.target then 
                set damageFlag = 'S04F'
                set damageIsAOE = true 
                set damageTag_Fire = true 
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            endif 
        endfunction
        function S04F_DEATH takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))*3.5
            set damageFlag = 'S04F'
            set damageTag_Fire = true 
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_HEAVY_BASH)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\firaga_2.mdx",proj.target,"origin"))
            call SetUnitAnimation(proj.source,"stand")
            if GetUnitCurrentOrder(proj.source) == ORDER_carrionscarabsoff then
                call IssueTargetOrderById(proj.source,ORDER_attack,proj.target)
            endif 
            call GainFistStance(proj.source,3)
        endfunction
        function SPELL_S04F takes nothing returns nothing   //炎凤击
            local projectile proj = ChargeUnitAsWave(spellCaster,spellTarget,1000,0,200,0,100,true,function S04F_HIT,function S04F_DEATH)
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("units\\human\\phoenix\\phoenix",spellCaster,"origin")
            call BlzSetSpecialEffectAlpha(proj.bindSFX_0,125)
        endfunction
        function SPELL_READY_S04F takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0)
        endfunction
        function SPELL_STOP_S04F takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function SPELL_END_S04F takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction

        function A660_DAMAGED_TARGET takes nothing returns nothing
            local mybuff bf
            if damageFlag == 'A65W' then 
                set bf = CreateBuff(damageTarget,damageTarget,BUFFTYPE_MONK_DEFLECT,400)
                set bf.addTime = false 
                set bf.realData = bf.realData+damageFinalDamage
                set bf.periodTime = 50
                call bf.addEnding(function A65W_END)
                call bf.addPeriod(function A65W_PERIOD)
                call bf.apply()
                if MONK_DEFLECT_CHECKER == 0 then 
                    set MONK_DEFLECT_CHECKER = delayedevent.create(5,0,function CheckDeflectSFX)
                endif 
                call MONK_DEFLECT_CHECKER.saveInteger("BUFF",bf)
                set damageFinalDamage = 0
            endif 
        endfunction
        function SPELL_S04H takes nothing returns nothing   //金刚禅
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_MONK_VAJRAZEN,800)
            call bf.addDmged_T(function A660_DAMAGED_TARGET)
            call bf.apply()
            call GainChi(spellCaster,0.5)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\sealofcrusader_impact.mdx",spellCaster,"origin"))
        endfunction

        function A661_DELAYED_HEAL takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            set healFlag = 'A661'
            call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("HEAL"))
        endfunction
        function A661_DAMAGED_TARGET takes nothing returns nothing
            local delayedevent de = 0
            local mybuff bf = mybuff.currentBuff
            if damageFinalDamage >= 0.5+GetUnitState(damageTarget,UNIT_STATE_LIFE) then 
                set damageFinalDamage = 0
                call SetUnitState(damageTarget,UNIT_STATE_LIFE,1)
                set de = delayedevent.create(1,1,function A661_DELAYED_HEAL)
                call de.saveUnit("CASTER",bf.buffSource)
                call de.saveUnit("TARGET",damageTarget)
                call de.saveReal("HEAL",bf.shieldNowValue)
                set bf.DESTROY = true 
            endif 
        endfunction
        function A661_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call MonkApplyMistHaze(bf.buffSource,bf.buffTarget)
        endfunction
        function SPELL_S04I takes nothing returns nothing   //作茧缚命
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_MONK_VITALCOCOON,1500)
            set bf.periodTime = 500
            set bf.shieldBlockPercent = 0.5
            set bf.shieldDestroy = true 
            set bf.shieldMaxValue = 4.5*I2R(ST_ABILITY_POWER.getTotalState(spellCaster))
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                call bf.addDmged_T(function A661_DAMAGED_TARGET)
            endif   
            call bf.addPeriod(function A661_PERIOD)
            call bf.apply()
            call MonkApplyMistHaze(spellCaster,spellTarget)
        endfunction

        function SPELL_S04J takes nothing returns nothing   //定势禅
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_MONK_FIRMSTANCE,800)
            call bf.apply()
            call GainFistStance(spellCaster,8)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\LightningShieldTarget_BirthOnly.mdx",spellCaster,"origin"))
        endfunction

        function S04K_HIT takes nothing returns nothing
            local real dmg = I2R(GetUnitAttack(waveCaster,0))*4
            if IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) then 
                set damageTag_Earth = true 
                set damageIsAOE = true 
                set damageFlag = 'S04K'
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call applyStun(waveCaster,waveTarget,'ATB0')
            endif 
        endfunction
        function SPELL_S04K takes nothing returns nothing   //烈风波
            local real a = AngleByUnXY(spellCaster,spellTargetX,spellTargetY)/57.2956
            local real x = GetUnitX(spellCaster)+500*Cos(a)
            local real y = GetUnitY(spellCaster)+500*Sin(a)
            local projectile proj = CreateWave(spellCaster,x,y,750,150,200,"war3campImported\\Hurricanwave.mdx",function S04K_HIT,null)
            call proj.launch()
            call GainFistStance(spellCaster,5)
        endfunction

        function SPELL_S04L takes nothing returns nothing   //轮回之触
            local real dmg = I2R(GetUnitAttack(spellCaster,0))*8
            local real targetLife  = GetUnitState(spellTarget,UNIT_STATE_LIFE) 
            local real selfMaxLife = GetUnitState(spellCaster,UNIT_STATE_MAX_LIFE)
            local real cd = 120
            if targetLife <= selfMaxLife then 
                set dmg = dmg+selfMaxLife
            endif 
            set damageTag_Shadow = true 
            set damageTag_Earth = true 
            set damageFlag = 'S04L'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_LIGHT_BASH)
            call GainFistStance(spellCaster,10)
            loop
                exitwhen targetLife <= 2*selfMaxLife or cd <= 46
                set targetLife = targetLife-selfMaxLife
                set cd = cd-15
            endloop 
            call BlzStartUnitAbilityCooldown(spellCaster,'S04L',cd)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",spellTarget,"origin"))
        endfunction

        function SPELL_S04M takes nothing returns nothing   //业报之触
            local real dmg = I2R(GetUnitAttack(spellCaster,0))*2
            local real dmgBonus = 1
            local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MONK_CHI)
            if bf > 0 then 
                set bf.DESTROY = true 
                set dmgBonus = dmgBonus+2*bf.realData/GetUnitState(spellCaster,UNIT_STATE_MAX_LIFE)
            endif 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MONK_DEFLECT)
            if bf > 0 then 
                set bf.DESTROY = true 
                set dmgBonus = dmgBonus+2*bf.realData/GetUnitState(spellCaster,UNIT_STATE_MAX_LIFE)
            endif 
            set dmg = dmg*dmgBonus 
            set damageTag_Earth = true 
            set damageFlag = 'S04M'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_LIGHT_BASH)

            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\sonicwave.mdx",spellTarget,"chest"))
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_MONK_KARMICTOUCH,500)
            set bf.shieldBlockPercent = 1
            set bf.shieldDestroy = true 
            set bf.shieldMaxValue = dmg
            call bf.apply()
        endfunction

        function SPELL_S04N takes nothing returns nothing   //还魂术
            local real heal = I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*4
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),900,playerAlly)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set healFlag = 'S04N'
                set healIsAOE = true 
                call UnitHealTarget(spellCaster,FirstOfGroup(pick),heal)
                call bufflist.flush()
                call bufflist.listUnitBuffs(FirstOfGroup(pick),false,true,true)
                call bufflist.dispelAllBuffs()
                call removeStun(FirstOfGroup(pick))
                call removeSnare(FirstOfGroup(pick))
                call removeSilence(FirstOfGroup(pick))
                call removeRoot(FirstOfGroup(pick))
                call removeCold(FirstOfGroup(pick))
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\VampiricAuraTargetBlue.mdx",FirstOfGroup(pick),"origin"))
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\White Ring.mdx",spellCaster,"origin"))
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\swarm_large.mdx",spellCaster,"origin"))
        endfunction

        function UNIT_nS0K_ATTACKED_SOURCE takes nothing returns nothing
            local master owner = minion.getMinionByUnit(damageSource).mast
            call GainFistStance(owner.masterUnit,1)
            set damageTag_Fire = true 
        endfunction
        function UNIT_nS0L_ATTACKED_SOURCE takes nothing returns nothing
            local master owner = minion.getMinionByUnit(damageSource).mast
            call GainChi(owner.masterUnit,0.05)
            set damageTag_Earth = true 
        endfunction
        function CHECK_STATE_nS0K takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 20*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/2
            call BlzSetUnitBaseDamage(checkingUnit,4*GetUnitLevel(owner.masterUnit)/9+6+R2I(I2R(GetUnitMaxAttack(owner.masterUnit,0))*0.5),0)
            call BlzSetUnitArmor(checkingUnit,3+3*GetUnitLevel(owner.masterUnit)/2)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function S04O_FIRE_IMMOLATION takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local group pick = null 
            if alive(ds) and ds != null then 
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(ds),GetUnitY(ds),250,playerEnemy)
                loop
                    exitwhen FirstOfGroup(pick) == null 
                    set damageIsAOE = true 
                    set damageTag_Fire = true 
                    set damageFlag = 'S04O'
                    call UnitDamageTarget(ds,FirstOfGroup(pick),0.25*I2R(GetUnitAttack(ds,0)),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                    call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\ImmolationRed\\ImmolationRedDamage.mdl",FirstOfGroup(pick),"chest"),100)
                    call GroupRemoveFirstUnit(pick)
                endloop
                call DestroyGroup(pick)
            else 
                set de.DESTROY = true 
            endif 
            set pick = null 
            set ds = null 
        endfunction
        function S04O_SUMMON_FIRE takes nothing returns nothing
            local delayedevent de = delayedevent.create(100,15,function S04O_FIRE_IMMOLATION)
            local projectile proj = projectile.currentProjectile
            local real x = proj.target_x
            local real y = proj.target_y
            local minion mini = minion.createWithFace(proj.source,'nS0K',x,y,GetUnitFacing(proj.dummy)-120)
            call SetUnitVertexColor(mini.summon,255,255,255,125)
            set mini.remove = true 
            set mini.deathSFX = "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl"
            call UnitApplyTimedLife(mini.summon,'BTLF',15)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl",x,y))
            call unitCheckState(mini.summon)
            call de.saveUnit("CASTER",mini.summon)
            set mini.bindSFX = AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\ImmolationRed\\ImmolationRedTarget.mdl",mini.summon,"chest")
        endfunction
        function CHECK_STATE_nS0L takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 25*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)
            call BlzSetUnitBaseDamage(checkingUnit,4*GetUnitLevel(owner.masterUnit)/9+6+R2I(I2R(GetUnitMaxAttack(owner.masterUnit,0))*0.1),0)
            call BlzSetUnitArmor(checkingUnit,5+5*GetUnitLevel(owner.masterUnit))
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function A664_DELAYED_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            set damageFlag = 'A664'
            set damageIsExtra = true 
            call UnitDamageTarget(de.loadUnit("SOURCE"),de.loadUnit("TARGET"),de.loadReal("DAMAGE"),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function A664_PREDAMAGE_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local delayedevent de = 0
            if bf.buffSource != null and alive(bf.buffSource) then 
                set de = delayedevent.create(1,1,function A664_DELAYED_DAMAGE)
                call de.saveUnit("SOURCE",damageSource)
                call de.saveUnit("TARGET",bf.buffSource)
                call de.saveReal("DAMAGE",damageFinalDamage*0.3)
                set damageFinalDamage = damageFinalDamage*0.7
            else 
                set bf.DESTROY = true 
            endif 
        endfunction
        function S04O_SUMMON_EARTH takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = proj.target_x
            local real y = proj.target_y
            local mybuff bf 
            local minion mini = minion.createWithFace(proj.source,'nS0L',x,y,GetUnitFacing(proj.dummy)+120)
            call SetUnitVertexColor(mini.summon,255,255,255,125)
            call unitAddState(mini.summon,STATE_RESISTANCE,3000)
            set mini.remove = true 
            set mini.deathSFX = "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl"
            call UnitApplyTimedLife(mini.summon,'BTLF',15)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl",x,y))
            call unitCheckState(mini.summon)
            set bf = CreateBuff(mini.summon,proj.source,BUFFTYPE_MONK_FIREEARTHSTORM,1500)
            call bf.addBefDmg_T(function A664_PREDAMAGE_TARGET)
            call bf.apply()
        endfunction
        function SPELL_S04O takes nothing returns nothing   //火土风暴
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetUnitFacing(spellCaster)/57.2956
            local projectile proj = CreateProjectileToLoc(spellCaster,x+200*Cos(a+1.047),y+200*Sin(a+1.047),300,0.25,"Units\\Creeps\\FirePandarenBrewmaster\\FirePandarenBrewmaster_Missile.mdl",null,function S04O_SUMMON_FIRE)
            set proj.ifCheckPath = true
            set proj.model_attach = "origin"
            call proj.launch()
            set proj = CreateProjectileToLoc(spellCaster,x+200*Cos(a-1.047),y+200*Sin(a-1.047),300,0.25,"Units\\Creeps\\EarthPandarenBrewmaster\\EarthPandarenBrewmaster_Missile.mdl",null,function S04O_SUMMON_EARTH)
            set proj.ifCheckPath = true
            set proj.model_attach = "origin"
            call proj.launch()
        endfunction
    //endregion 

    // region deathknight 死亡骑士
    ////////////////
    //HEROID = 9(10)
    ////////////////

        function HERO_10_MULTICAST takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local unit targetUnit = de.loadUnit("TARGET_U")
            local real targetX = de.loadReal("TARGET_X")
            local real targetY = de.loadReal("TARGET_Y")
            local integer spell = de.loadInteger("SPELL")
            local integer cost = 0
            //call BJDebugMsg("MULTI CAST "+I2SSSS(spell))

            set castingSpell = spell
            set spellCaster = caster 
            set spellTarget = targetUnit
            set spellTargetX = targetX
            set spellTargetY = targetY
            set spellCost = cost 
            set spellCooldown = 0
            set spellAbilityLevel = 0
            set spellTargetItem         = null 
            set SpellTargetDestructable = null 

            call Cast.execute()

            set caster = null 
            set targetUnit = null 
        endfunction
        function A63Z_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*0.5/5*mybuff.buffTimeScale*I2R(bf.intData)
            set damageIsDOT = true 
            set damageTag_Shadow = true 
            set damageFlag = 'A63Z'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function HERO_10_ATTACKING takes nothing returns nothing
            local integer maxStack = 3
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 6
            local real a 
            local real d 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B648') > 0 then 
                call UnitRemoveAbility(dt,'B648')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S033'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageDamage = damageDamage*1.2
                set damageFlag = 'S033'
                if GetUnitAbilityLevel(damageSource,'S034') > 0 then 
                    set eventBonusLeech = eventBonusLeech+0.1
                    if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,3) then 
                        set eventBonusLeech = eventBonusLeech+0.1
                    endif 
                    call AddUnitMana(damageSource,0.01*GetUnitState(damageSource,UNIT_STATE_MAX_MANA))
                    call Taunt(damageSource,damageTarget)
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodAcolyte.mdl",damageTarget,"origin"))
                elseif GetUnitAbilityLevel(damageSource,'S035') > 0 then 
                    set damageTag_Cold = true 
                    set damageAddCrit = damageAddCrit+0.1
                    if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,3) then 
                        set damageAddCritPower = damageAddCritPower+0.2
                    endif 
                    set damageDamage = damageDamage*1.25
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\LichMissile\\LichMissile.mdl",damageTarget,"chest"))
                elseif GetUnitAbilityLevel(damageSource,'S036') > 0 then 
                    if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,3) then 
                        set Qcd = Qcd-2
                    endif 
                    set damageTag_Shadow = true 
                    set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_DK_PLAGUESTRIKE,1500)
                    set bf.intData = IMinBJ(bf.intData+1,maxStack)
                    set bf.periodTime = 300
                    set bf.hasteAble = true
                    call bf.addPeriod(function A63Z_DOT)
                    call bf.apply()
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl",damageTarget,"chest"))
                endif 
                call BlzStartUnitAbilityCooldown(ds,'S033',Qcd*haste-0.01)
            endif

            set ds = null 
            set dt = null 
        endfunction
        function HERO_10_DAMAGING_TARGET takes nothing returns nothing
            if damageSource == damageTarget then 
                return 
            endif 
            if GetUnitAbilityLevel(damageTarget,'S034') > 0 then 
                set damageFinalDamage = damageFinalDamage*0.9
            endif 
        endfunction
        function HERO_10_LEARN_S034 takes nothing returns nothing
            call unitAddState(hero[9],STATE_LIFE_P,3000)
            call unitAddState(hero[9],STATE_ARMOR_P,3000)
        endfunction
        function HERO_10_RETRAIN_S034 takes nothing returns nothing
            call unitAddState(hero[9],STATE_LIFE_P,-3000)
            call unitAddState(hero[9],STATE_ARMOR_P,-3000)
        endfunction
        function HERO_10_LEARN_S035 takes nothing returns nothing
            call unitAddState(hero[9],STATE_CRIT_POWER,1000)
        endfunction
        function HERO_10_RETRAIN_S035 takes nothing returns nothing
            call unitAddState(hero[9],STATE_CRIT_POWER,-1000)
        endfunction
        function HERO_10_LEARN_S036 takes nothing returns nothing
            call unitAddState(hero[9],STATE_HASTE,1000)
            call unitAddState(hero[9],STATE_MOVE_SPEED_P,1000)
        endfunction
        function HERO_10_RETRAIN_S036 takes nothing returns nothing
            call unitAddState(hero[9],STATE_HASTE,-1000)
            call unitAddState(hero[9],STATE_MOVE_SPEED_P,-1000)
        endfunction

        function SPELL_S034 takes nothing returns nothing   //鲜血灵气
            local real dmg = R2I(GetUnitAttack(spellCaster,0))*1
            local group pick = CreateGroup()
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\BloodNova.mdx",spellCaster,"origin"))
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),350,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageFlag = 'S034'
                set eventBonusLeech = eventBonusLeech+0.25
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call Taunt(spellCaster,FirstOfGroup(pick))
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S035 takes nothing returns nothing   //冰霜灵气
            local real dmg = R2I(GetUnitAttack(spellCaster,0))*2.5
            local group pick = CreateGroup()
            //call BJDebugMsg("CAST S035")
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3mapimported\\Wind Blast - Classic.mdx",spellCaster,"origin"))
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),350,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageTag_Cold = true 
                set damageFlag = 'S035'
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applyCold(spellCaster,FirstOfGroup(pick),'ACO0')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S036 takes nothing returns nothing   //邪恶灵气
            local delayedevent de = 0
            local real dmg = R2I(GetUnitAttack(spellCaster,0))*4
            local mybuff bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_PLAGUESTRIKE)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*0.5*I2R(bf.remainingTime)/1500
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_DEATHKNIGHTSMARK)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*2*I2R(bf.remainingTime)/3000
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_SCOURGEPLAGUE)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*2*I2R(bf.remainingTime)/1200
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_FESTERINGPLAGUE)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*0.66*I2R(bf.remainingTime)/900
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_ICEPLAGUE)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*1.5*I2R(bf.remainingTime)/1800
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_VENOM)
            if bf > 0 then 
                set dmg = dmg+bf.realData*I2R(bf.remainingTime)/1200
                set bf.intData = 0
                set bf.DESTROY = true 
            endif 
            set damageTag_Shadow = true 
            set damageFlag = 'S036'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",spellTarget,"origin"))
            if GetUnitAbilityLevel(spellCaster,'S03C') > 0 then 
                set de = delayedevent.create(25,1,function HERO_10_MULTICAST)
                call de.saveUnit("CASTER",spellCaster)
                call de.saveUnit("TARGET_U",spellTarget)
                call de.saveReal("TARGET_X",GetUnitX(spellCaster))
                call de.saveReal("TARGET_Y",GetUnitY(spellCaster))
                call de.saveInteger("SPELL",'S03C')
            endif 
        endfunction

        function A640_PREDMG_T takes nothing returns nothing
            if damageTag_Cold and damageSource == mybuff.currentBuff.buffSource and damageIsDOT == false then 
                set damageAddCrit = damageAddCrit+0.3
                set mybuff.currentBuff.DESTROY = true 
            endif 
        endfunction
        function SPELL_S038 takes nothing returns nothing   //凛风冲击
            local mybuff bf 
            local group pick = CreateGroup()
            local real dmg = R2I(GetUnitAttack(spellCaster,0))*2.5
            set damageTag_Cold = true 
            set damageFlag = 'S038'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\splinterblastmainprojectile_pe.mdx",spellTarget,"chest"),100)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\FrostBolt\\FrostBoltMissile.mdl",spellTarget,"chest"))
            call applyCold(spellCaster,spellTarget,'ACO0')
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellTarget),GetUnitY(spellTarget),250,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                if FirstOfGroup(pick) != spellTarget then 
                    set damageTag_Cold = true 
                    set damageIsAOE = true 
                    set damageFlag = 'S038'
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg*0.3,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)      
                    call applyCold(spellCaster,FirstOfGroup(pick),'ACO0')
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_DK_FROSTBITE,3000)
            call bf.addPreDmg_T(function A640_PREDMG_T)
            call bf.apply()
        endfunction

        function A642_ATKED_T takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if unitCheckCooldown(damageTarget,'A642') then 
                if (HeroHaveTalent(damageTarget,HERO_ULTIMATE_TALENT,9) and random.get(damageTarget,0.75,'HTL9')) or HeroHaveTalent(damageTarget,HERO_ULTIMATE_TALENT,9) == false then 
                    set bf.intData = IMaxBJ(0,bf.intData-1)
                    if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                        set bf.bonusLife_P = 250*bf.intData
                        call bf.refreshStates()
                    endif 
                    call unitStartCooldown(damageTarget,'A642',100)
                    if bf.intData <= 0 then 
                        set bf.DESTROY = true 
                    endif 
                endif 
            endif 
        endfunction
        function SPELL_S037 takes nothing returns nothing   //白骨护甲
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_DK_BONEARMOR,3000)
            set bf.bonusArmor_P = 3000
            set bf.bonusBlock_P = 5000
            set bf.bonusBlock = 3*GetUnitLevel(spellCaster)
            if inCombat(spellCaster) then 
                set bf.intData = IMinBJ(10,bf.intData+5)
            else 
                set bf.intData = 10
            endif 
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                set bf.bonusLife_P = 250*bf.intData
            endif 
            call bf.addAtked_T(function A642_ATKED_T)
            call bf.apply()
        endfunction

        
        function A641_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*0.66/3*mybuff.buffTimeScale*I2R(bf.intData)
            set damageIsDOT = true 
            set damageTag_Shadow = true 
            set damageFlag = 'A641'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function CHECK_STATE_nS0G takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 10*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/3
            call BlzSetUnitBaseDamage(checkingUnit,1*GetUnitLevel(owner.masterUnit)/5+2+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ATTACK))*0.25),0)
            call BlzSetUnitArmor(checkingUnit,3+2*GetUnitLevel(owner.masterUnit)/3)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function UNIT_nS0G_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local integer maxStack = 3
            if random.get(damageSource,0.33,'nS0G') then 
                if HeroHaveTalent(damageMaster,HERO_PRIVATE_TALENT,6) then 
                    set maxStack = 5
                endif 
                set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_DK_FESTERINGPLAGUE,900)
                set bf.intData = IMinBJ(bf.intData+1,maxStack)
                set bf.periodTime = 300
                set bf.hasteAble = true
                call bf.addPeriod(function A641_DOT)
                call bf.apply()
            endif 
        endfunction
        function SPELL_S039 takes nothing returns nothing   //食尸鬼
            local minion mini = 0
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetRandomReal(-1.0472,1.0472)+GetUnitFacing(spellCaster)/57.2958
            local real d = 125
            local group pick = CreateGroup()
            local integer count = 0
            local integer maxcount = 1
            local mybuff bf 
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS0G' then 
                    set count = count+1
                    set mini = minion.getMinionByUnit(FirstOfGroup(pick))
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            if mini > 0 then 
                set bf = CreateBuff(spellCaster,mini.summon,BUFFTYPE_FRENZY,2000)
                set bf.bonusAttackSpeed = 3500
                set bf.bonusMoveSpeed_P = 3500
                call bf.apply()
            else
                set mini = minion.create(spellCaster,'nS0G',x+d*Cos(a),y+d*Sin(a))
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",x+d*Cos(a),y+d*Sin(a)))
                call unitAddState(mini.summon,STATE_RESISTANCE,1500)
                call unitCheckState.evaluate(mini.summon)
            endif 
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S03A takes nothing returns nothing   //湮灭
            local real dmg = R2I(GetUnitAttack(spellCaster,0))*5.5
            local delayedevent de
            local integer W = GetUnitAbility(spellCaster,ABILITY_W)
            if GetUnitAbilityLevel(spellCaster,'S034') > 0 then 
                set eventBonusLeech = eventBonusLeech+0.3
                set dmg = dmg*0.5
                call Taunt(spellCaster,spellTarget)
            elseif GetUnitAbilityLevel(spellCaster,'S035') > 0 then 
                set damageTag_Cold = true 
            elseif GetUnitAbilityLevel(spellCaster,'S036') > 0 then 
                set damageTag_Shadow = true 
            endif 
            set damageFlag = 'S03A'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_HEAVY_CHOP)
            call applyStun(spellCaster,spellTarget,'ATB0')
            if GetUnitAbilityLevel(spellCaster,'S034') > 0 then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Undead\\UndeadLargeDeathExplode\\UndeadLargeDeathExplode.mdl",spellTarget,"origin"))
            elseif GetUnitAbilityLevel(spellCaster,'S035') > 0 then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\LichMissile\\LichMissile.mdl",spellTarget,"chest"))
            elseif GetUnitAbilityLevel(spellCaster,'S036') > 0 then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",spellTarget,"chest"))
            endif 
            if W == 'S034' or W == 'S035' or W == 'S036' then 
                set de = delayedevent.create(25,1,function HERO_10_MULTICAST)
                call de.saveUnit("CASTER",spellCaster)
                call de.saveUnit("TARGET_U",spellTarget)
                call de.saveReal("TARGET_X",GetUnitX(spellCaster))
                call de.saveReal("TARGET_Y",GetUnitY(spellCaster))
                call de.saveInteger("SPELL",W)
            endif 
        endfunction
        function A644_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*2/10*mybuff.buffTimeScale*I2R(bf.intData)
            set damageIsDOT = true 
            set damageTag_Shadow = true 
            set damageFlag = 'A644'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function A644_PREDMG_T takes nothing returns nothing
            if damageTag_Cold and damageSource == mybuff.currentBuff.buffSource then 
                set damageAddCrit = damageAddCrit+0.15
                set damageFinalDamage = damageFinalDamage*1.15
            endif 
        endfunction
        function A644_DMGING_T takes nothing returns nothing
            if damageSource == mybuff.currentBuff.buffSource then 
                set eventBonusLeech = eventBonusLeech+0.15
            endif 
        endfunction
        function A644_ATKING takes nothing returns nothing
            local real a = 0.02
            if IsUnitEnemy(damageTarget,GetOwningPlayer(damageSource)) and IsUnitType(damageTarget,UNIT_TYPE_ANCIENT) == false then 
                set healFlag = 'A644'
                if damageSource == mybuff.currentBuff.buffSource then 
                    set a = a*1.5
                endif 
                call UnitHealTarget(damageTarget,damageTarget,GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE)*a)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",damageTarget,"origin"))
            endif 
        endfunction
        function SPELL_S03B takes nothing returns nothing   //死亡骑士印记
            local integer maxStack = 3
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_DK_DEATHKNIGHTSMARK,3000)
            if GetUnitAbilityLevel(spellCaster,'S036') > 0 then 
                set bf.intData = IMinBJ(maxStack,bf.intData+2)
                set bf.periodTime = 300
                set bf.hasteAble = true
                call bf.addPeriod(function A644_DOT)
            endif 
            if GetUnitAbilityLevel(spellCaster,'S034') > 0 then 
                call bf.addDmging_T(function A644_DMGING_T)
            endif 
            if GetUnitAbilityLevel(spellCaster,'S035') > 0 then 
                call bf.addPreDmg_T(function A644_PREDMG_T)
            endif 
            call bf.addAtking(function A644_ATKING)
            call bf.apply()
        endfunction
        function A643_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*2/4*mybuff.buffTimeScale*I2R(bf.intData)
            set damageIsDOT = true 
            set damageTag_Shadow = true 
            if GetUnitAbilityLevel(bf.buffSource,'S035') > 0 then 
                set damageTag_Cold = true 
            endif 
            set damageFlag = 'A643'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            if GetUnitAbilityLevel(bf.buffSource,'S034') > 0 then 
                set healFlag = 'A643'
                call UnitHealTarget(bf.buffSource,bf.buffSource,1.5*dmg)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",bf.buffSource,"origin"))
            endif 
        endfunction
        function SPELL_S03C takes nothing returns nothing   //根除
            local integer maxStack = 1
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_DK_SCOURGEPLAGUE,1200)
            local real dmg = R2I(GetUnitAttack(spellCaster,0))*2
            set bf.intData = IMinBJ(maxStack,bf.intData+1)
            set bf.periodTime = 300
            set bf.hasteAble = true
            call bf.addPeriod(function A643_DOT)
            call bf.apply()
            if GetUnitAbilityLevel(spellCaster,'S035') > 0 then 
                set damageTag_Cold = true 
            endif 
            set damageTag_Shadow = true 
            set damageFlag = 'S03C'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            if GetUnitAbilityLevel(spellCaster,'S034') > 0 then 
                call Taunt(spellCaster,spellTarget)
            endif 
            if GetUnitAbilityLevel(spellCaster,'S035') > 0 then 
                set bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_DK_FROSTBITE,3000)
                call bf.addPreDmg_T(function A640_PREDMG_T)
                call bf.apply()
            endif 
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3mapimported\\Dark Conversion Classic.mdx",spellTarget,"origin"))
        endfunction
        function A645_DMGING_T takes nothing returns nothing
            set damageFinalDamage = damageFinalDamage*0.8
        endfunction 
        function A645_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real x = GetUnitX(bf.buffSource)
            local real y = GetUnitY(bf.buffSource)
            local group pick = CreateGroup()
            local real dmg = R2I(GetUnitAttack(bf.buffSource,0))*0.5*mybuff.buffTimeScale
            call GroupEnumUnitsInRangeEx(pick,x,y,350,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageTag_Cold = true 
                set damageFlag = 'S035'
                call UnitDamageTarget(bf.buffSource,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set bf = CreateBuff(bf.buffSource,bf.buffSource,BUFFTYPE_DK_BONEARMOR,3000)
            set bf.bonusArmor_P = 3000
            set bf.bonusBlock_P = 5000
            set bf.bonusBlock = 5*GetUnitLevel(bf.buffSource)
            set bf.intData = IMinBJ(10,bf.intData+1)
            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,6) then 
                set bf.bonusLife_P = 250*bf.intData
            endif 
            call bf.addAtked_T(function A642_ATKED_T)
            call bf.apply()
        endfunction
        function SPELL_S03D takes nothing returns nothing   //白骨风暴
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_DK_BONESTORM,1000)
            set bf.periodTime = 100
            set bf.hasteAble = true
            call bf.addDmging_T(function A645_DMGING_T)
            call bf.addPeriod(function A645_PERIOD)
            call bf.apply()
        endfunction
        function S03E_HIT takes nothing returns nothing
            local mybuff bf 
            local real dmg = 5*GetUnitMaxAttack(waveCaster,0)
            if IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) then 
                set damageFlag = 'S03E'
                set damageIsAOE = true 
                set damageTag_Cold = true 
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applyCold(waveCaster,waveTarget,'ACO0')
                set bf = CreateBuff(waveCaster,waveTarget,BUFFTYPE_DK_FROSTBITE,3000)
                call bf.addPreDmg_T(function A640_PREDMG_T)
                call bf.apply()
            endif 
        endfunction
        function S03E_ATTACH_DUMMY takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit dummy = de.loadUnit("DUMMY")
            local projectile proj = de.loadInteger("PROJ")
            local real x = GetUnitX(proj.dummy)
            local real y = GetUnitY(proj.dummy)
            local real a = 0
            if proj.dummy == null or alive(proj.dummy) == false then 
                call KillUnit(dummy)
                set dummy = null
                set de.DESTROY = true  
                return 
            endif 
            if dummy != null and alive(dummy) then 
                set a = GetUnitFacing(dummy)
                call SetUnitX(dummy,x-170*Cos(a/57.2956))
                call SetUnitY(dummy,y-170*Sin(a/57.2956))
            endif 
            set dummy = null 
        endfunction
        function S03E_DELAYED_WAVE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local real a = de.loadReal("A")
            local unit dummy = de.loadUnit("DUMMY")
            local projectile proj = CreateWave(de.loadUnit("CASTER"),x+600*Cos(a/57.2956),y+600*Sin(a/57.2956),600,250,0,"",function S03E_HIT,null)
            set proj.LAUNCH_LOC = true 
            set proj.LAUNCH_UNIT = false 
            set proj.source_x = x 
            set proj.source_y = y
            call proj.launch()
            set de = delayedevent.create(1,99,function S03E_ATTACH_DUMMY)
            call de.saveUnit("DUMMY",dummy)
            call de.saveInteger("PROJ",proj)
            call UnitApplyTimedLife(dummy,'BHwe',1.0)
            call SetUnitAnimation(dummy,"stand")
            set dummy = null 
        endfunction
        function SPELL_S03E takes nothing returns nothing   //冰霜巨龙之怒
            local delayedevent de = delayedevent.create(130,1,function S03E_DELAYED_WAVE)
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = AngleByXY(x,y,spellTargetX,spellTargetY)
            local unit dummy = CreateUnit(PLAYER,'nS0F',x-164*Cos(a/57.2956),y-164*Sin(a/57.2956),a)
            call SetUnitAnimation(dummy,"birth")
            call de.saveUnit("DUMMY",dummy)
            call de.saveReal("X",x)
            call de.saveReal("Y",y)
            call de.saveReal("A",a)
            call de.saveUnit("CASTER",spellCaster)
            call BlzEndUnitAbilityCooldown(spellCaster,'S034')
            call BlzEndUnitAbilityCooldown(spellCaster,'S035')
            call BlzEndUnitAbilityCooldown(spellCaster,'S036')
            set dummy = null 
        endfunction
        function A646_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = bf.realData/7*I2R(bf.intData)*mybuff.buffTimeScale
            set damageIsDOT = true 
            set damageTag_Shadow = true 
            set damageFlag = 'A646'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S03F takes nothing returns nothing   //恶疾爆发
            local real dmg = R2I(GetUnitAttack(spellCaster,0))*1
            local group pick = CreateGroup()
            local mybuff bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_PLAGUESTRIKE)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*0.5*I2R(bf.remainingTime)/1500*1.5
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_DEATHKNIGHTSMARK)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*2*I2R(bf.remainingTime)/3000*1.5
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_SCOURGEPLAGUE)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*2*I2R(bf.remainingTime)/1200*1.5
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_ICEPLAGUE)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*1.5*I2R(bf.remainingTime)/1800*1.5
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_DK_FESTERINGPLAGUE)
            if bf > 0 then 
                set dmg = dmg+I2R(GetUnitAttack(bf.buffSource,0))*0.66*I2R(bf.remainingTime)/900*1.5
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\Acid Ex.mdx",spellTarget,"origin"))
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellTarget),GetUnitY(spellTarget),300,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageTag_Shadow = true 
                set damageFlag = 'S03F'
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_DK_VENOM,700)
                set bf.periodTime = 100
                set bf.hasteAble = true 
                set bf.realData = dmg 
                set bf.intData = 1 
                call bf.addPeriod(function A646_PERIOD)
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
    //endregion 

    // region warlock 魔巫
    ////////////////
    //HEROID = 12(13)
    ////////////////
        function S00Z_HIT takes nothing returns nothing
            local projectile proj 
            local unit ds = projectile.currentProjectile.source
            local unit dt = projectile.currentProjectile.target
            call projectile.currentProjectile.applyDamageSet()
            call enableRandomElement()
            set damageFlag = 'S00Z'
            call UnitDamageTarget(ds,dt,I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            set ds = null 
            set dt = null 
        endfunction
        function HERO_13_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            if GetUnitAbilityLevel(dt,'B60S') > 0 then 
                call UnitRemoveAbility(dt,'B60S')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S00Z'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = BlzGetUnitAbilityCooldown(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set attackingMissile.model_path = "war3campImported\\DarknessBomb.mdx"  
                set attackingMissile.curve = 0 
                set attackingMissile.speed = 900
                set attackingMissile.flag = 'S00Z'
                call attackingMissile.addOnHit(function S00Z_HIT)  

                
            endif 
            set ds = null 
            set dt = null 
        endfunction
        function CHECK_STATE_nS01 takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 20*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/3
            call BlzSetUnitBaseDamage(checkingUnit,2*GetUnitLevel(owner.masterUnit)/5+1+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER))*0.13),0)
            call BlzSetUnitArmor(checkingUnit,4+2*GetUnitLevel(owner.masterUnit)/3)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function A676_ENDING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call KillUnit(bf.buffTarget)
        endfunction
        function SPELL_S010 takes nothing returns nothing   //召唤骷髅
            local minion mini 
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetRandomReal(-1.0472,1.0472)+GetUnitFacing(spellCaster)/57.2958
            local real d = 125
            local group pick = CreateGroup()
            local integer count = 0
            local integer maxcount = 2
            local mybuff bf = 0
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS01' then 
                    set count = count+1
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if count == maxcount and GetUnitTypeId(FirstOfGroup(pick)) == 'nS01' then 
                    if bf == 0 and mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_WARLOCK_SKELETONPOWER) == 0 then 
                        set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_WARLOCK_SKELETONPOWER,2000)
                        set bf.bonusAttackSpeed = 5000
                        call bf.addEnding(function A676_ENDING)
                        call bf.apply()
                        call SetUnitVertexColor(FirstOfGroup(pick),75,255,75,175)
                    endif 
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            if count < maxcount then 
                set mini = minion.create(spellCaster,'nS01',x+d*Cos(a),y+d*Sin(a))
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",x+d*Cos(a),y+d*Sin(a)))
                call unitCheckState.evaluate(mini.summon)
                call delayedPauseUnit(mini.summon,200)
                call delayedPlayAnimation(mini.summon,"birth",233)
            endif 
            call DestroyGroup(pick)

            set pick = null 
        endfunction
        function CHECK_STATE_nS02 takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 15*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/4
            call BlzSetUnitBaseDamage(checkingUnit,1*GetUnitLevel(owner.masterUnit)/5+2+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER))*0.25),0)
            call BlzSetUnitArmor(checkingUnit,4+2*GetUnitLevel(owner.masterUnit)/4)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function SPELL_A63F takes nothing returns nothing
            local unit target = null 
            local mybuff bf 
            if (minion.getMinionByUnit(spellCaster).currentTarget != null and alive(minion.getMinionByUnit(spellCaster).currentTarget)) or (minion.getMinionByUnit(spellCaster).mast.lastTarget != null and alive(minion.getMinionByUnit(spellCaster).mast.lastTarget)) then 
                set target = minion.getMinionByUnit(spellCaster).currentTarget
                if target == null or alive(target) == false then 
                    set target = minion.getMinionByUnit(spellCaster).mast.lastTarget
                endif
                if target == null or alive(target) == false then 
                    set target = null 
                    return 
                endif 
                set bf = mybuff.create(spellCaster,target,BUFFTYPE_CURSEOFPAIN)
                set bf.lastTime = 1200
                set bf.periodTime = 200
                set bf.hasteAble = true 
                call bf.addPeriod(function SE00_DOT)
                set bf.realData = GetUnitMaxAttack(spellCaster,0)*0.66
                set bf.bonusAccuracy = -500
                call bf.apply()
            endif 
        endfunction
        function UNIT_nS02_ATTACKING takes nothing returns nothing
            set damageTag_Shadow = true 
            set damageAddAccuracy = 1000
            set damageFlag = 'S012'
            set damageDamageType = DAMAGE_TYPE_MAGIC
            set damageAttackType = ATTACK_TYPE_NORMAL
        endfunction
        function SPELL_S012 takes nothing returns nothing   //骷髅法师
            local minion mini 
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetRandomReal(-1.0472,1.0472)+GetUnitFacing(spellCaster)/57.2958
            local real d = 125
            local group pick = CreateGroup()
            local integer count = 0
            local integer maxcount = 1
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS02' then 
                    set count = count+1
                    call applySilence(spellCaster,minion.getMinionByUnit(FirstOfGroup(pick)).currentTarget,'ASI1')
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            if count < maxcount then 
                set mini = minion.create(spellCaster,'nS02',x+d*Cos(a),y+d*Sin(a))
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",x+d*Cos(a),y+d*Sin(a)))
                call unitAddState(mini.summon,STATE_RESISTANCE,2000)
                call unitCheckState.evaluate(mini.summon)
                call delayedPauseUnit(mini.summon,200)
                call delayedPlayAnimation(mini.summon,"birth",233)
            endif 
            call DestroyGroup(pick)

            set pick = null 
        endfunction
        function S013_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = proj.realData*I2R(unitGetAllBonusStateValue(proj.source,STATE_ABILITY_POWER))*3.5*(1+I2R(unitGetAllBonusStateValue(proj.source,STATE_CRIT))/10000)
            call proj.applyDamageSet()
            call enableAllElements()
            set damageAddCrit = damageAddCrit+100
            set damageFlag = 'S013'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S013 takes nothing returns nothing   //混乱之箭
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,700,0,"war3campImported\\decimate_missile_Medium.mdx",function S013_HIT,null)
            set proj.flag = 'S013'
            set proj.realData = 1
            call proj.launch()
        endfunction
        function CHECK_STATE_nS03 takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 20*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/2
            local integer miniBonusAbilityPower = 10+unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER)/2
            call BlzSetUnitBaseDamage(checkingUnit,4*GetUnitLevel(owner.masterUnit)/9+6+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER))*0.25),0)
            call BlzSetUnitArmor(checkingUnit,8+3*GetUnitLevel(owner.masterUnit)/4)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
            call unitAddState(checkingUnit,STATE_ABILITY_POWER,miniBonusAbilityPower-GetHeroData(checkingUnit,"BONUSED_ABILITY_POWER"))
            call SetHeroData(checkingUnit,"BONUSED_ABILITY_POWER",miniBonusAbilityPower)
        endfunction
        function UNIT_nS03_ATTACKING takes nothing returns nothing
            set damageTag_Shadow = true 
            set damageAddAccuracy = 1000
            set damageFlag = 'S014'
            set damageDamageType = DAMAGE_TYPE_MAGIC
            set damageAttackType = ATTACK_TYPE_NORMAL
            if HeroHaveTalent(damageMaster,HERO_PRIVATE_TALENT,7) then 
                call AddUnitMana(damageSource,15)
            else 
                call AddUnitMana(damageSource,7.5)
            endif 
        endfunction
        function S014_HIT takes nothing returns nothing
            local real dmg = projectile.currentProjectile.realData
            set damageFlag = 'A60R'
            call UnitDamageTarget(projectile.currentProjectile.source,projectile.currentProjectile.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_A60R takes nothing returns nothing
            local unit target = null 
            local real dmg = 0
            local group pick = null 
            local integer i = 0
            local projectile proj = 0
            if (minion.getMinionByUnit(spellCaster).currentTarget != null and alive(minion.getMinionByUnit(spellCaster).currentTarget)) or (minion.getMinionByUnit(spellCaster).mast.lastTarget != null and alive(minion.getMinionByUnit(spellCaster).mast.lastTarget)) then 
                set target = minion.getMinionByUnit(spellCaster).currentTarget
                if target == null or alive(target) == false then 
                    set target = minion.getMinionByUnit(spellCaster).mast.lastTarget
                endif 
                if GetRandomReal(0,1) < 0.5 then 
                    call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",GetUnitX(target),GetUnitY(target)))
                    set dmg = 2.5*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))
                    set damageTag_Cold = true 
                    set damageFlag = 'A60R'
                    call UnitDamageTarget(spellCaster,target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                    call applyCold(spellCaster,target,'A600')
                    set pick = CreateGroup()
                    call GroupEnumUnitsInRangeEx(pick,GetUnitX(target),GetUnitY(target),175,playerEnemy)
                    loop 
                        exitwhen FirstOfGroup(pick) == null 
                        if FirstOfGroup(pick) != target then 
                            set damageTag_Cold = true 
                            set damageIsAOE = true 
                            set damageFlag = 'A60R'
                            call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg*0.5,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                            call applyCold(spellCaster,FirstOfGroup(pick),'A600')
                        endif 
                        call GroupRemoveUnit(pick,FirstOfGroup(pick))
                    endloop 
                else
                    set dmg = 3*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))
                    set pick = CreateGroup()
                    call GroupEnumUnitsInRangeEx(pick,GetUnitX(target),GetUnitY(target),200,playerEnemy)
                    if CountUnitsInGroup(pick) > 3 then 
                        set i = CountUnitsInGroup(pick)-3
                        loop 
                            exitwhen i >= CountUnitsInGroup(pick)
                            call GroupRemoveUnit(pick,GroupPickRandomUnitEx(pick))
                            set i = i+1
                        endloop
                    endif 
                    loop 
                        exitwhen FirstOfGroup(pick) == null 
                        set proj = projectile.create(spellCaster)
                        set proj.model_path = "war3campImported\\PeeKay's BoneSpear.mdx"
                        set proj.speed = 900
                        set proj.curve = 0
                        set proj.realData = dmg
                        set proj.target = FirstOfGroup(pick)
                        set proj.TARGET_UNIT = true 
                        set proj.LAUNCH_UNIT = true 
                        call proj.addOnHit(function S014_HIT)
                        call proj.launch()
                        call GroupRemoveUnit(pick,FirstOfGroup(pick))
                    endloop 
                    call SetHeroData(spellCaster,"SPELL_INDEX",0)
                endif 
                call DestroyGroup(pick)
                set pick = null 
                set target = null 
            else 
                call AddUnitMana(spellCaster,50)
            endif 
            set target = null 
            set pick = null 
        endfunction
        function A675_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call AddUnitMana(bf.buffTarget,2.5)
        endfunction 
        function SPELL_S014 takes nothing returns nothing   //巫妖
            local minion mini 
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetRandomReal(-1.0472,1.0472)+GetUnitFacing(spellCaster)/57.2958
            local real d = 100
            local group pick = CreateGroup()
            local integer count = 0
            local integer maxcount = 1
            local mybuff bf = 0
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS03' then 
                    set count = count+1
                    set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_WARLOCK_LICHPOWER,500)
                    set bf.periodTime = 10
                    call bf.addPeriod(function A675_PERIOD)
                    call bf.apply()
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            if count < maxcount then 
                set mini = minion.create(spellCaster,'nS03',x+d*Cos(a),y+d*Sin(a))
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",x+d*Cos(a),y+d*Sin(a)))
                call unitAddState(mini.summon,STATE_RESISTANCE,4000)
                call unitCheckState.evaluate(mini.summon)
            endif 

            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function S011_DOT takes nothing returns nothing
            local real dmg = mybuff.currentBuff.realData*I2R(unitGetAllBonusStateValue(mybuff.currentBuff.buffSource,STATE_ABILITY_POWER))*2.5/6*mybuff.buffTimeScale
            set damageTag_Ignite = true 
            set damageTag_Fire = true 
            set damageTag_Shadow = true 
            set damageIsDOT = true 
            set damageFlag = 'A612'
            call UnitDamageTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function WarlockApplyHoloCaust takes unit source,unit target,integer duration returns nothing
            local mybuff bf = mybuff.create(source,target,BUFFTYPE_WARLOCK_HOLOCAUST)
            local integer iiii
            set iiii = bf.remainingTime
            set bf.periodTime = 200
            call bf.addPeriod(function S011_DOT)
            set bf.hasteAble = true 
            set bf.lastTime = duration
            if HeroHaveTalent(source,HERO_ULTIMATE_TALENT,10) then 
                set bf.lastTime = R2I(I2R(duration)*1.15)
            endif 
            call bf.apply()
            if HeroHaveTalent(source,HERO_ULTIMATE_TALENT,10) and bf.lastTime > 0 then
                set bf.realData = RMinBJ(5,1+bf.realData*(I2R(iiii)/I2R(bf.lastTime)))
            else 
                set bf.realData = 1
            endif 
        endfunction
        function SPELL_S011 takes nothing returns nothing   //燔祭
            local real dmg 
            local mybuff bf 
            set damageTag_Fire = true 
            set damageTag_Shadow = true 
            set damageTag_Ignite = true 
            set damageFlag = 'S011'
            set dmg = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*2
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_WARLOCK_HOLOCAUST)
            if bf != 0 then 
                set dmg = dmg*(1+I2R(unitGetAllBonusStateValue(spellCaster,STATE_CRIT))/10000)
                set damageAddCrit = damageAddCrit+100
            endif 
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call WarlockApplyHoloCaust(spellCaster,spellTarget,1200)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",spellTarget,"origin"))
        endfunction
        function SPELL_S01I takes nothing returns nothing   //灾变
            local mybuff bf 
            local real dmg 
            local group newgroup = CreateGroup()
            call GroupEnumUnitsInRangeEx(newgroup,spellTargetX,spellTargetY,250,playerEnemy)
