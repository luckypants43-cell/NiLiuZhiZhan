            call SetTalentArt(heroId,index,true,"ReplaceableTextures\\CommandButtons\\BTNSpellBreakerMagicDefend.blp")
            call SetTalentName(heroId,index,"法御之墙")
            call SetTalentDescription(heroId,index,"获得相当于你法力上限|cff20c00010%%|r的格挡值；\n\n提高|cff20c00010%%|r的格挡和法术抗性上限")
            
