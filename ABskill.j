    function HERO_14_TALENT_SPELLING_1 takes nothing returns nothing
        local mybuff bf = 0
        if castingSpell == 'S056' or castingSpell == 'S057' then 
            set bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_DH_CUTSOUL,1000)
            set bf.bonusResistance = -800
            call bf.apply()
        endif 
    endfunction
    function HERO_14_TALENT_LEARN_2 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_HASTE,500)
        call unitAddState(currentTTOwner,STATE_ATTACK_SPEED,500)
        call unitAddState(currentTTOwner,STATE_EVADE,500)
        call unitAddState(currentTTOwner,STATE_MAX_EVADE,500)
    endfunction
    function HERO_14_TALENT_RESET_2 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_HASTE,-500)
        call unitAddState(currentTTOwner,STATE_ATTACK_SPEED,-500)
        call unitAddState(currentTTOwner,STATE_EVADE,-500)
        call unitAddState(currentTTOwner,STATE_MAX_EVADE,-500)
    endfunction
    function HERO_14_TALENT_PREDAMAGE_TARGET_2 takes nothing returns nothing
        if damageTag_Attack == false and damageIsDOT == false then 
            if random.get(damageTarget,RMinBJ(damageMaxEvadeChance,damageEvade)-damageAccuracy-damageAddAccuracy,'AEev') then 
                set damageDamage = damageDamage*0.5
                set damageIfEvade = true 
            endif 
        endif
    endfunction

    function HERO_14_TALENT_BEFOREDAMAGE_SOURCE_5 takes nothing returns nothing
        if damageFlag == 'S05B' or damageFlag == 'S05C' or damageFlag == 'S05D' then 
            call enableAllElements()
        endif 
    endfunction
    function HERO_14_TALENT_DAMAGING_SOURCE_5 takes nothing returns nothing
        if damageTag_Arcane and damageTag_Cold and damageTag_Fire and damageTag_Divine and damageTag_Shadow and damageTag_Earth and damageTag_Lightning then 
            set damageFinalDamage = damageFinalDamage*1.25
            set eventBonusLeech = eventBonusLeech+0.1
        endif 
    endfunction
    
    function HERO_14_TALENT_AFTERDAMAGE_SOURCE_6 takes nothing returns nothing
        local mybuff bf = 0
        if damageFlag == 'S056' or damageFlag == 'S057' then 
            if GetUnitAbilityLevel(damageSource,'S05F') > 0 then 
                set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_DH_IMMOLATION)
                if bf > 0 then 
                    set bf.remainingTime = bf.remainingTime+100
                endif 
            endif 
        endif 
    endfunction

    function A685_PERIOD takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real nowVal = bf.shieldNowValue
        local real maxVal = RMaxBJ(0.01,GetUnitState(bf.buffSource,UNIT_STATE_MAX_LIFE)*0.33)
        set bf.bonusHaste = IMaxBJ(0,R2I(1000*nowVal/maxVal))
        if bf.bonusHaste != bf.bonusedHaste then 
            set bf.needRefreshState = true 
        endif 
    endfunction
    function HERO_14_TALENT_AFTERDAMAGE_SOURCE_7 takes nothing returns nothing
        local mybuff bf = 0
        local real maxVal = 0
        if damageTag_Fire then 
            set maxVal = GetUnitState(damageSource,UNIT_STATE_MAX_LIFE)*0.33
            set bf = CreateBuff(damageSource,damageSource,BUFFTYPE_DH_REVELINPAIN,3000)
            set bf.shieldBlockPercent = 1
            set bf.shieldMaxValue = bf.shieldMaxValue+0.16*damageDamage
            set bf.addShield = true 
            set bf.addShieldMaxValue = maxVal
            set bf.bonusHaste = bf.bonusedHaste
            set bf.shieldDestroy = true 
            set bf.periodTime = 10
            call bf.addPeriod(function A685_PERIOD)
            call bf.apply()
        endif   
    endfunction
    function HERO_14_TALENT_BEFOREDAMAGE_SOURCE_7 takes nothing returns nothing
        if damageFlag == 'S059' or damageFlag == 'S05A' then 
            set damageTag_Fire = true 
        endif 
    endfunction
    
    function HERO_14_TALENT_BEFOREDAMAGE_SOURCE_8 takes nothing returns nothing
        if damageFlag == 'S056' or damageFlag == 'S057' then
            if damageTag_Fire then 
                set damageDamage = damageDamage*1.2
            else 
                set damageTag_Fire = true 
            endif 
            if damageFlag == 'S056' then 
                set damageAddCrit = damageAddCrit+0.15
            else 
                set eventBonusLeech = eventBonusLeech+0.15
            endif 
        endif 
    endfunction

    function HERO_14_TALENT_SPELLING_10 takes nothing returns nothing
        local integer abi = 0
        if castingSpell == 'S05H' then
            set abi = 'S058'
            if GetUnitAbilityLevel(spellCaster,abi) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,abi) > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,abi,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,abi)-15))
            endif 
            set abi = 'S059'
            if GetUnitAbilityLevel(spellCaster,abi) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,abi) > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,abi,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,abi)-15))
            endif 
            set abi = 'S05A'
            if GetUnitAbilityLevel(spellCaster,abi) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,abi) > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,abi,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,abi)-15))
            endif 
            set abi = 'S05B'
            if GetUnitAbilityLevel(spellCaster,abi) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,abi) > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,abi,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,abi)-15))
            endif 
            set abi = 'S05D'
            if GetUnitAbilityLevel(spellCaster,abi) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,abi) > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,abi,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,abi)-15))
            endif 
            set abi = 'S05E'
            if GetUnitAbilityLevel(spellCaster,abi) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,abi) > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,abi,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,abi)-15))
            endif 
            set abi = 'S05F'
            if GetUnitAbilityLevel(spellCaster,abi) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,abi) > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,abi,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,abi)-15))
            endif 
            set abi = 'S05G'
            if GetUnitAbilityLevel(spellCaster,abi) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,abi) > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,abi,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,abi)-15))
            endif 
        endif
    endfunction

    function HERO_14_TALENT_11_RESET_STATES takes mybuff this returns nothing
        local integer value = 3600
        local real array weights
        local integer i = 0
        local real p = 0.5
        local real sum = 0
        local integer array result
        local integer allocated = 0
        loop
            exitwhen i > 7
            set weights[i] = Pow(GetRandomReal(0.0,1.0),p)
            set sum = sum+weights[i]
            set i = i+1
        endloop

        if sum == 0.0 then 
            set sum = 1.0
        endif 

        set i = 0
        loop
            exitwhen i > 7
            if i < 7 then 
                set result[i] = R2I(I2R(value)*weights[i]/sum)
                if result[i] < 0 then 
                    set result[i] = 0
                endif 
                set allocated = allocated+result[i]
            else 
                set result[i] = value-allocated
            endif 
            set i = i+1
        endloop

        set this.bonusAttack_P      = result[0]
        set this.bonusArmor_P       = result[1]
        set this.bonusAgi_P         = result[2]
        set this.bonusCrit          = result[3]
        set this.bonusHaste         = result[4]
        set this.bonusEvade         = result[5]
        set this.bonusLeech         = result[6]
        set this.bonusVersatility   = result[7]
        set this.needRefreshState   = true 
    endfunction
    function A686_AFTERDAMAGE_TARGET takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        set bf.realData = bf.realData+damageFinalDamage
        if bf.realData >= 0.15*GetUnitState(bf.buffTarget,UNIT_STATE_MAX_LIFE) then 
            set bf.realData = 0
            call HERO_14_TALENT_11_RESET_STATES(bf)
        endif 
    endfunction
    function A686_PERIOD takes nothing returns nothing
        call HERO_14_TALENT_11_RESET_STATES(mybuff.currentBuff)
    endfunction
    function HERO_14_TALENT_LEARN_11 takes nothing returns nothing
        local mybuff bf = CreateBuff(currentTTOwner,currentTTOwner,BUFFTYPE_DH_CHAOSTHEORY,36000000)
        set bf.periodTime = 1666
        call bf.addPeriod(function A686_PERIOD)
        set bf.removeWhenDeath = false 
        set bf.realData = 0
        call bf.addAftDmg_T(function A686_AFTERDAMAGE_TARGET)
        call HERO_14_TALENT_11_RESET_STATES(bf)
        call bf.apply()
    endfunction
    function HERO_14_TALENT_RESET_11 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(currentTTOwner,BUFFTYPE_DH_CHAOSTHEORY)
        if bf > 0 then 
            set bf.DESTROY = true 
        endif 
    endfunction

    function HERO_14_TALENT_DAMAGED_TARGET_12 takes nothing returns nothing
        if alive(damageTarget) and unitCheckCooldown(damageTarget,'HTLC') then 
            if damageFinalDamage >= 0.5+GetUnitState(damageTarget,UNIT_STATE_LIFE) then 
                set damageFinalDamage = 0
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\hiveNewModels\\Royal Guard.mdx",damageTarget,"origin"))
                call SetUnitState(damageTarget,UNIT_STATE_LIFE,GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))
                call DemonHunterTransformToDemon(damageTarget,1000)
                call unitStartCooldown(damageTarget,'HTLC',30000)
            endif 
        endif 
    endfunction
