        call unitAddState(currentTTOwner,STATE_HASTE,2000)
        call unitAddState(currentTTOwner,STATE_MOVE_SPEED_P,2000)
    endfunction
    function HERO_15_TALENT_RESET_9 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_HASTE,-2000)
        call unitAddState(currentTTOwner,STATE_MOVE_SPEED_P,-2000)
    endfunction

    function HERO_15_TALENT_HEALING_SOURCE_10 takes nothing returns nothing
        set healFinalHeal = healFinalHeal*1.2
    endfunction
    function HERO_15_TALENT_HEALING_TARGET_10 takes nothing returns nothing
        set healFinalHeal = healFinalHeal*1.2
    endfunction

    function HERO_15_TALENT_11_DELAYED_DAMAGE takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        set damageFlag = 'B664'
        call UnitDamageTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("DAMAGE"),false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WOOD_LIGHT_BASH)
    endfunction
    function HERO_15_TALENT_PREDAMAGE_SOURCE_11 takes nothing returns nothing
        set damageCritChance = RMaxBJ(0.1,damageCritChance)
    endfunction
    function HERO_15_TALENT_PREHEAL_SOURCE_11 takes nothing returns nothing
        set healCritChance = RMaxBJ(0.1,healCritChance)
    endfunction
    function HERO_15_TALENT_DAMAGED_SOURCE_11 takes nothing returns nothing
        local delayedevent de = 0
        if damageIfCrit then 
            set damageFinalDamage = damageFinalDamage*1.25
            if damageTag_Attack and GetRandomReal(0,1) < 0.5 then 
                set de = delayedevent.create(15,1,function HERO_15_TALENT_11_DELAYED_DAMAGE)
                call de.saveUnit("CASTER",damageSource)
                call de.saveUnit("TARGET",damageTarget)
                call de.saveReal("DAMAGE",0.5*I2R(GetUnitAttack(damageSource,0)))
            endif 
        endif 
    endfunction
    function HERO_15_TALENT_HEALED_SOURCE_11 takes nothing returns nothing
        local mybuff bf 
        if healIfCrit then 
            set healFinalHeal = healFinalHeal*1.25
            set bf = mybuff.getUnitBuff(healTarget,BUFFTYPE_MONK_MISTYHAZE)
            if healIsDOT == false and bf != 0 then 
                set bf.remainingTime = bf.remainingTime+200
            endif 
        endif 
    endfunction

    function HERO_15_TALENT_PREDAMAGE_TARGET_12 takes nothing returns nothing
        set damageCanEvade = false 
        set damageFinalDamage = damageFinalDamage/(1+(RMinBJ(damageMaxEvadeChance,damageEvade)-damageAccuracy-damageAddAccuracy)/2)
    endfunction
    function HERO_15_TALENT_DAMAGING_TARGET_12 takes nothing returns nothing
        if mybuff.getUnitBuff(damageSource,BUFFTYPE_MONK_ACUPOINTSEAL) > 0 then 
            set damageFinalDamage = damageFinalDamage*0.9
        endif 
    endfunction
    function HERO_15_TALENT_DAMAGING_SOURCE_12 takes nothing returns nothing
        if mybuff.getUnitBuff(damageTarget,BUFFTYPE_MONK_ACUPOINTSEAL) > 0 then 
            set damageFinalDamage = damageFinalDamage*1.1
        endif 
    endfunction
    function HERO_15_TALENT_AFTERDAMAGE_TARGET_12 takes nothing returns nothing
        if GetRandomReal(0,1) < 0.25 then 
            call MonkApplyAcupointSeal(damageTarget,damageSource)
        endif 
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_16
    //====================================================
    function HERO_16_DEATH takes nothing returns nothing
        set HERO_16_TALENT_1_ORBIT = 0 
    endfunction
    globals
        Orbit HERO_16_TALENT_1_ORBIT = 0
    endglobals
    function HERO_16_TALENT_SPELLING_1 takes nothing returns nothing
        local Orbit this = HERO_16_TALENT_1_ORBIT
        local boolean new = false 
        local integer i = 0
        if castingSpell == 'S00I' or castingSpell == 'S00H' then 
            if this == 0 then 
                set new = true 
            else 
                if this.flag != 'B601' or this.center != spellCaster or this.count == 0 then 
                    set new = true 
                endif 
            endif 
            if new then 
                set this = CreateOrbit(spellCaster,100,1.256,4,'hMSL')
                set this.flag = 'B601'
                loop
                    exitwhen i > 3
                    set this.bindSFX[i] = AddSpecialEffectTargetEX("war3campImported\\firespirit_2.mdx",this.satellites[i],"chest")
                    set i = i+1
                endloop
                set HERO_16_TALENT_1_ORBIT = this 
            else 
                if this.count <= 3 then 
                    loop
                        exitwhen this.count > 3
                        call this.addSatellite(CreateUnit(PLAYER,'hMSL',GetUnitX(spellCaster),GetUnitY(spellCaster),GetUnitFacing(spellCaster)))
                        set this.bindSFX[this.count-1] = AddSpecialEffectTargetEX("war3campImported\\firespirit_2.mdx",this.satellites[this.count-1],"chest")
                    endloop
                endif 
            endif 
        endif 
    endfunction
    function HERO_16_TALENT_1_HIT takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        local real dmg = I2R(ST_ABILITY_POWER.getTotalState(proj.source))*0.3
        set damageTag_Fire = true 
        set damageAddCrit = 1000
        set dmg = dmg*(1+I2R(ST_CRIT_CHANCE.getTotalState(proj.source))/10000)
        set damageFlag = 'B601'
        call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        call KillUnit(proj.dummy)
    endfunction
    function HERO_16_TALENT_ATTACKING_1 takes nothing returns nothing
        local Orbit this = HERO_16_TALENT_1_ORBIT
        local projectile proj = 0
        if this != 0 then 
            if this.count > 0 then
                if this.center == damageSource and this.flag == 'B601' then  
                    set proj = ChargeUnit(this.pickTopSatellite(),damageTarget,1000,0,0,false,function HERO_16_TALENT_1_HIT,null)
                    set proj.source = damageSource
                    set proj.ifDestroy = true 
                    set proj.model = this.bindSFX[this.count-1]
                    set this.bindSFX[this.count-1] = null 
                    call this.removeSatellite(this.pickTopSatellite())
                    if this.count <= 0 then 
                        set HERO_16_TALENT_1_ORBIT = 0
                    endif 
                else 
                    set HERO_16_TALENT_1_ORBIT = 0
                endif 
            else 
                set HERO_16_TALENT_1_ORBIT = 0
            endif 
        endif 
    endfunction

    globals 
        boolean HERO_16_TALENT_5_CHANGE = false 
    endglobals
    function A60K_END takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        call AddUnitMana(bf.buffSource,0.05*GetUnitState(bf.buffSource,UNIT_STATE_MAX_MANA))
        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl",bf.buffSource,"origin"))
        set HERO_16_TALENT_5_CHANGE = true 
        call State.checkAll(bf.buffSource)
    endfunction
    function HERO_16_TALENT_CHECK_STATE_5 takes nothing returns nothing
        if HERO_16_TALENT_5_CHANGE then 
            call BlzSetAbilityTooltip('S00G',"炎爆术",0)
            call BlzSetAbilityExtendedTooltip('S00G',"|cffadadff可在攻击时自动释放|r\n|cffadadff取消攻击|r\n发射一枚巨大的火球攻击目标敌人，造成|cffffcc00法术强度×3.5|r的法术伤害并点燃目标，在后续的12秒内额外造成|cffffcc00法术强度×1.5|r的法术伤害。\n|cff888888火焰、点燃、持续效果|r",0)
            call BlzSetAbilityActivatedIcon('S00G',"replaceabletextures\\commandbuttons\\mage_ability\\btnpyroblast.blp")
        else 
            call BlzSetAbilityTooltip('S00G',"火球术",0)
            call BlzSetAbilityExtendedTooltip('S00G',"|cffadadff可在攻击时自动释放\n取消攻击|r\n向目标投掷火球，造成|cffffcc00法术强度×1|r的法术伤害。\n|cff888888火焰|r",0)
            call BlzSetAbilityActivatedIcon('S00G',"replaceabletextures\\commandbuttonsauto\\mage_ability\\btnfireball_original.blp")
        endif 
    endfunction
    function HERO_16_TALENT_SPELLING_5 takes nothing returns nothing
        local real power = I2R(18+GetUnitLevel(spellCaster))/19*(1+I2R(eliteLevel[GetHeroIndex(spellCaster)-1])/100)*I2R(10000-unitGetBonusState(spellCaster,STATE_COST_REDUCE))
        local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_SORCERESS_EMBER,360000)
        set bf.realData = bf.realData+I2R(spellCost)
        call bf.addEnding(function A60K_END)
        if bf.realData > 5*I2R(BlzGetUnitAbilityManaCost(spellCaster,'S00B',0)) and bf.LAUNCH then 
            set bf.DESTROY = true 
        else 
            call bf.apply()
        endif 
    endfunction
    function HERO_16_TALENT_MISSILE_LAUNCH_5 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        if HERO_16_TALENT_5_CHANGE and proj.flag == 'S00G' then 
            set HERO_16_TALENT_5_CHANGE = false 
            set proj.model_path = "war3campImported\\Firebolt Rough Medium.mdx"
            set proj.speed = 1250
            set proj.curve = 0
            set proj.realData = 1
            call proj.addOnHit(function S00B_MISSILE_HIT)
            set proj.flag = 'S00B'
            call State.checkAll(proj.source)
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\hiveNewModels\\Firebolt Classic.mdl",proj.dummy,"chest")
        endif 
    endfunction
    function HERO_16_TALENT_RESET_5 takes nothing returns nothing
        set HERO_16_TALENT_5_CHANGE = false 
        call BlzSetAbilityTooltip('S00G',"火球术",0)
        call BlzSetAbilityExtendedTooltip('S00G',"|cffadadff可在攻击时自动释放\n取消攻击|r\n向目标投掷火球，造成|cffffcc00法术强度×1|r的法术伤害。\n|cff888888火焰|r",0)
        call BlzSetAbilityActivatedIcon('S00G',"replaceabletextures\\commandbuttonsauto\\mage_ability\\btnfireball_original.blp")
    endfunction

    function A678_BEFOREDAMAGE_SOURCE takes nothing returns nothing
        set damageAddCrit = damageAddCrit+mybuff.currentBuff.realData
    endfunction
    function HERO_16_TALENT_AFTERDAMAGE_SOURCE_2 takes nothing returns nothing
        local mybuff bf = 0
        if damageFlag == 'S00G' or damageFlag == 'S00I' then 
            if damageIfCrit then 
                set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_SORCERESS_EMPOWEREDFIREBALL)
                set bf.DESTROY = true 
            else 
                set bf = CreateBuff(damageSource,damageSource,BUFFTYPE_SORCERESS_EMPOWEREDFIREBALL,1000)
                set bf.realData = bf.realData+0.1
                call bf.addBefDmg_S(function A678_BEFOREDAMAGE_SOURCE)
                call bf.apply()
            endif 
        endif 
    endfunction
    function HERO_16_IGNITE_DAMAGE takes nothing returns nothing
        local real dmg = mybuff.currentBuff.realData*I2R(mybuff.currentBuff.periodTime)/I2R(mybuff.currentBuff.remainingTime+mybuff.currentBuff.periodTime)
        set mybuff.currentBuff.realData = mybuff.currentBuff.realData-dmg
        set damageTag_Ignite = true 
        set damageTag_Fire = true 
        set damageIsDOT = true 
        set damageIsExtra = true 
        set damageFlag = 'A602'
        set damageAddCrit = -100000
        call UnitDamageTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function HERO_16_TALENT_AFTERDAMAGE_SOURCE_3 takes nothing returns nothing
        local mybuff bf 
        if damageTag_Fire and damageIfCrit then 
            set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_SORCERESS_IGNITE)
            set bf.periodTime = 200
            set bf.lastTime = 400
            set bf.addTime = false 
            set bf.hasteAble = false 
            set bf.bonusResistance = -500
            call bf.addPeriod(function HERO_16_IGNITE_DAMAGE)
            set bf.realData = bf.realData+0.25*damageDamage
            call bf.apply()
        endif 
    endfunction
    function HERO_16_TALENT_DAMAGING_SOURCE_6 takes nothing returns nothing
        if damageIsDOT then 
            set damageFinalDamage = damageFinalDamage*1.1
        endif 
    endfunction
    function HERO_16_TALENT_DAMAGING_SOURCE_8 takes nothing returns nothing
        if damageTag_Ignite then 
            set damageFinalDamage = damageFinalDamage*1.15
        endif 
    endfunction
    function HERO_16_TALENT_7_DELAYED_LAUNCH takes nothing returns nothing
        local projectile proj = delayedevent.currentEvent.loadInteger("PROJ")
        call proj.launch()
        set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\hiveNewModels\\Firebolt Classic.mdl",proj.dummy,"chest")
    endfunction
    function HERO_16_TALENT_7_DELAYED_1 takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local unit caster = de.loadUnit("CASTER")
        local unit target = de.loadUnit("TARGET")
        local real cost = de.loadReal("COST")
        local projectile proj = 0
        if GetUnitState(caster,UNIT_STATE_MANA) > cost then 
            call AddUnitMana(caster,0-cost)
            set proj = CreateProjectileToUnit(caster,target,1250,0,"war3campImported\\Firebolt Rough Medium.mdx",function S00B_MISSILE_HIT,null)
            set proj.realData = 0.5
            call proj.addOnHit(function S00B_MISSILE_HIT)
            set proj.flag = 'S00B'
            set proj.tag_Fire = true 
            set de = CreateDelayedEvent(25,1,function HERO_16_TALENT_7_DELAYED_LAUNCH)
            call de.saveInteger("PROJ",proj)
        endif 
        set caster = null 
        set target = null 
    endfunction
    function HERO_16_TALENT_7_DELAYED_2 takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local unit caster = de.loadUnit("CASTER")
        local real cost = de.loadReal("COST")
        if GetUnitState(caster,UNIT_STATE_MANA) > cost then 
            call AddUnitMana(caster,0-cost)
            call BlzStartUnitAbilityCooldown(caster,'S00L',15)
        endif 
        set caster = null 
    endfunction
    function HERO_16_TALENT_SPELLING_7 takes nothing returns nothing
        local projectile proj = 0
        local delayedevent de = 0
        if castingSpell == 'S00B' then 
            set de = CreateDelayedEvent(1,1,function HERO_16_TALENT_7_DELAYED_1)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveReal("COST",I2R(spellCost))
        endif 
        if castingSpell == 'S00L' then 
            set de = CreateDelayedEvent(1,1,function HERO_16_TALENT_7_DELAYED_2)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("COST",I2R(spellCost))
        endif 
    endfunction
    
    function A60D_PERIOD takes nothing returns nothing
        call AddUnitLife(mybuff.currentBuff.buffTarget,0-RMinBJ(GetUnitState(mybuff.currentBuff.buffTarget,UNIT_STATE_LIFE)-1,GetUnitState(mybuff.currentBuff.buffTarget,UNIT_STATE_MAX_LIFE)*0.15))
    endfunction
    function B60J_DAMAGING_SOURCE takes nothing returns nothing
        if damageDamageType == DAMAGE_TYPE_MAGIC then 
            set damageFinalDamage = damageFinalDamage*(1+0.035*I2R(mybuff.currentBuff.intData))
        endif
    endfunction
    function HERO_16_TALENT_9_MULTICAST takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local unit caster = de.loadUnit("CASTER")
        local unit targetUnit = de.loadUnit("TARGET_U")
        local real targetX = de.loadReal("TARGET_X")
        local real targetY = de.loadReal("TARGET_Y")
        local integer spell = de.loadInteger("SPELL")
        local integer cost = de.loadInteger("COST")

        set castingSpell = spell+'1000'
        set spellCaster = caster 
        set spellTarget = targetUnit
        set spellTargetX = targetX
        set spellTargetY = targetY
        set spellCost = cost 
        set spellCooldown = 0
        set spellAbilityLevel = 0
        set spellTargetItem         = null 
        set SpellTargetDestructable = null 

        call Cast.execute()
        call AddUnitMana(spellCaster,0-I2R(spellCost))

        set caster = null 
        set targetUnit = null 
    endfunction
    function HERO_16_TALENT_SPELLING_9 takes nothing returns nothing
        local delayedevent de
        local integer W = GetUnitAbility(spellCaster,ABILITY_W)
        local integer E = GetUnitAbility(spellCaster,ABILITY_E)
        local integer R = GetUnitAbility(spellCaster,ABILITY_R)
        if castingSpell == W or castingSpell == E or castingSpell == R then 
            if (castingSpell == W and BlzGetUnitAbilityCooldownRemaining(spellCaster,E) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,R) > 0) or (castingSpell == E and BlzGetUnitAbilityCooldownRemaining(spellCaster,W) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,R) > 0) or (castingSpell == R and BlzGetUnitAbilityCooldownRemaining(spellCaster,E) > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,W) > 0) then
                set de = delayedevent.create(25,1,function HERO_16_TALENT_9_MULTICAST)
                call de.saveUnit("CASTER",spellCaster)
                call de.saveUnit("TARGET_U",spellTarget)
                call de.saveReal("TARGET_X",spellTargetX)
                call de.saveReal("TARGET_Y",spellTargetY)
                call de.saveInteger("SPELL",castingSpell)
                call de.saveInteger("COST",spellCost)
            endif 
        endif 
    endfunction
    function HERO_16_TALENT_DAMAGING_SOURCE_11 takes nothing returns nothing
        local mybuff bf
        if damageFlag == 'S00G' or damageFlag == 'S00I' then 
            set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_SORCERESS_GRILL)
            set bf.lastTime = 3000
            if damageFlag == 'S00I' then 
                set bf.intData = IMinBJ(20,bf.intData+3)
            else 
                set bf.intData = IMinBJ(20,bf.intData+1)
            endif 
            call bf.apply()
        endif 
        if damageFlag == 'S00B' or damageFlag == 'S00L' then 
            if damageIsDOT == false and damageIsExtra == false then 
                set bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_SORCERESS_GRILL)
                set damageFinalDamage = damageFinalDamage*(1+0.15*I2R(bf.intData))
                ////call BJDebugMsg("x"+R2S(1+0.15*I2R(bf.intData)))
                set bf.DESTROY = true 
            endif 
        endif 
    endfunction
    function HERO_16_TALENT_SPELLING_10 takes nothing returns nothing
        local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_SORCERESS_PHOENIXFIRE)
        set bf.intData = IMaxBJ(0,IMinBJ(10,bf.intData+1))
        set bf.bonusCostReduce = -200*bf.intData
        call bf.addDmged_S(function B60J_DAMAGING_SOURCE)
        set bf.lastTime = 500
        set bf.remainingTime = 0
        call bf.apply()
    endfunction
    function HERO_16_TALENT_LEARN_12 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_LIFE_REGEN,100)
        call unitAddState(currentTTOwner,STATE_LIFE_REGEN_P,5000)
    endfunction
    function HERO_16_TALENT_RESET_12 takes nothing returns nothing
        call unitAddState(currentTTOwner,STATE_LIFE_REGEN,-100)
        call unitAddState(currentTTOwner,STATE_LIFE_REGEN_P,-5000)
    endfunction
    function HERO_16_TALENT_SPELLING_12 takes nothing returns nothing
        local real regen = RMinBJ(spellCost/2,GetUnitState(spellCaster,UNIT_STATE_LIFE)-1)
        call AddUnitLife(spellCaster,0-RMinBJ(GetUnitState(spellCaster,UNIT_STATE_LIFE)-1,2*regen))
        call AddUnitMana(spellCaster,regen)
    endfunction
    function HERO_16_TALENT_DAMAGED_TARGET_12 takes nothing returns nothing
        local mybuff bf 
        if unitCheckCooldown(damageTarget,'A60D') and damageFinalDamage > GetUnitState(damageTarget,UNIT_STATE_LIFE)-1 then 
            set damageFinalDamage = 0
            call unitStartCooldown(damageTarget,'A60D',60)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl",damageTarget,"origin"))
            call SetUnitState(damageTarget,UNIT_STATE_LIFE,GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))
            set bf = mybuff.create(damageTarget,damageTarget,BUFFTYPE_SORCERESS_CAUTERIZE)
            set bf.periodTime = 100
            set bf.lastTime = 1000
            set bf.hasteAble = false 
            call bf.addPeriod(function A60D_PERIOD)
            call bf.apply() 
        endif 
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_12
    //====================================================
    function HERO_12_TALENT_LEARN_5 takes nothing returns nothing
        ////call BJDebugMsg(R2S(BlzGetUnitWeaponRealField(currentTTOwner,UNIT_WEAPON_RF_ATTACK_RANGE,1)))
        call SetUnitAttackRange(currentTTOwner,BlzGetUnitWeaponRealField(currentTTOwner,UNIT_WEAPON_RF_ATTACK_RANGE,1)-250)
        call unitAddState(currentTTOwner,STATE_ATTACK_SPEED,5000)
    endfunction
    function HERO_12_TALENT_RESET_5 takes nothing returns nothing
        ////call BJDebugMsg(R2S(BlzGetUnitWeaponRealField(currentTTOwner,UNIT_WEAPON_RF_ATTACK_RANGE,1)))
        call SetUnitAttackRange(currentTTOwner,BlzGetUnitWeaponRealField(currentTTOwner,UNIT_WEAPON_RF_ATTACK_RANGE,1))
        call unitAddState(currentTTOwner,STATE_ATTACK_SPEED,-5000)
    endfunction
    function HERO_12_TALENT_DAMAGING_SOURCE_5 takes nothing returns nothing
        if ifDamageHasElement() then 
            set damageFinalDamage = damageFinalDamage*1.05
        endif 
    endfunction
    function HERO_12_TALENT_HEALING_SOURCE_5 takes nothing returns nothing
        set healFinalHeal = healFinalHeal*1.05
    endfunction

    function HERO_12_TALENT_DAMAGING_SOURCE_7 takes nothing returns nothing
        if damageFlag == 'A66B' or damageFlag == 'A668' then 
            set damageFinalDamage = damageFinalDamage*1.25
        endif 
    endfunction 
    function HERO_12_TALENT_HEALING_SOURCE_7 takes nothing returns nothing
        if healFlag == 'A667' then 
            set healFinalHeal = healFinalHeal*1.25
        endif 
    endfunction
    
    function HERO_12_TALENT_SPELLING_4 takes nothing returns nothing
        local mybuff bf = 0
        if castingSpell == 'S01H' or castingSpell == 'S03W' or castingSpell == 'S03X' or castingSpell == 'S01G' or castingSpell == 'S03Y' or castingSpell == 'S03Z' or castingSpell == 'S04P' or castingSpell == 'S03H' or castingSpell == 'S040' or castingSpell == 'S041' or castingSpell == 'S04Q' then 
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_SHAMAN_WINDFURY,1500)
            set bf.intData = IMinBJ(bf.intData+R2I(spellCooldown/15+0.5),4)
            call bf.apply()
        endif 
    endfunction

    function HERO_12_TALENT_AFTERHEAL_SOURCE_8 takes nothing returns nothing
        if unitCheckCooldown(healTarget,'B66O') then
            call unitStartCooldown(healTarget,'B66O',500)
            call AddUnitMana(healTarget,0.01*GetUnitState(healTarget,UNIT_STATE_MAX_LIFE))
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\MoonWell\\MoonWellCasterArt.mdl",healTarget,"origin"))
        endif   
    endfunction
    function A66L_DAMAGING_TARGET takes nothing returns nothing
        if ifDamageHasElement() then 
            set damageFinalDamage = damageFinalDamage*1.05
        endif 
    endfunction
    function HERO_12_TALENT_AFTERDAMAGE_SOURCE_8 takes nothing returns nothing
        local mybuff bf = 0
        if damageTag_Lightning then 
            set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_SHAMAN_ELEMENTALBRAND,1000)
            call bf.addDmging_T(function A66L_DAMAGING_TARGET)
            call bf.apply()
        endif 
    endfunction

    function A66M_DELAYED_DAMAGE takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        set damageIsExtra = true 
        set damageFlag = 'A66M'
        call UnitDamageTarget(de.loadUnit("CASTER"),de.loadUnit("CASTER"),2*de.loadReal("DAMAGE"),false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function A66M_BEFOREDAMAGE_TARGET takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local delayedevent de = 0
        if bf.buffSource == null or alive(bf.buffSource) == false then 
            return 
        endif 
        set de = CreateDelayedEvent(1,1,function A66M_DELAYED_DAMAGE)
        call de.saveUnit("CASTER",bf.buffSource)
        call de.saveReal("DAMAGE",0.1*damageDamage)
        set damageDamage = damageDamage*0.9
    endfunction
    function A66M_ALLY_CHECK takes nothing returns nothing
        if IsUnitType(aura.filterUnit,UNIT_TYPE_HERO) then 
            set aura.able = true 
        else 
            set aura.able = false 
        endif 
    endfunction
    function A66M_ALLY_SET takes nothing returns nothing
        call aura.modifingAuraBuff.addBefDmg_T(function A66M_BEFOREDAMAGE_TARGET)
    endfunction
    function SHAMAN_SUMMON_EARTH_ELEMENTAL takes unit whichUnit returns minion
        local minion mini = minion.create(whichUnit,'nS0P',GetUnitX(whichUnit)+150*Cos(GetUnitFacing(whichUnit)/57.2956),GetUnitY(whichUnit)+150*Sin(GetUnitFacing(whichUnit)/57.2956))
        local aura ar = CreateAura(mini.summon,"SHAMAN_AURA_EARTH_PROTECT",900,0,BUFFTYPE_SHAMAN_EARTHPROTECT,"")
        call delayedPauseUnit(mini.summon,160)
        call delayedPlayAnimation(mini.summon,"birth",167)
        call unitAddState(mini.summon,STATE_RESISTANCE,10000)
        call unitCheckState.evaluate(mini.summon)
        set SHAMAN_EARTH_ELEMENTAL = mini.summon
        call ar.addAllyChk(function A66M_ALLY_CHECK)
        call ar.addAllySet(function A66M_ALLY_SET)
        return mini
    endfunction
    function SHAMAN_EARTH_ELEMENTAL_RESUMMON_FUNC takes nothing returns nothing
        local minion mini
        if (SHAMAN_EARTH_ELEMENTAL == null or alive(SHAMAN_EARTH_ELEMENTAL) == false) and alive(hero[11]) and HeroHaveTalent(hero[11],HERO_ULTIMATE_TALENT,9) then 
            set mini = SHAMAN_SUMMON_EARTH_ELEMENTAL(hero[11])
        endif 
        set SHAMAN_EARTH_ELEMENTAL_RESUMMON = 0
    endfunction
    function HERO_12_MINION_DEATH takes nothing returns nothing
        local mybuff bf
        if eventDyingUnit == SHAMAN_EARTH_ELEMENTAL and HeroHaveTalent(hero[11],HERO_ULTIMATE_TALENT,9) and alive(hero[11]) then 
            if SHAMAN_EARTH_ELEMENTAL_RESUMMON > 0 then 
                call SHAMAN_EARTH_ELEMENTAL_RESUMMON.destroy()
            endif
            if inCombat(hero[11]) then 
                set SHAMAN_EARTH_ELEMENTAL_RESUMMON = delayedevent.create(3000,1,function SHAMAN_EARTH_ELEMENTAL_RESUMMON_FUNC)
            else 
                set SHAMAN_EARTH_ELEMENTAL_RESUMMON = delayedevent.create(200,1,function SHAMAN_EARTH_ELEMENTAL_RESUMMON_FUNC)
            endif 
            set SHAMAN_EARTH_ELEMENTAL = null 
        endif 
    endfunction
    function CHECK_STATE_nS0P takes nothing returns nothing
        local master owner = minion.getMinionByUnit(checkingUnit).mast
        local integer miniBonusLife = 150+10*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)
        call BlzSetUnitBaseDamage(checkingUnit,2*GetUnitLevel(owner.masterUnit)/7+5+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER))*0.3),0)
        call BlzSetUnitArmor(checkingUnit,8+7*GetUnitLevel(owner.masterUnit)/5)
        call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
        call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
    endfunction
    globals 
        unit SHAMAN_EARTH_ELEMENTAL = null
        delayedevent SHAMAN_EARTH_ELEMENTAL_RESUMMON = 0
    endglobals
    function HERO_12_TALENT_LEARN_9 takes nothing returns nothing
        local minion mini = SHAMAN_SUMMON_EARTH_ELEMENTAL(currentTTOwner)
    endfunction
    function HERO_12_TALENT_RESET_9 takes nothing returns nothing
        call KillUnit(SHAMAN_EARTH_ELEMENTAL)
        set SHAMAN_EARTH_ELEMENTAL = null 
    endfunction

    function HERO_12_TALENT_SPELLING_10 takes nothing returns nothing
        local mybuff bf = 0
        if castingSpell == 'S043' or castingSpell == 'S044' or castingSpell == 'S04R' then 
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_SHAMAN_BLOODLUST,1500)
            set bf.bonusHaste = 3000
            set bf.bonusMoveSpeed_P = 3000
            call bf.apply()
        endif 
    endfunction

    function SHAMAN_EARTH_BLESS_STATE_SET takes nothing returns nothing
        set aura.modifingAuraBuff.bonusResistance = 1200
    endfunction
    function HERO_12_TALENT_LEARN_11 takes nothing returns nothing
        local aura ar = aura.create(currentTTOwner,"AURA_SHAMAN_EARTH_BLESS",900,0,BUFFTYPE_SHAMAN_EARTHBLESS,"war3campImported\\naturalorderaura.mdx")
        call ar.addAllySet(function SHAMAN_EARTH_BLESS_STATE_SET)
    endfunction
    function HERO_12_TALENT_RESET_11 takes nothing returns nothing
        set aura.getAura(currentTTOwner,"AURA_SHAMAN_EARTH_BLESS").DESTROY = true 
    endfunction

    function A66O_DAMAGING_SOURCE takes nothing returns nothing
        if damageFlag == 'A668' or damageFlag == 'A66B' then 
            set damageFinalDamage = damageFinalDamage*2
        endif 
    endfunction
    function A66O_HEALING_SOURCE takes nothing returns nothing
        if damageFlag == 'A667' then 
            set healFinalHeal = healFinalHeal*2
        endif 
    endfunction
    function HERO_12_TALENT_SPELLING_12 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_SHAMAN_ELEMENTALBODY)
        if spellCooldown > 0.5 and (bf == 0 or bf.boolData == false) then 
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_SHAMAN_ELEMENTALBODY,360000)
            set bf.realData = bf.realData+spellCooldown
            set bf.boolData = false 
            call bf.apply()
        endif 
        if bf != 0 then 
            if bf.realData >= 120 then 
                set bf.realData = 0
                set bf.boolData = true 
                set bf.remainingTime = 1000
                set bf.bindSFX = AddSpecialEffectTargetEX("war3campImported\\HamonAuraBlue.mdx",bf.buffTarget,"origin")
                call bf.addDmging_S(function A66O_DAMAGING_SOURCE)
                call bf.addHealing_S(function A66O_HEALING_SOURCE)
            endif 
        endif 
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_13
    //====================================================
    globals 
        integer HERO_13_TALENT_1_COUNT = 0
    endglobals
    function DOOM_DEATH takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local real x = GetUnitX(bf.buffTarget)
        local real y = GetUnitY(bf.buffTarget)
        local real a 
        local real d 
        local integer i = 0
        local minion mini 
        local master mast 
        set damageTag_Shadow = true 
        set damageFlag = 'A61L'
        call UnitDamageTarget(bf.buffSource,bf.buffTarget,bf.realData,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Deathfire_Portrait_L.mdx",x,y))
        set master.create(bf.buffSource).lastTarget = bf.buffTarget
        loop 
            exitwhen i > bf.intData-1
            set a = GetRandomReal(2.0944*I2R(i),2.0944*I2R(i+1))
            set d = SquareRoot(GetRandomReal(2500,15625))
            set mini = minion.create(bf.buffSource,'nS09',x+d*Cos(a),y+d*Sin(a))
            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,6) then
                call UnitApplyTimedLife(mini.summon,'BTLF',13)
            else 
                call UnitApplyTimedLife(mini.summon,'BTLF',10)
            endif 
            call unitCheckState.evaluate(mini.summon)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Deathfire_Portrait_L.mdx",x+d*Cos(a),y+d*Sin(a)))
            set i = i+1
        endloop 
    endfunction
    function HERO_13_TALENT_AFTERDAMAGE_SOURCE_1 takes nothing returns nothing
        local real haste = 1
        local mybuff bf 
        if damageFlag == 'S013' or damageFlag == 'A60R' then 
            if unitGetBonusState(damageSource,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(damageSource,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(damageSource,STATE_HASTE)))/10000
            endif 
            set bf = mybuff.create(damageMaster,damageTarget,BUFFTYPE_WARLOCK_DOOM)
            set bf.lastTime = R2I(600*haste)
            call bf.addEnding(function DOOM_DEATH)
            set bf.realData = bf.realData+0.2*damageDamage
            set bf.intData = bf.intData+1
            call bf.apply()
        endif 
    endfunction
    function HERO_13_TALENT_MISSILE_LAUNCH_1 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        if HERO_13_TALENT_1_COUNT == 15 and proj.flag == 'S00Z' then 
            set HERO_13_TALENT_1_COUNT = 0 
            set proj.model_path = "war3campImported\\decimate_missile_Medium.mdx"
            set proj.speed = 700
            set proj.curve = 0
            set proj.realData = 0.75
            call proj.addOnHit(function S013_HIT)
            set proj.flag = 'S013'
        endif 
    endfunction
    function HERO_13_TALENT_SPELLING_1 takes nothing returns nothing
        if castingSpell == 'S00Z' then 
            set HERO_13_TALENT_1_COUNT = HERO_13_TALENT_1_COUNT+1
            if HERO_13_TALENT_1_COUNT == 14 then 
                call BlzSetAbilityTooltip('S00Z',"混乱之箭",0)
                call BlzSetAbilityExtendedTooltip('S00Z',"|cffadadff可在攻击时自动释放|r\n|cffadadff取消攻击|r\n释放毁灭性的混乱能量攻击目标敌人，造成|cffffcc00法术强度×3.5|r的法术伤害。该伤害|cffffcc00必然暴击|r，你的暴击转而直接提高本次伤害。\n|cff888888所有元素|r",0)
                call BlzSetAbilityActivatedIcon('S00Z',"ReplaceableTextures\\CommandButtons\\Warlock\\BTNWarlock8.blp")
            else 
                call BlzSetAbilityTooltip('S00Z',"巫术箭",0)
                call BlzSetAbilityExtendedTooltip('S00Z',"|cffadadff可在攻击时自动释放\n取消攻击|r\n发射混乱能量，造成|cffffcc00法术强度×1|r的法术伤害。\n|cff888888随机元素|r",0)
                call BlzSetAbilityActivatedIcon('S00Z',"ReplaceableTextures\\CommandButtonsAuto\\BTNchaosboltNew.blp")
            endif 
        endif 
    endfunction
    function HERO_13_TALENT_RESET_1 takes nothing returns nothing
        call BlzSetAbilityTooltip('S00Z',"巫术箭",0)
        call BlzSetAbilityExtendedTooltip('S00Z',"|cffadadff可在攻击时自动释放|r\n|cffadadff取消攻击|r\n发射混乱能量，造成|cffffcc00法术强度×1|r的法术伤害。\n|cff888888随机元素|r",0)
        call BlzSetAbilityActivatedIcon('S00Z',"ReplaceableTextures\\CommandButtonsAuto\\BTNchaosboltNew.blp")
        set HERO_13_TALENT_1_COUNT = 0 
    endfunction
    function HERO_13_DEMON_FIRE_HIT takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        local real x = GetUnitX(proj.target)
        local real y = GetUnitY(proj.target)
        local group pick = CreateGroup()
        call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Other\\Volcano\\VolcanoMissile.mdl",x,y))
        call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\decimate_missile_Medium.mdx",x,y))
        set pick = CreateGroup()
        call GroupEnumUnitsInRangeEx(pick,x,y,200,playerEnemy)
        loop 
            exitwhen FirstOfGroup(pick) == null 
            call proj.applyDamageSet()
            set damageTag_Fire = true 
            set damageTag_Shadow = true 
            set damageIsAOE = true 
            set damageFlag = 'B616'
            call UnitDamageTarget(proj.source,FirstOfGroup(pick),I2R(unitGetAllBonusStateValue(proj.source,STATE_ABILITY_POWER))*proj.realData,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call DestroyGroup(pick)
        set pick = null 
    endfunction
    function HERO_13_LAUNCH_DEMON_FIRE takes unit source,unit target,real power returns projectile
        local projectile proj = projectile.create(source)
        local real x 
        local real y 
        local real X 
        local real Y
        local real a 
        local real b 
        local real c 
        local real d 
        set x = GetUnitX(source)
        set y = GetUnitY(source)
        set X = GetUnitX(target)
        set Y = GetUnitY(target)
        set a = GetRandomReal(90,135)
        if GetRandomReal(0,1) < 0.5 then 
            set a = 0-a
        endif 
        set b = GetRandomReal(250,350)
        set c = GetRandomReal(30,60)
        if a < 0 then 
            set c = 0-c
        endif 
        set d = RMinBJ(GetRandomReal(250,350),DisByXY(x,y,X,Y))
        set a = a+GetUnitFacing(source)
        set c = c+GetUnitFacing(source)
        set proj.model_path = "war3campImported\\emojian.mdx"
        set proj.speed = 650
        set proj.curve = GetRandomReal(0.1,0.2)
        set proj.bezier_points = 2
        set proj.bezier_x0 = x+b*Cos(a/57.2956)
        set proj.bezier_x1 = proj.bezier_x0+d*Cos(c/57.2956)
        set proj.bezier_y0 = y+b*Sin(a/57.2956)
        set proj.bezier_y1 = proj.bezier_y0+d*Cos(c/57.2956)
        set proj.target = target
        set proj.TARGET_UNIT = true 
        set proj.LAUNCH_UNIT = true 
        set proj.realData = power
        call proj.addOnHit(function HERO_13_DEMON_FIRE_HIT)
        set proj.flag = 'B616'
        return proj 
    endfunction
    function A677_HIT takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        local real dmg = I2R(GetUnitAttack(proj.source,0))
        call proj.applyDamageSet()
        set damageFlag = 'A677'
        set damageTag_Fire = true 
        call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
    endfunction
    function A677_ATTACKING takes nothing returns nothing
        local mybuff bf = mybuff.currentBuff
        local projectile proj = 0
        local integer i = 0
        loop
            exitwhen i > 4
            set proj = CreateProjectileToUnit(damageSource,damageTarget,1050,GetRandomReal(0.05,0.15),"war3campImported\\Firebolt Minor.mdx",function A677_HIT,null)
            set proj.start_y = GetRandomReal(-25,25)
            set proj.flag = 'A677'
            call delayedLaunchMissile(proj,5+10*i)
            set i = i+1
        endloop 
        set bf.DESTROY = true 
    endfunction
    function HERO_13_TALENT_AFTERDAMAGE_SOURCE_2 takes nothing returns nothing
        if damageFlag == 'S01M' then 
            call WarlockApplyHoloCaust(damageMaster,damageTarget,1000)
        endif
    endfunction
    function HERO_13_TALENT_SPELLING_2 takes nothing returns nothing
        local group pick = null 
        local projectile proj = 0
        local mybuff bf = 0
        local integer i = 0
        if castingSpell == 'S01I' then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,250,playerEnemy)
            loop
                exitwhen i > 2
                set proj = HERO_13_LAUNCH_DEMON_FIRE(spellCaster,GroupPickRandomUnitEx(pick),1)
                call delayedLaunchMissile(proj,25*i+15)
                set i = i+1
            endloop
            call DestroyGroup(pick)
        endif 
        if castingSpell == 'S012' then
            set pick = CreateGroup()
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS02' then 
                    set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_WARLOCK_MULTIFIREBALL,1000)
                    call bf.addAtking(function A677_ATTACKING)
                    call bf.apply()
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
        endif 
        set pick = null 
    endfunction
    function HERO_13_TALENT_DAMAGING_SOURCE_3 takes nothing returns nothing
        if mybuff.getUnitBuff(damageTarget,'A612') > 0 then
            set damageFinalDamage = damageFinalDamage*1.1
        endif 
    endfunction
    function HERO_13_TALENT_PREDAMAGE_SOURCE_8 takes nothing returns nothing
        if damageFlag == 'S00Z' then 
            call enableRandomElement()
        endif 
    endfunction
    function HERO_13_TALENT_DAMAGING_SOURCE_8 takes nothing returns nothing
        local mybuff bf 
        if damageFlag == 'S00Z' and (damageTag_Shadow or damageTag_Fire) then 
            call WarlockApplyHoloCaust(damageSource,damageTarget,1000)
        endif 
        if damageFlag == 'S00Z' and countDamageElements() == 1 then 
            set damageFinalDamage = damageFinalDamage*2
        endif 
    endfunction
    function HERO_13_TALENT_SPELLING_4 takes nothing returns nothing
        local mybuff bf 
        if spellCost > 0 and random.get(spellCaster,0.2+spellCooldown*0.015,'A614') then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_WARLOCK_REVERSEENTROPY)
            set bf.lastTime = 1000
            set bf.bonusHaste = 1500
            call bf.apply()
        endif 
    endfunction
    function A615_DAMAGING_TARGET takes nothing returns nothing
        if damageSource == damageTarget then 
            return 
        endif 
        if damageMaster == mybuff.currentBuff.buffSource then 
            set damageFinalDamage = damageFinalDamage*(1+0.04*I2R(mybuff.currentBuff.intData))
        endif 
    endfunction 
    function HERO_13_TALENT_SPELLING_5 takes nothing returns nothing
        local mybuff bf 
        if castingSpell == 'S00Z' then 
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_WARLOCK_CORRUPTION)
            set bf.lastTime = 400
            set bf.intData = IMinBJ(4,bf.intData+1)
            call bf.addDmging_T(function A615_DAMAGING_TARGET)
            call bf.apply()
        endif 
    endfunction
    function WARLOCK_DEMON_GUARD_RESUMMON_FUNC takes nothing returns nothing
        local minion mini
        if (WARLOCK_DEMON_GUARD == null or alive(WARLOCK_DEMON_GUARD) == false) and alive(hero[12]) and HeroHaveTalent(hero[12],HERO_ULTIMATE_TALENT,11) then 
            set mini = minion.create(hero[12],'nS07',GetUnitX(hero[12])+150*Cos(GetUnitFacing(hero[12])/57.2956),GetUnitY(hero[12])+150*Sin(GetUnitFacing(hero[12])/57.2956))
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\RitualDagger\\RitualDaggerTarget.mdl",mini.summon,"origin"))
            call unitCheckState.evaluate(mini.summon)
            set WARLOCK_DEMON_GUARD = mini.summon
        endif 
        set WARLOCK_DEMON_GUARD_RESUMMON = 0
    endfunction
    function HERO_13_TALENT_PREDAMAGE_SOURCE_6 takes nothing returns nothing
        if damageSource != damageMaster then 
            set damageArmor = damageArmor*0.7
            set damageAddCrit = damageAddCrit+0.1
        endif 
    endfunction
    function HERO_13_TALENT_AFTERDAMAGE_SOURCE_10 takes nothing returns nothing
        if damageSource != damageMaster and random.get(damageMaster,0.05,'HTLA') and damageTag_Attack and unitCheckCooldown(damageMaster,'HTLA') then 
            call WarlockApplyHoloCaust(damageMaster,damageTarget,400)
            call unitStartCooldown(damageMaster,'HTLA',100)
        endif 
        call unitStartCooldown(damageMaster,'HTLA',5)
    endfunction
    function CHECK_STATE_nS07 takes nothing returns nothing
        local master owner = minion.getMinionByUnit(checkingUnit).mast
        local integer miniBonusLife = 200+15*GetUnitLevel(owner.masterUnit)+3*unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/4
        call BlzSetUnitBaseDamage(checkingUnit,3*GetUnitLevel(owner.masterUnit)/9+6+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER))*0.3),0)
        call BlzSetUnitArmor(checkingUnit,12+3*GetUnitLevel(owner.masterUnit)/5)
        call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
        call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
    endfunction
    function SPELL_A617 takes nothing returns nothing
        local real dmg = 0
        local group pick = null 
        if (minion.getMinionByUnit(spellCaster).currentTarget != null and alive(minion.getMinionByUnit(spellCaster).currentTarget)) or (minion.getMinionByUnit(spellCaster).mast.lastTarget != null and alive(minion.getMinionByUnit(spellCaster).mast.lastTarget)) then 
            call delayedPlayAnimation(spellCaster,"spin",100)
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),250,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set dmg = 2*I2R(GetUnitMaxAttack(spellCaster,0))
                set damageIsAOE = true 
                set damageFlag = 'A617'
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_SLICE)
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop 
            call DestroyGroup(pick)
            set pick = null 
        endif 
    endfunction
    globals 
        unit WARLOCK_DEMON_GUARD = null
        delayedevent WARLOCK_DEMON_GUARD_RESUMMON = 0
    endglobals
    function HERO_13_TALENT_LEARN_11 takes nothing returns nothing
        local minion mini = minion.create(currentTTOwner,'nS07',GetUnitX(currentTTOwner)+150*Cos(GetUnitFacing(currentTTOwner)/57.2956),GetUnitY(currentTTOwner)+150*Sin(GetUnitFacing(currentTTOwner)/57.2956))
        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\RitualDagger\\RitualDaggerTarget.mdl",mini.summon,"origin"))
        call unitCheckState.evaluate(mini.summon)
        set WARLOCK_DEMON_GUARD = mini.summon
    endfunction
    function HERO_13_TALENT_RESET_11 takes nothing returns nothing
        call KillUnit(WARLOCK_DEMON_GUARD)
    endfunction
    function HERO_13_TALENT_RESET_9 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(currentTTOwner,BUFFTYPE_WARLOCK_RAINOFCHAOS)
        set bf.DESTROY = true 
    endfunction
    function HERO_13_TALENT_9_DELAYED takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local real x = de.loadReal("X")
        local real y = de.loadReal("Y")
        set de = delayedevent.create(100,1,function S01K_AOE)
        call de.saveUnit("CASTER",spellCaster)
        call de.saveReal("X",x)
        call de.saveReal("Y",y)
        call DestroyEffectEX(AddSpecialEffectEX("Units\\Demon\\Infernal\\InfernalBirth.mdl",x,y))
    endfunction
    function HERO_13_TALENT_SPELLING_9 takes nothing returns nothing
        local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_WARLOCK_RAINOFCHAOS)
        local delayedevent de
        set bf.lastTime = 6000
        set bf.intData = bf.intData+R2I(spellCooldown)
        call bf.apply()
        if castingSpell == 'S00Z' and bf.intData >= 120 then 
            set bf.intData = bf.intData-120
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif   
            set de = delayedevent.create(100,1,function S01K_AOE)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",GetUnitX(spellTarget)+50)
            call de.saveReal("Y",GetUnitY(spellTarget)+50)
            call DestroyEffectEX(AddSpecialEffectEX("Units\\Demon\\Infernal\\InfernalBirth.mdl",GetUnitX(spellTarget)+50,GetUnitY(spellTarget)+50))
            set de = CreateDelayedEvent(50,1,function HERO_13_TALENT_9_DELAYED)
            call de.saveReal("X",GetUnitX(spellTarget)-50)
            call de.saveReal("Y",GetUnitY(spellTarget)-50)
        endif 
    endfunction
    function EVIL_GOD_REMOVE_AURA takes nothing returns nothing
        set aura.getAura(mybuff.currentBuff.buffTarget,"AURA_EVIL_WISE").DESTROY = true 
    endfunction
    function AURA_EVIL_WISE_ALLY_SET takes nothing returns nothing
        set aura.modifingAuraBuff.bonusAbilityPower_P = 1000
    endfunction
    function HERO_13_TALENT_SPELLING_12 takes nothing returns nothing
        local mybuff bf
        local aura ar 
        local integer CD
        local delayedevent de 
        if spellCooldown > 0.5 and mybuff.getUnitBuff(spellCaster,BUFFTYPE_WARLOCK_EVILGOD) > 0 then 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_WARLOCK_EVILGOD)
            set CD = IMaxBJ(0,R2I(spellCooldown*100)-bf.remainingTime)
            set bf.remainingTime = IMaxBJ(0,bf.remainingTime-R2I(spellCooldown*100))
            set de = delayedevent.create(5,1,function DELAYED_RESET_SPELL_COOLDOWN)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveInteger("CODE",castingSpell)
            call de.saveReal("COOLDOWN",I2R(CD)/100)
        endif 
        if castingSpell == 'S01J' or castingSpell == 'S01K' or castingSpell == 'S04V' then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_WARLOCK_EVILGOD)
            set bf.bonusCrit = 1000
            set bf.lastTime = 4000
            call bf.addEnding(function EVIL_GOD_REMOVE_AURA)
            call bf.apply()
            set ar = aura.create(spellCaster,"AURA_EVIL_WISE",900,0,BUFFTYPE_WARLOCK_EVILWISE,"")
            call ar.addAllySet(function AURA_EVIL_WISE_ALLY_SET)
        endif 
    endfunction
    function HERO_13_TALENT_AFTERDAMAGE_SOURCE_7 takes nothing returns nothing
        if GetUnitTypeId(damageSource) == 'nS0B' and damageFlag == 'nS0B' and BlzGetUnitAbilityCooldownRemaining(damageSource,'A61M') > 0.5 then 
            call BlzStartUnitAbilityCooldown(damageSource,'A61M',BlzGetUnitAbilityCooldownRemaining(damageSource,'A61M')-3.5)
        endif 
    endfunction
    function HERO_13_TALENT_SPELLING_7 takes nothing returns nothing
        local projectile proj = 0
        local integer last = 0
        local integer time = 0
        local real multiple = 0
        local mybuff bf = 0            
        if castingSpell == 'S013' then 
            set bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_WARLOCK_HOLOCAUST)
            if bf != 0 then 
                set time = R2I(bf.realData*bf.remainingTime)
                set last = bf.remainingTime
                set multiple = bf.realData
                if time >= 600 then 
                    set time = time-600
                    set last = R2I(I2R(time)/multiple)
                    set bf.remainingTime = last
                    set proj = CreateProjectileToUnit(spellCaster,spellTarget,700,0,"war3campImported\\decimate_missile_Medium.mdx",function S013_HIT,null)
                    set proj.flag = 'S013'
                    set proj.realData = 0.5
                    call delayedLaunchMissile(proj,25)
                endif 
            endif 
        endif 
    endfunction
    function HERO_13_MINION_DEATH takes nothing returns nothing
        local projectile proj = 0
        local group pick = null 
        local mybuff bf 
        if HeroHaveTalent(hero[12],HERO_PRIVATE_TALENT,3) and GetUnitTypeId(eventDyingUnit) == 'nS01' then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(eventDyingUnit),GetUnitY(eventDyingUnit),250,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageTag_Fire = true 
                set damageTag_Shadow = true 
                call UnitDamageTarget(hero[12],FirstOfGroup(pick),I2R(ST_ABILITY_POWER.getTotalState(hero[12]))*0.5,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call WarlockApplyHoloCaust(hero[12],FirstOfGroup(pick),600)
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Explosion.mdx",GetUnitX(eventDyingUnit),GetUnitY(eventDyingUnit)))
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\shamanyouranus-shadowymissile.mdx",GetUnitX(eventDyingUnit),GetUnitY(eventDyingUnit)))
        endif 
        if HeroHaveTalent(hero[12],HERO_PRIVATE_TALENT,3) and GetUnitTypeId(eventDyingUnit) == 'nS09' then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(eventDyingUnit),GetUnitY(eventDyingUnit),650,playerEnemyCombat)
            if FirstOfGroup(pick) != null then 
                set proj = HERO_13_LAUNCH_DEMON_FIRE(eventDyingUnit,GroupPickRandomUnitEx(pick),0.6)
                set proj.LAUNCH_LOC = true 
                set proj.LAUNCH_UNIT = false 
                set proj.source_x = GetUnitX(eventDyingUnit)
                set proj.source_y = GetUnitY(eventDyingUnit)
                set proj.source = hero[12]
                call proj.launch()
            endif 
            call DestroyGroup(pick)
        endif 
        if eventDyingUnit == WARLOCK_DEMON_GUARD and HeroHaveTalent(hero[12],HERO_ULTIMATE_TALENT,11) and alive(hero[12]) then 
            if WARLOCK_DEMON_GUARD_RESUMMON > 0 then 
                call WARLOCK_DEMON_GUARD_RESUMMON.destroy()
            endif
            if inCombat(hero[12]) then 
                set WARLOCK_DEMON_GUARD_RESUMMON = delayedevent.create(2000,1,function WARLOCK_DEMON_GUARD_RESUMMON_FUNC)
            else 
                set WARLOCK_DEMON_GUARD_RESUMMON = delayedevent.create(200,1,function WARLOCK_DEMON_GUARD_RESUMMON_FUNC)
            endif 
            set WARLOCK_DEMON_GUARD = null 
        endif 
        set pick = null 
    endfunction
    //====================================================
    // endregion
    //====================================================

    //====================================================
    // region hero_11
    //====================================================
        function HERO_11_TALENT_DAMAGING_SOURCE_2 takes nothing returns nothing
            local real p = RMinBJ(1,(50-RAbsBJ(GetUnitManaPercent(damageSource)-50))/50)
            if GetUnitAbilityLevel(damageSource,'BZZX') > 0 or GetUnitAbilityLevel(damageSource,'S05V') > 0 then 
                return 
            endif 
            if damageTag_Arcane then 
                set damageFinalDamage = damageFinalDamage*(1+0.15*p)
            endif 
        endfunction
        function HERO_11_TALENT_DAMAGING_TARGET_2 takes nothing returns nothing
            local real p = RMinBJ(1,(50-RAbsBJ(GetUnitManaPercent(damageTarget)-50))/50)
            if GetUnitAbilityLevel(damageTarget,'BZZX') == 0 then 
                return 
            endif 
            set damageFinalDamage = damageFinalDamage*(1-0.15*p)
        endfunction

        function HERO_11_TALENT_3_MSL_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            call AddUnitMana(proj.target,0.005*GetUnitState(proj.target,UNIT_STATE_MAX_MANA))
        endfunction
        function HERO_11_TALENT_3_DELAY takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit source = de.loadUnit("SOURCE")
            local unit target = de.loadUnit("TARGET")
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(source))*0.2
            local projectile proj = CreateProjectileToUnit(target,source,1000,0,"Abilities\\Spells\\Undead\\DevourMagic\\DevourMagicBirthMissile.mdl",function HERO_11_TALENT_3_MSL_HIT,null)
            set proj.flag = 'SZ5I'
            call proj.launch()
            set damageFlag = 'SZ5I'
            set damageTag_Arcane = true 
            call UnitDamageTarget(source,target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function HERO_11_TALENT_ATTACKED_SOURCE_3 takes nothing returns nothing
            local delayedevent de = CreateDelayedEvent(10,1,function HERO_11_TALENT_3_DELAY)
            call de.saveUnit("SOURCE",damageSource)
            call de.saveUnit("TARGET",damageTarget)
        endfunction

        function A68F_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(proj.source))*0.5
            call proj.applyDamageSet()
            if GetUnitAbilityLevel(proj.source,'BZZX') > 0 or GetUnitAbilityLevel(proj.source,'S05V') > 0 then 
                set dmg = dmg/2
                call AddUnitMana(proj.source,0.01*GetUnitState(proj.source,UNIT_STATE_MANA))
                call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl",proj.source,"chest"),100)
            endif 
            set damageFlag = 'A68F'
            set damageTag_Arcane = true 
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function A68F_ATTACKING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local projectile proj = 0
            local integer i = 0
            local real x = GetUnitX(damageTarget)/2+GetUnitX(damageSource)/2
            local real y = GetUnitY(damageTarget)/2+GetUnitY(damageSource)/2
            local real a = AngleByUnits(damageSource,damageTarget)/57.2956
            local real d = DisByUnits(damageSource,damageTarget)
            local real a0 = 0
            if bf.DESTROY then 
                return 
            endif 
            if IsUnitEnemy(damageTarget,GetOwningPlayer(damageSource)) then 
                set bf.DESTROY = true 
                set i = bf.intData
                loop
                    exitwhen i <= 0
                    set proj = CreateProjectileToUnit(damageSource,damageTarget,1000,GetRandomReal(0,0.05),"war3campImported\\arcaneshot_missile2.mdx",function A68F_HIT,null)
                    set proj.bezier_points = 1
                    if ModuloInteger(i,2) == 1 then 
                        set a0 = a+1.5708
                    else 
                        set a0 = a-1.5708
                    endif 
                    set proj.bezier_x0 = x+d/3*Cos(a0)
                    set proj.bezier_y0 = y+d/3*Sin(a0)
                    set proj.flag = 'A68F'
                    call delayedLaunchMissile(proj,15*i)
                    set i = i-1
                endloop
            endif 
        endfunction
        function HERO_11_TALENT_SPELLING_5 takes nothing returns nothing
            local integer i
            local mybuff bf
            if castingSpell == 'S05O' or castingSpell == 'S05P' or castingSpell == 'S05Q' then
                set i = 3*R2I(spellCooldown/15+0.5)
                set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_AW_ARCANEMISSILE,1000)
                set bf.intData = IMinBJ(bf.intData+i,6)
                call bf.addAtking(function A68F_ATTACKING)
                call bf.apply()
            endif 
        endfunction

        function HERO_11_TALENT_CHECK_STATE_6 takes nothing returns nothing
            local boolean needCheck = false 
            local integer sumStates = (GetHeroAgi(checkingUnit,true)+GetHeroInt(checkingUnit,true)+GetHeroStr(checkingUnit,true))
            local integer BONUSED_AP = GetHeroData(checkingUnit,"HERO_11_TALENT_16_BONUSED_AP")
            local integer BONUSED_ARMOR = GetHeroData(checkingUnit,"HERO_11_TALENT_16_BONUSED_ARMOR")
            local integer BONUSED_BLOCK = GetHeroData(checkingUnit,"HERO_11_TALENT_16_BONUSED_BLOCK")
            local integer BONUSED_MANA = GetHeroData(checkingUnit,"HERO_11_TALENT_16_BONUSED_MANA")
            local integer BONUSING_ARMOR = sumStates*5
            local integer BONUSING_AP = sumStates*6
            local integer BONUSING_BLOCK = sumStates*7
            local integer BONUSING_MANA = sumStates*8
            if BONUSING_AP != BONUSED_AP then 
                call ST_ABILITY_POWER.addStateSimple(checkingUnit,STATE_MODE_REAL,BONUSING_AP-BONUSED_AP)
                set needCheck = true 
            endif 
            if BONUSING_ARMOR != BONUSED_ARMOR then 
                call ST_ARMOR.addStateSimple(checkingUnit,STATE_MODE_REAL,BONUSING_ARMOR-BONUSED_ARMOR)
                set needCheck = true 
            endif 
            if BONUSING_BLOCK != BONUSED_BLOCK then 
                call ST_BLOCK.addStateSimple(checkingUnit,STATE_MODE_REAL,BONUSING_BLOCK-BONUSED_BLOCK)
                set needCheck = true 
            endif 
            if BONUSING_MANA != BONUSED_MANA then 
                call ST_MANA.addStateSimple(checkingUnit,STATE_MODE_REAL,BONUSING_MANA-BONUSED_MANA)
                set needCheck = true 
            endif 
            call SetHeroData(checkingUnit,"HERO_11_TALENT_16_BONUSED_AP",BONUSING_AP)
            call SetHeroData(checkingUnit,"HERO_11_TALENT_16_BONUSED_ARMOR",BONUSING_ARMOR)
            call SetHeroData(checkingUnit,"HERO_11_TALENT_16_BONUSED_BLOCK",BONUSING_BLOCK)
            call SetHeroData(checkingUnit,"HERO_11_TALENT_16_BONUSED_MANA",BONUSING_MANA)
            if needCheck then 
                set doNotCheck = true 
                call State.checkAll(checkingUnit)
                set doNotCheck = false
            endif 
        endfunction
        function HERO_11_TALENT_RESET_6 takes nothing returns nothing
            local boolean needCheck = false 
            local integer BONUSED_AP = GetHeroData(currentTTOwner,"HERO_11_TALENT_16_BONUSED_AP")
            local integer BONUSED_ARMOR = GetHeroData(currentTTOwner,"HERO_11_TALENT_16_BONUSED_ARMOR")
            local integer BONUSED_BLOCK = GetHeroData(currentTTOwner,"HERO_11_TALENT_16_BONUSED_BLOCK")
            local integer BONUSED_MANA = GetHeroData(currentTTOwner,"HERO_11_TALENT_16_BONUSED_MANA")
            if BONUSED_AP > 0 then 
                call ST_ABILITY_POWER.addStateSimple(currentTTOwner,STATE_MODE_REAL,0-BONUSED_AP)
                set BONUSED_AP = 0
                set needCheck = true 
            endif 
            if BONUSED_ARMOR > 0 then 
                call ST_ARMOR.addStateSimple(currentTTOwner,STATE_MODE_REAL,0-BONUSED_ARMOR)
                set BONUSED_ARMOR = 0
                set needCheck = true 
            endif 
            if BONUSED_BLOCK > 0 then 
                call ST_BLOCK.addStateSimple(currentTTOwner,STATE_MODE_REAL,0-BONUSED_BLOCK)
                set BONUSED_BLOCK = 0
                set needCheck = true 
            endif 
            if BONUSED_MANA > 0 then 
                call ST_MANA.addStateSimple(currentTTOwner,STATE_MODE_REAL,0-BONUSED_MANA)
                set BONUSED_MANA = 0
                set needCheck = true 
            endif 
            call SetHeroData(currentTTOwner,"HERO_11_TALENT_16_BONUSED_AP",BONUSED_AP)
            call SetHeroData(currentTTOwner,"HERO_11_TALENT_16_BONUSED_ARMOR",BONUSED_ARMOR)
            call SetHeroData(currentTTOwner,"HERO_11_TALENT_16_BONUSED_BLOCK",BONUSED_BLOCK)
            call SetHeroData(currentTTOwner,"HERO_11_TALENT_16_BONUSED_MANA",BONUSED_MANA)
            if needCheck then 
                set doNotCheck = true 
                call State.checkAll(currentTTOwner)
                set doNotCheck = false
            endif 
        endfunction
        
        globals
            string ARCANE_WARRIOR_AURA_ENCHANTMENT = "ARCANE_WARRIOR_AURA_ENCHANTMENT"
            string ARCANE_WARRIOR_AURA_ECHO = "ARCANE_WARRIOR_AURA_ECHO"
        endglobals
        function A68G_ATTACKED_SOURCE takes nothing returns nothing
            set damageTag_Arcane = true 
        endfunction
        function A68G_ATTACKING takes nothing returns nothing
            local projectile proj = 0
            local mybuff bf = mybuff.currentBuff
            local real x
            local real y
            local real a
            local real d
            local real a0 = 0
            if unitCheckCooldown(damageTarget,'A68G') then 
                call unitStartCooldown(damageTarget,'A68G',5)
            else 
                return 
            endif 
            if random.get(bf.buffSource,0.2,'HTL7') then 
                set x = GetUnitX(damageTarget)/2+GetUnitX(damageSource)/2
                set y = GetUnitY(damageTarget)/2+GetUnitY(damageSource)/2
                set a = AngleByUnits(damageSource,damageTarget)/57.2956
                set d = DisByUnits(damageSource,damageTarget)
                set proj = CreateProjectileToUnit(bf.buffSource,damageTarget,1000,GetRandomReal(0,0.05),"war3campImported\\arcaneshot_missile2.mdx",function A68F_HIT,null)
                set proj.LAUNCH_UNIT = false 
                set proj.LAUNCH_LOC = true 
                set proj.source_x = GetUnitX(damageSource)
                set proj.source_y = GetUnitY(damageSource)
                set proj.bezier_points = 1
                if GetRandomReal(0.0,1.0) < 0.5 then 
                    set a0 = a+1.5708
                else 
                    set a0 = a-1.5708
                endif 
                set proj.bezier_x0 = x+d/3*Cos(a0)
                set proj.bezier_y0 = y+d/3*Sin(a0)
                set proj.flag = 'A68F'
                call delayedLaunchMissile(proj,15)
            endif 
        endfunction
        function AURA_ENCHANTMENT_STATE_CHECK takes nothing returns nothing
            if IsUnitType(aura.filterUnit,UNIT_TYPE_HERO) == false or aura.filterUnit == aura.checkingAura.bindUnit then 
                set aura.able = false 
                return 
            endif 
            set aura.able = true 
        endfunction
        function AURA_ENCHANTMENT_STATE_SET takes nothing returns nothing
            local mybuff bf = aura.modifingAuraBuff
            call bf.addAtked_S(function A68G_ATTACKED_SOURCE)
            call bf.addAtking(function A68G_ATTACKING)
        endfunction
        function HERO_11_TALENT_LEARN_7 takes nothing returns nothing
            local aura ar = CreateAura(currentTTOwner,ARCANE_WARRIOR_AURA_ENCHANTMENT,900,0,BUFFTYPE_AW_ARCANEENCHANTMENT,"")
            call ar.addAllySet(function AURA_ENCHANTMENT_STATE_SET)
            call ar.addAllyChk(function AURA_ENCHANTMENT_STATE_CHECK)
            set ar.removeWhenDeath = false 
        endfunction
        function HERO_11_TALENT_RESET_7 takes nothing returns nothing
            set aura.getAura(currentTTOwner,ARCANE_WARRIOR_AURA_ENCHANTMENT).DESTROY = true 
        endfunction 

        function HERO_11_TALENT_8_DELAYED_HEAL takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            
            set healFlag = 'SZ5J'
            set healIsExtra = true 
            set healAddCrit = -10000
            call UnitHealTarget(caster,caster,0.05*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
            call AddUnitMana(caster,0.05*GetUnitState(caster,UNIT_STATE_MAX_MANA))

            set caster = null 
        endfunction
        function HERO_11_TALENT_8_DELAYED_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local unit target = de.loadUnit("TARGET")
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(caster))*1.25
            
            set damageFlag = 'SZ5J'
            set damageIsExtra = true 
            set damageTag_Arcane = true 
            call UnitDamageTarget(caster,target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)

            set caster = null 
        endfunction
        function HERO_11_TALENT_SPELLING_8 takes nothing returns nothing
            local delayedevent de = 0
            if unitCheckCooldown(spellCaster,'SZ5J') == false then 
                return 
            endif 
            call bufflist.listUnitBuffs(spellCaster,false,true,true)
            if bufflist.dispel() then 
                call unitStartCooldown(spellCaster,'SZ5J',800)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",spellCaster,"origin"))
                set de = CreateDelayedEvent(15,1,function HERO_11_TALENT_8_DELAYED_HEAL)
                call de.saveUnit("CASTER",spellCaster)
            else 
                if castingSpell == 'S05J' then 
                    call bufflist.listUnitBuffs(spellTarget,true,false,true)
                    if bufflist.dispel() then 
                        call unitStartCooldown(spellCaster,'SZ5J',800)
                        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",spellTarget,"origin"))
                        set de = CreateDelayedEvent(15,1,function HERO_11_TALENT_8_DELAYED_HEAL)
                        call de.saveUnit("CASTER",spellCaster)
                        call de.saveUnit("TARGET",spellTarget)
                    elseif IsUnitType(spellTarget,UNIT_TYPE_SUMMONED) then 
                        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",spellTarget,"origin"))
                        set de = CreateDelayedEvent(15,1,function HERO_11_TALENT_8_DELAYED_HEAL)
                        call de.saveUnit("CASTER",spellCaster)
                        call de.saveUnit("TARGET",spellTarget)
                    endif 
                endif 
            endif 
        endfunction

        function HERO_11_TALENT_BEFOREDAMAGE_SOURCE_9 takes nothing returns nothing
            local real r = 0
            if damageFlag == 'S05J' then 
                if GetUnitAbilityLevel(damageSource,'BZZX') > 0 or GetUnitAbilityLevel(damageSource,'S05V') > 0 then 
                    set r = RMaxBJ(0,RMinBJ(0.05*GetUnitState(damageSource,UNIT_STATE_LIFE),GetUnitState(damageSource,UNIT_STATE_LIFE)-1))
                    set damageDamage = damageDamage+2*r 
                    call AddUnitMana(damageSource,r)
                    call AddUnitLife(damageSource,0-r)
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",damageTarget,"chest"))
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",damageSource,"chest"))
                else 
                    set r = RMaxBJ(0,0.1*GetUnitState(damageSource,UNIT_STATE_MANA))
                    set damageDamage = damageDamage+2*r 
                    call AddUnitMana(damageSource,0-r)
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",damageTarget,"chest"))
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",damageSource,"chest"))
                endif 
            endif 
        endfunction

        function A68H_PREDAMAGE_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if bf.buffSource == damageSource then 
                set damageResistance = damageResistance*(1-0.1*I2R(bf.intData))
            endif 
        endfunction
        function A68H_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local projectile proj = 0
            local integer i = bf.intData
            local real x = GetUnitX(bf.buffTarget)/2+GetUnitX(bf.buffSource)/2
            local real y = GetUnitY(bf.buffTarget)/2+GetUnitY(bf.buffSource)/2
            local real a = AngleByUnits(bf.buffSource,bf.buffTarget)/57.2956
            local real d = DisByUnits(bf.buffSource,bf.buffTarget)
            local real a0 = 0
            loop
                exitwhen i <= 0
                set proj = CreateProjectileToUnit(bf.buffSource,bf.buffTarget,1000,GetRandomReal(0,0.05),"war3campImported\\arcaneshot_missile2.mdx",function A68F_HIT,null)
                set proj.bezier_points = 1
                if ModuloInteger(i,2) == 1 then 
                    set a0 = a+1.5708
                else 
                    set a0 = a-1.5708
                endif 
                set proj.bezier_x0 = x+d/3*Cos(a0)
                set proj.bezier_y0 = y+d/3*Sin(a0)
                set proj.flag = 'A68F'
                call delayedLaunchMissile(proj,15*i)
                set i = i-1
            endloop
        endfunction
        function HERO_11_TALENT_ATTACKED_SOURCE_10 takes nothing returns nothing
            local mybuff bf = mybuff.getUnitBuff(damageTarget,BUFFTYPE_AW_ARCANETOUCH)
            if bf > 0 then 
                if bf.intData >= 6 then 
                    return 
                endif 
            endif
            set bf = CreateBuff(damageSource,damageTarget,BUFFTYPE_AW_ARCANETOUCH,600)
            set bf.addTime = false 
            set bf.intData = bf.intData+1
            call bf.addPreDmg_T(function A68H_PREDAMAGE_TARGET)
            call bf.addEnding(function A68H_END)
            call bf.apply()
        endfunction

        function A68I_DELAYED_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit source = de.loadUnit("SOURCE")
            local unit target = de.loadUnit("TARGET")
            local real dmg    = de.loadReal("DAMAGE")
            set damageFlag = 'A68I'
            set damageIsExtra = true 
            set damageTag_Arcane = true 
            call UnitDamageTarget(source,target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",target,"chest"))
            set source = null 
            set target = null 
        endfunction
        function A68I_AFTERDAMAGE_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local delayedevent de = 0
            if damageFlag != 'A68I' and damageIsExtra == false and unitCheckCooldown(damageTarget,'A68I') and damageIsDOT == false then 
                if random.get(damageTarget,0.25,'B68I') then 
                    call unitStartCooldown(damageTarget,'A68I',10)
                    set de = CreateDelayedEvent(GetRandomInt(15,25),1,function A68I_DELAYED_DAMAGE)
                    call de.saveUnit("SOURCE",bf.buffSource)
                    call de.saveUnit("TARGET",damageTarget)
                    call de.saveReal("DAMAGE",damageDamage*0.5)
                endif 
            endif 
        endfunction
        function AURA_ECHO_STATE_SET takes nothing returns nothing
            local mybuff bf = aura.modifingAuraBuff
            call bf.addAftDmg_T(function A68I_AFTERDAMAGE_TARGET)
        endfunction
        function HERO_11_TALENT_LEARN_11 takes nothing returns nothing
            local aura ar = CreateAura(currentTTOwner,ARCANE_WARRIOR_AURA_ECHO,900,BUFFTYPE_AW_ARCANEECHO,0,"war3campImported\\mana aura.mdx")
            call ar.addEnmSet(function AURA_ECHO_STATE_SET)
            set ar.removeWhenDeath = false 
        endfunction
        function HERO_11_TALENT_RESET_11 takes nothing returns nothing
            set aura.getAura(currentTTOwner,ARCANE_WARRIOR_AURA_ECHO).DESTROY = true 
        endfunction 

        

        function HERO_11_TALENT_CHECK_STATE_12 takes nothing returns nothing
            local boolean needCheck = false 
            local integer BONUSED_BLOCK = GetHeroData(checkingUnit,"HERO_11_TALENT_12_BONUSED_BLOCK")
            local integer BONUSING_BLOCK = R2I(GetUnitState(checkingUnit,UNIT_STATE_MAX_MANA))*10
            if BONUSING_BLOCK != BONUSED_BLOCK then 
                call ST_BLOCK.addStateSimple(checkingUnit,STATE_MODE_REAL,BONUSING_BLOCK-BONUSED_BLOCK)
                set needCheck = true 
            endif 
            call SetHeroData(checkingUnit,"HERO_11_TALENT_12_BONUSED_BLOCK",BONUSING_BLOCK)
            if needCheck then 
                set doNotCheck = true 
                call State.checkAll(checkingUnit)
                set doNotCheck = false
            endif 
        endfunction
        function HERO_11_TALENT_RESET_12 takes nothing returns nothing
            local boolean needCheck = false 
            local integer BONUSED_BLOCK = GetHeroData(currentTTOwner,"HERO_11_TALENT_12_BONUSED_BLOCK")
            if BONUSED_BLOCK > 0 then 
                call ST_BLOCK.addStateSimple(currentTTOwner,STATE_MODE_REAL,0-BONUSED_BLOCK)
                set BONUSED_BLOCK = 0
                set needCheck = true 
            endif 
            call SetHeroData(currentTTOwner,"HERO_11_TALENT_12_BONUSED_BLOCK",BONUSED_BLOCK)
            if needCheck then 
                set doNotCheck = true 
                call State.checkAll(currentTTOwner)
                set doNotCheck = false
            endif 
            call unitAddState(currentTTOwner,STATE_MAX_BLOCK,-1000)
            call unitAddState(currentTTOwner,STATE_MAX_RESISTANCE,-1000)
        endfunction
        function HERO_11_TALENT_LEARN_12 takes nothing returns nothing
            call unitAddState(currentTTOwner,STATE_MAX_BLOCK,1000)
            call unitAddState(currentTTOwner,STATE_MAX_RESISTANCE,1000)
        endfunction
    //====================================================
    // endregion
    //====================================================
endlibrary

