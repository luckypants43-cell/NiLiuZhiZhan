        function SPELL_S02X takes nothing returns nothing   //力量祝福
            local mybuff bf
            call removeBlessSfx()
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PALADIN_BLESSOFSTRENGTH)
            set bf.lastTime = 60000
            set bf.bonusAttack_P = 2000
            set bf.bonusAbilityPower_P = 2000
            set bf.periodTime = 10
            call bf.addPeriod(function PAL_BLESS_AUTO_DISPEL)
            call bf.addBefDmg_T(function HERO_2_TALENT_3_BEFDMG_T)
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,5) then 
                call removeSilence(spellTarget)
