                set bf.bonusAgi_P = 1000
            endif 
            call bf.apply()
            set paladinLastBlessTarget = spellTarget
            call bufflist.listUnitBuffs(spellTarget,false,true,true)
            call bufflist.dispelMultiBuffs(3)
