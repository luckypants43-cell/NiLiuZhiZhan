    function AUSF_HIT takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        call applySnare(proj.source,proj.target,'ASN3')
        call UnitApplyTimedLife(proj.target,'BHwe',5)
        call SetUnitInvulnerable(proj.target,true)
        call PauseUnit(proj.target,true)
        call SetUnitAnimation(proj.target,"stand")
        call delayedRemoveUnit(proj.target,502)
        if sideQuest[25].state == QUEST_STATE_INPROGRESS then 
            call sideQuest[25].obj1.addProgress()
        endif 
        if repeatableQuest[2].state == QUEST_STATE_INPROGRESS then 
            call repeatableQuest[2].obj1.addProgress()
        endif 
    endfunction
    function SPELL_AUSF takes nothing returns nothing
        local projectile proj = 0
        if MAP_INDEX != 1 then 
            return 
        endif 
        if sideQuest[25].state != QUEST_STATE_INPROGRESS and repeatableQuest[2].state != QUEST_STATE_INPROGRESS then 
            call DisplayErrorMsg("|cffffcc00你没有接取任务。|r")
            return 
        endif 
        if GetUnitTypeId(spellTarget) != 'n62B' and GetUnitTypeId(spellTarget) != 'n62C' then 
            call DisplayErrorMsg("|cffffcc00只能以野猪为目标。|r")
            return
        endif 
        if GetUnitLifePercent(spellTarget) > 50 then 
            call DisplayErrorMsg("|cffffcc00野猪的体力充沛，无法捕获。|r")
            return
        endif 
        set proj = CreateProjectileToUnit(spellCaster,spellTarget,900,0.1,"Abilities\\Spells\\Orc\\Ensnare\\EnsnareMissile.mdl",function AUSF_HIT,null)
        call proj.launch()
    endfunction

    globals
        private integer AUSG_COUNT = 0
    endglobals
    function SPELL_AUSG takes nothing returns nothing
        local unit nu = null 
        if MAP_INDEX != 1 then 
            return 
        endif 
        if sideQuest[27].state != QUEST_STATE_INPROGRESS or sideQuest[27].obj1.completed != false then 
            call DisplayErrorMsg("|cffffcc00你没有接取任务。|r")
            return 
        endif 
        if GetUnitTypeId(spellTarget) != 'n61S' and GetUnitTypeId(spellTarget) != 'n63W' then 
            call DisplayErrorMsg("|cffffcc00只能以女妖或怨灵为目标。|r")
            return
        endif 
        call UnitsAddLightningSFX(spellCaster,0,0,50,spellTarget,0,0,50,"CLPB",1,0.5,false)
        call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",GetUnitX(spellTarget),GetUnitY(spellTarget)))
        call KillUnit(spellTarget)
        if AUSG_COUNT < 5 then 
            set nu = CreateUnit(Player(11),'n643',GetUnitX(spellTarget),GetUnitY(spellTarget),GetUnitFacing(spellTarget))
            set RegisterEnemy(nu).needRespawn = false 
        else 
            set nu = CreateUnit(Player(11),'n644',GetUnitX(spellTarget),GetUnitY(spellTarget),GetUnitFacing(spellTarget))
            set RegisterEnemy(nu).needRespawn = false 
        endif 
        set AUSG_COUNT = AUSG_COUNT+1
    endfunction
    function SPELL_AUSH takes nothing returns nothing
        local unit nu = null 
        if MAP_INDEX != 2 then 
            return 
        endif 
        if sideQuest[41].state != QUEST_STATE_INPROGRESS or sideQuest[41].obj1.completed != false then 
            call DisplayErrorMsg("|cffffcc00你没有接取任务。|r")
            return 
        endif 
        if GetUnitTypeId(spellTarget) != 'n63O' then 
            call DisplayErrorMsg("|cffffcc00只能以阿伽玛甘之血为目标。|r")
            return
        endif 
        call UnitsAddLightningSFX(spellCaster,0,0,50,spellTarget,0,0,50,"AFOD",1,0.5,false)
        call KillUnit(spellTarget)
        set nu = CreateUnit(Player(11),'n64F',GetUnitX(spellTarget),GetUnitY(spellTarget),GetUnitFacing(spellTarget))
        call delayedPauseUnit(nu,100)
        call delayedPlayAnimation(nu,"birth",100)
        set RegisterEnemy(nu).needRespawn = false 
    endfunction
    function ITEM_PICK_if00 takes nothing returns nothing
        local unit tempUU = CreateUnit(PLAYER,'nSZ0',GetWidgetX(itemTriggerItem),GetWidgetY(itemTriggerItem),270)
        local delayedevent de = delayedevent.create(200,15,function CAMP_FIRE_REGEN)
        call UnitApplyTimedLife(tempUU,'BTLF',30)
        call de.saveUnit("CASTER",tempUU)
        call RemoveItem(itemTriggerItem)
        set tempUU = null 
    endfunction

    function ITEM_PICK_IB00 takes nothing returns nothing
        local integer i = 0
        if enableBank == i then 
            set enableBank = i+1
            call ShowUnit(bank[i],true)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\Transmute\\GoldBottleMissile.mdl",GetTriggerUnit(),"origin"))
            call PingMinimap(GetUnitX(bank[i]),GetUnitY(bank[i]),5)
            call SetUnitOwner(bank[i],PLAYER,true)
        endif 
        if bankManager != null then 
            call QuestReplaceDialog(bankManager,'IB00','IB01',1)
        endif 
    endfunction
