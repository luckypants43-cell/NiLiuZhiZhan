        set BUFFTYPE_ITEM_CORRUPTION = bufftype.create('A635','B63E',false,true,true)                          //腐蚀术
        set BUFFTYPE_ITEM_ENTRENCHING = bufftype.create('A636','B63F',false,true,true)                          //
        set BUFFTYPE_AMULET_FIREENCHANT = bufftype.create('A60H','B63G',true,false,true)                    //火焰附魔
        set BUFFTYPE_AMULET_HARDENEDSKIN = bufftype.create('A637','B63H',true,false,true)                    //硬化护甲
        set BUFFTYPE_FLASK = bufftype.create('ABFL','BBFL',true,false,false)                    //合剂
        set BUFFTYPE_ITEM_ENDURANCEAURA = bufftype.create('A64L','B64V',true,false,false)                    //耐久光环
        set BUFFTYPE_ITEM_BRILLIANCEAURA = bufftype.create('A64M','B64W',true,false,false)                    //辉煌光环
