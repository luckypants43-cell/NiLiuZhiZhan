    function HERO_10_TALENT_AFTERDAMAGE_TARGET_1 takes nothing returns nothing
        local delayedevent de = delayedevent.create(500,1,function HERO_10_TALENT_1_REMOVE_SAVED)
        call de.saveReal("SAVED",damageFinalDamage)
        set deathStrikeSavedDamage = deathStrikeSavedDamage+damageFinalDamage
    endfunction

    function A647_DMGING_T takes nothing returns nothing
