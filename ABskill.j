            set mini.remove = true 
            set mini.intData = globalNowtime
            set mini.deathSFX = "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl"
            call UnitApplyTimedLife(mini.summon,'BTLF',30)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl",x,y))
            call unitCheckState(mini.summon)
        endfunction
        function SPELL_S053 takes nothing returns nothing   //钢铁风暴
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = GetUnitFacing(spellCaster)/57.2956
            local projectile proj = CreateProjectileToLoc(spellCaster,x+200*Cos(a+1.047),y+200*Sin(a+1.047),300,0.25,"Units\\Creeps\\HeroTinkerFactory\\HeroTinkerFactoryMissle.mdl",null,function S053_SUMMON_TANK)
            set proj.ifCheckPath = true
            set proj.model_attach = "origin"
            call proj.launch()
            set proj = CreateProjectileToLoc(spellCaster,x+200*Cos(a-1.047),y+200*Sin(a-1.047),300,0.25,"Units\\Creeps\\HeroTinkerFactory\\HeroTinkerFactoryMissle.mdl",null,function S053_SUMMON_AIRPLANE)
            set proj.ifCheckPath = true
            set proj.model_attach = "origin"
            call proj.launch()
            set proj = CreateProjectileToLoc(spellCaster,x+200*Cos(a),y+200*Sin(a),300,0.25,"Units\\Creeps\\HeroTinkerFactory\\HeroTinkerFactoryMissle.mdl",null,function S053_SUMMON_GOLEM)
            set proj.ifCheckPath = true
            set proj.model_attach = "origin"
            call proj.launch()
        endfunction

        function A67M_ENDING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call BlzSetUnitAttackCooldown(bf.buffTarget,2,0)
            if HeroHaveTalent(bf.buffSource,HERO_ULTIMATE_TALENT,11) then 
                call applyStun(bf.buffSource,bf.buffTarget,'ATB1')
                call TINKER_LOAD_RUNESHELL(bf.buffSource,BUFFTYPE_TINKER_LOADRUNESHELL_NUKE,1)
            else 
                call applyStun(bf.buffSource,bf.buffTarget,'ATB2')
            endif 
        endfunction
        function SPELL_S054 takes nothing returns nothing   //过热
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_TINKER_OVERHEAT,800)
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,10) then 
                set bf.bonusAttack_P = 10000
            else 
                call bf.addEnding(function A67M_ENDING)
                call BlzSetUnitAttackCooldown(spellCaster,0.5,0)
            endif 
            call bf.apply()
            call BlzEndUnitAbilityCooldown(spellCaster,'S04W')
        endfunction

        function A67U_BEFOREDAMAGE_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if damageMaster == bf.buffSource then 
                set damageExtraCritTime = damageExtraCritTime+1
                set damageArmor = damageArmor*0.5
            endif 
        endfunction
        function S055_HIT takes nothing returns nothing
            local mybuff bf = 0
            local real dmg = I2R(GetUnitAttack(waveCaster,0))*3
            if IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) then 
                set damageFlag = 'S055'
                set damageIsAOE = true 
                if nowRuneShell == 0 then 
                    set damageTag_Fire = true 
                elseif nowRuneShell == 1 then 
                    set damageTag_Cold = true 
                elseif nowRuneShell == 2 then 
                    set damageTag_Earth = true 
                elseif nowRuneShell == 3 then 
                    set damageTag_Shadow = true 
                elseif nowRuneShell == 4 then 
                    set damageTag_Lightning = true 
                endif
                set damageTag_Attack = true 
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                if HeroHaveTalent(waveCaster,HERO_ULTIMATE_TALENT,11) then 
                    set bf = CreateBuff(waveCaster,waveTarget,BUFFTYPE_TINKER_AIMTARGET,1500)
                    call bf.addBefDmg_T(function A67U_BEFOREDAMAGE_TARGET)
                    call bf.apply()
                endif 
            endif 
        endfunction
        function S055_NUKE takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = GetUnitX(proj.dummy)
            local real y = GetUnitY(proj.dummy)
            local real dmg = I2R(GetUnitAttack(proj.source,0))*5
            local group pick = CreateGroup()
            call GroupEnumUnitsInRange(pick,x,y,130,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null
                set damageTag_Fire = true 
                set damageFlag = 'S055'
                set damageIsAOE = true 
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call applyStun(proj.source,FirstOfGroup(pick),'ATB0')
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl",x,y))
        endfunction
        function S055_MISSILE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local projectile proj = de.loadInteger("PROJ")
            local real x = GetUnitX(proj.dummy)
            local real y = GetUnitY(proj.dummy)
            local real a = GetUnitFacing(proj.dummy)/57.2956
            local projectile newProj = CreateProjectileToLoc(proj.source,x+411*Cos(a),y+411*Sin(a),522,0,"Abilities\\Weapons\\RocketMissile\\RocketMissile.mdl",null,function S055_NUKE)
            set newProj.LAUNCH_LOC = true 
            set newProj.LAUNCH_UNIT = false 
            set newProj.source_x = GetUnitX(proj.dummy)
            set newProj.source_y = GetUnitY(proj.dummy)
            set newProj.start_z = GetUnitFlyHeight(proj.dummy)
            set newProj.end_z = 0
            call newProj.launch()
        endfunction
        function S055_SFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local projectile proj = de.loadInteger("PROJ")
            local real x = GetUnitX(proj.dummy)
            local real y = GetUnitY(proj.dummy)
            local real a = GetUnitFacing(proj.dummy)-40
            local real d = 150
            local integer i = 0
            loop
                exitwhen i > 4
                call delayedDestroyEffect(AddSpecialEffectEX(runeShellProj[nowRuneShell],x+d*Cos((a+20*I2R(i))/57.2956),y+d*Sin((a+20*I2R(i))/57.2956)),30)
                set i = i+1
            endloop
        endfunction
        function SPELL_S055 takes nothing returns nothing   //空袭
            local real a = AngleByUnXY(spellCaster,spellTargetX,spellTargetY)/57.2956
            local real x = GetUnitX(spellCaster)+626.4*Cos(a)
            local real y = GetUnitY(spellCaster)+626.4*Sin(a)
            local delayedevent de = CreateDelayedEvent(17,10,function S055_SFX)
            local projectile proj = CreateWave(spellCaster,x,y,522,150,0,"units\\human\\Gyrocopter\\Gyrocopter_V1.mdl",function S055_HIT,null)
            set proj.start_x = -261
            set proj.start_z = 200
            set proj.end_z = 200
            call proj.launch()
            call de.saveInteger("PROJ",proj)
            set de = CreateDelayedEvent(10,1,function S055_MISSILE)
            call de.saveInteger("PROJ",proj)
            set de = CreateDelayedEvent(60,1,function S055_MISSILE)
            call de.saveInteger("PROJ",proj)
            set de = CreateDelayedEvent(110,1,function S055_MISSILE)
            call de.saveInteger("PROJ",proj)
        endfunction
    // endregion 

    ///////////////
    ///////////////

    // region 护符技能
        function AA00_BOUNCE takes nothing returns nothing
            local group newgroup = delayedevent.currentEvent.loadGroup("GROUP")
            local group newEnum = CreateGroup()
            local group filterEnum = CreateGroup()
            local unit lastTarget = delayedevent.currentEvent.loadUnit("LAST_TARGET")
            local unit nowTarget = null
            local integer count = delayedevent.currentEvent.loadInteger("COUNT")
            call GroupEnumUnitsInRangeEx(newEnum,GetUnitX(lastTarget),GetUnitY(lastTarget),450,groupEnumLegal)
            call GroupRemoveGroup(newgroup,newEnum)
            set nowTarget = GroupPickRandomUnitEx(newEnum)
            loop 
                exitwhen FirstOfGroup(newEnum) == null 
                if (IsUnitEnemy(FirstOfGroup(newEnum),PLAYER) and mybuff.countUnitPosBuffDispelAble(FirstOfGroup(newEnum)) > 0) or (IsUnitAlly(FirstOfGroup(newEnum),PLAYER) and mybuff.countUnitNegBuffDispelAble(FirstOfGroup(newEnum)) > 0) or (IsUnitEnemy(FirstOfGroup(newEnum),PLAYER) and IsUnitType(FirstOfGroup(newEnum),UNIT_TYPE_SUMMONED)) then 
                    call GroupAddUnit(filterEnum,FirstOfGroup(newEnum))
                endif 
                call GroupRemoveUnit(newEnum,FirstOfGroup(newEnum))
            endloop
            call DestroyGroup(newEnum)
            if CountUnitsInGroup(filterEnum) > 0 then 
                set nowTarget = GroupPickRandomUnitEx(filterEnum)
            endif 
            call DestroyGroup(filterEnum)
            if nowTarget == null then 
                set count = 0
            else 
                call GroupAddUnit(newgroup,nowTarget)
                if IsUnitEnemy(nowTarget,PLAYER) then 
                    if IsUnitType(nowTarget,UNIT_TYPE_SUMMONED) then 
                        set damageTag_Arcane = true 
                        set damageFlag = 'AA00'
                        call UnitDamageTarget(hero[6],nowTarget,I2R(unitGetAllBonusStateValue(hero[6],STATE_ABILITY_POWER))*4,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                        call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\arcane_missile_lvl4.mdx",nowTarget,"chest"))
                    endif 
                    call bufflist.listUnitBuffs(nowTarget,true,false,true)
                    call bufflist.dispelMultiBuffs(3)
                    call bufflist.flush()
                elseif IsUnitAlly(nowTarget,PLAYER) then 
                    call bufflist.listUnitBuffs(nowTarget,false,true,true)
                    call bufflist.dispelMultiBuffs(3)
                    call bufflist.flush()
                endif 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",nowTarget,"chest"))
                call UnitsAddLightningSFX(lastTarget,0,0,30,nowTarget,0,0,30,"SPLK",1.5,0.3,false).setColor(0.45,0.2,1,1)
                set count = count-1
                call delayedevent.currentEvent.saveUnit("LAST_TARGET",nowTarget)
            endif 
            if count <= 0 then 
                call DestroyGroup(newgroup)
            endif 
            set newEnum = null 
            set filterEnum = null 
            set lastTarget = null 
            set nowTarget = null 
            set newgroup = null 
        endfunction
        function SPELL_AA00 takes nothing returns nothing   //瓦解之链
            local group newgroup = CreateGroup()
            local delayedevent de
            call GroupAddUnit(newgroup,spellTarget)
            if IsUnitEnemy(spellTarget,PLAYER) then 
                if IsUnitType(spellTarget,UNIT_TYPE_SUMMONED) then 
                    set damageTag_Arcane = true 
                    set damageFlag = 'AA00'
                    call UnitDamageTarget(spellCaster,spellTarget,I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*4,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                    call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\arcane_missile_lvl4.mdx",spellTarget,"chest"))
                endif 
                call bufflist.listUnitBuffs(spellTarget,true,false,true)
                call bufflist.dispelMultiBuffs(3)
                call bufflist.flush()
            elseif IsUnitAlly(spellTarget,PLAYER) then 
                call bufflist.listUnitBuffs(spellTarget,false,true,true)
                call bufflist.dispelMultiBuffs(3)
                call bufflist.flush()
            endif 
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",spellTarget,"chest"))
            call UnitsAddLightningSFX(spellCaster,0,0,30,spellTarget,0,0,30,"SPLK",1.5,0.3,false).setColor(0.45,0.2,1,1)
            set de = delayedevent.create(15,2,function AA00_BOUNCE)
            call de.saveGroup("GROUP",newgroup)
            call de.saveUnit("LAST_TARGET",spellTarget)
            call de.saveInteger("COUNT",2)
            set newgroup = null 
        endfunction
        function ATTACKED_SOURCE_AA01 takes nothing returns nothing
            set damageTag_Fire = true 
        endfunction
        function SPELL_AA01 takes nothing returns nothing   //火焰附魔
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_AMULET_FIREENCHANT)
            set bf.lastTime = 1000
            set bf.bonusAttack_P = 1500
            call bf.addAtked_S(function ATTACKED_SOURCE_AA01)
            call bf.apply()
        endfunction
        function SPELL_AA02 takes nothing returns nothing   //自我疗愈
            call AddUnitMana(spellCaster,30.0)
            set healFlag = 'AA02' 
            call UnitHealTarget(spellCaster,spellCaster,2*unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",spellCaster,"origin"))
        endfunction
        function SPELL_AA03 takes nothing returns nothing   //硬化护甲
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_AMULET_HARDENEDSKIN)
            set bf.lastTime = 1000
            set bf.bonusArmor_P = 2000
            set bf.bonusResistance = 2000
            call bf.apply()
        endfunction
        function SPELL_AA04 takes nothing returns nothing   //静默射线
            local real dmg = 2*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))
            set damageTag_Shadow = true 
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\ManaBurn\\ManaBurnTarget.mdl",spellTarget,"chest"))
            call UnitsAddLightningSFX(spellCaster,0,0,30,spellTarget,0,0,30,"MBUR",1.5,0.3,false)
            call applySilence(spellCaster,spellTarget,'ASI1')
        endfunction

        
        function AA05_HIT takes nothing returns nothing
            local mybuff bf
            if alive(waveTarget) and IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) and IsUnitType(waveTarget,UNIT_TYPE_ANCIENT) == false and IsUnitType(waveTarget,UNIT_TYPE_STRUCTURE) == false then 
                set damageTag_Cold = true
                set damageIsAOE = true
                set damageFlag = 'AA05'
                call UnitDamageTarget(waveCaster,waveTarget,I2R(unitGetAllBonusStateValue(waveCaster,STATE_ABILITY_POWER))*2,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call bufflist.flush()
                call bufflist.listUnitBuffs(waveTarget,true,false,true)
                call bufflist.dispelMultiBuffs(3)
            endif 
        endfunction
        function SPELL_AA05 takes nothing returns nothing   //净化
            local real a = AngleByUnXY(spellCaster,spellTargetX,spellTargetY)/57.2956
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local projectile proj = CreateWave(spellCaster,x+500*Cos(a),y+500*Sin(a),1200,150,300,"Abilities\\Spells\\Other\\BreathOfFrost\\BreathOfFrostMissile.mdl",function AA05_HIT,null)
            call proj.launch()
        endfunction

        function AA06_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = 2*I2R(unitGetAllBonusStateValue(proj.source,STATE_ABILITY_POWER))
            set damageFlag = 'AA06'
            set damageTag_Fire = true 
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call applyStun(proj.source,proj.target,'ATB1')
        endfunction
        function SPELL_AA06 takes nothing returns nothing   //火焰冲击
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1000,0,"Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl",function AA06_HIT,null)
            call proj.launch()
        endfunction

        function SPELL_AA07 takes nothing returns nothing   //驱邪术
            local real dmg = 3.5*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,300,playerAlly)
            loop
                exitwhen FirstOfGroup(pick) == null
                call bufflist.flush()
                call bufflist.listUnitBuffs(FirstOfGroup(pick),false,true,true)
                if bufflist.dispel() then 
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",FirstOfGroup(pick),"origin"))
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call GroupClear(pick)
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,300,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null
                call bufflist.flush()
                call bufflist.listUnitBuffs(FirstOfGroup(pick),true,false,true)
                if bufflist.dispel() then 
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",FirstOfGroup(pick),"origin"))
                endif 
                if IsUnitType(FirstOfGroup(pick),UNIT_TYPE_SUMMONED) then 
                    set damageTag_Divine = true 
                    set damageIsAOE = true 
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Other\\Andt\\Andt.mdl",spellTargetX,spellTargetY))
        endfunction

        function SPELL_AA08 takes nothing returns nothing   //鲜血献祭
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_AMULET_BLOODSACRIFICE,800)
            local integer ii = IMaxBJ(R2I(GetUnitLifePercent(spellCaster))-50,1)
            set bf.bonusHaste = 2500*ii/50
            set bf.bonusCrit = 2500*ii/50
            call bf.apply()
            call SetUnitState(spellCaster,UNIT_STATE_LIFE,RMinBJ(GetUnitState(spellCaster,UNIT_STATE_LIFE),0.5*GetUnitState(spellCaster,UNIT_STATE_MAX_LIFE)))
        endfunction

        function A65R_PREDAMAGE_SOURCE takes nothing returns nothing
            set damageArmor = damageArmor*0.85
            set damageResistance = damageResistance*0.85
        endfunction
        function A65R_AFTERDAMAGE_SOURCE takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if damageTag_Arcane then 
                if bf.bonusVersatility != 500 then 
                    set bf.bonusVersatility = 500
                    set bf.needRefreshState = true 
                endif 
            endif 
            if damageTag_Fire then 
                if bf.bonusCrit != 500 then 
                    set bf.bonusCrit = 500
                    set bf.needRefreshState = true 
                endif 
            endif 
            if damageTag_Lightning then 
                if bf.bonusHaste != 500 then 
                    set bf.bonusHaste = 500
                    set bf.needRefreshState = true 
                endif 
            endif 
            if damageTag_Cold then 
                if bf.bonusManaRegen != 10*UnitLevel(bf.buffSource) then 
                    set bf.bonusManaRegen = 10*UnitLevel(bf.buffSource)
                    set bf.needRefreshState = true 
                endif 
            endif 
            if damageTag_Earth then 
                if bf.bonusCostReduce != 1500 then 
                    set bf.bonusCostReduce = 1500
                    set bf.needRefreshState = true 
                endif 
            endif 
            if damageTag_Divine then 
                if bf.bonusImmune_Cold != 1 then 
                    set bf.bonusImmune_Cold = 1
                    set bf.needRefreshState = true 
                endif 
                if bf.bonusImmune_Silence != 1 then 
                    set bf.bonusImmune_Silence = 1
                    set bf.needRefreshState = true 
                endif 
                if bf.bonusImmune_Snare != 1 then 
                    set bf.bonusImmune_Snare = 1
                    set bf.needRefreshState = true 
                endif 
                if bf.bonusImmune_Stun != 1 then 
                    set bf.bonusImmune_Stun = 1
                    set bf.needRefreshState = true 
                endif 
                if bf.bonusImmune_Root != 1 then 
                    set bf.bonusImmune_Root = 1
                    set bf.needRefreshState = true 
                endif 
            endif 
            if damageTag_Shadow then 
                if bf.trigPredamageSource == null then 
                    call bf.addPreDmg_S(function A65R_PREDAMAGE_SOURCE)
                endif 
            endif 
        endfunction
        function SPELL_AA09 takes nothing returns nothing   //元素之体
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_AMULET_ELEMENTALFORM,1500)
            call bf.addAftDmg_S(function A65R_AFTERDAMAGE_SOURCE)
            call bf.apply()
        endfunction

        function A65S_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call bufflist.flush()
            call bufflist.listUnitBuffs(bf.buffSource,false,true,true)
            if bufflist.dispel() then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",bf.buffSource,"origin"))
            endif 
        endfunction
        function SPELL_AA0A takes nothing returns nothing   //霸体
            local group pick = CreateGroup()
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_AMULET_UNSTOPPABLE,1000)
            set bf.bonusImmune_Cold = 1
            set bf.bonusImmune_Root = 1
            set bf.bonusImmune_Silence = 1
            set bf.bonusImmune_Snare = 1
            set bf.bonusImmune_Stun = 1
            set bf.periodTime = 100
            call bf.addPeriod(function A65S_PERIOD)
            call bf.apply()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),350,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null
                call Taunt(spellCaster,FirstOfGroup(pick))
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl",spellCaster,"origin"))
            call removeSilence(spellCaster)
            call removeStun(spellCaster)
            call removeSnare(spellCaster)
            call removeRoot(spellCaster)
            call removeCold(spellCaster)
        endfunction

        function AA0B_ALLY_CHECK takes nothing returns nothing
            if IsUnitType(aura.filterUnit,UNIT_TYPE_HERO) == false then 
                set aura.able = false 
                return 
            endif 
            set aura.able = true 
        endfunction
        function AA0B_ALLY_SET takes nothing returns nothing
            local mybuff bf = aura.modifingAuraBuff
            set bf.bonusVersatility = 300
        endfunction
        function SPELL_AA0B takes nothing returns nothing   //英勇
            local aura ar = CreateAura(spellCaster,"AURA_HEROISM_AMULET",900,0,BUFFTYPE_AMULET_HEROISM,"war3campImported\\hiveNewModels\\PhoenixGlow015.mdx")
            call ar.addAllyChk(function AA0B_ALLY_CHECK)
            call ar.addAllySet(function AA0B_ALLY_SET)
            call ar.setLastTime(6000)
        endfunction

        function SPELL_AA0C takes nothing returns nothing   //嗜血术
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_AMULET_BLOODLUST,1500)
            set bf.bonusHaste = 3000
            set bf.bonusMoveSpeed_P = 3000
            call bf.apply()
        endfunction

        function AA0D_AOE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local real dmg = de.loadReal("DAMAGE")
            call GroupEnumUnitsInRangeEx(pick,x,y,300,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageTag_Cold = true 
                set damageFlag = 'AA0D'
                call UnitDamageTarget(caster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set caster = null 
            set pick = null 
        endfunction
        function AA0D_SFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local integer i = 0
            local real a
            local real d 
            local delayedevent dede 
            local location loc = Location(x,y)
            set dede = delayedevent.create(75,1,function AA0D_AOE)
            call dede.saveUnit("CASTER",de.loadUnit("CASTER"))
            call dede.saveReal("X",x)
            call dede.saveReal("Y",y)
            call dede.saveReal("DAMAGE",de.loadReal("DAMAGE"))
            loop 
                exitwhen i > 7
                set d = SquareRoot(GetRandomReal(2500,62500))
                set a = GetRandomReal(0.7854*I2R(i),0.7854*I2R(i+1))
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Blizzard\\BlizzardTarget.mdl",x+d*Cos(a),y+d*Sin(a)))
                set i = i+1
            endloop
            call Play3DSndEx(SND_BLIZZARD,x,y,GetLocationZ(loc))
            call RemoveLocation(loc)
            set loc = null 
        endfunction
        function SPELL_AA0D takes nothing returns nothing   //暴风雪
            local delayedevent de = delayedevent.create(100,5,function AA0D_SFX)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveReal("DAMAGE",I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*4/6)

            set de = delayedevent.create(1,1,function AA0D_SFX)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveReal("DAMAGE",I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*4/6)
        endfunction

        function SPELL_AA0E takes nothing returns nothing   //冲击波
            local group pick = CreateGroup()
            local real dmg = I2R(GetUnitMaxAttack(spellCaster,0))*2
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Firenova.mdx",x,y))
            call GroupEnumUnitsInRangeEx(pick,x,y,400,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if inCombat(FirstOfGroup(pick)) or DisByUnXY(FirstOfGroup(pick),x,y) < 250+BlzGetUnitCollisionSize(spellCaster)+BlzGetUnitCollisionSize(FirstOfGroup(pick)) then
                    set damageTag_Fire = true 
                    set damageIsAOE = true 
                    set damageFlag = 'AA0E'
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                    call applyStun(spellCaster,FirstOfGroup(pick),'ATB1')
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction

        function SPELL_AA0F takes nothing returns nothing   //挑衅怒吼
            local group pick = CreateGroup()
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl",spellCaster,"origin"))
            call GroupEnumUnitsInRangeEx(pick,x,y,450,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                call Taunt(spellCaster,FirstOfGroup(pick))
                call applySilence(spellCaster,FirstOfGroup(pick),'ASI1')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction

        function SPELL_AA0G takes nothing returns nothing   //群体回复
            local real dmg = 1*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),900,playerAlly)
            loop
                exitwhen FirstOfGroup(pick) == null
                set healFlag = 'AA0G'
                set healIsAOE = true 
                call UnitHealTarget(spellCaster,FirstOfGroup(pick),dmg)
                call bufflist.flush()
                call bufflist.listUnitBuffs(FirstOfGroup(pick),false,true,true)
                if bufflist.dispelMultiBuffs(3) then 
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",FirstOfGroup(pick),"origin"))
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Other\\Andt\\Andt.mdl",GetUnitX(spellCaster),GetUnitY(spellCaster)))
        endfunction
        function A68N_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call bufflist.listUnitBuffs(bf.buffTarget,false,true,true)
            call bufflist.dispel()
        endfunction
        function SPELL_AA0H takes nothing returns nothing   //魔龙精气
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_AMULET_DRAGONSPIRITE,800)
            set bf.bonusLifeRegen = R2I(4*GetUnitState(spellCaster,UNIT_STATE_MAX_LIFE))
            set bf.bonusImmune_Cold = 1
            set bf.bonusImmune_Silence = 1
            set bf.bonusImmune_Snare = 1
            set bf.bonusImmune_Stun = 1
            set bf.bonusImmune_Root = 1
            set bf.periodTime = 50
            call bf.addPeriod(function A68N_PERIOD)
            call bf.apply()
        endfunction
    // endregion

    //SPELL_
    //SPELL_READY_
    //SPELL_END_
    //SPELL_STOP_

    //全局技能
    function SPELL_ASP0 takes nothing returns nothing
        if GetItemCharges(spellTargetItem) <= 1 then 
            call SetItemPosition(spellTargetItem,GetUnitX(spellCaster),GetUnitY(spellCaster))
        else 
            call SetItemCharges(spellTargetItem,GetItemCharges(spellTargetItem)-1)
            call CreateItemEx(GetItemTypeId(spellTargetItem),GetUnitX(spellCaster),GetUnitY(spellCaster))
            call SetItemCharges(lastCreatedItem,1)
        endif   
    endfunction
    function SPELL_ASP1 takes nothing returns nothing
        if GetItemCharges(spellTargetItem) <= 5 then 
            call SetItemPosition(spellTargetItem,GetUnitX(spellCaster),GetUnitY(spellCaster))
        else 
            call SetItemCharges(spellTargetItem,GetItemCharges(spellTargetItem)-5)
            call CreateItemEx(GetItemTypeId(spellTargetItem),GetUnitX(spellCaster),GetUnitY(spellCaster))
            call SetItemCharges(lastCreatedItem,5)
        endif   
    endfunction
    function SPELL_ASP2 takes nothing returns nothing
        if GetItemCharges(spellTargetItem) <= 10 then 
            call SetItemPosition(spellTargetItem,GetUnitX(spellCaster),GetUnitY(spellCaster))
        else 
            call SetItemCharges(spellTargetItem,GetItemCharges(spellTargetItem)-10)
            call CreateItemEx(GetItemTypeId(spellTargetItem),GetUnitX(spellCaster),GetUnitY(spellCaster))
            call SetItemCharges(lastCreatedItem,10)
        endif   
    endfunction
    function SPELL_ASP3 takes nothing returns nothing
        if GetItemCharges(spellTargetItem) <= 20 then 
            call SetItemPosition(spellTargetItem,GetUnitX(spellCaster),GetUnitY(spellCaster))
        else 
            call SetItemCharges(spellTargetItem,GetItemCharges(spellTargetItem)-20)
            call CreateItemEx(GetItemTypeId(spellTargetItem),GetUnitX(spellCaster),GetUnitY(spellCaster))
            call SetItemCharges(lastCreatedItem,20)
        endif   
    endfunction
    function SPELL_ASWP takes nothing returns nothing
        local integer i = 0
        local Equipment eq_armoury = 0
        local Equipment eq_hero    = 0
        local real x = GetUnitX(armoury)
        local real y = GetUnitY(armoury)
        local item tempItem = null 
        if GetHeroIndex(spellTarget) == 0 then 
            call DisplayTextToPlayer(PLAYER,0,0,"|cffffcc00错误的目标。|r")
            return 
        endif
        set i = 0
        loop 
            exitwhen i > 5
            set tempItem = UnitItemInSlot(armoury,i)
            call SetItemPosition(tempItem,x,y)
            call UnitAddItem(armoury,UnitItemInSlot(spellTarget,i))
            call UnitAddItem(spellTarget,tempItem)
            set i = i+1
        endloop 
        set i = 0
        loop 
            exitwhen i > 9
            set eq_armoury = GetEquipedItem(armoury,i)
            set eq_hero = GetEquipedItem(spellTarget,i)
            if eq_armoury > 0 then 
                call eq_armoury.unEquip(armoury,i)
            endif 
            if eq_hero > 0 then 
                call eq_hero.unEquip(spellTarget,i)
            endif 
            if eq_hero > 0 then 
                call eq_hero.equip(armoury)
            endif 
            if eq_armoury > 0 then 
                call eq_armoury.equip(spellTarget)
            endif 
            set i = i+1
        endloop 
        set tempItem = null 
    endfunction
    function ATP0_DELAYED takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local unit caster = de.loadUnit("CASTER")
        local unit target = de.loadUnit("TARGET")
        local group pick = CreateGroup()
        local real x = GetUnitX(target)
        local real y = GetUnitY(target)
        call GroupEnumUnitsInRangeEx(pick,GetUnitX(caster),GetUnitY(caster),500,playerHero)
        loop
            exitwhen FirstOfGroup(pick) == null 
            if inCombat(FirstOfGroup(pick)) == false then 
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",GetUnitX(FirstOfGroup(pick)),GetUnitY(FirstOfGroup(pick))))
                call SetUnitPosition(FirstOfGroup(pick),x,y)
            endif 
            call GroupRemoveFirstUnit(pick)
        endloop
        call DestroyGroup(pick)
        call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdll",GetUnitX(caster),GetUnitY(caster)))
        call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdll",x,y))
        set pick = null 
        set target = null 
        set caster = null 
    endfunction
    function SPELL_ATP0 takes nothing returns nothing
        local delayedevent de 
        if GetUnitTypeId(spellTarget) == 'hAVT' then
            set de = delayedevent.create(300,1,function ATP0_DELAYED)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call delayedDestroyEffect(AddSpecialEffectEX("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl",GetUnitX(spellCaster),GetUnitY(spellCaster)),300)
            call delayedDestroyEffect(AddSpecialEffectEX("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl",GetUnitX(spellTarget),GetUnitY(spellTarget)),300)
        else 
            call DisplayErrorMsg("|cffffcc00只能以复活石为目标。|r")
        endif 
    endfunction

    //! textmacro spell_inv_icons takes iid,islot 
        function SPELL_READY_$iid$ takes nothing returns nothing
            local integer slot = $islot$
            if GetEquipedItem(spellCaster,slot) > 0 then 
                call GetEquipedItem(spellCaster,slot).unEquip(spellCaster,slot)
            endif 
            call IssueImmediateOrderById(spellCaster,ORDER_stop)
        endfunction
