        call AddUnitLife(itemTriggerUnit,4000)
        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",itemTriggerUnit,"origin"))
    endfunction
    function ITEM_IEXP_USE takes nothing returns nothing
        call getXP(50000)
        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl",itemTriggerUnit,"origin"))
    endfunction
    function ITEM_IF00_USE takes nothing returns nothing
        local mybuff bf
        if mybuff.getUnitBuff(itemTriggerUnit,BUFFTYPE_FLASK) > 0 then 
            call mybuff.getUnitBuff(itemTriggerUnit,BUFFTYPE_FLASK).destroy()
        endif 
        set bf = mybuff.create(itemTriggerUnit,itemTriggerUnit,BUFFTYPE_FLASK)
        set bf.bonusManaRegen = 50
        set bf.removeWhenDeath = false 
        set bf.lastTime = 3600000
        call bf.apply()
    endfunction 
