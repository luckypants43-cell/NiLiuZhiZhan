        set BUFFTYPE_SUNDERARMOR = bufftype.create('A64J','B64T',false,true,true)                          //破甲
        set BUFFTYPE_ENTANGLINGROOT = bufftype.create('A65N','B65U',false,true,true)                           //纠缠根须
        set BUFFTYPE_IMMOLATION = bufftype.create('A65O','B65V',true,false,false)                          //献祭
        set BUFFTYPE_FROSTARMOR = bufftype.create('A68K','B68K',true,false,true)                          //冰霜护甲
        set BUFFTYPE_FROSTHASTE = bufftype.create('A68L','B68L',true,false,true)                          //蓝冰急速
        set BUFFTYPE_THUNDERCLAP = bufftype.create('A65P','B65W',false,true,true)                           //雷霆一击
        set BUFFTYPE_CRIPPLE = bufftype.create('A66W','B66W',false,true,true)                           //残废
        set BUFFTYPE_POISON = bufftype.create('A66X','B66X',false,true,false)                           //中毒
        set BUFFTYPE_BLEED = bufftype.create('A66Y','B66Y',false,true,false)                           //流血
        set BUFFTYPE_BURN = bufftype.create('A66Z','B66Z',false,true,false)                           //烧伤
        set BUFFTYPE_ARCANERETALITION = bufftype.create('A68M','B68M',false,true,true)                           //狂咒
        set BUFFTYPE_DEVOTIONAURA = bufftype.create('A670','B670',false,true,false)                           //虔诚光环
    endfunction
    //buff注册end    
    function Dual_DamagedTarget takes nothing returns nothing
        set damageFinalDamage = 0.01*damageFinalDamage
    endfunction
    function AddDualBuff takes unit whichUnit returns mybuff
        local mybuff bf = mybuff.create(whichUnit,whichUnit,BUFFTYPE_DUAL)
        set bf.lastTime = 36000000
        call bf.addDmged_T(function Dual_DamagedTarget)
        call bf.apply()
        return bf
    endfunction
endlibrary

library spelllib requires initSkillDatas
        
    function DELAYED_RESET_SPELL_COOLDOWN takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        call BlzStartUnitAbilityCooldown(de.loadUnit("CASTER"),de.loadInteger("CODE"),de.loadReal("COOLDOWN")+0.05)
    endfunction
    // region vanguard 先锋
    ////////////////
    //HEROID = 0(1)
    ////////////////
        globals
            real VANGUARD_TENACITY_TOTAL_DAMAGE_TAKEN = 0
        endglobals
        function HERO_1_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 4
            local real a 
            local real d 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B61R') > 0 then 
                call UnitRemoveAbility(dt,'B61R')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S001'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageDamage = damageDamage*1.4
                set damageFlag = 'S001'
                call BlzStartUnitAbilityCooldown(ds,'S001',Qcd*haste-0.01)
                call Taunt(damageSource,damageTarget)
                call AddUnitMana(damageSource,0.02*GetUnitState(damageSource,UNIT_STATE_MAX_MANA))
            endif
            set ds = null 
            set dt = null 
        endfunction
        function HERO_1_AFTERDAMAGE_TARGET takes nothing returns nothing
            local mybuff bf 
            if GetUnitAbilityLevel(damageTarget,'S01Q') > 0 and mybuff.getUnitBuff(damageTarget,BUFFTYPE_VANGUARD_TENACITY) == 0 then 
                set VANGUARD_TENACITY_TOTAL_DAMAGE_TAKEN = VANGUARD_TENACITY_TOTAL_DAMAGE_TAKEN+damageFinalDamage
                if VANGUARD_TENACITY_TOTAL_DAMAGE_TAKEN > 0.5*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) then 
                    set VANGUARD_TENACITY_TOTAL_DAMAGE_TAKEN = VANGUARD_TENACITY_TOTAL_DAMAGE_TAKEN-0.5*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE)
                    set bf = mybuff.create(damageTarget,damageTarget,BUFFTYPE_VANGUARD_TENACITY)
                    set bf.lastTime = 500
                    set bf.bonusBlock = R2I(1*BlzGetUnitArmor(damageTarget)+0.5)
                    set bf.bonusMaxBlock = 1000
                    call bf.apply()
                    set healFlag = 'S01Q'
                    call UnitHealTarget(damageTarget,damageTarget,0.2*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))
                    call removeAllDisabilities(damageTarget)
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl",damageTarget,"origin"))
                endif 
            endif 
        endfunction
        function HERO_1_DAMAGED_TARGET takes nothing returns nothing
            if damageFinalDamage > GetUnitState(damageTarget,UNIT_STATE_LIFE)-0.5 and GetUnitAbilityLevel(damageTarget,'S01P') > 0 and BlzGetUnitAbilityCooldownRemaining(damageTarget,'S01P') < 0.5 then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl",damageTarget,"origin"))
                call SetUnitState(damageTarget,UNIT_STATE_LIFE,1)

                set castingSpell        = 'S01P'
                set spellCaster         = damageTarget
                set spellTarget         = null
                set spellTargetX        = 0
                set spellTargetY        = 0
                set spellAbilityLevel   = 1
                set spellCost           = BlzGetUnitAbilityManaCost(damageTarget,'S01P',0)
                set spellCooldown       = 90
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 

                call Cast.execute()
                call BlzStartUnitAbilityCooldown(damageTarget,'S01P',90)

                set damageFinalDamage = 0
            endif 
        endfunction 
        function SPELL_S000_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            set damageFlag = 'S000'
            call UnitDamageTarget(proj.source,proj.target,I2R(GetUnitAttack(proj.source,0))*2.5,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_HEAVY_BASH)
            call applySnare(proj.source,proj.target,'ASN1')
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl",proj.source,"origin"))
        endfunction
        function SPELL_S000_DEATH takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local group pick = CreateGroup()
            call SetUnitAnimation(proj.source,"stand")
            call SetUnitTimeScale(proj.source,1)
            if GetUnitCurrentOrder(proj.source) == ORDER_cannibalize then
                call IssueTargetOrderById(proj.source,ORDER_attack,proj.target)
            endif 
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl",proj.source,"origin"))
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(proj.target),GetUnitY(proj.target),200,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                call Taunt(proj.source,FirstOfGroup(pick))
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S000 takes nothing returns nothing   //冲锋
            local projectile proj = ChargeUnit(spellCaster,spellTarget,1500,0,100,true,function SPELL_S000_HIT,function SPELL_S000_DEATH)
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\Valiant Charge.mdx",spellCaster,"origin")
            call BlzSetSpecialEffectColor(proj.bindSFX_0,50,50,50)
            call proj.launchWithDummy(spellCaster,false)
            call SetUnitAnimationByIndex(spellCaster,8)
            call SetUnitTimeScale(spellCaster,3)
        endfunction
        function SPELL_S01O takes nothing returns nothing   //嘲讽
            local group pick = CreateGroup()
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_VANGUARD_TAUNTER)
            set bf.lastTime = 500
            set bf.bonusBlock = R2I(1.5*BlzGetUnitArmor(spellCaster)+0.5)
            call bf.apply()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),450,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                call Taunt(spellCaster,FirstOfGroup(pick))
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        
        function SPELL_S01P takes nothing returns nothing   //不屈之力
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_VANGUARD_INDOMITABLESTRENGTH)
            set bf.lastTime = 1500
            set bf.bonusArmor = GetUnitLevel(spellCaster)*2
            set bf.bonusResistance = 1500
            set bf.bonusLife_P = 2000
            call bf.apply()
            call UnitHealTarget(spellCaster,spellCaster,0.2*GetUnitState(spellCaster,UNIT_STATE_MAX_LIFE))
            call removeAllDisabilities(spellCaster)
        endfunction
        function SPELL_S01R takes nothing returns nothing   //觉醒
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_VANGUARD_AVATAR)
            set bf.lastTime = 2000
            set bf.bonusArmor_P = 2000
            set bf.bonusLife_P = 2000
            set bf.bonusAttack_P = 2000
            set bf.bonusResistance = 5000
            set bf.bonusImmune_Root = 1
            set bf.bonusImmune_Silence = 1
            set bf.bonusImmune_Snare = 1
            set bf.bonusImmune_Stun = 1
            set bf.bonusMaxArmor = 1500
            set bf.bonusMaxResistance = 1500
            call bf.apply()
            call removeAllDisabilities(spellCaster)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Avatar\\AvatarCaster.mdl",spellCaster,"origin"))
        endfunction
        function SHIELD_BASH_END takes nothing returns nothing
            call AddUnitAnimationProperties(mybuff.currentBuff.buffSource,"defend",false)
        endfunction
        function SHIELD_BASH_ATTACKED_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            set bf.intData = bf.intData-1
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl",bf.buffSource,"origin"))
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif 
        endfunction
        function SPELL_S01S takes nothing returns nothing   //盾牌猛击
            local real dmg = 1*I2R(GetUnitAttack(spellCaster,0))+I2R(unitGetAllBonusStateValue(spellCaster,STATE_BLOCK))+BlzGetUnitArmor(spellCaster)
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_VANGUARD_SHIELDBARRIER)
            set bf.lastTime = 800
            set bf.bonusBlock_P = 10000
            set bf.intData = 4+bf.intData
            set bf.bonusMaxBlock = 10000
            call bf.addAtked_T(function SHIELD_BASH_ATTACKED_TARGET)
            call bf.addEnding(function SHIELD_BASH_END)
            call bf.apply()
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl",spellTarget,"chest"))
            call AddUnitAnimationProperties(spellCaster,"defend",true)
            set damageFlag = 'S01S'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_HEAVY_BASH)
            call bufflist.listUnitBuffs(spellTarget,true,false,true)
            call bufflist.dispelMultiBuffs(3)
            call Taunt(spellCaster,spellTarget)
            call applyStun(spellCaster,spellTarget,'ATB0')
        endfunction 
        function HEROIC_SHOUT_DAMAGING_TARGET takes nothing returns nothing
            if damageSource == damageTarget then 
                return 
            endif 
            if damageTarget == mybuff.currentBuff.buffSource then 
                set damageFinalDamage = damageFinalDamage*(1-0.5*mybuff.currentBuff.realData)
            else 
                set damageFinalDamage = damageFinalDamage*(1-0.3*mybuff.currentBuff.realData)
            endif 
        endfunction
        function SPELL_S01T takes nothing returns nothing   //英勇怒吼
            local group pick = CreateGroup()
            local mybuff bf
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),350,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                call Taunt(spellCaster,FirstOfGroup(pick))
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),450,playerAlly)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_VANGUARD_HEROICSHOUT)
                set bf.lastTime = 800
                set bf.realData = 1
                call bf.addDmging_T(function HEROIC_SHOUT_DAMAGING_TARGET)
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function BATTLE_SHOUT_DAMAGING_SOURCE takes nothing returns nothing
            set damageFinalDamage = damageFinalDamage*(1+0.15*mybuff.currentBuff.realData)
        endfunction
        function SPELL_S01U takes nothing returns nothing   //命令怒吼
            local group pick = CreateGroup()
            local mybuff bf
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),450,playerAlly)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_VANGUARD_BATTLESHOUT)
                set bf.lastTime = 1500
                set bf.realData = 1
                call bf.addDmging_S(function BATTLE_SHOUT_DAMAGING_SOURCE)
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
    // endregion

    // region paladin 圣骑士
    ////////////////
    //HEROID = 1(2)
    ////////////////
        globals
            unit paladinLastBlessTarget = null 
            unit paladinDivineBeaconTarget = null 
            unit paladinVirtueBeaconTarget = null 
            private string AURA_PALADIN_DEVOTION = "AURA_PALADIN_DEVOTION"
            private string AURA_PALADIN_RETRIBUTION = "AURA_PALADIN_RETRIBUTION"
            private string AURA_PALADIN_LIFE = "AURA_PALADIN_LIFE"
        endglobals
        function removeBlessSfx takes nothing returns nothing
            if paladinLastBlessTarget != null then 
                set mybuff.getUnitBuff(paladinLastBlessTarget,BUFFTYPE_PALADIN_BLESSOFPROTECTION).DESTROY = true 
                set mybuff.getUnitBuff(paladinLastBlessTarget,BUFFTYPE_PALADIN_BLESSOFLIFE).DESTROY = true 
                set mybuff.getUnitBuff(paladinLastBlessTarget,BUFFTYPE_PALADIN_BLESSOFSTRENGTH).DESTROY = true 
            endif 
            set paladinLastBlessTarget = null
        endfunction
        function removeDivineBeaconSfx takes nothing returns nothing
            if paladinDivineBeaconTarget != null then 
                set mybuff.getUnitBuff(paladinDivineBeaconTarget,BUFFTYPE_PALADIN_DIVINEBEACON).DESTROY = true 
            endif 
            set paladinDivineBeaconTarget = null
        endfunction
        function removeVirtueBeaconSfx takes nothing returns nothing
            if paladinVirtueBeaconTarget != null then 
                set mybuff.getUnitBuff(paladinVirtueBeaconTarget,BUFFTYPE_PALADIN_VIRTUEBEACON).DESTROY = true 
            endif 
            set paladinVirtueBeaconTarget = null
        endfunction
        function HERO_2_RETRAIN takes nothing returns nothing
            call removeBlessSfx()
            call removeDivineBeaconSfx()
            call removeVirtueBeaconSfx()
            set aura.getAura(hero[1],AURA_PALADIN_DEVOTION).DESTROY = true 
            set aura.getAura(hero[1],AURA_PALADIN_RETRIBUTION).DESTROY = true 
            set aura.getAura(hero[1],AURA_PALADIN_LIFE).DESTROY = true 
        endfunction
        function HERO_2_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 6.3
            local real a 
            local real d 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B627') > 0 then 
                call UnitRemoveAbility(dt,'B627')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S02R'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageDamage = damageDamage*1.5
                set damageTag_Divine = true 
                set damageFlag = 'S02R'
                call BlzStartUnitAbilityCooldown(ds,'S02R',Qcd*haste-0.01)
                call Taunt(damageSource,damageTarget)

                set bf = mybuff.create(ds,ds,BUFFTYPE_PALADIN_DIVINEBARRIER)
                set bf.lastTime = 800 
                set bf.bonusArmor = R2I(I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*0.3)
                call bf.apply()
            endif

            set ds = null 
            set dt = null 
        endfunction
        function S02S_RESET takes nothing returns nothing
            local real haste = 1
            local real cooldown = 2
            if HeroHaveTalent(hero[1],HERO_PRIVATE_TALENT,2) then 
                set cooldown = cooldown-0.5
            endif 
            if unitGetBonusState(hero[1],STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetBonusState(hero[1],STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetBonusState(hero[1],STATE_HASTE)))/10000
            endif 
            call BlzStartUnitAbilityCooldown(hero[1],'S02S',RMaxBJ(0.52,cooldown*haste))
        endfunction
        function SPELL_S02S takes nothing returns nothing    //圣光闪现 
            local delayedevent de = delayedevent.create(1,1,function S02S_RESET)
            set healFlag = 'S02S'
            call UnitHealTarget(spellCaster,spellTarget,I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*1.2)
        endfunction
        function SPELL_S02U takes nothing returns nothing    //圣光术
            set healFlag = 'S02U'
            call UnitHealTarget(spellCaster,spellTarget,I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*3)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",spellTarget,"origin"))
        endfunction
        function S02T_HIT takes nothing returns nothing
            local real dmg = I2R(GetUnitAttack(projectile.currentProjectile.source,0))*2
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Divine = true 
            set damageFlag = 'S02T'
            call UnitDamageTarget(projectile.currentProjectile.source,projectile.currentProjectile.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",projectile.currentProjectile.target,"origin"))
            call Taunt(projectile.currentProjectile.source,projectile.currentProjectile.target)
            call applySilence(projectile.currentProjectile.source,projectile.currentProjectile.target,'ASI0')
        endfunction
        function SPELL_S02T takes nothing returns nothing   //审判
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1000,0,"war3campImported\\GryphonRiderMissileYellow.mdx",function S02T_HIT,null)
            set proj.flag = 'S02T'
            set proj.bounceMultiplier = 1
            set proj.maxBounceLimit = 3
            set proj.bounceRange = 450
            set proj.tag_Divine = true 
            call proj.launch()
        endfunction
        function A63P_DMGING_T takes nothing returns nothing
            set damageFinalDamage = damageFinalDamage*0.9
        endfunction
        function HERO_2_TALENT_3_DELAYED_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            set damageFlag = 'SZ2V'
            set damageIsExtra = true 
            call UnitDamageTarget(de.loadUnit("SOURCE"),de.loadUnit("TARGET"),de.loadReal("DAMAGE"),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function HERO_2_TALENT_3_BEFDMG_T takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local delayedevent de
            local real dmgReduce 
            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,3) then
                if bf.buffSource == damageSource then 
                    set damageDamage = damageDamage*0.9
                else 
                    set de = delayedevent.create(1,1,function HERO_2_TALENT_3_DELAYED_DAMAGE)
                    call de.saveUnit("SOURCE",damageSource)
                    call de.saveUnit("TARGET",bf.buffSource)
                    set dmgReduce = RMinBJ(GetUnitState(bf.buffSource,UNIT_STATE_LIFE)*2-1,damageDamage*0.2)
                    call de.saveReal("DAMAGE",dmgReduce*0.5)
                    set damageDamage = damageDamage-dmgReduce
                endif 
            endif   
        endfunction
        function PAL_BLESS_AUTO_DISPEL takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real haste = 1
            if ST_HASTE.getTotalState(bf.buffSource) >= 0 then 
                set haste = 1/(1+I2R(ST_HASTE.getTotalState(bf.buffSource))/10000)
            else 
                set haste = 1+I2R(ST_HASTE.getTotalState(bf.buffSource))/10000
            endif 
            if unitCheckCooldown(bf.buffTarget,bf.type.buffId) then 
                call bufflist.flush()
                call bufflist.listUnitBuffs(bf.buffTarget,false,true,true)
                if bufflist.dispelMultiBuffs(3) then 
                    call unitStartCooldown(bf.buffTarget,bf.type.buffId,800)
                endif 
            endif 
            if globalNowtime-bf.intData >= R2I(600*haste) then 
                set bf.intData = globalNowtime
                set healFlag = 'S02S'
                call UnitHealTarget(bf.buffSource,bf.buffTarget,I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*1.2)
                call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl",bf.buffTarget,"origin"),183)
            endif 
        endfunction
        function SPELL_S02V takes nothing returns nothing   //庇护祝福
            local mybuff bf
            call removeBlessSfx()
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PALADIN_BLESSOFPROTECTION)
            set bf.lastTime = 60000
            set bf.bonusArmor_P = 1500
            set bf.periodTime = 10
            call bf.addPeriod(function PAL_BLESS_AUTO_DISPEL)
            call bf.addBefDmg_T(function HERO_2_TALENT_3_BEFDMG_T)
            call bf.addDmging_T(function A63P_DMGING_T)
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,5) then 
                call removeSilence(spellTarget)
                call removeSnare(spellTarget)
                call removeRoot(spellTarget)
                call removeCold(spellTarget)
                set bf.bonusImmune_Cold = 1
                set bf.bonusImmune_Root = 1
                set bf.bonusImmune_Silence = 1
                set bf.bonusImmune_Snare = 1
                set bf.bonusInt_P = 1000
                set bf.bonusStr_P = 1000
                set bf.bonusAgi_P = 1000
            endif 
            call bf.apply()
            set paladinLastBlessTarget = spellTarget
            call bufflist.listUnitBuffs(spellTarget,false,true,true)
            call bufflist.dispelMultiBuffs(3)
        endfunction
        function A63Q_DELAYED_HEAL takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real heal = I2R(unitGetAllBonusStateValue(de.loadUnit("CASTER"),STATE_ABILITY_POWER))*0.3
            set healFlag = 'A63Q'
            call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),heal)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",de.loadUnit("TARGET"),"origin"))
        endfunction
        function A63Q_ATKING takes nothing returns nothing
            local delayedevent de = delayedevent.create(1,1,function A63Q_DELAYED_HEAL)
            call de.saveUnit("TARGET",damageSource)
            call de.saveUnit("CASTER",mybuff.currentBuff.buffSource)
        endfunction
        function A63Q_HEALING_T takes nothing returns nothing
            set healFinalHeal = healFinalHeal*1.2
        endfunction
        function SPELL_S02W takes nothing returns nothing   //生命祝福
            local mybuff bf
