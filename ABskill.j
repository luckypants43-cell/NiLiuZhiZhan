    //====================================================
    // region hero_15
    //====================================================
    function HERO_15_DELAYED_HEAL takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local real heal = de.loadReal("HEAL")
        set healFlag = de.loadInteger("FLAG")
        set healIsExtra = true
        if healFlag == 'S046' then 
            if GetUnitLifePercent(de.loadUnit("TARGET")) < 0.5 then 
                set heal = heal*1.5
            endif 
        endif 
        call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),heal)
        call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\VampiricAuraTargetBlue.mdx",de.loadUnit("TARGET"),"origin"))
    endfunction
    function HERO_15_TALENT_AFTERDAMAGE_SOURCE_1 takes nothing returns nothing
        local delayedevent de = 0
        local group pickA = null 
        local group pickB = null 
        if damageIsDOT or damageDamageType != DAMAGE_TYPE_NORMAL then 
            return 
        endif 
        set pickA = CreateGroup()
        call GroupEnumUnitsInRangeEx(pickA,GetUnitX(damageSource),GetUnitY(damageSource),900,playerHero)
        set pickB = CreateGroup()
        loop
            exitwhen FirstOfGroup(pickA) == null 
            if mybuff.getUnitBuff(FirstOfGroup(pickA),BUFFTYPE_MONK_MISTYHAZE) > 0 then 
                call GroupAddUnit(pickB,FirstOfGroup(pickA))
            endif 
            call GroupRemoveFirstUnit(pickA)
        endloop
        if FirstOfGroup(pickB) != null then 
            set de = delayedevent.create(1,1,function HERO_15_DELAYED_HEAL)
            call de.saveUnit("CASTER",damageSource)
            call de.saveUnit("TARGET",GetUnitWithLowestHealthPct(pickB))
            call de.saveInteger("FLAG",'B667')
            call de.saveReal("HEAL",I2R(ST_ABILITY_POWER.getTotalState(damageSource))*0.4)
        endif 
        call DestroyGroup(pickA)
        set pickA = null
        call DestroyGroup(pickB)
        set pickB = null
    endfunction

    function HERO_15_DELAYED_GAIN_CHI takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        call GainChi(de.loadUnit("CASTER"),de.loadReal("STACK"))
    endfunction
    function HERO_15_DELAYED_GAIN_FISTSTANCE takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        call GainFistStance(de.loadUnit("CASTER"),de.loadInteger("STACK"))
    endfunction
    function HERO_15_TALENT_SPELLING_2 takes nothing returns nothing
        local delayedevent de = 0
        if castingSpell == 'S045' then 
            set de = delayedevent.create(300,1,function HERO_15_DELAYED_GAIN_CHI)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("STACK",0.125)
        endif 
        if castingSpell == 'S046' then 
            set de = delayedevent.create(200,1,function HERO_15_DELAYED_HEAL)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveInteger("FLAG",'S046')
            call de.saveReal("HEAL",I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*0.25)
        endif 
        if castingSpell == 'S047' then 
            set de = delayedevent.create(100,1,function HERO_15_DELAYED_GAIN_FISTSTANCE)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveInteger("STACK",1)
        endif 
    endfunction

    function HERO_15_TALENT_CHECK_STATE_3 takes nothing returns nothing
        local State array ST_BONUS_TYPE
        local integer array ST_BONUS_MODE
        local integer array ST_BONUS_VALUE

        local State array ST_WEAPON_BONUS_TYPE
        local integer array ST_WEAPON_BONUS_MODE
        local integer array ST_WEAPON_BONUS_VALUE

        local Equipment eq
        local integer BONUS_HASTE = GetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_HASTE")

        local integer i = 0
        local boolean needCheck = false 

        loop
            exitwhen i > 6
            set ST_BONUS_TYPE[i] = GetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_TYPE_"+I2S(i))
            set ST_BONUS_MODE[i] = GetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_MODE_"+I2S(i))
            set ST_BONUS_VALUE[i] = GetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_VALUE_"+I2S(i))
            set i = i+1
        endloop
        
        if GetEquipedItem(checkingUnit,1) == 0 then 
            set eq = GetEquipedItem(checkingUnit,0)
                if eq > 0 then 
                    set ST_WEAPON_BONUS_TYPE[0] = eq.type.bonusWhichState1
                    set ST_WEAPON_BONUS_TYPE[1] = eq.type.bonusWhichState2
                    set ST_WEAPON_BONUS_TYPE[2] = eq.type.bonusWhichState3
                    set ST_WEAPON_BONUS_TYPE[3] = eq.type.bonusWhichState4
                    set ST_WEAPON_BONUS_TYPE[4] = eq.type.bonusWhichState5
                    set ST_WEAPON_BONUS_TYPE[5] = eq.type.bonusWhichState6
                    set ST_WEAPON_BONUS_TYPE[6] = eq.type.bonusWhichState7
                    set ST_WEAPON_BONUS_MODE[0] = eq.type.bonusWhichMode1
                    set ST_WEAPON_BONUS_MODE[1] = eq.type.bonusWhichMode2
                    set ST_WEAPON_BONUS_MODE[2] = eq.type.bonusWhichMode3
                    set ST_WEAPON_BONUS_MODE[3] = eq.type.bonusWhichMode4
                    set ST_WEAPON_BONUS_MODE[4] = eq.type.bonusWhichMode5
                    set ST_WEAPON_BONUS_MODE[5] = eq.type.bonusWhichMode6
                    set ST_WEAPON_BONUS_MODE[6] = eq.type.bonusWhichMode7
                    set ST_WEAPON_BONUS_VALUE[0] = eq.type.bonusWhichValue1*3/5
                    set ST_WEAPON_BONUS_VALUE[1] = eq.type.bonusWhichValue2*3/5
                    set ST_WEAPON_BONUS_VALUE[2] = eq.type.bonusWhichValue3*3/5
                    set ST_WEAPON_BONUS_VALUE[3] = eq.type.bonusWhichValue4*3/5
                    set ST_WEAPON_BONUS_VALUE[4] = eq.type.bonusWhichValue5*3/5
                    set ST_WEAPON_BONUS_VALUE[5] = eq.type.bonusWhichValue6*3/5
                    set ST_WEAPON_BONUS_VALUE[6] = eq.type.bonusWhichValue7*3/5
                    set i = 0
                    loop
                        exitwhen i > 6
                        if ST_BONUS_TYPE[i] != ST_WEAPON_BONUS_TYPE[i] or ST_BONUS_MODE[i] != ST_WEAPON_BONUS_MODE[i] or ST_BONUS_VALUE[i] != ST_WEAPON_BONUS_VALUE[i] then 
                            if ST_BONUS_TYPE[i] != 0 then 
                                call ST_BONUS_TYPE[i].addStateSimple(checkingUnit,ST_BONUS_MODE[i],0-ST_BONUS_VALUE[i])
                            endif 

                            set ST_BONUS_TYPE[i] = ST_WEAPON_BONUS_TYPE[i]
                            set ST_BONUS_MODE[i] = ST_WEAPON_BONUS_MODE[i]
                            set ST_BONUS_VALUE[i] = ST_WEAPON_BONUS_VALUE[i]

                            if ST_BONUS_TYPE[i] != 0 then 
                                call ST_BONUS_TYPE[i].addStateSimple(checkingUnit,ST_BONUS_MODE[i],ST_BONUS_VALUE[i])
                            endif 

                            call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_TYPE_"+I2S(i),ST_BONUS_TYPE[i])
                            call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_MODE_"+I2S(i),ST_BONUS_MODE[i])
                            call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_VALUE_"+I2S(i),ST_BONUS_VALUE[i])
                            set needCheck = true 
                        endif 
                        set i = i+1
                    endloop
                else 
                    set i = 0
                    loop
                        exitwhen i > 6
                        if ST_BONUS_TYPE[i] != 0 then 
                            call ST_BONUS_TYPE[i].addStateSimple(checkingUnit,ST_BONUS_MODE[i],0-ST_BONUS_VALUE[i])
                            set ST_BONUS_TYPE[i] = 0
                            set ST_BONUS_MODE[i] = 0
                            set ST_BONUS_VALUE[i] = 0
                            call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_TYPE_"+I2S(i),ST_BONUS_TYPE[i])
                            call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_MODE_"+I2S(i),ST_BONUS_MODE[i])
                            call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_VALUE_"+I2S(i),ST_BONUS_VALUE[i])
                            set needCheck = true 
                        endif 
                        set i = i+1
                    endloop
                endif 
                if BONUS_HASTE != 1500 then 
                    call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,1500-BONUS_HASTE)
                    set BONUS_HASTE = 1500
                    call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_HASTE",BONUS_HASTE)
                    set needCheck = true 
                endif
        else 
            set i = 0
            loop
                exitwhen i > 6
                if ST_BONUS_TYPE[i] != 0 then 
                    call ST_BONUS_TYPE[i].addStateSimple(checkingUnit,ST_BONUS_MODE[i],0-ST_BONUS_VALUE[i])
                    set ST_BONUS_TYPE[i] = 0
                    set ST_BONUS_MODE[i] = 0
                    set ST_BONUS_VALUE[i] = 0
                    call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_TYPE_"+I2S(i),ST_BONUS_TYPE[i])
                    call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_MODE_"+I2S(i),ST_BONUS_MODE[i])
                    call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_STATE_VALUE_"+I2S(i),ST_BONUS_VALUE[i])
                    set needCheck = true 
                endif 
                set i = i+1
            endloop
            if BONUS_HASTE != 0 then
                call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_HASTE)
                set BONUS_HASTE = 0
                call SetHeroData(checkingUnit,"MONK_TALENT_3_BONUS_HASTE",BONUS_HASTE)
                set needCheck = true 
            endif 
        endif 
        
        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(checkingUnit)
            set doNotCheck = false
        endif 
    endfunction
    function HERO_15_TALENT_RESET_3 takes nothing returns nothing
        local State array ST_BONUS_TYPE
        local integer array ST_BONUS_MODE
        local integer array ST_BONUS_VALUE

        local State array ST_WEAPON_BONUS_TYPE
        local integer array ST_WEAPON_BONUS_MODE
        local integer array ST_WEAPON_BONUS_VALUE

        local integer BONUS_HASTE = GetHeroData(currentTTOwner,"MONK_TALENT_3_BONUS_HASTE")

        local integer i = 0
        local boolean needCheck = false 

        loop
            exitwhen i > 6
            set ST_BONUS_TYPE[i] = GetHeroData(currentTTOwner,"MONK_TALENT_3_BONUS_STATE_TYPE_"+I2S(i))
            set ST_BONUS_MODE[i] = GetHeroData(currentTTOwner,"MONK_TALENT_3_BONUS_STATE_MODE_"+I2S(i))
            set ST_BONUS_VALUE[i] = GetHeroData(currentTTOwner,"MONK_TALENT_3_BONUS_STATE_VALUE_"+I2S(i))
            set i = i+1
        endloop

        set i = 0
        loop
            exitwhen i > 6
            if ST_BONUS_TYPE[i] != 0 then 
                call ST_BONUS_TYPE[i].addStateSimple(currentTTOwner,ST_BONUS_MODE[i],0-ST_BONUS_VALUE[i])
                set ST_BONUS_TYPE[i] = 0
                set ST_BONUS_MODE[i] = 0
                set ST_BONUS_VALUE[i] = 0
                call SetHeroData(currentTTOwner,"MONK_TALENT_3_BONUS_STATE_TYPE_"+I2S(i),ST_BONUS_TYPE[i])
                call SetHeroData(currentTTOwner,"MONK_TALENT_3_BONUS_STATE_MODE_"+I2S(i),ST_BONUS_MODE[i])
                call SetHeroData(currentTTOwner,"MONK_TALENT_3_BONUS_STATE_VALUE_"+I2S(i),ST_BONUS_VALUE[i])
                set needCheck = true 
            endif 
            set i = i+1
        endloop
        if BONUS_HASTE != 0 then
            call ST_HASTE.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_HASTE)
            set BONUS_HASTE = 0
            call SetHeroData(currentTTOwner,"MONK_TALENT_3_BONUS_HASTE",BONUS_HASTE)
            set needCheck = true 
        endif 
        
        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(currentTTOwner)
            set doNotCheck = false
        endif 
    endfunction

    function HERO_15_TALENT_SPELLING_4 takes nothing returns nothing
        local projectile proj = 0
        if castingSpell == 'S048' or castingSpell == 'S049' or castingSpell == 'S04A' then 
            set proj = CreateProjectileToUnit(spellCaster,spellCaster,1000,0,"war3campImported\\mysticsnake_fx_v1.mdx",function S04D_HIT,null)
            set proj.flag = 'S04D'
            set proj.tag_Earth = true 
            set proj.realData = 0.6
            set proj.maxBounceLimit = proj.maxBounceLimit+6
            set proj.bounceMultiplier = RMinBJ(proj.bounceMultiplier,0.75)
            set proj.bounceRange = RMaxBJ(600,proj.bounceRange)
            call proj.launch()
        endif 
    endfunction

    globals
        integer HERO_15_TALENT_5_COUNT = 0
        integer HERO_15_TALENT_5_STORED = 0
        delayedevent HERO_15_TALENT_5_DE = 0
    endglobals
    function HERO_15_TALENT_5_DELAYED_CHECK takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        
        local unit owner = de.loadUnit("OWNER")

        local integer BONUS_HASTE = GetHeroData(owner,"MONK_TALENT_5_BONUS_HASTE")
        local integer BONUS_CRIT = GetHeroData(owner,"MONK_TALENT_5_BONUS_CRIT")
        local integer BONUS_CRIT_POWER = GetHeroData(owner,"MONK_TALENT_5_BONUS_CRIT_POWER")
        local integer BONUS_EVADE = GetHeroData(owner,"MONK_TALENT_5_BONUS_EVADE")
        local integer BONUS_MAX_EVADE = GetHeroData(owner,"MONK_TALENT_5_BONUS_MAX_EVADE")
        local integer BONUS_VERSATILITY = GetHeroData(owner,"MONK_TALENT_5_BONUS_VERSATILITY")

        local integer OTHER_HASTE = ST_HASTE.getTotalState(owner)-BONUS_HASTE
        local integer OTHER_CRIT = ST_CRIT_CHANCE.getTotalState(owner)-BONUS_CRIT
        local integer OTHER_CRIT_POWER = ST_CRIT_POWER.getTotalState(owner)-BONUS_CRIT_POWER

        local boolean needCheck = false 

        if BONUS_HASTE != 0-OTHER_HASTE then 
            call ST_HASTE.addStateSimple(owner,STATE_MODE_PERCENTAGE,0-BONUS_HASTE)
            set BONUS_HASTE = 0-OTHER_HASTE
            call ST_HASTE.addStateSimple(owner,STATE_MODE_PERCENTAGE,BONUS_HASTE)
            call SetHeroData(owner,"MONK_TALENT_5_BONUS_HASTE",BONUS_HASTE)
            set needCheck = true 
        endif 
        if BONUS_CRIT != 0-OTHER_CRIT then 
            call ST_CRIT_CHANCE.addStateSimple(owner,STATE_MODE_PERCENTAGE,0-BONUS_CRIT)
            set BONUS_CRIT = 0-OTHER_CRIT
            call ST_CRIT_CHANCE.addStateSimple(owner,STATE_MODE_PERCENTAGE,BONUS_CRIT)
            call SetHeroData(owner,"MONK_TALENT_5_BONUS_CRIT",BONUS_CRIT)
            set needCheck = true 
        endif 
        if BONUS_CRIT_POWER != 0-OTHER_CRIT_POWER then 
            call ST_CRIT_POWER.addStateSimple(owner,STATE_MODE_PERCENTAGE,0-BONUS_CRIT_POWER)
            set BONUS_CRIT_POWER = 0-OTHER_CRIT_POWER
            call ST_CRIT_POWER.addStateSimple(owner,STATE_MODE_PERCENTAGE,BONUS_CRIT_POWER)
            call SetHeroData(owner,"MONK_TALENT_5_BONUS_CRIT_POWER",BONUS_CRIT_POWER)
            set needCheck = true 
        endif 
        
        if BONUS_EVADE != OTHER_HASTE/2 then
            call ST_EVADE.addStateSimple(owner,STATE_MODE_PERCENTAGE,0-BONUS_EVADE)
            set BONUS_EVADE = OTHER_HASTE/2
            call ST_EVADE.addStateSimple(owner,STATE_MODE_PERCENTAGE,BONUS_EVADE)
            call SetHeroData(owner,"MONK_TALENT_5_BONUS_EVADE",BONUS_EVADE)
            set needCheck = true 
        endif 
        if BONUS_MAX_EVADE != OTHER_CRIT_POWER/25 then
            call ST_MAX_EVADE.addStateSimple(owner,STATE_MODE_PERCENTAGE,0-BONUS_MAX_EVADE)
            set BONUS_MAX_EVADE = OTHER_CRIT_POWER/25
            call ST_MAX_EVADE.addStateSimple(owner,STATE_MODE_PERCENTAGE,BONUS_MAX_EVADE)
            call SetHeroData(owner,"MONK_TALENT_5_BONUS_MAX_EVADE",BONUS_MAX_EVADE)
            set needCheck = true 
        endif 
        if BONUS_VERSATILITY != OTHER_CRIT/2 then
            call ST_VERSATILITY.addStateSimple(owner,STATE_MODE_PERCENTAGE,0-BONUS_VERSATILITY)
            set BONUS_VERSATILITY = OTHER_CRIT/2
            call ST_VERSATILITY.addStateSimple(owner,STATE_MODE_PERCENTAGE,BONUS_VERSATILITY)
            call SetHeroData(owner,"MONK_TALENT_5_BONUS_VERSATILITY",BONUS_VERSATILITY)
            set needCheck = true 
        endif 

        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(checkingUnit)
            set doNotCheck = false
        endif 
        set owner = null 
    endfunction
    function HERO_15_TALENT_CHECK_STATE_5 takes nothing returns nothing
        local integer BONUS_HASTE = GetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_HASTE")
        local integer BONUS_CRIT = GetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_CRIT")
        local integer BONUS_CRIT_POWER = GetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_CRIT_POWER")
        local integer BONUS_EVADE = GetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_EVADE")
        local integer BONUS_MAX_EVADE = GetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_MAX_EVADE")
        local integer BONUS_VERSATILITY = GetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_VERSATILITY")

        local integer OTHER_HASTE = ST_HASTE.getTotalState(checkingUnit)-BONUS_HASTE
        local integer OTHER_CRIT = ST_CRIT_CHANCE.getTotalState(checkingUnit)-BONUS_CRIT
        local integer OTHER_CRIT_POWER = ST_CRIT_POWER.getTotalState(checkingUnit)-BONUS_CRIT_POWER

        local delayedevent de = 0

        local boolean needCheck = false 

        if mybuff.getUnitBuff(checkingUnit,BUFFTYPE_MONK_CHI) == 0 or mybuff.getUnitBuff(checkingUnit,BUFFTYPE_MONK_CHI).DESTROY then 
            if BONUS_HASTE != 0 then 
                call ST_HASTE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_HASTE)
                set BONUS_HASTE = 0
                call SetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_HASTE",BONUS_HASTE)
                set needCheck = true 
            endif 
            if BONUS_CRIT != 0 then 
                call ST_CRIT_CHANCE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_CRIT)
                set BONUS_CRIT = 0
                call SetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_CRIT",BONUS_CRIT)
                set needCheck = true 
            endif 
            if BONUS_CRIT_POWER != 0 then 
                call ST_CRIT_POWER.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_CRIT_POWER)
                set BONUS_CRIT_POWER = 0
                call SetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_CRIT_POWER",BONUS_CRIT_POWER)
                set needCheck = true 
            endif 
            if BONUS_EVADE != 0 then 
                call ST_EVADE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_EVADE)
                set BONUS_EVADE = 0
                call SetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_EVADE",BONUS_EVADE)
                set needCheck = true 
            endif 
            if BONUS_MAX_EVADE != 0 then 
                call ST_MAX_EVADE.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_MAX_EVADE)
                set BONUS_MAX_EVADE = 0
                call SetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_MAX_EVADE",BONUS_MAX_EVADE)
                set needCheck = true 
            endif 
            if BONUS_VERSATILITY != 0 then 
                call ST_VERSATILITY.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_VERSATILITY)
                set BONUS_VERSATILITY = 0
                call SetHeroData(checkingUnit,"MONK_TALENT_5_BONUS_VERSATILITY",BONUS_VERSATILITY)
                set needCheck = true 
            endif 
        else 
            set de = delayedevent.create(1,1,function HERO_15_TALENT_5_DELAYED_CHECK)
            call de.saveUnit("OWNER",checkingUnit)
        endif 
        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(checkingUnit)
            set doNotCheck = false
        endif 
    endfunction
    function HERO_15_TALENT_PERIOD_CHECK takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(hero[14],BUFFTYPE_MONK_FISTSTANCE)
        if inCombat(hero[14]) and bf != 0 and mybuff.getUnitBuff(hero[14],BUFFTYPE_MONK_CHI) != 0 then 
            if HERO_15_TALENT_5_STORED <= bf.intData then 
                set HERO_15_TALENT_5_STORED = bf.intData
                set HERO_15_TALENT_5_COUNT = HERO_15_TALENT_5_COUNT+10
                if HERO_15_TALENT_5_COUNT >= 500 then 
                    set HERO_15_TALENT_5_COUNT = 0
                    call FistStanceDecrease(bf)
                endif 
            else 
                set HERO_15_TALENT_5_STORED = bf.intData
                set HERO_15_TALENT_5_COUNT = 0
            endif 
        endif 
    endfunction
    function HERO_15_TALENT_LEARN_5 takes nothing returns nothing
        if HERO_15_TALENT_5_DE == 0 then 
            set HERO_15_TALENT_5_DE = delayedevent.create(10,0,function HERO_15_TALENT_PERIOD_CHECK)
        endif 
    endfunction
    function HERO_15_TALENT_RESET_5 takes nothing returns nothing
        local integer BONUS_HASTE = GetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_HASTE")
        local integer BONUS_CRIT = GetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_CRIT")
        local integer BONUS_CRIT_POWER = GetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_CRIT_POWER")
        local integer BONUS_EVADE = GetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_EVADE")
        local integer BONUS_MAX_EVADE = GetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_MAX_EVADE")
        local integer BONUS_VERSATILITY = GetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_VERSATILITY")

        local integer OTHER_HASTE = ST_HASTE.getTotalState(currentTTOwner)-BONUS_HASTE
        local integer OTHER_CRIT = ST_CRIT_CHANCE.getTotalState(currentTTOwner)-BONUS_CRIT
        local integer OTHER_CRIT_POWER = ST_CRIT_POWER.getTotalState(currentTTOwner)-BONUS_CRIT_POWER

        local delayedevent de = 0

        local boolean needCheck = false 

        if BONUS_HASTE != 0 then 
            call ST_HASTE.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_HASTE)
            set BONUS_HASTE = 0
            call SetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_HASTE",BONUS_HASTE)
            set needCheck = true 
        endif 
        if BONUS_CRIT != 0 then 
            call ST_CRIT_CHANCE.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_CRIT)
            set BONUS_CRIT = 0
            call SetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_CRIT",BONUS_CRIT)
            set needCheck = true 
        endif 
        if BONUS_CRIT_POWER != 0 then 
            call ST_CRIT_POWER.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_CRIT_POWER)
            set BONUS_CRIT_POWER = 0
            call SetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_CRIT_POWER",BONUS_CRIT_POWER)
            set needCheck = true 
        endif 
        if BONUS_EVADE != 0 then 
            call ST_EVADE.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_EVADE)
            set BONUS_EVADE = 0
            call SetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_EVADE",BONUS_EVADE)
            set needCheck = true 
        endif 
        if BONUS_MAX_EVADE != 0 then 
            call ST_MAX_EVADE.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_MAX_EVADE)
            set BONUS_MAX_EVADE = 0
            call SetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_MAX_EVADE",BONUS_MAX_EVADE)
            set needCheck = true 
        endif 
        if BONUS_VERSATILITY != 0 then 
            call ST_VERSATILITY.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_VERSATILITY)
            set BONUS_VERSATILITY = 0
            call SetHeroData(currentTTOwner,"MONK_TALENT_5_BONUS_VERSATILITY",BONUS_VERSATILITY)
            set needCheck = true 
        endif 
        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(currentTTOwner)
            set doNotCheck = false
        endif 
        if HERO_15_TALENT_5_DE != 0 then 
            set HERO_15_TALENT_5_DE.DESTROY = true 
            set HERO_15_TALENT_5_COUNT = 0
        endif 
    endfunction

    function HERO_15_TALENT_AFTERHEAL_TARGET_6 takes nothing returns nothing
        local mybuff bf = 0
        if mybuff.getUnitBuff(healTarget,BUFFTYPE_MONK_VAJRAZEN) != 0 then 
            set bf = mybuff.getUnitBuff(healTarget,BUFFTYPE_MONK_DEFLECT)
            if bf != 0 then 
                set bf.realData = RMaxBJ(0,bf.realData-0.5*healOverdoze)
                if bf.realData <= 0.5 then 
                    set bf.DESTROY = true 
                endif 
            endif 
        endif 
    endfunction
    function HERO_15_TALENT_DAMAGING_TARGET_6 takes nothing returns nothing
        if mybuff.getUnitBuff(damageTarget,BUFFTYPE_MONK_VAJRAZEN) != 0 then 
            set damageFinalDamage = damageFinalDamage*0.8
        endif 
    endfunction
    function HERO_15_TALENT_ATTACKING_6 takes nothing returns nothing
        if mybuff.getUnitBuff(damageSource,BUFFTYPE_MONK_FIRMSTANCE) != 0 and GetUnitAbilityLevel(damageSource,'S04J') > 0 then 
            call GainFistStance(damageSource,1)
        endif 
    endfunction
    function HERO_15_TALENT_SPELLING_6 takes nothing returns nothing
        local mybuff bf = 0
        if castingSpell == 'S04K' then
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_MONK_FIRMSTANCE,200)
            call bf.apply()
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\LightningShieldTarget_BirthOnly.mdx",spellCaster,"origin"))
        endif 
    endfunction

    function HERO_15_TALENT_CHECK_STATE_8 takes nothing returns nothing
        local integer BONUS_MOVE_SPEED = GetHeroData(checkingUnit,"MONK_TALENT_8_BONUS_MOVE_SPEED")
        local integer OTHER_MOVE_SPEED = ST_MOVE_SPEED.getP(checkingUnit)-BONUS_MOVE_SPEED
        local boolean needCheck = false 
        if OTHER_MOVE_SPEED >= 0 then 
            if ST_MOVE_SPEED != 0 then 
                call ST_MOVE_SPEED.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_MOVE_SPEED)
                set BONUS_MOVE_SPEED = 0
                call SetHeroData(checkingUnit,"MONK_TALENT_8_BONUS_MOVE_SPEED",BONUS_MOVE_SPEED)
                set needCheck = true 
            endif 
        else 
            if BONUS_MOVE_SPEED != 0-OTHER_MOVE_SPEED then 
                call ST_MOVE_SPEED.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,0-BONUS_MOVE_SPEED)
                set BONUS_MOVE_SPEED = 0-OTHER_MOVE_SPEED
                call ST_MOVE_SPEED.addStateSimple(checkingUnit,STATE_MODE_PERCENTAGE,BONUS_MOVE_SPEED)
                call SetHeroData(checkingUnit,"MONK_TALENT_8_BONUS_MOVE_SPEED",BONUS_MOVE_SPEED)
                set needCheck = true 
            endif 
        endif 
        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(checkingUnit)
            set doNotCheck = false
        endif 
    endfunction
    function UNBOUND_AURA_STATE_SET takes nothing returns nothing
        set aura.modifingAuraBuff.bonusMoveSpeed = 15
    endfunction
    function HERO_15_TALENT_LEARN_8 takes nothing returns nothing
        local aura ar = aura.create(currentTTOwner,"AURA_MONK_UNBOUND",900,0,BUFFTYPE_MONK_UNBOUND,"Abilities\\Spells\\Other\\Tornado\\Tornado_Target.mdl")
        call ar.addAllySet(function UNBOUND_AURA_STATE_SET)
        call unitAddState(currentTTOwner,STATE_IMMUNE_COLD,1)
        call unitAddState(currentTTOwner,STATE_IMMUNE_SILENCE,1)
        call unitAddState(currentTTOwner,STATE_IMMUNE_SNARE,1)
        call unitAddState(currentTTOwner,STATE_IMMUNE_STUN,1)
        call unitAddState(currentTTOwner,STATE_IMMUNE_ROOT,1)
    endfunction
    function HERO_15_TALENT_RESET_8 takes nothing returns nothing
        local integer BONUS_MOVE_SPEED = GetHeroData(currentTTOwner,"MONK_TALENT_8_BONUS_MOVE_SPEED")
        local integer OTHER_MOVE_SPEED = ST_MOVE_SPEED.getP(currentTTOwner)-BONUS_MOVE_SPEED
        local boolean needCheck = false 
        if ST_MOVE_SPEED != 0 then 
            call ST_MOVE_SPEED.addStateSimple(currentTTOwner,STATE_MODE_PERCENTAGE,0-BONUS_MOVE_SPEED)
            set BONUS_MOVE_SPEED = 0
            call SetHeroData(currentTTOwner,"MONK_TALENT_8_BONUS_MOVE_SPEED",BONUS_MOVE_SPEED)
            set needCheck = true 
        endif 
        if needCheck then 
            set doNotCheck = true 
            call State.checkAll(currentTTOwner)
