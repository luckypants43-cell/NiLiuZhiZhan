            call de.saveInteger("MINI",mini)
            set newgroup = null 
            set caster = null 
        endfunction
        function CHECK_STATE_nS06 takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 40*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)/2
            local integer miniBonusAbilityPower = 15+unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER)/4
            call BlzSetUnitBaseDamage(checkingUnit,3*GetUnitLevel(owner.masterUnit)/5+4+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER))*0.3),0)
            call BlzSetUnitArmor(checkingUnit,8+5*GetUnitLevel(owner.masterUnit)/3)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
            call unitAddState(checkingUnit,STATE_ABILITY_POWER,miniBonusAbilityPower-GetHeroData(checkingUnit,"BONUSED_ABILITY_POWER"))
            call SetHeroData(checkingUnit,"BONUSED_ABILITY_POWER",miniBonusAbilityPower)
        endfunction
