    function SPELL_AUSI takes nothing returns nothing   //驱邪术卷轴
        local group pick = CreateGroup()
        call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,350,playerAlly)
        loop
            exitwhen FirstOfGroup(pick) == null
            call bufflist.flush()
            call bufflist.listUnitBuffs(FirstOfGroup(pick),false,true,true)
            if bufflist.dispelMultiBuffs(3) then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",FirstOfGroup(pick),"origin"))
            endif 
            call GroupRemoveFirstUnit(pick)
        endloop
        call GroupClear(pick)
        call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,350,playerEnemy)
        loop
            exitwhen FirstOfGroup(pick) == null
            call bufflist.flush()
            call bufflist.listUnitBuffs(FirstOfGroup(pick),true,false,true)
            if bufflist.dispelMultiBuffs(3) then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",FirstOfGroup(pick),"origin"))
            endif 
            call GroupRemoveFirstUnit(pick)
        endloop
        call DestroyGroup(pick)
        set pick = null 
        call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Other\\Andt\\Andt.mdl",spellTargetX,spellTargetY))
    endfunction
    function SPELL_AUSJ takes nothing returns nothing   //沉默术卷轴
        local group pick = CreateGroup()
        call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,350,playerEnemy)
        loop
            exitwhen FirstOfGroup(pick) == null
            call applySilence(spellCaster,FirstOfGroup(pick),'ASI2')
            call GroupRemoveFirstUnit(pick)
        endloop
        call DestroyGroup(pick)
        set pick = null 
        call delayedDestroyEffect(AddSpecialEffectEX("Abilities\\Spells\\Other\\Silence\\SilenceAreaBirth.mdl",spellTargetX,spellTargetY),100)
    endfunction
    function ITEM_IPB2_USE takes nothing returns nothing    //治疗祷言卷轴
        local real heal = I2R(ST_ABILITY_POWER.getTotalState(itemTriggerUnit))*2
        local group pick = CreateGroup()
        call GroupEnumUnitsInRangeEx(pick,GetUnitX(itemTriggerUnit),GetUnitY(itemTriggerUnit),500,playerAlly)
        loop
            exitwhen FirstOfGroup(pick) == null
            set healFlag = 'IPB2'
            set healIsAOE = true 
            set healAddCrit = -10000
            call UnitHealTarget(itemTriggerUnit,FirstOfGroup(pick),heal)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",FirstOfGroup(pick),"origin"))
            call GroupRemoveFirstUnit(pick)
        endloop
        call DestroyGroup(pick)
        set pick = null 
        call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Undead\\ReplenishHealth\\ReplenishHealthCasterOverhead.mdl",GetUnitX(itemTriggerUnit),GetUnitY(itemTriggerUnit)))
    endfunction 


    
        function SPELL_AGMS takes nothing returns nothing   //GM
            local real dmg = 0
            local group newgroup = CreateGroup()
            call GroupEnumUnitsInRangeEx(newgroup,spellTargetX,spellTargetY,500,playerEnemy)
            loop 
                exitwhen FirstOfGroup(newgroup) == null 
                set dmg = GetUnitState(FirstOfGroup(newgroup),UNIT_STATE_MAX_LIFE)
                set damageIsAOE = true
                set damageFlag = 'AGMS'
                call UnitDamageTarget(spellCaster,FirstOfGroup(newgroup),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applyStun(spellCaster,FirstOfGroup(newgroup),'ATB0')
                call GroupRemoveUnit(newgroup,FirstOfGroup(newgroup))
            endloop
            call DestroyGroup(newgroup)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Firaga.mdx",spellTargetX,spellTargetY))
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Flame Burst.mdx",spellTargetX,spellTargetY))
            set newgroup = null 
        endfunction
        function SPELL_AGMB takes nothing returns nothing   //GM
            call SetUnitX(spellCaster,spellTargetX)
            call SetUnitY(spellCaster,spellTargetY)
        endfunction
endlibrary

