    //天赋注册end
    function initUnitDatas takes nothing returns nothing
        local integer i = 0
        local integer k = 0

        call SetUnitTypeIcon('HZ00',"ReplaceableTextures\\CommandButtons\\BTNTheCaptain.blp")
        call SetHeroIndex('HZ00',1)
        call SetUnitTypeIcon('HZ01',"ReplaceableTextures\\CommandButtons\\BTNHeroPaladin.blp")
        call SetHeroIndex('HZ01',2)
        call SetUnitTypeIcon('HZ02',"ReplaceableTextures\\CommandButtons\\BTNArthas.blp")
        call SetHeroIndex('HZ02',3)
        call SetUnitTypeIcon('HZ03',"ReplaceableTextures\\CommandButtons\\BTNRifleman.blp")
        call SetHeroIndex('HZ03',4)
        call SetUnitTypeIcon('HZ04',"ReplaceableTextures\\CommandButtons\\BTNSylvanusWindrunner.blp")
        call SetHeroIndex('HZ04',5)
        call SetUnitTypeIcon('HZ05',"ReplaceableTextures\\CommandButtons\\BTNHeroWarden.blp")
        call SetHeroIndex('HZ05',6)
        call SetUnitTypeIcon('HZ06',"ReplaceableTextures\\CommandButtons\\BTNJaina.blp")
        call SetHeroIndex('HZ06',7)
        call SetUnitTypeIcon('HZ07',"ReplaceableTextures\\CommandButtons\\BTNPriest.blp")
        call SetHeroIndex('HZ07',8)
        call SetUnitTypeIcon('HZ08',"ReplaceableTextures\\CommandButtons\\BTNDruidOfTheClaw.blp")
        call SetHeroIndex('HZ08',9)
        call SetUnitTypeIcon('HZ09',"ReplaceableTextures\\CommandButtons\\BTNWatcherDeathKnight.blp")
        call SetHeroIndex('HZ09',10)
        call SetUnitTypeIcon('HZ0A',"ReplaceableTextures\\CommandButtons\\BTNSpellBreaker.blp")
        call SetHeroIndex('HZ0A',11)
        call SetUnitTypeIcon('HZ0B',"ReplaceableTextures\\CommandButtons\\BTNHeroDwarfShaman.blp")
        call SetHeroIndex('HZ0B',12)
        call SetUnitTypeIcon('HZ0C',"ReplaceableTextures\\CommandButtons\\BTNKelThuzad.blp")
        call SetHeroIndex('HZ0C',13)
        call SetUnitTypeIcon('HZ0D',"ReplaceableTextures\\CommandButtons\\BTNHeroDemonHunter.blp")
        call SetHeroIndex('HZ0D',14)
        call SetUnitTypeIcon('HZ0E',"ReplaceableTextures\\CommandButtons\\BTNPandarenBrewmaster.blpp")
        call SetHeroIndex('HZ0E',15)
        call SetUnitTypeIcon('HZ0F',"ReplaceableTextures\\CommandButtons\\BTNSorceress.blp")
        call SetHeroIndex('HZ0F',16)

        set i = 1
        loop 
            exitwhen i > MAX_HERO_TYPE
            set k = 0
            loop 
                exitwhen k > 29
                call SetTalentArt(i,k,true,"")
                call SetTalentArt(i,k,false,"")
                call SetTalentName(i,k,"")
                call SetTalentDescription(i,k,"")
                set k = k+1
            endloop
            set i = i+1
        endloop
        call initTalentDatas.execute()
    endfunction

