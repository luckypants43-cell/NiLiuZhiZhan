        local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_MAGE_ICESHIELD)
        if castingSpell == 'S002' and bf > 0 then 
            set bf.realData = RMinBJ(0.2,bf.realData+0.02)
        endif 
    endfunction
    function HERO_7_TALENT_RESET_4 takes nothing returns nothing
        local mybuff bf = mybuff.getUnitBuff(currentTTOwner,BUFFTYPE_MAGE_ICESHIELD)
        if bf > 0 then 
            set bf.realData = 0
        endif 
    endfunction
    function HERO_7_TALENT_SPELLING_5 takes nothing returns nothing
        local mybuff bf
        if castingSpell == 'S002' then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_MAGE_FLIPPERICE)
            set bf.lastTime = 1000
            set bf.intData = IMinBJ(5,bf.intData+1)
            set bf.bonusHaste = 500*bf.intData
            call bf.apply()
        endif 
    endfunction
    function HERO_7_TALENT_ICE_BLAST takes nothing returns nothing
        local delayedevent de = delayedevent.currentEvent
        local unit ds = de.loadUnit("CASTER")
        local unit dt = de.loadUnit("TARGET")
        local real dmg = I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1.5
        local group pick = CreateGroup()
        call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),150,playerEnemy)
        call GroupRemoveUnit(pick,dt)
        loop 
            exitwhen FirstOfGroup(pick) == null 
            set damageTag_Cold = true 
            set damageIsAOE = true 
            set damageFlag = 'AUfn'
            call UnitDamageTarget(ds,FirstOfGroup(pick),dmg*0.5,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call DestroyGroup(pick)
        set damageTag_Cold = true 
        set damageFlag = 'AUfn'
        call UnitDamageTarget(ds,dt,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        set pick = null 
        set ds = null 
        set dt = null 
    endfunction
    function HERO_7_TALENT_AFTERDAMAGE_SOURCE_6 takes nothing returns nothing
        local delayedevent de 
        if damageFlag == 'S002' and random.get(damageSource,0.3*damageAddBonusDamage,'HTL6') then 
            set de = delayedevent.create(5,1,function HERO_7_TALENT_ICE_BLAST)
            call de.saveUnit("CASTER",damageSource)
            call de.saveUnit("TARGET",damageTarget)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",damageTarget,"origin"))
        endif 
    endfunction
    function HERO_7_TALENT_DAMAGED_SOURCE_7 takes nothing returns nothing
        if damageAttackType == ATTACK_TYPE_NORMAL and damageIfCrit then 
            set damageFinalDamage = damageFinalDamage*1.15
        endif 
    endfunction
    function HERO_7_TALENT_AFTERDAMAGE_SOURCE_7 takes nothing returns nothing
        local mybuff bf 
        if damageAttackType == ATTACK_TYPE_NORMAL then 
            if damageIfCrit then 
                set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_MAGE_OVERFLOW)
                if bf > 0 then 
                    set bf.DESTROY = true 
                endif  
            else 
                set bf = mybuff.create(damageSource,damageSource,BUFFTYPE_MAGE_OVERFLOW)
                set bf.lastTime = 800 
                set bf.intData = IMinBJ(5,bf.intData+1)
                set bf.bonusCrit = 300*bf.intData
                call bf.apply()
            endif 
        endif 
    endfunction
    function HERO_7_TALENT_SPELLING_8 takes nothing returns nothing
        local group pick 
        local mybuff bf 
        local real dmg = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*2.5
        local real x = GetUnitX(spellCaster)
        local real y = GetUnitY(spellCaster)
        if castingSpell == 'S00D' then 
            set pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,x,y,450,playerHero)
            call GroupRemoveUnit(pick,spellCaster)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(spellCaster,FirstOfGroup(pick),BUFFTYPE_MAGE_ICESHIELD)
                set bf.lastTime = 3000
                set bf.shieldBlockPercent = 1
                set bf.shieldDestroy = true 
                set bf.shieldMaxValue = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*1.75
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\icenova.mdx",x,y))
            call GroupEnumUnitsInRangeEx(pick,x,y,700,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if inCombat(FirstOfGroup(pick)) or DisByUnXY(FirstOfGroup(pick),x,y) < 450+BlzGetUnitCollisionSize(spellCaster)+BlzGetUnitCollisionSize(FirstOfGroup(pick)) then
                    set damageTag_Cold = true 
                    set damageIsAOE = true 
                    set damageFlag = 'S007'
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                    call applyCold(spellCaster,FirstOfGroup(pick),'ACO0')
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endif 
    endfunction
    function HERO_7_TALENT_SPELLING_9 takes nothing returns nothing
        local mybuff bf 
        local projectile proj 
        if castingSpell == 'S002' then 
            set bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_MAGE_ENDLESSFROST)
            set bf.lastTime = 6000
            set bf.intData = bf.intData+1
            call bf.apply() 
            if bf.intData >= 15 then 
                set bf.DESTROY = true 
                set proj = projectile.create(spellCaster)
                set proj.LAUNCH_UNIT = true 
                set proj.TARGET_LOC = true 
                set proj.target_x = GetUnitX(spellTarget)
                set proj.target_y = GetUnitY(spellTarget)
                set proj.speed = 600
                set proj.model_path = "war3campImported\\hanbingbaozhu.mdl"
                set proj.model_attach = "origin" 
                set proj.IS_WAVE = true 
                set proj.Wave_Radius_Add = 0
                set proj.Wave_Radius_Start = 175 
                call proj.addOnHit(function FROZEN_ORB_HIT)  
                call proj.addOnEnd(function FROZEN_ORB_DEATH)  
                set proj.ifDestroy = false 
                set proj.destroyAttach = false 
                call proj.launch()
            endif 
        endif 
    endfunction
