        set BUFFTYPE_ITEM_DASH = bufftype.create('A66U','B66U',true,false,true)                    //疾跑
        set BUFFTYPE_ITEM_IRONSKIN = bufftype.create('A66V','B66V',true,false,true)                    //钢铁之肤
