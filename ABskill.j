    function SPELL_AUS7 takes nothing returns nothing
        local unit tempUU = CreateUnit(PLAYER,'nSZ0',spellTargetX,spellTargetY,GetUnitFacing(spellCaster))
        local delayedevent de = delayedevent.create(200,15,function CAMP_FIRE_REGEN)
        call UnitApplyTimedLife(tempUU,'BTLF',30)
        call de.saveUnit("CASTER",tempUU)
        set tempUU = null 
    endfunction 
