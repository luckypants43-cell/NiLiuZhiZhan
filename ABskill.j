            loop 
                exitwhen FirstOfGroup(pick) == null 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Orc\\Devour\\DevourEffectArt.mdl",FirstOfGroup(pick),"origin"))
                call proj.applyDamageSet()
                set damageIsAOE = true 
