        function SPELL_S02Y takes nothing returns nothing   //虔诚之盾
            local group pick 
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_PALADIN_DIVINESHIELD)
            set bf.bonusBlock = R2I(I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*1.5)
            set bf.bonusArmor_P = 2500
            set bf.bonusResistance = 2500
            set bf.lastTime = 3000
            set bf.bonusMaxBlock = 2000
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                set bf.bonusImmune_Stun = 1
                set bf.bonusImmune_Cold = 1
                set bf.bonusImmune_Root = 1
                set bf.bonusImmune_Silence = 1
                set bf.bonusImmune_Snare = 1
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),400,playerEnemy)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    call Taunt(spellCaster,FirstOfGroup(pick))
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
                call DestroyGroup(pick)
                set pick = null 
            endif 
            call bf.apply()
            call bufflist.listUnitBuffs(spellCaster,false,true,true)
            call bufflist.dispelAllBuffs()
            call removeAllDisabilities(spellCaster)
        endfunction
        function A63T_DELAYED_HEAL takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            set healFlag = 'A63T'
            set healIsAOE = true 
            call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("HEAL"))
        endfunction
        function HERO_2_AFTERHEAL_SOURCE takes nothing returns nothing
            local delayedevent de 
            local mybuff beacon = mybuff.getUnitBuff(paladinDivineBeaconTarget,BUFFTYPE_PALADIN_DIVINEBEACON)
            local group pick = null 
            if beacon == 0 and paladinDivineBeaconTarget != null then 
                set paladinDivineBeaconTarget = null
            endif 
            if beacon > 0 and healIsAOE == false and healTarget != paladinDivineBeaconTarget then 
                set de = delayedevent.create(1,1,function A63T_DELAYED_HEAL)
                call de.saveReal("HEAL",healHeal)
                call de.saveUnit("CASTER",healSource)
                call de.saveUnit("TARGET",paladinDivineBeaconTarget)
            endif 
            if beacon > 0 and healIsAOE == false and healTarget == paladinDivineBeaconTarget then 
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(paladinDivineBeaconTarget),GetUnitY(paladinDivineBeaconTarget),900,playerAlly)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    if FirstOfGroup(pick) != paladinDivineBeaconTarget then 
                        set de = delayedevent.create(1,1,function A63T_DELAYED_HEAL)
                        call de.saveReal("HEAL",healHeal*0.25)
                        call de.saveUnit("CASTER",healSource)
                        call de.saveUnit("TARGET",FirstOfGroup(pick))
                    endif 
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
                call DestroyGroup(pick)
                set pick = null 
            endif 
        endfunction
        function A63T_DMGING_T takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,1) and bf.buffSource != damageTarget then 
                if (GetUnitState(damageTarget,UNIT_STATE_LIFE)-damageDamage)/GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE) < 0.35 then 
                    set damageFinalDamage = damageFinalDamage*0.85
                endif 
            endif 
            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,4) and bf.buffSource != damageTarget then 
                set damageFinalDamage = damageFinalDamage*(1-RMinBJ(0.15,0.5*(I2R(unitGetAllBonusStateValue(hero[1],STATE_CRIT))/10000)))
            endif 
        endfunction
        function A63T_DMGED_T takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,6) then 
                if damageFinalDamage > GetUnitState(damageTarget,UNIT_STATE_LIFE) then 
                    call BlzEndUnitAbilityCooldown(bf.buffSource,'S02Z')
                    call BlzStartUnitAbilityCooldown(bf.buffSource,'S02Z',30)
                    set damageFinalDamage = 0
                    set bf.DESTROY = true 
                    call SetUnitState(damageTarget,UNIT_STATE_LIFE,0.1*GetUnitState(damageTarget,UNIT_STATE_MAX_LIFE))
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",damageTarget,"origin"))
                endif 
            endif 
        endfunction
        function SPELL_S02Z takes nothing returns nothing   //神圣道标
            local mybuff bf
            call removeDivineBeaconSfx()
            if mybuff.getUnitBuff(spellTarget,BUFFTYPE_PALADIN_VIRTUEBEACON) > 0 then 
                set mybuff.getUnitBuff(spellTarget,BUFFTYPE_PALADIN_VIRTUEBEACON).DESTROY = true 
            endif 
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PALADIN_DIVINEBEACON)
            set bf.lastTime = 60000
            call bf.addDmging_T(function A63T_DMGING_T)
            call bf.addDmged_T(function A63T_DMGED_T)
            call bf.apply()
            set paladinDivineBeaconTarget = spellTarget
        endfunction
        function DEVOTION_DAMAGING_TARGET takes nothing returns nothing
            if damageSource == damageTarget then 
                return 
            endif 
            if hero[1] == damageTarget then 
                set damageFinalDamage = damageFinalDamage*0.88
            else 
                set damageFinalDamage = damageFinalDamage*0.94
            endif 
        endfunction
        function DEVOTION_AURA_STATE_SET takes nothing returns nothing
            local mybuff bf = aura.modifingAuraBuff
            call bf.addDmging_T(function DEVOTION_DAMAGING_TARGET)
            if hero[1] == bf.buffTarget then 
                if HeroHaveTalent(hero[1],HERO_ULTIMATE_TALENT,12) then 
                    set bf.bonusHaste = 1000
                    set bf.bonusResistance = 1000
                    set bf.bonusMoveSpeed_P = 2000
                else 
                    set bf.bonusHaste = 0
                    set bf.bonusResistance = 0
                    set bf.bonusMoveSpeed_P = 0
                endif 
            else 
                if HeroHaveTalent(hero[1],HERO_ULTIMATE_TALENT,12) then 
                    set bf.bonusHaste = 500
                    set bf.bonusResistance = 500
                    set bf.bonusMoveSpeed_P = 1000
                else 
                    set bf.bonusHaste = 0
                    set bf.bonusResistance = 0
                    set bf.bonusMoveSpeed_P = 0
                endif 
            endif 
        endfunction
        function HERO_2_LEARN_S030 takes nothing returns nothing    //虔诚光环
            local aura ar = aura.create(hero[1],AURA_PALADIN_DEVOTION,900,0,BUFFTYPE_PALADIN_DEVOTIONAURA,"Abilities\\Spells\\Human\\DevotionAura\\DevotionAura.mdl")
            call ar.addAllySet(function DEVOTION_AURA_STATE_SET)
            set ar.removeWhenDeath = false 
        endfunction
        function RETRIBUTION_AURA_STATE_SET takes nothing returns nothing
            local mybuff bf = aura.modifingAuraBuff
            if hero[1] == bf.buffTarget then 
                set bf.bonusAbilityPower_P = 2000
                set bf.bonusAttack_P = 2000
                if HeroHaveTalent(hero[1],HERO_ULTIMATE_TALENT,12) then 
                    set bf.bonusHaste = 1000
                    set bf.bonusResistance = 1000
                    set bf.bonusMoveSpeed_P = 2000
                else 
                    set bf.bonusHaste = 0
                    set bf.bonusResistance = 0
                    set bf.bonusMoveSpeed_P = 0
                endif 
            else 
                set bf.bonusAbilityPower_P = 1000
                set bf.bonusAttack_P = 1000
                if HeroHaveTalent(hero[1],HERO_ULTIMATE_TALENT,12) then 
                    set bf.bonusHaste = 500
                    set bf.bonusResistance = 500
                    set bf.bonusMoveSpeed_P = 1000
                else 
                    set bf.bonusHaste = 0
                    set bf.bonusResistance = 0
                    set bf.bonusMoveSpeed_P = 0
                endif 
            endif 
        endfunction
        function HERO_2_LEARN_S031 takes nothing returns nothing    //惩戒光环
            local aura ar = aura.create(hero[1],AURA_PALADIN_RETRIBUTION,900,0,BUFFTYPE_PALADIN_RETRIBUTIONAURA,"Abilities\\Spells\\Orc\\WarDrums\\DrumsCasterHeal.mdl")
            call ar.addAllySet(function RETRIBUTION_AURA_STATE_SET)
