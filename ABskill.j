                exitwhen FirstOfGroup(newgroup) == null 
                set bf = mybuff.getUnitBuff(FirstOfGroup(newgroup),BUFFTYPE_WARLOCK_HOLOCAUST)
                set dmg = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*3.5
                if bf != 0 then 
                    set dmg = dmg*(1+I2R(unitGetAllBonusStateValue(spellCaster,STATE_CRIT))/10000)
