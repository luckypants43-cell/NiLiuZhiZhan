    function CAMP_FIRE_REGEN takes nothing returns nothing
        local group pick = CreateGroup() 
        local delayedevent de = delayedevent.currentEvent
        local real x = GetUnitX(de.loadUnit("CASTER"))
        local real y = GetUnitY(de.loadUnit("CASTER"))
        call GroupEnumUnitsInRangeEx(pick,x,y,450,playerAlly)
        loop
            exitwhen FirstOfGroup(pick) == null
            if not inCombat(FirstOfGroup(pick)) then 
                call AddUnitLife(FirstOfGroup(pick),0.08*GetUnitState(FirstOfGroup(pick),UNIT_STATE_MAX_LIFE))
                call AddUnitMana(FirstOfGroup(pick),0.08*GetUnitState(FirstOfGroup(pick),UNIT_STATE_MAX_MANA))
            endif 
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call DestroyGroup(pick) 
        set pick = null 
    endfunction
    function CAMP_FIRE_REGEN_PIG_0 takes nothing returns nothing
        local group pick = CreateGroup() 
        local delayedevent de = delayedevent.currentEvent
        local real x = GetUnitX(de.loadUnit("CASTER"))
        local real y = GetUnitY(de.loadUnit("CASTER"))
        local mybuff bf
        call GroupEnumUnitsInRangeEx(pick,x,y,450,playerAlly)
        loop
            exitwhen FirstOfGroup(pick) == null
            if not inCombat(FirstOfGroup(pick)) then 
                call AddUnitLife(FirstOfGroup(pick),0.12*GetUnitState(FirstOfGroup(pick),UNIT_STATE_MAX_LIFE))
                call AddUnitMana(FirstOfGroup(pick),0.12*GetUnitState(FirstOfGroup(pick),UNIT_STATE_MAX_MANA))
                set bf = mybuff.create(FirstOfGroup(pick),FirstOfGroup(pick),BUFFTYPE_CAMPFIRE)
                set bf.lastTime = 60000
                set bf.bonusStr = 2
                set bf.bonusAgi = 2
                set bf.bonusInt = 2
                call bf.apply()
            endif 
            call GroupRemoveUnit(pick,FirstOfGroup(pick))
        endloop
        call DestroyGroup(pick) 
        set pick = null 
    endfunction
