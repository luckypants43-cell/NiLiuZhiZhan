            endloop
            call DestroyGroup(newgroup)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Deathfire_Portrait_L.mdx",x,y))
            loop 
                exitwhen i > 2
                set a = GetRandomReal(2.0944*I2R(i),2.0944*I2R(i+1))
                set d = SquareRoot(GetRandomReal(2500,15625))
                set mini = minion.create(caster,'nS09',x+d*Cos(a),y+d*Sin(a))
                if HeroHaveTalent(caster,HERO_PRIVATE_TALENT,6) then
                    call UnitApplyTimedLife(mini.summon,'BTLF',15.6)
                else 
                    call UnitApplyTimedLife(mini.summon,'BTLF',12)
                endif 
                call unitCheckState.evaluate(mini.summon)
                call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\Deathfire_Portrait_L.mdx",x+d*Cos(a),y+d*Sin(a)))
                set i = i+1
            endloop 
            set newgroup = null 
            set caster = null 
        endfunction
