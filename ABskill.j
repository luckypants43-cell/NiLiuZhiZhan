            set damageFlag = 'S04V'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",spellTarget,"origin"))
            call UnitsAddLightningSFX(spellCaster,0,0,50,spellTarget,0,0,50,"AFOD",1,0.5,false)
            call WarlockApplyHoloCaust(spellCaster,spellTarget,1800)
        endfunction
    //endregion 

    // region priest 牧师
    ////////////////
    //HEROID = 7(8)
    ////////////////
        function S00N_HIT takes nothing returns nothing
            local unit ds = projectile.currentProjectile.source
            local unit dt = projectile.currentProjectile.target
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Shadow = true 
            set damageFlag = 'S00N'
            call UnitDamageTarget(ds,dt,I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            set ds = null 
            set dt = null 
        endfunction
        function A674_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = bf.realData/((I2R(bf.remainingTime)/I2R(bf.periodTime))+1)
            set damageTag_Shadow = true 
            set damageIsDOT = true 
            set damageIsExtra = true
            set damageFlag = 'A674' 
            call UnitDamageTarget(bf.buffTarget,bf.buffTarget,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            set bf.realData = bf.realData-dmg
        endfunction
        function HERO_8_AFTERHEAL_SOURCE takes nothing returns nothing
            local mybuff bf = 0
            if healFlag == 'S04T' then 
                set bf = CreateBuff(healSource,healTarget,BUFFTYPE_PRIEST_SHADOWMENDING,800)
                set bf.addTime = false 
                set bf.periodTime = 100
                set bf.realData = bf.realData+0.5*healEffective
                call bf.addPeriod(function A674_PERIOD)
                call bf.apply()
            endif 
        endfunction
        function HERO_8_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            if GetUnitAbilityLevel(dt,'B60L') > 0 then 
                call UnitRemoveAbility(dt,'B60L')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S00N'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = BlzGetUnitAbilityCooldown(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set attackingMissile.model_path = "war3campImported\\OrbOfDeathMissile_particle.mdx"  
                set attackingMissile.curve = 0 
                set attackingMissile.speed = 2000
                call attackingMissile.addOnHit(function S00N_HIT)
                set attackingMissile.flag = 'S00N'
                set attackingMissile.tag_Shadow = true 

                
            endif 
            set ds = null 
            set dt = null 
        endfunction
        function S00O_RESET takes nothing returns nothing
            local real haste = 1
            if unitGetBonusState(hero[7],STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetBonusState(hero[7],STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetBonusState(hero[7],STATE_HASTE)))/10000
            endif 
            call BlzStartUnitAbilityCooldown(hero[7],'S00O',RMaxBJ(0.52,1.5*haste))
        endfunction
        function SPELL_S00O takes nothing returns nothing    //快速治疗 
            local delayedevent de = delayedevent.create(1,1,function S00O_RESET)
            set healFlag = 'S00O'
            call UnitHealTarget(spellCaster,spellTarget,I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*1)
            if GetUnitAbilityLevel(spellCaster,'S00U') > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U') > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,'S00U',RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U')-2))
            endif 
        endfunction
        function A60M_HOT takes nothing returns nothing
            local real heal = mybuff.currentBuff.realData*I2R(unitGetAllBonusStateValue(mybuff.currentBuff.buffSource,STATE_ABILITY_POWER))*0.3*mybuff.buffTimeScale
            set healIsDOT = true 
            set healFlag = 'A60M'
            call UnitHealTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,heal)
        endfunction
        function S00P_HEAL takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local mybuff bf = CreateBuff(de.loadUnit("CASTER"),de.loadUnit("TARGET"),BUFFTYPE_PRIEST_RENEW,1000)
            set bf.periodTime = 200
            call bf.addPeriod(function A60M_HOT)
            set bf.hasteAble = true 
            set bf.realData = 1
            call bf.apply()

            set healFlag = 'S00P'
            call UnitHealTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("HEAL"))
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",de.loadUnit("TARGET"),"origin"))
        endfunction
        function SPELL_S00P takes nothing returns nothing    //强效治疗 
            local delayedevent de
            local real haste = 1
            local integer delay = 100
            local real heal = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*2.8
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,5) then 
                set delay = 1
                set heal = heal*0.9
            endif 
            if unitGetBonusState(spellCaster,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetBonusState(spellCaster,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetBonusState(spellCaster,STATE_HASTE)))/10000
            endif 
            set de = delayedevent.create(R2I(delay*haste),1,function S00P_HEAL)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveReal("HEAL",heal)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Orc\\LiquidFire\\Liquidfire.mdl",spellTarget,"origin"),IMaxBJ(50,delay))
            if GetUnitAbilityLevel(spellCaster,'S00U') > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U') > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,'S00U',RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U')-4))
            endif
        endfunction
        function S00Q_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            if IsUnitEnemy(proj.target,GetOwningPlayer(proj.source)) then 
                call proj.applyDamageSet()
                set damageFlag = 'S00Q'
                call UnitDamageTarget(proj.source,proj.target,proj.realData*I2R(unitGetAllBonusStateValue(proj.source,STATE_ABILITY_POWER))*1.2,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            else 
                call proj.applyHealSet()
                set healFlag = 'S00Q'
                call UnitHealTarget(proj.source,proj.target,proj.realData*I2R(unitGetAllBonusStateValue(proj.source,STATE_ABILITY_POWER))*1.8)
            endif 
        endfunction
        function SPELL_S00Q takes nothing returns nothing    //苦修
            local delayedevent de
            local projectile proj = projectile.create(spellCaster)
            local integer i = 0
            local integer imax = 2
            local real haste = 1
            local integer time = 150
            local boolean dark = false 
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,5) then 
                set imax = imax+1
                set dark = true 
            endif 
            if unitGetBonusState(spellCaster,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetBonusState(spellCaster,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetBonusState(spellCaster,STATE_HASTE)))/10000
            endif 
            set time = R2I(I2R(time)*haste)
            set proj.speed = 900
            set proj.curve = 0
            set proj.realData = 1
            set proj.target = spellTarget
            set proj.TARGET_UNIT = true 
            set proj.LAUNCH_UNIT = true 
            call proj.addOnHit(function S00Q_HIT)
            set proj.flag = 'S00Q'
            if dark then 
                if IsUnitEnemy(spellTarget,GetOwningPlayer(spellCaster)) then 
                    set proj.model_path = "war3campImported\\PenanceDark.mdx"
                    set proj.tag_Shadow = true 
                else 
                    set proj.realData = 0.9
                    set proj.model_path = "war3campImported\\Penance.mdx"
                    set proj.tag_Divine = true 
                endif 
            else 
                set proj.model_path = "war3campImported\\Penance.mdx"
                set proj.tag_Divine = true 
            endif 
            call proj.launch()
            loop 
                exitwhen i > imax-1
                set proj = projectile.create(spellCaster)
                set proj.speed = 900
                set proj.curve = 0
                set proj.realData = 1
                set proj.target = spellTarget
                set proj.TARGET_UNIT = true 
                set proj.LAUNCH_UNIT = true 
                call proj.addOnHit(function S00Q_HIT)
                set proj.flag = 'S00Q'
                if dark then 
                    if IsUnitEnemy(spellTarget,GetOwningPlayer(spellCaster)) then 
                        set proj.model_path = "war3campImported\\PenanceDark.mdx"
                        set proj.tag_Shadow = true 
                    else 
                        set proj.realData = 0.9
                        set proj.model_path = "war3campImported\\Penance.mdx"
                        set proj.tag_Divine = true 
                    endif 
                else 
                    set proj.model_path = "war3campImported\\Penance.mdx"
                    set proj.tag_Divine = true 
                endif 
                set de = delayedevent.create(time/imax*(i+1),1,function DELAYED_MISSILE_LAUNCH)
                call de.saveInteger("MISSILE",proj)
                set i = i+1
            endloop 
            if GetUnitAbilityLevel(spellCaster,'S00U') > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U') > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,'S00U',RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U')-8))
            endif 
        endfunction
        function S00R_DOT takes nothing returns nothing
            local real dmg = mybuff.currentBuff.realData*I2R(unitGetAllBonusStateValue(mybuff.currentBuff.buffSource,STATE_ABILITY_POWER))*5.1/7*mybuff.buffTimeScale
            set damageTag_Shadow = true 
            set damageIsDOT = true 
            set damageFlag = 'A60L'
            call UnitDamageTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S00R takes nothing returns nothing   //吸血鬼之触
            local mybuff bf = mybuff.getUnitBuff(spellTarget,BUFFTYPE_PRIEST_VAMPIRETOUCH)
            local group pick = null 
            if bf != 0 and HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) then 
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellTarget),GetUnitY(spellTarget),250,playerEnemy)
                loop
                    exitwhen FirstOfGroup(pick) == null 
                    set damageIsAOE = true 
                    set damageTag_Divine = true 
                    set damageFlag = 'S00R'
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*1.5,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                    call GroupRemoveFirstUnit(pick)
                endloop
                call DestroyGroup(pick)
                set pick = null 
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3mapimported\\Sacred Verdict.mdx",spellTarget,"origin"))
            endif 
            set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PRIEST_VAMPIRETOUCH)
            set bf.lastTime = 2100
            set bf.periodTime = 300
            call bf.addPeriod(function S00R_DOT)
            set bf.hasteAble = true 
            set bf.realData = 1
            call bf.apply()
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",spellTarget,"origin"))
        endfunction
        function S00S_HOT takes nothing returns nothing
            local real heal = mybuff.currentBuff.realData*I2R(unitGetAllBonusStateValue(mybuff.currentBuff.buffSource,STATE_ABILITY_POWER))*0.9*mybuff.buffTimeScale
            set healIsDOT = true 
            set healFlag = 'A60M'
            call UnitHealTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,heal)
        endfunction
        struct Exorcism
            static string array iconPath [3]
            static integer nowStack = 2
            static timer chargeTimer = CreateTimer()
            static boolean charging = false 

            static method recharge takes nothing returns nothing
                set thistype.charging = false 
                set thistype.nowStack = IMinBJ(2,thistype.nowStack+1)
                call BlzSetAbilityIcon('S00S',thistype.iconPath[thistype.nowStack])
                if thistype.nowStack < 2 then 
                    call TimerStart(thistype.chargeTimer,30.0,false,function thistype.recharge)
                    set thistype.charging = true 
                endif 
            endmethod
            static method onCast takes unit whichUnit returns nothing
                if not thistype.charging then 
                    call TimerStart(thistype.chargeTimer,30.0,false,function thistype.recharge)
                    set thistype.charging = true 
                endif 
                set thistype.nowStack = IMaxBJ(0,thistype.nowStack-1)
                call BlzSetAbilityIcon('S00S',thistype.iconPath[thistype.nowStack])
                if thistype.nowStack == 0 then 
                    call BlzStartUnitAbilityCooldown(whichUnit,'S00S',TimerGetRemaining(thistype.chargeTimer))
                endif 
            endmethod
            static method onReset takes nothing returns nothing
                call PauseTimer(thistype.chargeTimer)
                set thistype.charging = false 
                set thistype.nowStack = 2 
                call BlzSetAbilityIcon('S00S',thistype.iconPath[thistype.nowStack])
            endmethod
            static method onInit takes nothing returns nothing
                set thistype.iconPath[0] = "ReplaceableTextures\\CommandButtons\\paladin\\BTNpaladin_22.blp"
                set thistype.iconPath[1] = "ReplaceableTextures\\CommandButtons\\1\\BTNpaladin_22.blp"
                set thistype.iconPath[2] = "ReplaceableTextures\\CommandButtons\\2\\BTNpaladin_22.blp"
                call BlzSetAbilityIcon('S00S',thistype.iconPath[thistype.nowStack])
            endmethod
        endstruct
        function SPELL_S00S takes nothing returns nothing   //驱邪术
            local mybuff bf = 0
            local real dmg = 5*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,300,playerAlly)
            loop
                exitwhen FirstOfGroup(pick) == null
                call bufflist.flush()
                call bufflist.listUnitBuffs(FirstOfGroup(pick),false,true,true)
                if bufflist.dispelMultiBuffs(3) then 
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",FirstOfGroup(pick),"origin"))
                    if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) then 
                        set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_PRIEST_RENEW,2000)
                        set bf.periodTime = 200
                        call bf.addPeriod(function A60M_HOT)
                        set bf.hasteAble = true 
                        set bf.realData = 1
                        call bf.apply()
                    endif 
                endif 
                set healIsAOE = true 
                set healFlag = 'S00S'
                call UnitHealTarget(spellCaster,FirstOfGroup(pick),I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*1)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",FirstOfGroup(pick),"origin"))
                call GroupRemoveFirstUnit(pick)
            endloop
            call GroupClear(pick)
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,300,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null
                call bufflist.flush()
                call bufflist.listUnitBuffs(FirstOfGroup(pick),true,false,true)
                if bufflist.dispelMultiBuffs(3) then 
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",FirstOfGroup(pick),"origin"))
                endif 
                if IsUnitType(FirstOfGroup(pick),UNIT_TYPE_SUMMONED) then 
                    set damageTag_Divine = true 
                    set damageIsAOE = true 
                    set damageFlag = 'S00S'
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Other\\Andt\\Andt.mdl",spellTargetX,spellTargetY))
            if GetUnitAbilityLevel(spellCaster,'S00U') > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U') > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,'S00U',RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U')-10))
            endif 
            call Exorcism.onCast(spellCaster)
        endfunction
        function HERO_8_RETRAIN takes nothing returns nothing
            call Exorcism.onReset()
        endfunction

        function SPELL_S006 takes nothing returns nothing   //心灵之火
            local mybuff bf = 0
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),900,playerHero)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_PRIEST_INNERFIRE,9000)
                set bf.bonusArmor = 1*UnitLevel(spellCaster)
                set bf.bonusAttack = 2*UnitLevel(spellCaster)
                set bf.bonusAbilityPower = 2*UnitLevel(spellCaster)
                if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) and FirstOfGroup(pick) == spellCaster then 
                    set bf.bonusAbilityPower = bf.bonusAbilityPower*2
                endif 
                set bf.bonusLifeRegen = 40*UnitLevel(spellCaster)
                call bf.apply()
                call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\InnerFire\\InnerFireTarget.mdl",FirstOfGroup(pick),"overhead"),150)
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIda\\AIdaCaster.mdl",spellCaster,"origin"))
        endfunction 
        function A60N_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            set bf = CreateBuff(bf.buffSource,bf.buffTarget,BUFFTYPE_PRIEST_RENEW,1000)
            set bf.periodTime = 200
            call bf.addPeriod(function A60M_HOT)
            set bf.hasteAble = true 
            set bf.realData = 1
            call bf.apply()
        endfunction
        function SPELL_S00T takes nothing returns nothing   //真言护盾
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_PRIEST_SHIELD,1500)
            set bf.shieldDestroy = true 
            set bf.shieldBlockPercent = 1
            set bf.shieldMaxValue = I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*2.5
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,5) then 
                call bf.addEnding(function A60N_END)
            endif 
            if bf.shieldMaxValue > 0 then 
                call bf.apply()
            else 
                call bf.destroy()
            endif 
            if GetUnitAbilityLevel(spellCaster,'S00U') > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U') > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,'S00U',RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U')-4))
            endif 
        endfunction
        function S00W_DOT takes nothing returns nothing
            local real dmg = mybuff.currentBuff.realData*I2R(unitGetAllBonusStateValue(mybuff.currentBuff.buffSource,STATE_ABILITY_POWER))*7.5/7*mybuff.buffTimeScale
            set damageTag_Shadow = true 
            set damageIsDOT = true 
            set damageFlag = 'A60O'
            call UnitDamageTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S00W_DAMAGED takes nothing returns nothing
            if damageTag_Shadow then 
                set damageFinalDamage = damageFinalDamage*(1+0.1*mybuff.getUnitBuff(damageTarget,BUFFTYPE_PRIEST_DEVOURINGPLAGUE).realData)
            endif 
        endfunction
        function SPELL_S00W takes nothing returns nothing   //噬灵疫病
            local mybuff bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_PRIEST_DEVOURINGPLAGUE)
            set bf.lastTime = 700
            set bf.periodTime = 100
            call bf.addPeriod(function S00W_DOT)
            set bf.hasteAble = true 
            set bf.realData = 1
            call bf.addDmged_T(function S00W_DAMAGED)
            call bf.apply()
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl",spellTarget,"overhead"))
        endfunction
        function SPELL_S00U takes nothing returns nothing   //圣言术
            local group newgroup = CreateGroup()
            call GroupEnumUnitsInRangeEx(newgroup,spellTargetX,spellTargetY,250,playerAlly)
            loop 
                exitwhen FirstOfGroup(newgroup) == null 
                set healIsAOE = true 
                set healFlag = 'S00U'
                call UnitHealTarget(spellCaster,FirstOfGroup(newgroup),I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*4)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",FirstOfGroup(newgroup),"origin"))
                call GroupRemoveUnit(newgroup,FirstOfGroup(newgroup))
            endloop
            call DestroyGroup(newgroup)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\HolyForce.mdx",spellTargetX,spellTargetY))
        endfunction

        function S00V_DAMAGED_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local delayedevent de = bf.intData
            local real life = de.loadReal("LIFE")
            local real absorb = RMinBJ(life,damageFinalDamage)
            set life = life-absorb
            set damageFinalDamage = damageFinalDamage-absorb
            set damageBlockDamage = damageBlockDamage+absorb
            call EventBlockDamage(damageSource,damageMaster,bf.buffSource,damageTarget,absorb,bf.type.abilityId)
            call de.saveReal("LIFE",life)
            if life < 0.5 then 
                set de.DESTROY = true 
            endif 
        endfunction
        function S00V_PERIOD takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local mybuff bf 
            local real scale = 1/I2R(de.loadInteger("LEVEL"))
            call GroupEnumUnitsInRangeEx(pick,x,y,250,playerAlly)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(caster,FirstOfGroup(pick),BUFFTYPE_PRIEST_BARRIER)
                set bf.fromAura = true 
                set bf.lastTime = 6
                set bf.intData = de 
                call bf.addDmged_T(function S00V_DAMAGED_TARGET)
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
        endfunction
        function S00V_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            call DestroyEffectEX(de.loadEffect("SFX"))
        endfunction
        function SPELL_S00V takes nothing returns nothing   //信仰壁垒
            local delayedevent de = delayedevent.create(5,160,function S00V_PERIOD)
            local real life = I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*8
            local effect sfx = delayedDestroyEffect(AddSpecialEffectEX("war3campImported\\antimagiczone.mdl",spellTargetX,spellTargetY),800)
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,12) then 
                set life = life/2
            endif 
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveInteger("LEVEL",spellAbilityLevel)
            call de.saveReal("LIFE",life)
            call de.saveEffect("SFX",sfx)
            call de.addOnEnd(function S00V_DELAYED)
            call BlzSetSpecialEffectScale(sfx,0.39)
            set sfx = null 
        endfunction
        function S00X_HEALED takes nothing returns nothing
            set healFinalHeal = healFinalHeal*mybuff.getUnitBuff(healTarget,BUFFTYPE_PRIEST_RAINOFHEAVEN).realData
        endfunction
        function S00X_PERIOD takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local real x = GetUnitX(caster)
            local real y = GetUnitY(caster)
            local group pick = CreateGroup()
            local mybuff bf 
            local real scale = 1/I2R(de.loadInteger("LEVEL"))
            call GroupEnumUnitsInRangeEx(pick,x,y,700,playerAlly)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(caster,FirstOfGroup(pick),BUFFTYPE_PRIEST_RAINOFHEAVEN)
                set bf.lastTime = 1000
                set bf.realData = 1.15
                call bf.addHealed_T(function S00X_HEALED)
                call bf.apply()
                set healIsAOE = true 
                set healFlag = 'S00X'
                call UnitHealTarget(caster,FirstOfGroup(pick),I2R(unitGetAllBonusStateValue(caster,STATE_ABILITY_POWER))*1.05*scale)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",FirstOfGroup(pick),"origin"))
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
        endfunction
        function SPELL_S00X takes nothing returns nothing   //天堂之雨
            local real haste = 1
            local integer time = 200
            local delayedevent de
            if unitGetBonusState(spellCaster,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetBonusState(spellCaster,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetBonusState(spellCaster,STATE_HASTE)))/10000
            endif
            set time = R2I(I2R(time)*haste)
            set de = delayedevent.create(time,4,function S00X_PERIOD)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveInteger("LEVEL",spellAbilityLevel)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\rainofheaven.mdx",spellCaster,"origin"),time*4)
        endfunction
        function CHECK_STATE_nS00 takes nothing returns nothing
            call BlzSetUnitBaseDamage(checkingUnit,unitGetAllBonusStateValue(minion.getMinionByUnit(checkingUnit).mast.masterUnit,STATE_ABILITY_POWER)/minion.getMinionByUnit(checkingUnit).intData-1,0)
            call BlzSetUnitArmor(checkingUnit,2*GetUnitLevel(minion.getMinionByUnit(checkingUnit).mast.masterUnit)/3)
        endfunction
        function UNIT_nS00_ATTACKING takes nothing returns nothing
            set damageTag_Shadow = true 
            set damageTag_Attack = false 
            set damageFlag = 'S00Y'
            set damageDamageType = DAMAGE_TYPE_MAGIC
            set damageAttackType = ATTACK_TYPE_NORMAL
            call AddUnitMana(damageMaster,0.0025*GetUnitState(damageMaster,UNIT_STATE_MAX_MANA))
        endfunction
        function SPELL_S00Y takes nothing returns nothing   //暗影魔
            local minion mini 
            local real x = GetUnitX(spellTarget)
            local real y = GetUnitY(spellTarget)
            local real a = GetRandomReal(0,6.283)
            local real d = 150
            set mini = minion.create(spellCaster,'nS00',x+d*Cos(a),y+d*Sin(a))
            set mini.aimTarget = spellTarget
            set mini.remove = true 
            set mini.deathSFX = "Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl"
            call IssueTargetOrderById(mini.summon,ORDER_attack,spellTarget)
            call UnitApplyTimedLife(mini.summon,'BTLF',12)
            call unitAddState(mini.summon,STATE_LIFE,30*GetUnitLevel(spellCaster))
            call unitCheckState.evaluate(mini.summon)
            set mini.intData = spellAbilityLevel
        endfunction
        function A673_DAMAGING_TARGET takes nothing returns nothing
            set damageFinalDamage = damageFinalDamage*0.6
        endfunction
        function SPELL_S04S takes nothing returns nothing   //痛苦压制
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_PRIEST_PAINSUPPRESSION,800)
            set bf.bonusImmune_Silence = 1
            set bf.bonusImmune_Snare = 1
            set bf.bonusImmune_Stun = 1
            set bf.bonusImmune_Root = 1
            call bf.addDmging_T(function A673_DAMAGING_TARGET)
            call bf.apply()
            call removeStun(spellTarget)
            call removeSnare(spellTarget)
            call removeSilence(spellTarget)
            call removeRoot(spellTarget)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\sealofrighteous_impact_base.mdx",spellTarget,"origin"))
        endfunction
        function SPELL_S04T takes nothing returns nothing   //暗影愈合
            set healFlag = 'S04T'
            call UnitHealTarget(spellCaster,spellTarget,I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*5)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\Ambush_50%.mdx",spellTarget,"chest"))
            call bufflist.listUnitBuffs(spellTarget,false,true,true)
            call bufflist.dispelMultiBuffs(1)
            if GetUnitAbilityLevel(spellCaster,'S00U') > 0 and BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U') > 0.01 then 
                call BlzStartUnitAbilityCooldown(spellCaster,'S00U',RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(spellCaster,'S00U')-4))
            endif 
        endfunction
    // endregion 

    // region shaman 贤者
    ////////////////
    //HEROID = 11(12)
    ////////////////
        function ShamanDecreaseFireShock takes unit whichUnit,integer value returns nothing
            local mybuff bf = mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_FIRESHOCK)
            local integer i = 0

            set i = value 
            set bf.intData = IMaxBJ(0,bf.intData-value)
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif 

            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,3) then 
                if GetRandomReal(0,1) < 0.25*I2R(ModuloInteger(i,4)) then 
                    set i = i+4
                endif 
                if i/4 > 0 then 
                    call ShamanGainLightningEnchantment.evaluate(bf.buffSource,i/4)
                endif 
            endif 
        endfunction
        function A66B_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            set damageTag_Fire = true 
            set damageIsExtra = true 
            set damageFlag = 'A66B'
            call UnitDamageTarget(de.loadUnit("CASTER"),de.loadUnit("TARGET"),de.loadReal("DAMAGE"),false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\LordofFlameMissile\\LordofFlameMissile.mdl",de.loadUnit("TARGET"),"origin"))
        endfunction
        function A66B_ATTACKED_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local delayedevent de = 0
            if damageSource != bf.buffSource then 
                return 
            endif 
            set de = delayedevent.create(25,1,function A66B_DELAYED)
            if bf.intData > 1 and HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,2) and damageFlag == 'S01E' then
                call ShamanDecreaseFireShock(damageTarget,2)
                call de.saveReal("DAMAGE",0.7*I2R(ST_ABILITY_POWER.getTotalState(bf.buffSource)))
            else 
                call ShamanDecreaseFireShock(damageTarget,1)
                call de.saveReal("DAMAGE",0.35*I2R(ST_ABILITY_POWER.getTotalState(bf.buffSource)))
            endif 
            call de.saveUnit("CASTER",bf.buffSource)
            call de.saveUnit("TARGET",damageTarget)
        endfunction
        function ShamanApplyFireShock takes unit caster,unit whichUnit,integer value returns nothing
            local mybuff bf = CreateBuff(caster,whichUnit,BUFFTYPE_SHAMAN_FIRESHOCK,3000)
            local integer max = 20
            if mybuff.getUnitBuff(caster,BUFFTYPE_SHAMAN_FIREAVATAR) != 0 then 
                set value = value*2
            endif 
            if mybuff.getUnitBuff(caster,BUFFTYPE_SHAMAN_ELEMENTALBODY) != 0 then 
                if mybuff.getUnitBuff(caster,BUFFTYPE_SHAMAN_ELEMENTALBODY).boolData then 
                    set value = value*2
                endif 
            endif 
            set bf.addTime = false 
            set bf.intData = IMinBJ(max,bf.intData+value)
            call bf.addAtked_T(function A66B_ATTACKED_TARGET)
            call bf.apply()
        endfunction

        function ShamanDecreaseWaterEnchantment takes unit whichUnit,integer value returns nothing
            local mybuff bf = mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_WATERENCHANTMENT)
            local integer i = 0
            local integer k = 0

            set i = value 

            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,7) then 
                set k = value 
                loop
                    exitwhen k <= 0
                    if random.get(whichUnit,0.25,'HTL7') then 
                        set value = value-1
                    endif 
                    set k = k-1
                endloop
            endif 

            set bf.intData = IMaxBJ(0,bf.intData-value)
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif 
            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,1) then 
                if GetRandomReal(0,1) < 0.25*I2R(ModuloInteger(i,4)) then 
                    set i = i+4
                endif 
                if i/4 > 0 then 
                    call ShamanGainLightningEnchantment.evaluate(whichUnit,i/4)
                endif 
            endif 
            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,6) and GetUnitAbilityLevel(whichUnit,'S03X') > 0 and BlzGetUnitAbilityCooldownRemaining(whichUnit,'S03X') > 0.5 then
                set bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_SHAMAN_LAVACHARGE,360000)
                set bf.intData = IMinBJ(20,bf.intData+2*i)
                call bf.apply()
            endif 
        endfunction
        function A667_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(proj.source))*0.5
            call proj.applyHealSet()
            set healFlag = 'A667'
            call UnitHealTarget(proj.source,proj.target,dmg)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\VampiricAuraTargetBlue.mdx",proj.target,"origin"))
        endfunction
        function A667_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local projectile proj = CreateProjectileToUnit(de.loadUnit("CASTER"),de.loadUnit("TARGET"),1000,0,"Abilities\\Weapons\\WaterElementalMissile\\WaterElementalMissile.mdl",function A667_HIT,null)
            set proj.LAUNCH_LOC = true 
            set proj.LAUNCH_UNIT = false 
            set proj.source_x = de.loadReal("X")
            set proj.source_y = de.loadReal("Y")
            set proj.flag = 'A667'
            if HeroHaveTalent(de.loadUnit("CASTER"),HERO_PRIVATE_TALENT,3) then 
                set proj.maxBounceLimit = proj.maxBounceLimit+1
                set proj.bounceMultiplier = RMinBJ(0.75,proj.bounceMultiplier)
                set proj.bounceRange = RMaxBJ(450,proj.bounceRange)
            endif 
            call proj.launch()
        endfunction
        function A667_ATTACKED_SOURCE takes nothing returns nothing
            local delayedevent de = 0
            local mybuff bf = mybuff.currentBuff
            local group pick = null 
            local unit target = null 
            if damageMaster != damageSource then 
                return 
            endif 
            if GetRandomReal(0,1) < 0.25*I2R(bf.intData) then 
                call ShamanDecreaseWaterEnchantment(bf.buffTarget,1)
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(damageTarget),GetUnitY(damageTarget),900,playerHero)
                set target = GetUnitWithLowestHealthPct(pick)
                if target == null then 
                    call GroupClear(pick)
                    call GroupEnumUnitsInRangeEx(pick,GetUnitX(damageTarget),GetUnitY(damageTarget),900,playerAlly)
                    set target = GetUnitWithLowestHealthPct(pick)
                endif 
                if target != null then 
                    set de = delayedevent.create(1,1,function A667_DELAYED)
                    call de.saveUnit("CASTER",damageSource)
                    call de.saveUnit("TARGET",target)
                    call de.saveReal("X",GetUnitX(damageTarget))
                    call de.saveReal("Y",GetUnitY(damageTarget))
                endif 
                call DestroyGroup(pick)

                if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,1) and GetRandomReal(0,1) < 0.25 then 
                    call ShamanApplyFireShock(damageSource,damageTarget,1)
                endif 
            endif 
            set pick = null 
            set target = null 
        endfunction
        function ShamanGainWaterEnchantment takes unit whichUnit,integer value returns nothing
            local mybuff bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_SHAMAN_WATERENCHANTMENT,360000)
            local integer max = 4
            if mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_ELEMENTALBODY) != 0 then 
                if mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_ELEMENTALBODY).boolData then 
                    set value = value*2
                endif 
            endif 
            set bf.addTime = false 
            set bf.intData = IMinBJ(max,bf.intData+value)
            call bf.addAtked_S(function A667_ATTACKED_SOURCE)
            call bf.apply()
        endfunction

        function ShamanDecreaseLightningEnchantmentValue takes unit whichUnit,integer value returns nothing
            local mybuff bf = mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_LIGHTNINGENCHANTMENT)
            local integer i = 0
            local integer k = 0

            set i = value 

            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,7) then 
                set k = value 
                loop
                    exitwhen k <= 0
                    if random.get(whichUnit,0.25,'HTL7') then 
                        set value = value-1
                    endif 
                    set k = k-1
                endloop
            endif 
            set bf.intData = IMaxBJ(0,bf.intData-value)
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif 
            if mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_TEMPEST) > 0 then 
                set mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_TEMPEST).remainingTime = mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_TEMPEST).remainingTime+40*value
            endif 
            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,1) then 
                if GetRandomReal(0,1) < 0.1*I2R(ModuloInteger(i,10)) then 
                    set i = i+10
                endif 
                if i/10 > 0 then 
                    call ShamanGainWaterEnchantment.evaluate(whichUnit,i/10)
                endif 
            endif 
            if HeroHaveTalent(whichUnit,HERO_PRIVATE_TALENT,6) and GetUnitAbilityLevel(whichUnit,'S03X') > 0 and BlzGetUnitAbilityCooldownRemaining(whichUnit,'S03X') > 0.5 then
                set bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_SHAMAN_LAVACHARGE,360000)
                set bf.intData = IMinBJ(20,bf.intData+i)
                call bf.apply()
            endif 
        endfunction
        function ShamanDecreaseLightningEnchantment takes unit whichUnit returns nothing
            local mybuff bf = mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_LIGHTNINGENCHANTMENT)
            local integer value = bf.intData
            call ShamanDecreaseLightningEnchantmentValue(whichUnit,value)
        endfunction
        function A668_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(proj.source))*0.75*proj.realData
            call proj.applyDamageSet()
            set damageTag_Lightning = true 
            set damageFlag = 'A668'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",proj.target,"origin"))
            call UnitsAddLightningSFX(proj.bounce_lastTarget,0,0,50,proj.target,0,0,50,"CLPB",1.5,0.75,true)
            if mybuff.getUnitBuff(proj.source,BUFFTYPE_SHAMAN_FIREAVATAR) != 0 then 
                call ShamanApplyFireShock(proj.source,proj.target,1)
            endif 
        endfunction
        function A668_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local projectile proj = CreateProjectileToUnit(de.loadUnit("CASTER"),de.loadUnit("TARGET"),2000,0,"Abilities\\Spells\\Orc\\LightningBolt\\LightningBoltMissile.mdl",function A668_HIT,null)
            set proj.flag = 'A668'
            set proj.tag_Lightning = true 
            set proj.bounceRange = RMaxBJ(proj.bounceRange,450)
            set proj.bounceMultiplier = RMinBJ(0.75,proj.bounceMultiplier)
            set proj.maxBounceLimit = 4
            set proj.realData = de.loadReal("DAMAGE_BONUS")
            call proj.launch()
        endfunction
        function A668_ATTACKING takes nothing returns nothing
            local delayedevent de = 0
            local mybuff bf = mybuff.currentBuff
            if damageMaster != damageSource then 
                return 
            endif 
            if GetRandomReal(0,1) < 0.1*I2R(bf.intData) then 
                set de = delayedevent.create(1,1,function A668_DELAYED)
                call de.saveUnit("CASTER",damageSource)
                call de.saveUnit("TARGET",damageTarget)
                if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,3) then 
                    call de.saveReal("DAMAGE_BONUS",(1+0.1*I2R(bf.intData))*(1+0.1*I2R(bf.intData)))
                else 
                    call de.saveReal("DAMAGE_BONUS",1+0.1*I2R(bf.intData))
                endif 
                call ShamanDecreaseLightningEnchantment(bf.buffTarget)

                if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,1) and GetRandomReal(0,1) < 0.25 then 
                    call ShamanApplyFireShock(damageSource,damageTarget,1)
                endif 
            endif 
        endfunction
        function ShamanGainLightningEnchantment takes unit whichUnit,integer value returns nothing
            local mybuff bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_SHAMAN_LIGHTNINGENCHANTMENT,360000)
            local integer max = 10
            if mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_ELEMENTALBODY) != 0 then 
                if mybuff.getUnitBuff(whichUnit,BUFFTYPE_SHAMAN_ELEMENTALBODY).boolData then 
                    set value = value*2
                endif 
            endif 
            set bf.addTime = false 
            set bf.intData = IMinBJ(max,bf.intData+value)
            call bf.addAtking(function A668_ATTACKING)
            call bf.apply()
        endfunction

        function S01E_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local unit ds = proj.source
            local unit dt = proj.target
            local delayedevent de
            call proj.applyDamageSet()
            set damageTag_Lightning = true 
            set damageTag_Attack = true 
            set damageFlag = 'S01E'
            call UnitDamageTarget(ds,dt,I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call UnitsAddLightningSFX(proj.bounce_lastTarget,0,0,50,proj.target,0,0,50,"BLNL",1.0,0.5,false)
            set ds = null 
            set dt = null 
        endfunction
        function HERO_12_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 6.6
            local boolean stormStrike = false 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 

            if GetUnitAbilityLevel(dt,'B614') > 0 then 
                call UnitRemoveAbility(dt,'B614')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S01E'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = BlzGetUnitAbilityCooldown(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set stormStrike = true 

                set attackingMissile.model_path = "Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl"  
                set attackingMissile.curve = 0 
                set attackingMissile.speed = 1000
                set attackingMissile.flag = 'S01E'
                set attackingMissile.tag_Lightning = true 
                call attackingMissile.addOnHit(function S01E_HIT)  
                set attackingMissile.bounceRange = RMaxBJ(450,attackingMissile.bounceRange)
                if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,2) then 
                    set attackingMissile.maxBounceLimit = attackingMissile.maxBounceLimit+2
                    set attackingMissile.bounceMultiplier = RMinBJ(0.85,attackingMissile.bounceMultiplier)
                else 
                    set attackingMissile.maxBounceLimit = attackingMissile.maxBounceLimit+1
                    set attackingMissile.bounceMultiplier = RMinBJ(0.75,attackingMissile.bounceMultiplier)
                endif 
                
                call ShamanGainLightningEnchantment(damageSource,1)
            endif 

            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_SHAMAN_WINDFURY)
            if bf != 0 then 
                if stormStrike then 
                    set proj = CreateProjectileToUnit(damageSource,damageTarget,1000,0,"Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",function S01E_HIT,null)
                    set proj.flag = 'S01E'
                    set proj.tag_Lightning = true 
                    set proj.bounceRange = RMaxBJ(450,proj.bounceRange)
                    if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,2) then 
                        set proj.maxBounceLimit = proj.maxBounceLimit+2
                        set proj.bounceMultiplier = RMinBJ(0.85,proj.bounceMultiplier)
                    else 
                        set proj.maxBounceLimit = proj.maxBounceLimit+1
                        set proj.bounceMultiplier = RMinBJ(0.75,proj.bounceMultiplier)
                    endif 
                else 
                    set proj = CreateProjectileToUnit(damageSource,damageTarget,attackingMissile.speed,attackingMissile.curve,attackingMissile.model_path,function AttackMissileHit,null)
                    set proj.flag = 'Aatk'
                endif 
                call delayedLaunchMissile(proj,25)
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 

            set ds = null 
            set dt = null 
        endfunction  
        function S01F_RESET takes nothing returns nothing
            local real haste = 1
            local real cooldown = 3
            if unitGetBonusState(hero[11],STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetBonusState(hero[11],STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetBonusState(hero[11],STATE_HASTE)))/10000
            endif 
            if HeroHaveTalent(hero[11],HERO_PRIVATE_TALENT,2) then 
                set cooldown = cooldown-0.5
            endif 
            call BlzStartUnitAbilityCooldown(hero[11],'S01F',RMaxBJ(0.52,cooldown*haste))
        endfunction
        function SPELL_S01F takes nothing returns nothing    //治疗之涌
            local delayedevent de = delayedevent.create(1,1,function S01F_RESET)
            set healFlag = 'S01F'
            set healAddCrit = 0.25
            call UnitHealTarget(spellCaster,spellTarget,I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*1)

            call ShamanGainWaterEnchantment(spellCaster,1)
        endfunction
        function S01G_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local unit target = de.loadUnit("TARGET")
            local unit lastTarget = de.loadUnit("LAST_TARGET")
            local group bouncedGroup = de.loadGroup("GROUP")
            local real heal = de.loadReal("HEAL")
            local real fix = de.loadReal("FIX")
            local real range = de.loadReal("RANGE")
            local integer maxCount = de.loadInteger("COUNT")
            local real x = GetUnitX(target)
            local real y = GetUnitY(target)
            local group pick = null 
            set healFlag = 'S01G'
            set healIsAOE = true 
            call UnitHealTarget(caster,target,heal)
            call UnitsAddLightningSFX(lastTarget,0,0,50,target,0,0,50,"HWPB",3,1.5,true)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("war3campImported\\HealingWaveTargetFixed.mdx",target,"origin"),183)
            
            call bufflist.listUnitBuffs(target,false,true,true)
            call bufflist.dispelMultiBuffs(1)
            set lastTarget = target
            call GroupAddUnit(bouncedGroup,target)
            set maxCount = maxCount-1
            set heal = heal*fix
            if maxCount > 0 then
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,x,y,range,playerHero)
                call GroupRemoveGroup(bouncedGroup,pick)
                set target = null 
                set target = GetUnitWithLowestHealthPct(pick)
                call GroupClear(pick)
                if target == null then
                    call GroupEnumUnitsInRangeEx(pick,x,y,range,playerAlly)
                    call GroupRemoveGroup(bouncedGroup,pick)
                    set target = null 
                    set target = GetUnitWithLowestHealthPct(pick)
                    call GroupClear(pick)
                endif 
                if target != null then 
                    set de = delayedevent.create(20,1,function S01G_DELAYED) 
                    call de.saveUnit("CASTER",caster)
                    call de.saveUnit("TARGET",target)
                    call de.saveUnit("LAST_TARGET",lastTarget)
                    call de.saveGroup("GROUP",bouncedGroup)
                    call de.saveReal("HEAL",heal)
                    call de.saveReal("FIX",fix)
                    call de.saveReal("RANGE",range)
                    call de.saveInteger("COUNT",maxCount)
                else 
                    call DestroyGroup(bouncedGroup)
                endif 
                call DestroyGroup(pick)
            else 
                call DestroyGroup(bouncedGroup)
            endif 
            set caster = null 
            set target = null 
            set lastTarget = null 
            set pick = null 
            set bouncedGroup = null 
        endfunction
        function SPELL_S01G takes nothing returns nothing    //治疗链
            local real heal = 2.5*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))
            local real fix = 0.75
            local real range = 450
            local integer maxCount = 3
            local delayedevent de = delayedevent.create(5,1,function S01G_DELAYED)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveUnit("LAST_TARGET",spellCaster)
            call de.saveGroup("GROUP",CreateGroup())
            call de.saveReal("HEAL",heal)
            call de.saveReal("FIX",fix)
            call de.saveReal("RANGE",range)
            call de.saveInteger("COUNT",maxCount)
            call ShamanGainWaterEnchantment(spellCaster,1)
        endfunction

        function A66J_AFTERHEAL_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local mybuff sourceBuff = mybuff.getUnitBuff(bf.buffSource,BUFFTYPE_SHAMAN_TORRENTTOTEM)
            if sourceBuff != 0 then 
                set sourceBuff.realData = sourceBuff.realData+healEffective
            endif 
        endfunction
        function S01H_TALENT_ADD_BUFF takes nothing returns nothing
            local mybuff bf = 0
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            if caster != null and alive(caster) then 
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(caster),GetUnitY(caster),550,playerHero)
                loop
                    exitwhen FirstOfGroup(pick) == null 
                    set bf = CreateBuff(caster,FirstOfGroup(pick),BUFFTYPE_SHAMAN_TORRENTTOTEM,11)
                    call bf.addAftHeal_T(function A66J_AFTERHEAL_TARGET)
                    call bf.apply()
                    call GroupRemoveFirstUnit(pick)
                endloop
            else 
                set de.DESTROY = true 
            endif 
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
        endfunction
        function A66J_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real heal = 0.12*bf.realData
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(bf.buffTarget),GetUnitY(bf.buffTarget),550,playerHero)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set healIsAOE = true 
                set healFlag = 'A66J'
                call UnitHealTarget(bf.buffSource,FirstOfGroup(pick),heal)
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\VampiricAuraTargetBlue.mdx",FirstOfGroup(pick),"origin"))
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function CHECK_STATE_nS05 takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local real haste = 1
            local real Qcd = 2.5
            if unitGetBonusState(owner.masterUnit,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_HASTE)))/10000
            endif 
            call BlzSetUnitAbilityCooldown(checkingUnit,'A611',0,Qcd*haste)
        endfunction
        function SPELL_A611 takes nothing returns nothing
            local group pick = CreateGroup()
            local unit healTar = null 
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),550,playerHero)
            set healTar = GetUnitWithLowestHealthPct(pick)
            call GroupClear(pick)
            if healTar == null then 
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),550,playerAlly)
                set healTar = GetUnitWithLowestHealthPct(pick)
            endif 
            if healTar != null then 
                set healFlag = 'S01H'
                call UnitHealTarget(spellCaster,healTar,I2R(unitGetAllBonusStateValue(GetMinionOwnerUnitByUnit(spellCaster),STATE_ABILITY_POWER))*1)
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\VampiricAuraTargetBlue.mdx",healTar,"origin"))
            endif 
            call DestroyGroup(pick)
            set pick = null 
            set healTar = null 
        endfunction
        function SPELL_S01H takes nothing returns nothing    //治疗之泉图腾
            local delayedevent de = 0
            local mybuff bf = 0
            local minion mini 
            local group pick = CreateGroup()
            local integer count = 0
            local integer maxcount = 1
            local real x = spellTargetX
            local real y = spellTargetY
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS05' and minion.getMinionByUnit(FirstOfGroup(pick)) != 0  then 
                    set count = count+1
                    if count > maxcount-1 then
                        set minion.getMinionByUnit(FirstOfGroup(pick)).DESTROY = true
                    endif 
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            set mini = minion.createWithFace(spellCaster,'nS05',x,y,270)
            call DestroyEffectEX(AddSpecialEffectEX("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",x,y))
            call unitAddState(mini.summon,STATE_RESISTANCE,10000)
            call unitCheckState.evaluate(mini.summon)
            call UnitApplyTimedLife(mini.summon,'BTLF',24)
            set mini.lastOrderTime = -65535
            set mini.remove = false 
            call DestroyGroup(pick)
            set pick = null 
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                set de = CreateDelayedEvent(10,240,function S01H_TALENT_ADD_BUFF)
                call de.saveUnit("CASTER",mini.summon)
                set bf = CreateBuff(spellCaster,mini.summon,BUFFTYPE_SHAMAN_TORRENTTOTEM,2400)
                set bf.realData = 0
                call bf.addEnding(function A66J_END)
                call bf.apply()
            endif 
        endfunction
        function S03H_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real x = GetUnitX(bf.buffTarget)
            local real y = GetUnitY(bf.buffTarget)
            local real heal = 0.4*I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*mybuff.buffTimeScale
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,x,y,450,playerAlly)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set healFlag = 'S03H' 
                set healIsAOE = true 
                call UnitHealTarget(bf.buffSource,FirstOfGroup(pick),heal)
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\VampiricAuraTargetBlue.mdx",FirstOfGroup(pick),"origin"))
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S03H takes nothing returns nothing    //治疗之潮图腾
            local minion mini 
            local integer count = 0
            local integer maxcount = 1
            local real x = spellTargetX
            local real y = spellTargetY
            local mybuff bf 
