        function S05B_END takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))*2
            local mybuff bf = mybuff.getUnitBuff(proj.source,BUFFTYPE_DH_BLADEDANCE)
            local integer time = 1000
            local integer power = 1
            if bf.DESTROY == false and bf > 0 then 
                set bf.DESTROY = true 
                set dmg = dmg*2
            endif 
            set damageFlag = 'S05B'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
            if GetUnitAbilityLevel(proj.source,'S057') > 0 then 
                set time = time/2
                set power = power*2
                call Taunt(proj.source,proj.target)
            endif 
            set bf = CreateBuff(proj.source,proj.target,BUFFTYPE_DH_SUNDER,time)
            set bf.bonusArmor = 0-IMaxBJ(1,GetUnitLevel(proj.source)/2*power)
            call bf.apply()
        endfunction
        function SPELL_S05B takes nothing returns nothing   //疾影突进
            local projectile proj = ChargeUnit(spellCaster,spellTarget,1500,0,100,true,null,function S05B_END)
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",spellCaster,"hand left")
            set proj.bindSFX_1 = AddSpecialEffectTargetEX("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",spellCaster,"hand right")
            if heroNowForm[13] == FORM_DEMON_HUNTER_NORMAL then 
                call SetUnitAnimationByIndex(spellCaster,6)
            elseif heroNowForm[13] == FORM_DEMON_HUNTER_DEMON then 
                call SetUnitAnimationByIndex(spellCaster,4)
            endif 
        endfunction
        function SPELL_READY_S05B takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0)
        endfunction
        function SPELL_STOP_S05B takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function SPELL_END_S05B takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction

        function S05D_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))*1.8
            local mybuff bf = mybuff.getUnitBuff(proj.source,BUFFTYPE_DH_BLADEDANCE)
            if bf.DESTROY == false and bf > 0 then 
                set bf.DESTROY = true 
                set dmg = dmg*2
            endif 
            set damageFlag = 'S05D'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
            if GetUnitAbilityLevel(proj.source,'S057') > 0 then 
                call Taunt(proj.source,proj.target)
            endif 
            call applyStun(proj.source,proj.target,'ATB1')
        endfunction
        function SPELL_S05D takes nothing returns nothing   //战刃投掷
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1000,0,"war3campImported\\IllidanMissile.mdx",function S05D_HIT,null)
            set proj.maxBounceLimit = 3
            set proj.bounceMultiplier = 1
            set proj.bounceRange = 400
            set proj.flag = 'S05D'
            call proj.launch()
            if GetUnitAbilityLevel(spellCaster,'S056') > 0 then 
                call BlzEndUnitAbilityCooldown(spellCaster,'S056')
            elseif GetUnitAbilityLevel(spellCaster,'S057') > 0 then 
                call BlzEndUnitAbilityCooldown(spellCaster,'S057')
            endif 
        endfunction


        function S05E_PERIOD takes nothing returns nothing
            local mybuff bf = 0
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local integer loopC = de.loadInteger("LOOP")
            local real extraLeech = de.loadReal("LEECH")
            local boolean mustCrit = de.loadBoolean("CRIT")
            local real remainingTime = BlzGetUnitAbilityCooldownRemaining(ds,'S05E')
            local real dmg = I2R(GetUnitMaxAttack(ds,0))*4.25/10
            local real crit = RMinBJ(1,I2R(ST_CRIT_CHANCE.getTotalState(ds))/10000)
            local real a = AngleByUnXY(ds,x,y)/57.2956
            local group pick = CreateGroup()
            set loopC = loopC+1
            if alive(ds) and GetUnitCurrentOrder(ds) == ORDER_blizzard then 
                call GroupEnumUnitsInRangeEx(pick,x,y,400,playerEnemy)
                loop
                    exitwhen FirstOfGroup(pick) == null 
                    if RAbsBJ(DisByUnits(ds,FirstOfGroup(pick))*Sin((AngleByUnits(ds,FirstOfGroup(pick))/57.2956-a))) < 95+BlzGetUnitCollisionSize(FirstOfGroup(pick)) and Cos((AngleByUnits(ds,FirstOfGroup(pick))/57.2956-a)) > 0 then 
                        set damageFlag = 'S05E'
                        call enableAllElements()
                        set damageIsAOE = true 
                        set eventBonusLeech = extraLeech
                        if mustCrit then 
                            set damageAddCrit = 10000
                            set dmg = dmg*(1+crit)
                        endif 
                        call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",FirstOfGroup(pick),"chest"))
                    endif 
                    call GroupRemoveFirstUnit(pick)
                endloop
                if loopC >= 10 then 
                    call UnitRemoveAbility(ds,'S05E')
                    call UnitAddAbility(ds,'S05E')
                    call BlzStartUnitAbilityCooldown(ds,'S05E',remainingTime)
                    call State.checkAll(ds)
                    set de.DESTROY = true 
                    //call BJDebugMsg("END EVENT = "+I2S(de))
                    if HeroHaveTalent(ds,HERO_PRIVATE_TALENT,6) then 
                        set bf = CreateBuff(ds,ds,BUFFTYPE_DH_BLINDWRATH,1000)
                        set bf.bonusHaste = 2500
                        call bf.apply()
                    endif 
                endif 
            else 
                set de.DESTROY = true 
                    //call BJDebugMsg("END EVENT = "+I2S(de))
            endif 
            call de.saveInteger("LOOP",loopC)
            call DestroyGroup(pick)
            set pick = null 
            set ds = null 
        endfunction
        function S05E_CHECK takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local effect sfx = de.loadEffect("SFX")
            if alive(ds) == false or GetUnitCurrentOrder(ds) != ORDER_blizzard then 
                call DestroyEffectEX(sfx)
                set de.DESTROY = true 
                    //call BJDebugMsg("END EVENT = "+I2S(de))
            endif 
            set ds = null 
            set sfx = null 
        endfunction
        function SPELL_S05E takes nothing returns nothing   //眼棱
            local delayedevent de
            local delayedevent de2
            local integer haste
            local boolean mustCrit = false 
            local real extraLeech = 0
            local mybuff bf
            local integer period = 30
            local effect sfx = AddSpecialEffectEX("war3campImported\\EyeBeam_wide.mdx",GetUnitX(spellCaster),GetUnitY(spellCaster))
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,3) then 
                call DemonHunterTransformToDemon(spellCaster,800)
            endif 
            set haste = ST_HASTE.getTotalState(spellCaster)
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_DH_BLADEDANCE)
            if bf > 0 and bf.DESTROY == false then 
                set bf.DESTROY = true 
                set haste = haste+10000
                set mustCrit = true 
            endif 
            if GetUnitAbilityLevel(spellCaster,'S057') > 0 then 
                set extraLeech = extraLeech+0.25
            endif 
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            set de = delayedevent.create(period,10,function S05E_PERIOD)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveInteger("LOOP",0)
            call de.saveBoolean("CRIT",mustCrit)
            call de.saveReal("LEECH",extraLeech)
            set de2 = CreateDelayedEvent(1,1000,function S05E_CHECK)
            call de2.saveUnit("CASTER",spellCaster)
            call de2.saveEffect("SFX",sfx)
            call BlzSetUnitFacingEx(spellCaster,AngleByUnXY(spellCaster,spellTargetX,spellTargetY))
            call BlzSetSpecialEffectOrientation(sfx,AngleByUnXY(spellCaster,spellTargetX,spellTargetY)/57.2956,0,0)
            if heroDefaultForm[13] == FORM_DEMON_HUNTER_NORMAL then 
                call SetUnitAnimation(spellCaster,"stand ready")
                call BlzSetSpecialEffectHeightEX(sfx,75)
            elseif heroDefaultForm[13] == FORM_DEMON_HUNTER_DEMON then 
                call SetUnitAnimation(spellCaster,"stand channel")
                call BlzSetSpecialEffectHeightEX(sfx,100)
            endif 
            set sfx = null 
        endfunction
        function SPELL_READY_S05E takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0)
        endfunction
        function SPELL_STOP_S05E takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function SPELL_END_S05E takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction

        function A67Y_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local mybuff newbf = 0
            local real dmg = I2R(GetUnitMaxAttack(bf.buffSource,0))*0.2*mybuff.buffTimeScale
            local real finalDmg = dmg 
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(bf.buffSource),GetUnitY(bf.buffSource),250,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null
                set finalDmg = dmg
                if bf.boolData then 
                    set newbf = CreateBuff(bf.buffSource,FirstOfGroup(pick),BUFFTYPE_DH_STACKIMMOLATION,200)
                    set finalDmg = finalDmg*(1+newbf.realData)
                    set newbf.addTime = false 
                    set newbf.realData = RMinBJ(1,newbf.realData+0.1)
                    call newbf.apply()
                endif 
                set damageFlag = 'A67Y'
                set damageIsAOE = true 
                set damageIsDOT = true 
                set damageTag_Fire = true 
                call UnitDamageTarget(bf.buffSource,FirstOfGroup(pick),finalDmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function A67Y_DAMAGEING_TARGET takes nothing returns nothing
            if damageAttackType == ATTACK_TYPE_NORMAL then 
                set damageFinalDamage = damageFinalDamage*0.85
            endif 
        endfunction
        function SPELL_S05F takes nothing returns nothing   //献祭
            local mybuff newbf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_DH_IMMOLATION,1000)
            local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_DH_BLADEDANCE)
            set newbf.periodTime = 100
            set newbf.hasteAble = true 
            call newbf.addPeriod(function A67Y_PERIOD)
            if bf > 0 and bf.DESTROY == false then 
                set bf.DESTROY = true 
                set newbf.boolData = true
            else 
                set newbf.boolData = false 
            endif 
            if GetUnitAbilityLevel(spellCaster,'S057') > 0 then 
                call newbf.addDmging_T(function A67Y_DAMAGEING_TARGET)
            endif 
            call newbf.apply()
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,3) then 
                call DemonHunterTransformToDemon(spellCaster,300)
            endif 
        endfunction

        function S05G_MISSILE takes nothing returns nothing
            local real dmg = I2R(GetUnitAttack(waveCaster,0))*0.66
            if waveWave.DESTROY then 
                return 
            endif 
            if IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) then 
                if unitCheckCooldown(waveTarget,'SZ5G') then 
                    set damageFlag = 'SZ5G'
                    set eventBonusLeech = eventBonusLeech+0.66
                    call enableAllElements()
                    call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                    call unitStartCooldown(waveTarget,'SZ5G',66)
                    set waveWave.DESTROY = true 
                endif 
            endif 
        endfunction
        function S05G_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local projectile newProj = 0
            local real x = GetUnitX(proj.dummy)
            local real y = GetUnitY(proj.dummy)
            local mybuff newbf = 0
            local real dmg = I2R(GetUnitMaxAttack(proj.source,0))*1
            local group pick = CreateGroup()
            local integer i = 0
            local real a = GetUnitFacing(proj.dummy)/57.2956+0.5236
            call GroupEnumUnitsInRangeEx(pick,x,y,200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'S05G'
                set damageIsAOE = true 
                set damageTag_Fire = true 
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                if GetUnitAbilityLevel(proj.source,'S057') > 0 then 
                    call Taunt(proj.source,FirstOfGroup(pick))
                    call bufflist.listUnitBuffs(FirstOfGroup(pick),true,false,true)
                    call bufflist.dispelMultiBuffs(3)
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\InfernalStrike.mdx",x,y))
            if proj.boolData then 
                set newbf = CreateBuff(proj.source,proj.source,BUFFTYPE_DH_IMMOLATION,1000)
                set newbf.periodTime = 100
                set newbf.hasteAble = true 
                call newbf.addPeriod(function A67Y_PERIOD)
                set newbf.boolData = false 
                call newbf.apply()
            endif 
            set pick = null 
            if HeroHaveTalent(proj.source,HERO_PRIVATE_TALENT,3) then 
                call DemonHunterTransformToDemon(proj.source,400)
            endif 
            if HeroHaveTalent(proj.source,HERO_PRIVATE_TALENT,6) then 
                set i = 0
                loop
                    exitwhen i > 5
                    set a = a+1.0472
                    set newProj = CreateWave(proj.source,x+350*Cos(a),y+350*Sin(a),900,75,0,"Abilities\\Weapons\\DemonHunterMissile\\DemonHunterMissile.mdl",function S05G_MISSILE,null)
                    set newProj.flag = 'SZ5G'
                    call delayedLaunchMissile(newProj,10)
                    set i = i+1
                endloop
            endif 
        endfunction
        function SPELL_S05G takes nothing returns nothing   //地狱火冲撞
            local projectile proj = CreateProjectileToLoc(spellCaster,spellTargetX,spellTargetY,1000,0.25,"",null,function S05G_HIT)
            local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_DH_BLADEDANCE)
            if bf > 0 and bf.DESTROY == false then 
                set bf.DESTROY = true 
                set proj.boolData = true 
            else 
                set proj.boolData = false 
            endif 
            call proj.launchWithDummy(spellCaster,false)
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\Sweep_Unholy_Small.mdx",spellCaster,"hand left")
            set proj.bindSFX_1 = AddSpecialEffectTargetEX("war3campImported\\Sweep_Unholy_Small.mdx",spellCaster,"hand right")
            if heroNowForm[13] == FORM_DEMON_HUNTER_NORMAL then 
                call SetUnitAnimationByIndex(spellCaster,6)
            elseif heroNowForm[13] == FORM_DEMON_HUNTER_DEMON then 
                call SetUnitAnimationByIndex(spellCaster,4)
            endif 
        endfunction
        function SPELL_READY_S05G takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0)
        endfunction
        function SPELL_STOP_S05G takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction
        function SPELL_END_S05G takes nothing returns nothing
            call BlzSetUnitRealField(spellCaster,UNIT_RF_CAST_POINT,0.4)
        endfunction

        function SPELL_S05H takes nothing returns nothing   //恶魔形态
            call removeAllDisabilities(spellCaster)
            call bufflist.listUnitBuffs(spellCaster,false,true,true)
            call bufflist.dispelAllBuffs()
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,9) then 
                call DemonHunterTransformToDemon(spellCaster,3500)
            else 
                call DemonHunterTransformToDemon(spellCaster,2000)
            endif 
        endfunction
    // endregion 
    
    // region assassin 刺客
    ////////////////
    //HEROID = 5(6)
    ////////////////
        
        function HERO_6_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 5.4
            local real a 
            local real d 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B64X') > 0 then 
                call UnitRemoveAbility(dt,'B64X')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S03G'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set damageDamage = damageDamage*1.5
                if isBackStab(damageSource,damageTarget,60) then 
                    call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl",damageTarget,"origin"))
                    set damageAddCrit = damageAddCrit+0.1
                    if HeroHaveTalent(damageSource,HERO_PRIVATE_TALENT,8) then 
                        set damageDamage = damageDamage*2.5
                        set Qcd = Qcd+5.4
                        call HERO_6_ADD_PHANTOM_STRIKE.evaluate(damageSource)
                    endif 
                endif 
                set damageFlag = 'S03G'
                call BlzStartUnitAbilityCooldown(ds,'S03G',Qcd*haste-0.01)
            endif

            set ds = null 
            set dt = null 
        endfunction

        function SPELL_S03N takes nothing returns nothing
            local real dmg = 3*I2R(GetUnitAttack(spellCaster,0))
            set damageFlag = 'S03N'
            set damageAddCrit = 0.1
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodSorceress.mdl",spellTarget,"origin"))
            call applyStun(spellCaster,spellTarget,'ATB1')
        endfunction

        function A65A_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = 3*I2R(GetUnitAttack(spellCaster,0))/5*mybuff.buffTimeScale
            set damageIsDOT = true 
            set damageTag_Bleed = true 
            set damageFlag = 'A65A'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S03O takes nothing returns nothing
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_ASSASSIN_SLICE,1500)
            local real dmg = 1.5*I2R(GetUnitAttack(spellCaster,0))
            set bf.periodTime = 300
            set bf.hasteAble = true 
            call bf.addPeriod(function A65A_PERIOD)
            call bf.apply()
            set damageFlag = 'S03O'
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl",spellTarget,"origin"))
        endfunction
        
        function A65B_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = 2.5*I2R(GetUnitAttack(spellCaster,0))/5*mybuff.buffTimeScale
            set damageIsDOT = true 
            set damageTag_Posion = true 
            set damageTag_Earth = true 
            set damageFlag = 'A65B'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S03P takes nothing returns nothing
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_ASSASSIN_TOXICBLADE,1000)
            local real dmg = 2*I2R(GetUnitAttack(spellCaster,0))
            set bf.periodTime = 200
            set bf.hasteAble = true 
            set bf.bonusAttackSpeed = -1000
            set bf.bonusMoveSpeed_P = -1000
            call bf.addPeriod(function A65B_PERIOD)
            call bf.apply()
            set damageFlag = 'S03P'
            set damageTag_Earth = true 
            set damageTag_Posion = true 
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\PoisonArrow\\PoisonArrowMissile.mdl",spellTarget,"chest"))
            call bufflist.listUnitBuffs(spellTarget,true,false,false)
            call bufflist.dispelMultiBuffs(3)
        endfunction

        function SPELL_S03Q takes nothing returns nothing
            local integer i = 0
            local real maxD = 0
            local real a = GetUnitFacing(spellTarget)+180
            local real d = 100+BlzGetUnitCollisionSize(spellCaster)+BlzGetUnitCollisionSize(spellTarget)
            local real x = GetUnitX(spellTarget)
            local real y = GetUnitY(spellTarget)
            local boolean pathAble = false 
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_ASSASSIN_SHADOWSTALK,800)
            local real dmg = 3*I2R(GetUnitAttack(spellCaster,0))
            set bf.bonusArmor_P = -1500
            call bf.apply()
            call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",spellCaster,"hand left"),30)
            call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",spellCaster,"hand right"),30)
            loop
                exitwhen i >= 36
                if PathCheck(x+d*Cos(a/57.2956),y+d*Sin(a/57.2956)) then 
                    set pathAble = true 
                    exitwhen true 
                else 
                    set a = a+10
                endif 
            endloop
            if pathAble then 
                set x = x+d*Cos(a/57.2956)
                set y = y+d*Sin(a/57.2956) 
                set a = AngleByUnXY(spellCaster,x,y)/57.2956
                set maxD = DisByUnXY(spellCaster,x,y)
                loop
                    exitwhen maxD <= 0.5
                    set d = RMinBJ(maxD,16)
                    if PathCheck(GetUnitX(GetTriggerUnit())+d*Cos(a),GetUnitY(GetTriggerUnit())+d*Sin(a)) then 
                        call SetUnitX(spellCaster,GetUnitX(spellCaster)+d*Cos(a))
                        call SetUnitY(spellCaster,GetUnitY(spellCaster)+d*Sin(a))
                        set maxD = maxD-d
                    else 
                        set maxD = -1
                    endif 
                endloop
                call SetUnitFacingTimed(spellCaster,AngleByUnits(spellCaster,spellTarget),0)
            endif 
            set damageFlag = 'S03Q'
            set damageTag_Shadow = true 
            call UnitDamageTarget(spellCaster,spellTarget,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\OrbOfDeath\\OrbOfDeathMissile.mdl",spellTarget,"chest"))
        endfunction

        function SPELL_S03R takes nothing returns nothing
            local real ad = 0 
            local real dmg = 5.5*I2R(GetUnitAttack(spellCaster,0))
            if BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03N') > 0.01 or BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03O') > 0.01 then 
                set ad = ad+0.15
            endif 
            if BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03P') > 0.01 or BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03Q') > 0.01 then 
                set ad = ad+0.15
            endif 
            
            set damageFlag = 'S03R'
            set damageAddCrit = I2R(unitGetAllBonusStateValue(spellCaster,STATE_HASTE))/10000
            call UnitDamageTarget(spellCaster,spellTarget,dmg*(1+ad),false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_MEDIUM_SLICE)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodSorceress.mdl",spellTarget,"origin"))
            call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Orc\\Disenchant\\DisenchantSpecialArt.mdl",spellCaster,"weapon"),30)
            call applyStun(spellCaster,spellTarget,'ATB1')
        endfunction

        function SPELL_S03S takes nothing returns nothing
            local group pick = CreateGroup()
            local real haste = I2R(unitGetAllBonusStateValue(spellCaster,STATE_HASTE))/10000
            local real dmg = 4*I2R(GetUnitAttack(spellCaster,0))
            local real ad = 0
            if BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03N') > 0.01 or BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03O') > 0.01 then 
                set ad = ad+0.15
            endif 
            if BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03P') > 0.01 or BlzGetUnitAbilityCooldownRemaining(spellCaster,'S03Q') > 0.01 then 
                set ad = ad+0.15
            endif 

            call delayedDestroyEffect(AddSpecialEffectEX("Abilities\\Spells\\NightElf\\FanOfKnives\\FanOfKnivesCaster.mdl",GetUnitX(spellCaster),GetUnitY(spellCaster)),166)
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),425,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'S03S'
                set damageIsAOE = true 
                set damageAddCrit = damageAddCrit+ad
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg*(1+haste),false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        
        function BLOOD_INFUSION_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local real dmg = I2R(GetUnitAttack(ds,0))*2.7*(1+I2R(unitGetAllBonusStateValue(ds,STATE_CRIT))/10000)
            set damageFlag = 'S03V'
            set damageAddCrit = damageAddCrit+100
            set damageTag_Bleed = true 
            call UnitDamageTarget(ds,dt,dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",dt,"origin"))
            set ds = null 
            set dt = null 
        endfunction
        
        function A65G_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitAttack(bf.buffSource,0))*4/4*mybuff.buffTimeScale
            set damageFlag = 'A65G'
            set damageTag_Posion = true 
            set damageTag_Earth = true 
            set damageIsDOT = true 
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function TOXIN_INFUSION_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local mybuff bf = CreateBuff(ds,dt,BUFFTYPE_ASSASSIN_TOXINSTRIKE,800)
            set bf.periodTime = 200
            set bf.hasteAble = true 
            set bf.bonusAttackSpeed = -1500
            set bf.bonusMoveSpeed_P = -1500
            call bf.addPeriod(function A65G_DOT)
            call bf.apply()
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl",dt,"chest"))
            set ds = null 
            set dt = null 
        endfunction

        function SHADOW_INFUSION_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local real dmg = I2R(GetUnitAttack(ds,0))*2.5
            local mybuff bf
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),200,playerEnemy)
            if de.loadBoolean("MODE") == false then 
                if CountUnitsInGroup(pick) >= 5 then 
                    set dmg = dmg*5/I2R(CountUnitsInGroup(pick))
                endif 
                loop
                    exitwhen FirstOfGroup(pick) == null 
                    set bf = CreateBuff(ds,FirstOfGroup(pick),BUFFTYPE_ASSASSIN_SHADOWSTRIKE,1000)
                    set bf.bonusArmor_P = -1500
                    call bf.apply()
                    set damageFlag = 'S03T'
                    set damageIsAOE = true 
                    set damageTag_Shadow = true 
                    call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                    call GroupRemoveFirstUnit(pick)
                endloop
            else 
                if CountUnitsInGroup(pick) > 1 then 
                    set dmg = dmg*2
                endif 
                set bf = CreateBuff(ds,dt,BUFFTYPE_ASSASSIN_SHADOWSTRIKE,1000)
                set bf.bonusArmor_P = -1500
                call bf.apply()
                set damageFlag = 'S03T'
                set damageIsAOE = true 
                set damageTag_Shadow = true 
                call UnitDamageTarget(ds,dt,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            endif 
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Undead\\OrbOfDeath\\AnnihilationMissile.mdl",dt,"chest"))
            call DestroyGroup(pick)
            set pick = null 
            set ds = null 
            set dt = null 
        endfunction

        function INFUSION_PREDMG_S takes nothing returns nothing
            local mybuff si = mybuff.getUnitBuff(damageSource,BUFFTYPE_ASSASSIN_SHADOWINFUSION)
            local mybuff ti = mybuff.getUnitBuff(damageSource,BUFFTYPE_ASSASSIN_TOXININFUSION)
            local mybuff bi = mybuff.getUnitBuff(damageSource,BUFFTYPE_ASSASSIN_BLOODINFUSION)
            local delayedevent de
            if damageFlag == 'S03N' or damageFlag == 'S03O' or damageFlag == 'S03P' or damageFlag == 'S03Q' or damageFlag == 'S03R' or damageFlag == 'S03S' then
                if si > 0 then 
                    if RAbsBJ(si.realData-I2R(globalNowtime))>0.02 then 
                        set si.realData = I2R(globalNowtime)
                        set si.intData = si.intData-1
                        if si.intData <= 0 then 
                            set si.DESTROY = true 
                        endif 
                    endif 
                    set damageArmor = 0
                    set damageTag_Shadow = true 
                    set de = delayedevent.create(10,1,function SHADOW_INFUSION_DELAYED)
                    call de.saveUnit("CASTER",damageSource)
                    call de.saveUnit("TARGET",damageTarget)
                    call de.saveBoolean("MODE",damageIsAOE)
                endif 
                if ti > 0 then 
                    if RAbsBJ(ti.realData-I2R(globalNowtime))>0.02 then 
                        set ti.realData = I2R(globalNowtime)
                        set ti.boolData = false 
                        set ti.intData = ti.intData-1
                        if ti.intData <= 0 then 
                            set ti.DESTROY = true 
                        endif 
                    endif 
                    set damageTag_Earth = true 
                    set damageTag_Posion = true 
                    set de = delayedevent.create(10,1,function TOXIN_INFUSION_DELAYED)
                    call de.saveUnit("CASTER",damageSource)
                    call de.saveUnit("TARGET",damageTarget)
                endif 
                if bi > 0 then 
                    if RAbsBJ(bi.realData-I2R(globalNowtime))>0.02 then 
                        set bi.realData = I2R(globalNowtime)
                        set bi.boolData = false 
                        set bi.intData = bi.intData-1
                        if bi.intData <= 0 then 
                            set bi.DESTROY = true 
                        endif 
                    endif 
                    set damageTag_Bleed = true 
                    set damageAddCrit = damageAddCrit+I2R(unitGetAllBonusStateValue(damageSource,STATE_HASTE))/10000
                    set de = delayedevent.create(10,1,function BLOOD_INFUSION_DELAYED)
                    call de.saveUnit("CASTER",damageSource)
                    call de.saveUnit("TARGET",damageTarget)
                endif 
            endif 
        endfunction

        function SPELL_S03T takes nothing returns nothing
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_ASSASSIN_SHADOWINFUSION,30000)
            call bf.addPreDmg_S(function INFUSION_PREDMG_S)
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,11) then 
                set bf.intData = IMinBJ(4,bf.intData+2)
            else  
                set bf.intData = IMinBJ(2,bf.intData+1)
            endif 
            set bf.realData = 0
            call bf.apply()
        endfunction
        function SPELL_S03U takes nothing returns nothing
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_ASSASSIN_TOXININFUSION,30000)
            call bf.addPreDmg_S(function INFUSION_PREDMG_S)
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,11) then 
                set bf.intData = IMinBJ(4,bf.intData+2)
            else  
                set bf.intData = IMinBJ(2,bf.intData+1)
            endif 
            set bf.realData = 0
            call bf.apply()
        endfunction
        function SPELL_S03V takes nothing returns nothing
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_ASSASSIN_BLOODINFUSION,30000)
            call bf.addPreDmg_S(function INFUSION_PREDMG_S)
            if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,11) then 
                set bf.intData = IMinBJ(4,bf.intData+2)
            else  
                set bf.intData = IMinBJ(2,bf.intData+1)
            endif 
            set bf.realData = 0
            call bf.apply()
        endfunction
    // endregion

    // region ranger 游侠
    ////////////////
    //HEROID = 4(5)
    ////////////////
        function S015_HIT takes nothing returns nothing
            local projectile proj 
            local unit ds = projectile.currentProjectile.source
            local unit dt = projectile.currentProjectile.target
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Fire = true 
            set damageTag_Attack = true
            set damageFlag = 'S015'
            call UnitDamageTarget(ds,dt,I2R(GetUnitAttack(ds,0))*1.5,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            set ds = null 
            set dt = null 
        endfunction
        function S017_DOT takes nothing returns nothing
            local real dmg = mybuff.currentBuff.realData*I2R(mybuff.currentBuff.periodTime)/I2R(mybuff.currentBuff.remainingTime+mybuff.currentBuff.periodTime)
            set mybuff.currentBuff.realData = mybuff.currentBuff.realData-dmg
            set damageTag_Earth = true 
            set damageTag_Posion = true 
            set damageIsDOT = true 
            set damageFlag = 'A60S'
            call UnitDamageTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S017_HIT takes nothing returns nothing
            local projectile proj 
            local unit ds = projectile.currentProjectile.source
            local unit dt = projectile.currentProjectile.target
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Earth = true 
            set damageTag_Posion = true 
            set damageTag_Attack = true
            set damageFlag = 'S017'
            call UnitDamageTarget(ds,dt,I2R(GetUnitAttack(ds,0))*1,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            set ds = null 
            set dt = null 
        endfunction
        function HERO_5_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 6
            local real a 
            local real d 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B60T') > 0 then 
                call UnitRemoveAbility(dt,'B60T')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S015'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set attackingMissile.model_path = "Abilities\\Weapons\\SearingArrow\\SearingArrowMissile.mdl"  
                set attackingMissile.curve = 0.1
                set attackingMissile.flag = 'S015'
                set attackingMissile.speed = 1000
                call attackingMissile.addOnHit(function S015_HIT)
                set attackingMissile.tag_Fire = true 
                call BlzStartUnitAbilityCooldown(ds,'S015',Qcd*haste-0.01)
            endif 
            if GetUnitAbilityLevel(dt,'B60V') > 0 then 
                call UnitRemoveAbility(dt,'B60V')
                set attackingMissile.bonusAccuracy = attackingMissile.bonusAccuracy+0.1
                set attackingMissile.bonusCrit = attackingMissile.bonusCrit+0.1
                set attackingMissile.bonusCritPower = attackingMissile.bonusCritPower+0.2
            endif 

            set bf = mybuff.getUnitBuff(dt,BUFFTYPE_RANGER_HUNTERSMARK)
            if bf > 0 then 
                set a = AngleByUnits(ds,dt)
                set d = DisByUnits(ds,dt)
                set proj = projectile.create(ds)
                set proj.model_path = "war3campImported\\SpiritArrow_ByEpsilon.mdx"
                set proj.target = dt 
                set proj.flag = 'S01B'
                call proj.addOnHit(function AttackMissileHit)
                set proj.bonusAccuracy = 100
                set proj.speed = 1000
                set proj.curve = 0.15
                set proj.bezier_points = 1
                set proj.bezier_x0 = GetUnitX(ds)+0.577*d*Cos((a+30)/57.2958)
                set proj.bezier_y0 = GetUnitY(ds)+0.577*d*Sin((a+30)/57.2958)
                set proj.LAUNCH_UNIT = true 
                set proj.TARGET_UNIT = true 
                call proj.launch()
                call SetUnitScale(proj.dummy,0.7,0.7,0.7)
                set proj = projectile.create(ds)
                set proj.model_path = "war3campImported\\SpiritArrow_ByEpsilon.mdx"
                set proj.target = dt 
                set proj.flag = 'S01B'
                call proj.addOnHit(function AttackMissileHit)
                set proj.bonusAccuracy = 100
                set proj.speed = 1000
                set proj.curve = 0.15
                set proj.bezier_points = 1
                set proj.bezier_x0 = GetUnitX(ds)+0.577*d*Cos((a-30)/57.2958)
                set proj.bezier_y0 = GetUnitY(ds)+0.577*d*Sin((a-30)/57.2958)
                set proj.LAUNCH_UNIT = true 
                set proj.TARGET_UNIT = true 
                call proj.launch()
                call SetUnitScale(proj.dummy,0.7,0.7,0.7)
            endif 

            set ds = null 
            set dt = null 
        endfunction
        function HERO_5_MISSILE_LAUNCH takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real chance = 0.25
            if HeroHaveTalent(proj.source,HERO_PRIVATE_TALENT,3) then 
                set chance = chance+0.15
            endif 
            if proj.flag == 'Aatk' and GetUnitAbilityLevel(proj.source,'S017') > 0 and random.get(proj.source,chance,'S017') then 
                set proj.model_path = "war3campImported\\Arrow of Pestilence.mdx"  
                set proj.curve = 0
                set proj.speed = 1200
                set proj.flag = 'S017'
                call proj.addOnHit(function S017_HIT)  
                set proj.tag_Earth = true 
            endif 
        endfunction
        function HERO_5_ATTACKED_SOURCE takes nothing returns nothing
            local mybuff bf
            if damageFlag == 'S017' then 
                set bf = mybuff.create(damageSource,damageTarget,BUFFTYPE_RANGER_TOXINSHOT)
                set bf.lastTime = 1200
                set bf.periodTime = 200
                call bf.addPeriod(function S017_DOT)
                set bf.realData = bf.realData+I2R(GetUnitAttack(damageSource,0))*1.5
                set bf.hasteAble = false 
                call bf.apply()
            endif 
            if damageFlag == 'S01B' then 
                set damageAttackType = ATTACK_TYPE_NORMAL
                set damageDamageType = DAMAGE_TYPE_MAGIC
            endif 
        endfunction
        function S016_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))*3.5*proj.realData
            call proj.applyDamageSet()
            set damageTag_Lightning = true 
            set damageFlag = 'S016'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",proj.target,"origin"))
            if HeroHaveTalent(proj.source,HERO_PRIVATE_TALENT,8) then 
                call applySilence(proj.source,proj.target,'ASI1')
            endif 
        endfunction
        function SPELL_S016 takes nothing returns nothing   //雷鸣箭
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1500,0,"war3campImported\\LightningArrow1.mdx",function S016_HIT,null)
            set proj.flag = 'S016'
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,8) then 
                set proj.maxBounceLimit = 4
                set proj.realData = 1.25
            else 
                set proj.bounceMultiplier = 0.5
                set proj.maxBounceLimit = 2
                set proj.realData = 1
            endif 
            set proj.bounceRange = 450
            set proj.tag_Lightning = true 
            call proj.launch()
        endfunction

        function S01D_HIT takes nothing returns nothing
            local real dmg = I2R(GetUnitAttack(projectile.currentProjectile.source,0))*1
            call projectile.currentProjectile.applyDamageSet()
            set damageFlag = 'S01D'
            set damageIsAOE = true 
            set damageTag_Attack = true 
            call UnitDamageTarget(projectile.currentProjectile.source,projectile.currentProjectile.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S01D_DELAYED takes nothing returns nothing 
            local delayedevent de = delayedevent.currentEvent
            local projectile proj = 0
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local group pickB = CreateGroup()
            local integer i = 0
            local unit tar = null 
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(caster),GetUnitY(caster),550,playerEnemy)
            call GroupEnumUnitsInRangeEx(pickB,GetUnitX(caster),GetUnitY(caster),900,playerEnemyCombat)
            call GroupAddGroup(pickB,pick)
            loop
                exitwhen FirstOfGroup(pick) == null or i > 2
                set tar = GroupPickRandomUnitEx(pick)
                set proj = CreateProjectileToUnit(caster,tar,1000,0,"Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl",function S01D_HIT,null)
                set proj.flag = 'S01D'
                call proj.launch()
                call GroupRemoveUnit(pick,tar)
                set i = i+1
            endloop
            call DestroyGroup(pick)
            call DestroyGroup(pickB)
            set pick = null
            set pickB = null  
            set tar = null 
        endfunction 
        function SPELL_S01D takes nothing returns nothing   //多重射击
            local delayedevent de = CreateDelayedEvent(1,1,function S01D_DELAYED)
            local integer count = 2
            call de.saveUnit("CASTER",spellCaster)
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,3) then 
                set count = count+1
            endif 
            set de = CreateDelayedEvent(20,count,function S01D_DELAYED)
            call de.saveUnit("CASTER",spellCaster)
        endfunction 
        
        function S018_HIT takes nothing returns nothing
            local real dmg = I2R(GetUnitAttack(projectile.currentProjectile.source,0))*3.5
            call projectile.currentProjectile.applyDamageSet()
            set damageTag_Arcane = true 
            set damageFlag = 'S018'
            call UnitDamageTarget(projectile.currentProjectile.source,projectile.currentProjectile.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\arcane_missile_lvl4.mdx",projectile.currentProjectile.target,"chest"))
            call bufflist.listUnitBuffs(projectile.currentProjectile.target,true,false,true)
            call bufflist.dispelMultiBuffs(3)
        endfunction
        function SPELL_S018 takes nothing returns nothing   //奥术射击
            local projectile proj 
            set proj = projectile.create(spellCaster)
            set proj.model_path = "war3campImported\\ArcaneArrow.mdx"
            set proj.speed = 1300
            set proj.curve = 0
            set proj.target = spellTarget 
            set proj.tag_Arcane = true 
            set proj.flag = 'S018'
            set proj.TARGET_UNIT = true 
            set proj.LAUNCH_UNIT = true 
            call proj.addOnHit(function S018_HIT)
