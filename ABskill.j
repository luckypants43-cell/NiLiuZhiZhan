        function S01M_SUMMON takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local projectile proj 
            local real x1 = de.loadReal("X1")
            local real y1 = de.loadReal("Y1")
            local real x2 = de.loadReal("X2")
            local real y2 = de.loadReal("Y2")
            local unit caster = de.loadUnit("CASTER")
            local unit target = de.loadUnit("TARGET")
            local minion mini
            local real a1 = AngleByXYnU(x1,y1,target)
            local real a2 = AngleByXYnU(x2,y2,target)
            call DestroyEffectEX(de.loadEffect("GATE_1"))
            call DestroyEffectEX(de.loadEffect("GATE_2"))
            set mini = minion.createWithFace(caster,'nS0A',x1,y1,a1)
            if HeroHaveTalent(caster,HERO_PRIVATE_TALENT,6) then
                call UnitApplyTimedLife(mini.summon,'BTLF',15.6)
            else 
                call UnitApplyTimedLife(mini.summon,'BTLF',12)
            endif 
            call unitCheckState.evaluate(mini.summon)
            if target != null and alive(target) then 
                set mini.lastOrderTime = -65535
                call PauseUnit(mini.summon,true)
                set proj = projectile.create(mini.summon)
                set proj.LAUNCH_UNIT = true 
                set proj.TARGET_UNIT = true 
                set proj.target = target 
                set proj.speed = 1100
                set proj.curve = 0.15
                set proj.start_z = 75
                set proj.realData = I2R(unitGetAllBonusStateValue(caster,STATE_ABILITY_POWER))*1.2
                set proj.intData = mini
                call proj.addOnHit(function S01M_HIT)
                call proj.addOnEnd(function S01M_DEATH)
                call proj.launchWithDummy(mini.summon,false)
                set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\Windwalk Necro Soul.mdx",mini.summon,"origin")
            endif 
            set mini = minion.createWithFace(caster,'nS0A',x2,y2,a2)
            if HeroHaveTalent(caster,HERO_PRIVATE_TALENT,6) then
                call UnitApplyTimedLife(mini.summon,'BTLF',15.6)
            else 
                call UnitApplyTimedLife(mini.summon,'BTLF',12)
            endif 
            call unitCheckState.evaluate(mini.summon)
            if target != null and alive(target) then 
                set mini.lastOrderTime = -65535
                call PauseUnit(mini.summon,true)
                set proj = projectile.create(mini.summon)
                set proj.LAUNCH_UNIT = true 
                set proj.TARGET_UNIT = true 
                set proj.target = target 
                set proj.speed = 1200
                set proj.curve = 0.15
                set proj.start_z = 75
                set proj.realData = I2R(unitGetAllBonusStateValue(caster,STATE_ABILITY_POWER))*2
                set proj.intData = mini
                call proj.addOnHit(function S01M_HIT)
                call proj.addOnEnd(function S01M_DEATH)
                call proj.launchWithDummy(mini.summon,false)
                set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\Windwalk Necro Soul.mdx",mini.summon,"origin")
            endif 
            set caster = null 
            set target = null 
        endfunction
        function SPELL_S01M takes nothing returns nothing   //恐惧猎犬
            local delayedevent de = delayedevent.create(100,1,function S01M_SUMMON)
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real d = 100
            local real a = GetUnitFacing(spellCaster)/57.2956
            local real x1 = x+d*Cos(a+1.5708)
            local real y1 = y+d*Sin(a+1.5708)
            local real x2 = x+d*Cos(a-1.5708)
            local real y2 = y+d*Sin(a-1.5708)
            set master.create(spellCaster).lastTarget = spellTarget
            call de.saveUnit("CASTER",spellCaster)
            call de.saveUnit("TARGET",spellTarget)
            call de.saveEffect("GATE_1",AddSpecialEffectEX("war3campImported\\csm.mdl",x1,y1))
            call de.saveEffect("GATE_2",AddSpecialEffectEX("war3campImported\\csm.mdl",x2,y2))
            call de.saveReal("X1",x1)
            call de.saveReal("Y1",y1)
            call de.saveReal("X2",x2)
            call de.saveReal("Y2",y2)
        endfunction
        function nS0B_SUMMON_IMP takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local minion mini
            local real a 
            local real x = de.loadReal("X1")
            local real y = de.loadReal("Y1")
            local real face = de.loadReal("FACE")
            local unit caster = de.loadUnit("CASTER")
            local integer i = 0
            loop 
                exitwhen i > 2
                set a = -0.5236+0.5236*I2R(i)+face/57.2956
                set mini = minion.createWithFace(caster,'nS09',x,y,face)
                if HeroHaveTalent(caster,HERO_PRIVATE_TALENT,6) then
                    call UnitApplyTimedLife(mini.summon,'BTLF',10.4)
                else 
                    call UnitApplyTimedLife(mini.summon,'BTLF',8)
                endif 
                call unitCheckState.evaluate(mini.summon)
                call IssuePointOrderById(mini.summon,ORDER_AImove,x+150*Cos(a),y+150*Sin(a))
                set mini.lastOrderTime = globalNowtime
                set i = i+1
            endloop 
            call DestroyEffectEX(de.loadEffect("GATE"))
            set caster = null 
        endfunction
        function SPELL_A61M takes nothing returns nothing
            local unit target = null 
            local integer i = 0
            local projectile proj = 0
            local delayedevent de 
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real d = 100
            local real a = GetUnitFacing(spellCaster)/57.2956
            local real add = GetRandomReal(-1.5708,1.5708)
            local real x1 = x+d*Cos(a+add)
            local real y1 = y+d*Sin(a+add)
            if (minion.getMinionByUnit(spellCaster).currentTarget != null and alive(minion.getMinionByUnit(spellCaster).currentTarget)) or (minion.getMinionByUnit(spellCaster).mast.lastTarget != null and alive(minion.getMinionByUnit(spellCaster).mast.lastTarget)) then 
                set target = minion.getMinionByUnit(spellCaster).currentTarget
                if target == null or alive(target) == false then 
                    set target = minion.getMinionByUnit(spellCaster).mast.lastTarget
                endif 
                set proj = projectile.create(spellCaster)
                set proj.model_path = "war3campImported\\decimate_missile_Low.mdx"
                set proj.realData = 1
                set proj.speed = 420
                set proj.curve = 0
                set proj.target = target
                set proj.TARGET_UNIT = true 
                set proj.LAUNCH_UNIT = true 
                call proj.addOnHit(function S013_HIT)
                set proj.flag = 'S013'
                call proj.launch()
                set de = delayedevent.create(100,1,function nS0B_SUMMON_IMP)
                call de.saveUnit("CASTER",minion.getMinionByUnit(spellCaster).mast.masterUnit)
                call de.saveReal("X1",x1)
                call de.saveReal("Y1",y1)
                call de.saveReal("FACE",GetUnitFacing(spellCaster))
                call de.saveEffect("GATE",AddSpecialEffectEX("war3campImported\\csm.mdx",x1,y1))
            else 
                call AddUnitMana(spellCaster,100)
            endif 
            set target = null 
        endfunction
