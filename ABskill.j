    function PUBLIC_TALENT_MISSILE_LAUNCH_7 takes nothing returns nothing
        local projectile proj = projectile.currentProjectile
        if proj.currentBounceCount == 0 and proj.TARGET_UNIT then 
            set proj.maxBounceLimit = proj.maxBounceLimit+1
            set proj.bounceMultiplier = RMinBJ(proj.bounceMultiplier,1)
            set proj.bounceRange = RMaxBJ(proj.bounceRange,350)
        endif 
    endfunction

