            call DestroyEffectEX(AddSpecialEffectEX("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",x,y))
            call unitAddState(mini.summon,STATE_RESISTANCE,10000)
            call unitCheckState.evaluate(mini.summon)
            call UnitApplyTimedLife(mini.summon,'BTLF',10.02)
            set mini.bindSFX = AddSpecialEffectTargetEX("war3campImported\\SeaAura.mdx",mini.summon,"origin")
            set bf = CreateBuff(spellCaster,mini.summon,BUFFTYPE_SHAMAN_TOTEMOFHEALINGTIDE,1000) 
            set bf.periodTime = 100
            set bf.hasteAble = true 
            call bf.addPeriod(function S03H_PERIOD)
            call bf.apply()
        endfunction

        function CHECK_STATE_nS0M takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local real haste = 1
            local real Qcd = 4
            if unitGetBonusState(owner.masterUnit,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_HASTE)))/10000
            endif 
            call BlzSetUnitAbilityCooldown(checkingUnit,'A669',0,Qcd*haste)
        endfunction
        function A669_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(minion.getMinionByUnit(proj.source).mast.masterUnit))*0.75*proj.realData
            call proj.applyDamageSet()
            set damageTag_Lightning = true 
            set damageFlag = 'A669'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_A669 takes nothing returns nothing
            local group pick = CreateGroup()
            local unit target = null 
            local projectile proj = 0
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),550,playerEnemy)
            set target = GroupPickRandomUnitEx(pick)
            if target != null then 
                set proj = CreateProjectileToUnit(spellCaster,target,1200,0,"war3campImported\\Lightning_Fury_Missile_Blue.mdx",function A669_HIT,null)
                set proj.flag = 'A669'
                set proj.tag_Lightning = true 
                if HeroHaveTalent(minion.getMinionByUnit(spellCaster).mast.masterUnit,HERO_PRIVATE_TALENT,6) then 
                    set proj.realData = 0.75
                else 
                    set proj.realData = 1
                endif   
                call proj.launch()
                call SetUnitScale(proj.dummy,0.55,0.55,0.55)
            endif 
            call DestroyGroup(pick)
            if DisByUnits(spellCaster,minion.getMinionByUnit(spellCaster).mast.masterUnit) <= 550 then 
                call ShamanGainLightningEnchantment(minion.getMinionByUnit(spellCaster).mast.masterUnit,1)
            endif 
            set pick = null 
            set target = null 
        endfunction
        function S03W_AURA_SET takes nothing returns nothing
            set aura.modifingAuraBuff.bonusAttackSpeed = 1000
        endfunction
        function SPELL_S03W takes nothing returns nothing    //电涌图腾
            local aura ar = 0
            local minion mini 
            local group pick = CreateGroup()
            local integer count = 0
            local integer maxcount = 1
            local real x = spellTargetX
            local real y = spellTargetY
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                set maxcount = maxcount+1
            endif 
            call GroupAddGroup(master.create(spellCaster).minions,pick)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if GetUnitTypeId(FirstOfGroup(pick)) == 'nS0M' and minion.getMinionByUnit(FirstOfGroup(pick)) != 0 then 
                    set count = count+1
                    if count > maxcount-1 then
                        set minion.getMinionByUnit(FirstOfGroup(pick)).DESTROY = true
                    endif 
                endif 
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            set mini = minion.createWithFace(spellCaster,'nS0M',x,y,270)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",x,y))
            call unitAddState(mini.summon,STATE_RESISTANCE,10000)
            call unitCheckState.evaluate(mini.summon)
            call UnitApplyTimedLife(mini.summon,'BTLF',60)
            set mini.bindSFX = AddSpecialEffectTargetEX("war3campImported\\OrbOfLightning.mdx",mini.summon,"origin")
            set mini.lastOrderTime = -65535
            set ar = CreateAura(mini.summon,"AURA_SHAMAN_LIGHTNING_SURGE",550,0,BUFFTYPE_SHAMAN_LIGHTNINGSURGE,"")
            call ar.addAllySet(function S03W_AURA_SET)
            call DestroyGroup(pick)
            set pick = null 
        endfunction

        function S03X_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = 3*I2R(ST_ABILITY_POWER.getTotalState(proj.source))*proj.realData
            call proj.applyDamageSet()
            set damageTag_Fire = true 
            set damageFlag = 'S03X'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call ShamanApplyFireShock(proj.source,proj.target,R2I(5*proj.realData+0.5))
            call applyStun(proj.source,proj.target,'ATB0')
        endfunction
        function S03X_DELAYED_LAUNCH takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local projectile proj = de.loadInteger("MISSILE")
            call proj.launch()
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl",proj.dummy,"chest")
        endfunction
        function SPELL_S03X takes nothing returns nothing   //熔岩爆裂
            local delayedevent de = 0
            local integer delay = 20
            local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_SHAMAN_LAVACHARGE)
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1000,0.05,"Abilities\\Spells\\Other\\Volcano\\VolcanoMissile.mdl",function S03X_HIT,null)
            set proj.flag = 'S03X'
            set proj.tag_Fire = true 
            set proj.realData = 1
            call proj.launch()
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl",proj.dummy,"chest")

            if bf != 0 then 
                if bf.intData >= 10 then 
                    loop
                        exitwhen bf.intData < 10
                        set proj = CreateProjectileToUnit(spellCaster,spellTarget,1000,0.05,"Abilities\\Spells\\Other\\Volcano\\VolcanoMissile.mdl",function S03X_HIT,null)
                        set proj.flag = 'S03X'
                        set proj.tag_Fire = true  
                        set proj.realData = 0.5
                        set de = CreateDelayedEvent(delay,1,function S03X_DELAYED_LAUNCH)
                        call de.saveInteger("MISSILE",proj)
                        set delay = delay+20
                        set bf.intData = bf.intData-10
                    endloop
                endif 
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif 
            endif 
        endfunction

        function S03Y_LIGHTNING_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(proj.source))*1
            call proj.applyDamageSet()
            set damageTag_Lightning = true 
            set damageFlag = 'S03Y'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",proj.target,"origin"))
            call UnitsAddLightningSFX(proj.bounce_lastTarget,0,0,50,proj.target,0,0,50,"FORK",1.5,0.75,true)
        endfunction
        function S03Y_DELAYED takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,de.loadReal("X"),de.loadReal("Y"),250,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Fire = true 
                set damageFlag = 'S03Y'
                set damageIsAOE = true 
                call UnitDamageTarget(de.loadUnit("CASTER"),FirstOfGroup(pick),de.loadReal("DAMAGE"),false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call delayedDestroyEffect(AddSpecialEffectEX("war3campImported\\Lava Crack.mdx",de.loadReal("X"),de.loadReal("Y")),50)
        endfunction
        function SPELL_S03Y takes nothing returns nothing   //元素浩劫
            local delayedevent de = 0
            local projectile proj = 0
            local mybuff bf       = 0
            local integer fireCount = 0
            local group pick = CreateGroup()
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*2.5
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_SHAMAN_LIGHTNINGENCHANTMENT)
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,250,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Earth = true 
                set damageFlag = 'S03Y'
                set damageIsAOE = true 
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applyRoot(spellCaster,FirstOfGroup(pick),'AET1')
                if bf != 0 then 
                    if bf.intData > 0 then 
                        call ShamanDecreaseLightningEnchantmentValue(spellCaster,1)
                        set proj = CreateProjectileToUnit(spellCaster,FirstOfGroup(pick),2000,0,"Abilities\\Spells\\Orc\\LightningBolt\\LightningBoltMissile.mdl",function S03Y_LIGHTNING_HIT,null)
                        set proj.flag = 'S03Y'
                        set proj.tag_Lightning = true 
                        call proj.launch()
                    endif 
                endif
                if mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_SHAMAN_FIRESHOCK) > 0 then 
                    if mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_SHAMAN_FIRESHOCK).intData > 0 then 
                        set fireCount = fireCount+mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_SHAMAN_FIRESHOCK).intData
                        call ShamanDecreaseFireShock(FirstOfGroup(pick),mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_SHAMAN_FIRESHOCK).intData)
                    endif 
                endif 
                call GroupRemoveFirstUnit(pick) 
            endloop
            if fireCount > 0 then 
                set de = delayedevent.create(25,1,function S03Y_DELAYED)
                call de.saveUnit("CASTER",spellCaster)
                call de.saveReal("X",spellTargetX)
                call de.saveReal("Y",spellTargetY)
                call de.saveReal("DAMAGE",I2R(fireCount)*0.25*I2R(ST_ABILITY_POWER.getTotalState(spellCaster)))
            endif 
            set bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_SHAMAN_WATERENCHANTMENT)
            if bf > 0 then 
                if bf.intData > 0 then 
                    set dmg = 0.5*I2R(bf.intData)*I2R(ST_ABILITY_POWER.getTotalState(spellCaster))
                    call GroupClear(pick)
                    call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,250,playerAlly)
                    loop
                        exitwhen FirstOfGroup(pick) == null 
                        set healFlag = 'S03Y'
                        set healIsAOE = true 
                        call UnitHealTarget(spellCaster,FirstOfGroup(pick),dmg)
                        call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl",FirstOfGroup(pick),"chest"))
                        call GroupRemoveFirstUnit(pick)
                    endloop
                    call ShamanDecreaseWaterEnchantment(spellCaster,bf.intData)
                    call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\riptide09.mdx",spellTargetX,spellTargetY))
                endif 
            endif 
            call DestroyGroup(pick)
            set pick = null 
            call delayedDestroyEffect(AddSpecialEffectEX("war3campImported\\Quick Sand.mdx",spellTargetX,spellTargetY),70)
            call delayedDestroyEffect(AddSpecialEffectEX("Abilities\\SpellsOrc\\EarthQuake\\EarthQuakeTarget.mdl",spellTargetX,spellTargetY),100)
        endfunction

        
        function CHECK_STATE_nS0N takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local real haste = 1
            local real Qcd = 2
            if unitGetBonusState(owner.masterUnit,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_HASTE)))/10000
            endif 
            call BlzSetUnitAbilityCooldown(checkingUnit,'A66C',0,Qcd*haste)
        endfunction
        function SPELL_A66C takes nothing returns nothing
            local real dmg = 0.6*I2R(ST_ABILITY_POWER.getTotalState(minion.getMinionByUnit(spellCaster).mast.masterUnit))
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),230,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null
                set damageTag_Fire = true 
                set damageIsAOE = true 
                set damageFlag = 'A66C'
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\ImmolationRed\\ImmolationRedDamage.mdl",FirstOfGroup(pick),"chest"),100)
                if random.get(FirstOfGroup(pick),0.3,'A66C') then 
                    call ShamanApplyFireShock(minion.getMinionByUnit(spellCaster).mast.masterUnit,FirstOfGroup(pick),1)
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S03Z takes nothing returns nothing    //献祭图腾
            local aura ar = 0
            local minion mini 
            local real x = spellTargetX
            local real y = spellTargetY
            set mini = minion.createWithFace(spellCaster,'nS0N',x,y,270)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl",x,y))
            call unitAddState(mini.summon,STATE_RESISTANCE,10000)
            call unitCheckState.evaluate(mini.summon)
            call UnitApplyTimedLife(mini.summon,'BTLF',15)
            set mini.lastOrderTime = -65535
        endfunction

        function S040_HIT takes nothing returns nothing
            local real dmg = 4.5*I2R(ST_ABILITY_POWER.getTotalState(waveCaster))
            local real heal = 2.5*I2R(ST_ABILITY_POWER.getTotalState(waveCaster))
            if IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) then 
                set damageTag_Cold = true 
                set damageIsAOE = true 
                set damageFlag = 'S040'
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl",waveTarget,"chest"))
            endif 
            if IsUnitAlly(waveTarget,GetOwningPlayer(waveCaster)) then 
                set healIsAOE = true 
                set healFlag = 'S040'
                call UnitHealTarget(waveCaster,waveTarget,heal)
                call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\VampiricAuraTargetBlue.mdx",waveTarget,"origin"))
            endif 
        endfunction
        function SPELL_S040 takes nothing returns nothing   //潮汐
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local real a = AngleByUnXY(spellCaster,spellTargetX,spellTargetY)/57.2956
            local projectile proj = CreateWave(spellCaster,x+700*Cos(a),y+700*Sin(a),1000,125,178.57,"Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveMissile.mdl",function S040_HIT,null)
            call proj.launch()
            call ShamanGainWaterEnchantment(spellCaster,2)
        endfunction

        function CHECK_STATE_nS0O takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local real haste = 1
            local real Qcd = 4
            local integer miniBonusLife = 50*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)*2/5
            call BlzSetUnitBaseDamage(checkingUnit,3*GetUnitLevel(owner.masterUnit)/7+2+R2I(I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_ABILITY_POWER))*0.5),0)
            call BlzSetUnitArmor(checkingUnit,4+3*GetUnitLevel(owner.masterUnit)/4)
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
            if unitGetBonusState(owner.masterUnit,STATE_HASTE) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_HASTE)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(owner.masterUnit,STATE_HASTE)))/10000
            endif 
            call BlzSetUnitAbilityCooldown(checkingUnit,'A66D',0,Qcd*haste)
        endfunction
        function UNIT_nS0O_ATTACKING takes nothing returns nothing
            set damageTag_Attack = false 
            set damageDamageType = DAMAGE_TYPE_MAGIC
            set damageAttackType = ATTACK_TYPE_NORMAL
            set damageTag_Fire = true 
        endfunction
        function A66D_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = 2*I2R(GetUnitMaxAttack(proj.source,0))
            call proj.applyDamageSet()
            set damageTag_Fire = true 
            set damageFlag = 'A66D'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_A66D takes nothing returns nothing
            local projectile proj = 0
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),600,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null
                if mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_SHAMAN_FIRESHOCK) > 0 then 
                    set proj = CreateProjectileToUnit(spellCaster,FirstOfGroup(pick),1000,0,"war3campImported\\Firebolt Rough Minor.mdl",function A66D_HIT,null)
                    set proj.tag_Fire = true 
                    set proj.flag = 'A66D'
                    call proj.launch()
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S041 takes nothing returns nothing   //火元素
            local aura ar = 0
            local minion mini 
            local real x = spellTargetX
            local real y = spellTargetY
            set mini = minion.createWithFace(spellCaster,'nS0O',x,y,AngleByUnXY(spellCaster,x,y))
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl",x,y))
            call unitAddState(mini.summon,STATE_RESISTANCE,10000)
            call unitCheckState.evaluate(mini.summon)
            call UnitApplyTimedLife(mini.summon,'BTLF',30)
            call delayedPauseUnit(mini.summon,130)
            call delayedPlayAnimation(mini.summon,"birth",150)
        endfunction

        function SPELL_S042 takes nothing returns nothing   //嗜血术
            local mybuff bf = 0
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),900,playerAlly)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_SHAMAN_BLOODLUST,1500)
                if HeroHaveTalent(spellCaster,HERO_ULTIMATE_TALENT,10) and FirstOfGroup(pick) == spellCaster then 
                    set bf.lastTime = 3000
                endif 
                set bf.bonusHaste = 3000
                set bf.bonusMoveSpeed_P = 3000
                call bf.apply()
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction

        function S043_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real x = GetUnitX(bf.buffTarget)
            local real y = GetUnitY(bf.buffTarget)
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(bf.buffTarget))*1.25*mybuff.buffTimeScale
            local group pick = CreateGroup()
            local group pickA = CreateGroup()
            call GroupEnumUnitsInRangeEx(pickA,x,y,900,playerEnemyCombat)
            call GroupEnumUnitsInRangeEx(pick,x,y,550,playerEnemy)
            call GroupAddGroup(pickA,pick)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Lightning = true 
                set damageIsAOE = true 
                set damageFlag = 'S043'
                call UnitDamageTarget(bf.buffTarget,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",FirstOfGroup(pick),"origin"))
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyGroup(pickA)
            set pickA = null 
        endfunction
        function SPELL_S043 takes nothing returns nothing   //浩劫
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_SHAMAN_TEMPEST,1500)
            set bf.periodTime = 300
            set bf.hasteAble = true 
            call bf.addPeriod(function S043_PERIOD)
            call bf.apply()
        endfunction

        function A66G_DAMAGING_TARGET takes nothing returns nothing
            if damageSource == damageTarget then 
                return 
            endif 
            set damageFinalDamage = damageFinalDamage*0.9
        endfunction
        function S044_ADD_BUFF takes nothing returns nothing
            local mybuff bf = 0
            local delayedevent de = delayedevent.currentEvent
            local unit caster = de.loadUnit("CASTER")
            local integer count = de.loadInteger("COUNT")
            local master ma = minion.getMinionByUnit(caster)
            local real totalMaxLife = 0
            local real totalNowLife = 0
            local group pick = CreateGroup()
            if caster != null and alive(caster) then 
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(caster),GetUnitY(caster),400,playerHero)
                loop
                    exitwhen FirstOfGroup(pick) == null 
                    set bf = CreateBuff(ma.masterUnit,FirstOfGroup(pick),BUFFTYPE_SHAMAN_SOULLINK,11)
                    call bf.addDmging_T(function A66G_DAMAGING_TARGET)
                    call bf.apply()
                    set totalMaxLife = totalMaxLife+GetUnitState(FirstOfGroup(pick),UNIT_STATE_MAX_LIFE)
                    set totalNowLife = totalNowLife+GetUnitState(FirstOfGroup(pick),UNIT_STATE_LIFE)
                    call GroupRemoveFirstUnit(pick)
                endloop
                if ModuloInteger(count,10) == 0 then 
                    set totalNowLife = totalNowLife/RMaxBJ(totalMaxLife,1)
                    call GroupClear(pick)
                    call GroupEnumUnitsInRangeEx(pick,GetUnitX(caster),GetUnitY(caster),400,playerHero)
                    loop
                        exitwhen FirstOfGroup(pick) == null 
                        call SetUnitState(FirstOfGroup(pick),UNIT_STATE_LIFE,totalNowLife*GetUnitState(FirstOfGroup(pick),UNIT_STATE_MAX_LIFE))
                        call UnitsAddLightningSFX(caster,0,0,30,FirstOfGroup(pick),0,0,50,"SPBM",0.5,0.25,true)
                        call GroupRemoveFirstUnit(pick)
                    endloop
                endif 
            else 
                set de.DESTROY = true 
            endif 
            call DestroyGroup(pick)
            set count = count+1
            call de.saveInteger("COUNT",count)
            set pick = null 
            set caster = null 
        endfunction
        function SPELL_S044 takes nothing returns nothing   //灵魂链接图腾
            local delayedevent de = 0
            local minion mini 
            local real x = spellTargetX
            local real y = spellTargetY
            set mini = minion.createWithFace(spellCaster,'nS0I',x,y,270)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Undead\\Possession\\PossessionMissile.mdl",x,y))
            call unitAddState(mini.summon,STATE_RESISTANCE,10000)
            call unitCheckState.evaluate(mini.summon)
            call UnitApplyTimedLife(mini.summon,'BTLF',10.02)
            set mini.bindSFX = AddSpecialEffectTargetEX("war3campImported\\Soul Armor Necro_opt.mdx",mini.summon,"origin")
            set mini.lastOrderTime = -65535
            set de = CreateDelayedEvent(10,101,function S044_ADD_BUFF)
            call de.saveUnit("CASTER",mini.summon)
            call de.saveInteger("COUNT",0)
            call CreateOrbit(mini.summon,400,6.28,2,'nO00')
        endfunction

        function S04P_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = 3*I2R(ST_ABILITY_POWER.getTotalState(proj.source))
            call proj.applyDamageSet()
            set damageTag_Earth = true 
            set damageFlag = 'S04P'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call bufflist.listUnitBuffs(proj.target,true,false,true)
            call bufflist.dispelAllBuffs()
            call applySilence(proj.source,proj.target,'ASI1')
        endfunction
        function SPELL_S04P takes nothing returns nothing   //风剪
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1000,0,"war3campImported\\OrbOfWind.mdx",function S04P_HIT,null)
            set proj.flag = 'S04P'
            set proj.tag_Earth = true 
            call proj.launch()
            call ShamanGainLightningEnchantment(spellCaster,3)
        endfunction

        function SPELL_S04Q takes nothing returns nothing   //雷霆打击
            local delayedevent de = 0
            local mybuff bf = mybuff.getUnitBuff(spellCaster,BUFFTYPE_SHAMAN_LIGHTNINGENCHANTMENT)
            local group pick = CreateGroup()
            local group pickA = CreateGroup()
            local real dmg = 3.5*I2R(ST_ABILITY_POWER.getTotalState(spellCaster))
            if bf != 0 then 
                set dmg = dmg*(1+0.2*I2R(bf.intData))
                call ShamanDecreaseLightningEnchantment(spellCaster)
            endif 
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),400,playerEnemy)
            call GroupEnumUnitsInRangeEx(pickA,GetUnitX(spellCaster),GetUnitY(spellCaster),600,playerEnemyCombat)
            call GroupAddGroup(pickA,pick)
            call GroupClear(pickA)
            loop
                exitwhen FirstOfGroup(pick) == null 
                if Cos((AngleByUnits(spellCaster,FirstOfGroup(pick))-AngleByUnXY(spellCaster,spellTargetX,spellTargetY))/57.2956) > 0.5 then 
                    call GroupAddUnit(pickA,FirstOfGroup(pick))
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            if CountUnitsInGroup(pickA) <= 2 then 
                set dmg = dmg*1.5
            endif   
            loop
                exitwhen FirstOfGroup(pickA) == null 
                set bf = mybuff.getUnitBuff(FirstOfGroup(pickA),BUFFTYPE_SHAMAN_FIRESHOCK)
                if bf != 0 then 
                    set de = delayedevent.create(25,1,function A66B_DELAYED)
                    call de.saveUnit("CASTER",bf.buffSource)
                    call de.saveUnit("TARGET",bf.buffTarget)
                    call de.saveReal("DAMAGE",0.35*I2R(bf.intData)*I2R(ST_ABILITY_POWER.getTotalState(bf.buffSource)))
                    call ShamanDecreaseFireShock(bf.buffTarget,bf.intData)
                endif 
                set damageTag_Lightning = true 
                set damageFlag = 'S04Q'
                set damageIsAOE = true 
                call UnitDamageTarget(spellCaster,FirstOfGroup(pickA),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",FirstOfGroup(pickA),"origin"))
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",FirstOfGroup(pickA),"origin"))
                call GroupRemoveFirstUnit(pickA)
            endloop
            call DestroyGroup(pick)
            call DestroyGroup(pickA)
            set pick = null 
            set pickA = null 
        endfunction

        function S04R_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real x = GetUnitX(bf.buffTarget)
            local real y = GetUnitY(bf.buffTarget)
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(bf.buffTarget))*0.2*mybuff.buffTimeScale
            local group pick = CreateGroup()
            local group pickA = CreateGroup()
            call GroupEnumUnitsInRangeEx(pickA,x,y,900,playerEnemyCombat)
            call GroupEnumUnitsInRangeEx(pick,x,y,550,playerEnemy)
            call GroupAddGroup(pickA,pick)
            loop
                exitwhen FirstOfGroup(pick) == null 
                if mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_SHAMAN_FIRESHOCK) != 0 then 
                    set damageTag_Fire = true 
                    set damageIsAOE = true 
                    set damageFlag = 'S04R'
                    call UnitDamageTarget(bf.buffTarget,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyGroup(pickA)
            set pickA = null 
        endfunction
        function SPELL_S04R takes nothing returns nothing   //炽焰升腾
            local real x = GetUnitX(spellCaster)
            local real y = GetUnitY(spellCaster)
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_SHAMAN_FIREAVATAR,3000)
            local group pick = CreateGroup()
            set bf.periodTime = 200
            set bf.hasteAble = true 
            call bf.addPeriod(function S04R_PERIOD)
            call bf.apply()
            
            call GroupEnumUnitsInRangeEx(pick,x,y,900,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                if mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_SHAMAN_FIRESHOCK) != 0 then 
                    call ShamanApplyFireShock(spellCaster,FirstOfGroup(pick),mybuff.getUnitBuff(FirstOfGroup(pick),BUFFTYPE_SHAMAN_FIRESHOCK).intData)
                    call delayedDestroyEffect(AddSpecialEffectTargetEX("Doodads\\Cinematic\\FireTrapUp\\FireTrapUp",FirstOfGroup(pick),"origin"),300)
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl",x,y))
        endfunction
    // endregion 

    // region sorceress 女巫
    ////////////////
    //HEROID = 15(16)
    ////////////////
        function S00G_HIT takes nothing returns nothing
            local group pick = null 
            local projectile nowP = projectile.currentProjectile
            local projectile proj 
            local unit ds = nowP.source
            local unit dt = nowP.target
            local delayedevent de
            local real dmg = nowP.realData*I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1
            if nowP.intData == 0 then 
                call nowP.applyDamageSet()
                set damageTag_Fire = true 
                call UnitDamageTarget(ds,dt,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            else 
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Other\\Volcano\\VolcanoMissile.mdl",GetUnitX(dt),GetUnitY(dt)))
                call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl",GetUnitX(dt),GetUnitY(dt)))
                set pick = CreateGroup()
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),225,playerEnemy)
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    call nowP.applyDamageSet()
                    set damageTag_Fire = true 
                    set damageIsAOE = true 
                    call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
                call DestroyGroup(pick)
                set pick = null 
            endif 
            set ds = null 
            set dt = null 
        endfunction
        function HERO_16_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            if mybuff.getUnitBuff(ds,BUFFTYPE_SORCERESS_HOTSTREAK) != 0 then 
                call mybuff.getUnitBuff(ds,BUFFTYPE_SORCERESS_HOTSTREAK).destroy()
            endif 
            if GetUnitAbilityLevel(dt,'B60E') > 0 then 
                call UnitRemoveAbility(dt,'B60E')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S00G'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = BlzGetUnitAbilityCooldown(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set attackingMissile.realData = 1
                set attackingMissile.tag_Fire = true 
                set attackingMissile.flag = 'S00G'
                set bf = mybuff.getUnitBuff(ds,BUFFTYPE_SORCERESS_HUGEFIREBALL)
                if bf != 0 then 
                    set attackingMissile.realData = attackingMissile.realData*3.5
                    set attackingMissile.intData = 1
                    set bf.intData = bf.intData-1
                    if bf.intData <= 0 then 
                        set bf.DESTROY = true 
                    endif 
                else
                    set attackingMissile.intData = 0
                endif 
                if attackingMissile.intData == 1 then 
                    set attackingMissile.model_path = "war3campImported\\Fireball Medium.mdx"  
                    set attackingMissile.flag = 'S00I'
                    set attackingMissile.curve = 0.2
                    set attackingMissile.speed = 650
                else 
                    set attackingMissile.model_path = "war3campImported\\Fireball Minor.mdx"  

                    set attackingMissile.curve = 0 
                    set attackingMissile.speed = 1000
                endif 
                call attackingMissile.addOnHit(function S00G_HIT) 
                set bf = mybuff.getUnitBuff(ds,BUFFTYPE_SORCERESS_FIREBALL)
                if bf != 0 then 
                    set attackingMissile.realData = attackingMissile.realData*bf.realData
                    set i = 0
                    loop 
                        exitwhen i > bf.intData-1
                        set proj = CreateProjectileToUnit(damageSource,damageTarget,1000,0,"war3campImported\\Fireball Minor.mdx",function S00G_HIT,null)
                        set proj.flag = 'S00G'
                        set proj.realData = bf.realData
                        set proj.tag_Fire = true 
                        set proj.start_y = GetRandomReal(30,40)*((i+2)/2*Pow(-1,i+1))
                        set de = delayedevent.create(15+i*15,1,function DELAYED_MISSILE_LAUNCH)
                        call de.saveInteger("MISSILE",proj)

                        set i = i+1
                    endloop
                    set bf.DESTROY = true 
                endif 
            endif 
            if GetUnitAbilityLevel(ds,'S00K') > 0 then 
                set bf = mybuff.create(ds,ds,BUFFTYPE_SORCERESS_BURNINGSOUL)
                if bf.intData < 20 then 
                    set bf.intData = bf.intData+1
                    set bf.bonusHaste = bf.intData*200
                    set bf.lastTime = 1000
                    set bf.boolData = true 
                    call bf.apply()
                    set bf.remainingTime = 1000
                    //////call BJDebugMsg("叠加"+I2S(bf.intData))
                elseif bf.boolData then 
                    set bf.bonusHaste = 10000
                    set bf.boolData = false 
                    set bf.lastTime = 500
                    set bf.remainingTime = 500
                    set bf.lastTime = 500
                    set bf.remainingTime = 500
                    call bf.apply()
                    
                    call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",GetUnitX(ds),GetUnitY(ds)))
                    //////call BJDebugMsg("爆发"+I2S(bf.intData))
                endif 
            endif 
            set ds = null 
            set dt = null 
        endfunction
        function HERO_16_DAMAGING_SOURCE takes nothing returns nothing
            local mybuff bf
            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_SORCERESS_COMBUSTION)
            if bf != 0 then 
                if damageTag_Fire and damageAttackType == ATTACK_TYPE_NORMAL then 
                    set damageFinalDamage = damageFinalDamage*(1+I2R(unitGetAllBonusStateValue(damageSource,STATE_CRIT))/10000)
                    set damageAddCrit = damageAddCrit+100
                endif 
            endif 
        endfunction
        function SPELL_S00H takes nothing returns nothing //连珠火球
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_SORCERESS_FIREBALL)
            set bf.lastTime = 1000
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) then 
                set bf.realData = 1.2
                set bf.intData = bf.intData+4
            else 
                set bf.realData = 1.5
                set bf.intData = bf.intData+2
            endif 
            call bf.apply()
        endfunction
        function SPELL_S00I takes nothing returns nothing //爆裂火球
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_SORCERESS_HUGEFIREBALL)
            set bf.lastTime = 1000
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) then 
                set bf.intData = bf.intData+2
            else 
                set bf.intData = bf.intData+1
            endif 
            call bf.apply()
        endfunction

        function A60C_DAMAGING_TARGET takes nothing returns nothing
            if damageSource == damageTarget then 
                return 
            endif 
            if damageTag_Fire and damageAttackType == ATTACK_TYPE_NORMAL then 
                set damageFinalDamage = damageFinalDamage*(1+0.1*mybuff.getUnitBuff(damageTarget,BUFFTYPE_SORCERESS_MELT).realData)
            endif 
        endfunction
        function S008_DOT takes nothing returns nothing
            local real dmg = 4.5/10*mybuff.currentBuff.realData*I2R(unitGetAllBonusStateValue(mybuff.currentBuff.buffSource,STATE_ABILITY_POWER))*mybuff.buffTimeScale
            set damageTag_Ignite = true 
            set damageTag_Fire = true 
            set damageIsDOT = true 
            set damageFlag = 'A605'
            call UnitDamageTarget(mybuff.currentBuff.buffSource,mybuff.currentBuff.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_S008 takes nothing returns nothing   //焚烧
            local mybuff bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_SORCERESS_BURN)
            local group pick = null 
            local real dmg 
            if bf.remainingTime > 0 then 
                set damageTag_Fire = true 
                set damageTag_Ignite = true 
                set damageFlag = 'S008'
                set dmg = 1*I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*0.45*R2I(bf.remainingTime)/R2I(bf.periodTime)
                call UnitDamageTarget(spellCaster,spellTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",spellTarget,"origin"))
            endif 
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                set bf.lastTime = 3000
            else 
                set bf.lastTime = 2000
            endif 
            set bf.periodTime = 200
            call bf.addPeriod(function S008_DOT)
            set bf.hasteAble = true 
            set bf.realData = 1
            call bf.apply()
            call applySilence(spellCaster,spellTarget,'ASI0')
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIfb\\AIfbSpecialArt.mdl",spellTarget,"chest"))

            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,8) then 
                set bf = mybuff.create(spellCaster,spellTarget,BUFFTYPE_SORCERESS_MELT)
                if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                    set bf.lastTime = 1350
                else 
                    set bf.lastTime = 900
                endif 
                set bf.realData = 0.6
                call bf.addDmged_T(function A60C_DAMAGING_TARGET)
                call bf.apply()
            endif 
        endfunction
        function S00B_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = bf.realData*I2R(unitGetAllBonusStateValue(bf.buffSource,STATE_ABILITY_POWER))*0.25*mybuff.buffTimeScale
            set damageTag_Ignite = true 
            set damageTag_Fire = true 
            set damageIsDOT = true 
            set damageFlag = 'A606'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S00B_MISSILE_HIT takes nothing returns nothing
            local mybuff bf
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(unitGetAllBonusStateValue(proj.source,STATE_ABILITY_POWER))*3.5*proj.realData
            call proj.applyDamageSet()
            set damageTag_Fire = true 
            set damageFlag = 'S00B'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            set bf = mybuff.create(proj.source,proj.target,BUFFTYPE_SORCERESS_PYROBLAST)
            if HeroHaveTalent(proj.source,HERO_PRIVATE_TALENT,6) then 
                set bf.lastTime = 1800
            else 
                set bf.lastTime = 1200
            endif 
            set bf.realData = RMinBJ(2,bf.realData+proj.realData)
            set bf.periodTime = 200
            set bf.hasteAble = true 
            call bf.addPeriod(function S00B_DOT)
            call bf.apply()
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",proj.target,"origin"))
        endfunction
        function SPELL_S00B takes nothing returns nothing   //炎爆术
            local projectile proj = CreateProjectileToUnit(spellCaster,spellTarget,1250,0,"war3campImported\\Firebolt Rough Medium.mdx",function S00B_MISSILE_HIT,null)
            set proj.realData = 1
            call proj.addOnHit(function S00B_MISSILE_HIT)
            set proj.flag = 'S00B'
            set proj.tag_Fire = true 
            call proj.launch()
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("war3campImported\\hiveNewModels\\Firebolt Classic.mdl",proj.dummy,"chest")
        endfunction
        function SPELL_S00J takes nothing returns nothing   //燃烧
            local mybuff bf = mybuff.create(spellCaster,spellCaster,BUFFTYPE_SORCERESS_COMBUSTION)
            set bf.lastTime = 1000
            call bf.apply()
        endfunction
        function S00E_AOE_GROUND takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group newgroup = CreateGroup()
            call GroupEnumUnitsInRangeEx(newgroup,x,y,225,playerEnemy)
            loop 
                exitwhen FirstOfGroup(newgroup) == null 
                set damageTag_Fire = true
                set damageIsAOE = true
                set damageIsDOT = true 
                set damageFlag = 'S00E'
                call UnitDamageTarget(caster,FirstOfGroup(newgroup),I2R(unitGetAllBonusStateValue(caster,STATE_ABILITY_POWER))*0.5,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\ImmolationRed\\ImmolationRedDamage.mdl",FirstOfGroup(newgroup),"overhead"),100)
                call GroupRemoveUnit(newgroup,FirstOfGroup(newgroup))
            endloop
            call DestroyGroup(newgroup)
            set newgroup = null 
            set caster = null 
        endfunction
        function S00E_AOE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local real dmg = I2R(unitGetAllBonusStateValue(caster,STATE_ABILITY_POWER))*7
            local group newgroup = CreateGroup()
            call GroupEnumUnitsInRangeEx(newgroup,x,y,250,playerEnemy)
            loop 
                exitwhen FirstOfGroup(newgroup) == null 
                set damageTag_Fire = true
                set damageIsAOE = true
                set damageFlag = 'S00E'
                call UnitDamageTarget(caster,FirstOfGroup(newgroup),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applyStun(caster,FirstOfGroup(newgroup),'ATB0')
                call GroupRemoveUnit(newgroup,FirstOfGroup(newgroup))
            endloop
            call DestroyGroup(newgroup)
            call DestroyEffectEX(de.loadEffect("SFX1"))
            call DestroyEffectEX(de.loadEffect("SFX2"))
            call DestroyEffectEX(AddSpecialEffectEX("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x,y))
            set newgroup = null 
            set caster = null 
        endfunction
        function SPELL_S00E takes nothing returns nothing   //陨石
            local delayedevent de = delayedevent.create(250,1,function S00E_AOE)
            local real d 
            local real a 
            local integer i = 0
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\InfernalMeteor3Fire.mdx",spellTargetX,spellTargetY))
            call de.saveEffect("SFX1",AddSpecialEffectEX("war3campImported\\dibanshengwensmall.mdx",spellTargetX,spellTargetY))
            call de.saveEffect("SFX2",AddSpecialEffectEX("Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl",spellTargetX,spellTargetY))
        endfunction

        function S00L_SFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local real d 
            local real a 
            local integer i = 0
            loop 
                exitwhen i > 7
                set a = GetRandomReal(I2R(i)*0.7854,I2R(i+1)*0.7854)
                set d = SquareRoot(GetRandomReal(16,50625))
                call delayedDestroyEffect(AddSpecialEffectEX("Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeEmbers.mdl",x+d*Cos(a),y+d*Sin(a)),125)
                set i = i+1
            endloop
        endfunction
        function S00L_AOE_GROUND takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group newgroup = CreateGroup()
            call GroupEnumUnitsInRangeEx(newgroup,x,y,225,playerEnemy)
            loop 
                exitwhen FirstOfGroup(newgroup) == null 
                set damageTag_Fire = true
                set damageTag_Ignite = true 
                set damageIsAOE = true
                set damageIsDOT = true 
                set damageFlag = 'XHfs'
                call UnitDamageTarget(caster,FirstOfGroup(newgroup),I2R(unitGetAllBonusStateValue(caster,STATE_ABILITY_POWER))*2.5/6,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call delayedDestroyEffect(AddSpecialEffectTargetEX("Abilities\\Spells\\Other\\ImmolationRed\\ImmolationRedDamage.mdl",FirstOfGroup(newgroup),"overhead"),100)
                call GroupRemoveUnit(newgroup,FirstOfGroup(newgroup))
            endloop
            call DestroyGroup(newgroup)
            set newgroup = null 
            set caster = null 
        endfunction
        function SPELL_S00L takes nothing returns nothing   //烈焰风暴
            local delayedevent de
            local real d 
            local real a 
            local integer i = 0
            local effect sfx = null 
            local group newgroup = CreateGroup()
            local integer haste
            local integer period = 100
            set haste = ST_HASTE.getTotalState(spellCaster)
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            call GroupEnumUnitsInRangeEx(newgroup,spellTargetX,spellTargetY,225,playerEnemy)
            loop 
                exitwhen FirstOfGroup(newgroup) == null 
                set damageTag_Fire = true
                set damageIsAOE = true
                set damageFlag = 'S00L'
                call UnitDamageTarget(spellCaster,FirstOfGroup(newgroup),I2R(unitGetAllBonusStateValue(spellCaster,STATE_ABILITY_POWER))*3.5,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveUnit(newgroup,FirstOfGroup(newgroup))
            endloop
            call DestroyGroup(newgroup)
            set sfx = AddSpecialEffectEX("Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdl",spellTargetX,spellTargetY)
            call delayedDestroyEffect(sfx,100)
            call BlzSetSpecialEffectTimeScale(sfx,10)
            set sfx = AddSpecialEffectEX("Abilities\\Spells\\Human\\FlameStrike\\FlameStrike.mdl",spellTargetX,spellTargetY)
            call delayedDestroyEffect(sfx,100)
            call BlzSetSpecialEffectTimeScale(sfx,8)
            set sfx = AddSpecialEffectEX("Abilities\\Spells\\Human\\FlameStrike\\FlameStrike2.mdl",spellTargetX,spellTargetY)
            call delayedDestroyEffect(sfx,100)
            call BlzSetSpecialEffectTimeScale(sfx,12)
            set sfx = null
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                set de = delayedevent.create(period,9,function S00L_SFX)
            else 
                set de = delayedevent.create(period,5,function S00L_SFX)
            endif 
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                set de = delayedevent.create(period,9,function S00L_AOE_GROUND)
            else 
                set de = delayedevent.create(period,6,function S00L_AOE_GROUND)
            endif 
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            set newgroup = null 
        endfunction

        function S00M_HIT takes nothing returns nothing
            local mybuff bf
            if alive(waveTarget) and IsUnitEnemy(waveTarget,GetOwningPlayer(waveCaster)) and IsUnitType(waveTarget,UNIT_TYPE_ANCIENT) == false and IsUnitType(waveTarget,UNIT_TYPE_STRUCTURE) == false then 
                set damageTag_Fire = true
                set damageIsAOE = true
                set damageFlag = 'S00M'
                call UnitDamageTarget(waveCaster,waveTarget,I2R(unitGetAllBonusStateValue(waveCaster,STATE_ABILITY_POWER))*2.5,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                set bf = mybuff.create(waveCaster,waveTarget,BUFFTYPE_SORCERESS_MELT)
                if HeroHaveTalent(waveCaster,HERO_PRIVATE_TALENT,6) then 
                    set bf.lastTime = 2250
                else 
                    set bf.lastTime = 1500
                endif 
                set bf.realData = 1
                call bf.addDmged_T(function A60C_DAMAGING_TARGET)
                call bf.apply()

                if HeroHaveTalent(waveCaster,HERO_PRIVATE_TALENT,8) then 
                    set bf = mybuff.create(spellCaster,waveTarget,BUFFTYPE_SORCERESS_BURN)
                    if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,6) then 
                        set bf.lastTime = 1800
                    else 
                        set bf.lastTime = 1200
                    endif 
                    set bf.periodTime = 200
                    call bf.addPeriod(function S008_DOT)
                    set bf.hasteAble = true 
                    set bf.realData = 0.6
                    call bf.apply()
                endif 
            endif 
        endfunction
        function SPELL_S00M takes nothing returns nothing   //龙息术
            local projectile proj = projectile.create(spellCaster)
            set proj.IS_WAVE = true 
            set proj.Wave_Radius_Start = 150
            set proj.Wave_Radius_Add = 300
            set proj.speed = 1200
            set proj.target_x = GetUnitX(spellCaster)+600*Cos(AngleByUnXY(spellCaster,spellTargetX,spellTargetY)/57.2956)
            set proj.target_y = GetUnitY(spellCaster)+600*Sin(AngleByUnXY(spellCaster,spellTargetX,spellTargetY)/57.2956)
            call proj.addOnHit(function S00M_HIT)
            set proj.TARGET_LOC = true 
            set proj.LAUNCH_UNIT = true 
            set proj.model_path = "Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireMissile.mdl" 
            set proj.model_attach = "origin"
            call proj.launch()
        endfunction
    // endregion 

    // region arcanewarrior 魔战士
    ////////////////
    //HEROID = 10(11)
    ////////////////
        function A687_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call AddUnitAnimationProperties(bf.buffTarget,"defend",false)
            call SetUnitAttackRange(bf.buffTarget,BlzGetUnitWeaponRealField(bf.buffTarget,UNIT_WEAPON_RF_ATTACK_RANGE,1))
        endfunction
        function ArcaneWarriorGuard takes unit whichUnit returns nothing
            local mybuff bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_AW_GUARD,2000)
            set bf.bonusArmor_P = 2500
            set bf.bonusBlock_P = 2500
            set bf.bonusResistance = 500
            call bf.addEnding(function A687_END)
            call bf.apply()
            if bf.boolData == false then 
                call AddUnitAnimationProperties(whichUnit,"defend",true)
                call SetUnitAttackRange(whichUnit,BlzGetUnitWeaponRealField(whichUnit,UNIT_WEAPON_RF_ATTACK_RANGE,1)/2)
                set bf.boolData = true 
            endif 
        endfunction

        function S05J_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(proj.source))*1
            call proj.applyDamageSet() 
            set damageTag_Arcane = true 
            set damageTag_Attack = true 
            set damageFlag = 'S05J'
            call UnitDamageTarget(proj.source,proj.target,dmg,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function HERO_11_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 5.4
            local real a 
            local real d 

            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'BZZZ') > 0 then 
                set Qcd = 4
                call UnitRemoveAbility(dt,'BZZZ')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S05I'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call BlzStartUnitAbilityCooldown(ds,'S05I',Qcd*haste-0.01)
                call Taunt(damageSource,damageTarget)

                call ArcaneWarriorGuard(ds)

                call AddUnitMana(ds,0.01*GetUnitState(ds,UNIT_STATE_MAX_MANA))

                if HeroHaveTalent(damageSource,HERO_ULTIMATE_TALENT,9) then 
                    set attackingMissile.realData = 1
                    set attackingMissile.boolData = false
                    set attackingMissile.model_path = "war3campImported\\ASMR.mdx"
                    set attackingMissile.flag = 'S05J'
                    call attackingMissile.addOnHit(function S05J_HIT)
                endif 
            endif

            if GetUnitAbilityLevel(dt,'BZZY') > 0 then 
                set Qcd = 0
                call UnitRemoveAbility(dt,'BZZY')
                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S05J'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0
                
                call Cast.execute()

                set attackingMissile.realData = 1
                set attackingMissile.boolData = false
                set attackingMissile.model_path = "war3campImported\\ASMR.mdx"
                set attackingMissile.flag = 'S05J'
                call attackingMissile.addOnHit(function S05J_HIT)

            endif
            set ds = null 
            set dt = null 
        endfunction

        function HERO_11_DAMAGED_TARGET takes nothing returns nothing
            local real ap = I2R(ST_ABILITY_POWER.getTotalState(damageTarget))
            local real p = 1+ap/(4*I2R(UnitLevel(damageTarget))+0.01*GetUnitState(damageTarget,UNIT_STATE_MAX_MANA))
            local real block = 0
            local real mana = GetUnitState(damageTarget,UNIT_STATE_MANA)
            local real shield
            if HeroHaveTalent(damageTarget,HERO_PRIVATE_TALENT,1) then 
                set p = p+0.5
            endif 
            set shield = mana*p
            if GetUnitAbilityLevel(damageTarget,'BZZX') > 0 then 
                set block = RMinBJ(shield,0.5*damageFinalDamage)
                set damageDamage = damageFinalDamage-block
                set damageBlockDamage = damageBlockDamage+block
                call EventBlockDamage(damageSource,damageTarget,damageTarget,damageTarget,block,'S05K')
                call AddUnitMana(damageTarget,0-block/p)
                set ARCANE_WARRIOR_MANA_SHIELD_COST = ARCANE_WARRIOR_MANA_SHIELD_COST+block/p
            endif 
        endfunction

        function HERO_11_AFTERDAMAGE_SOURCE takes nothing returns nothing
            if damageFlag == 'S05J' and damageIfCrit and GetUnitAbilityLevel(damageSource,'S05J') > 0 then 
                call AddUnitMana(damageSource,0.01*GetUnitState(damageSource,UNIT_STATE_MAX_MANA))
            endif 
        endfunction

        function HERO_11_PREDAMAGE_SOURCE takes nothing returns nothing
            if damageFlag == 'S05J' then 
                set damageResistance = damageResistance*0.5
            endif 
        endfunction

        globals
            string ARCANE_WARRIOR_AURA_RECYCLE = "ARCANE_WARRIOR_AURA_RECYCLE"
            real ARCANE_WARRIOR_MANA_SHIELD_COST = 0
            trigger ARCANE_WARRIOR_CANCEL_MANA_SHIELD = null 
        endglobals

        function CANCEL_S05K takes nothing returns nothing
            if GetIssuedOrderId() == ORDER_unimmolation then 
                call AddUnitMana(GetTriggerUnit(),ARCANE_WARRIOR_MANA_SHIELD_COST*0.5)
                set ARCANE_WARRIOR_MANA_SHIELD_COST = 0
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl",GetTriggerUnit(),"origin"))
                call BlzStartUnitAbilityCooldown(GetTriggerUnit(),'S05K',15.0)
            endif 
        endfunction
        function SPELL_S05K takes nothing returns nothing
            if ARCANE_WARRIOR_CANCEL_MANA_SHIELD == null then 
                set ARCANE_WARRIOR_CANCEL_MANA_SHIELD = CreateTrigger()
                call TriggerRegisterUnitEvent(ARCANE_WARRIOR_CANCEL_MANA_SHIELD,spellCaster,EVENT_UNIT_ISSUED_ORDER)
                call TriggerAddActionEx(ARCANE_WARRIOR_CANCEL_MANA_SHIELD,function CANCEL_S05K)
            endif 
        endfunction

        function HERO_11_RETRAIN takes nothing returns nothing
            set aura.getAura(hero[10],ARCANE_WARRIOR_AURA_RECYCLE).DESTROY = true 
            set ARCANE_WARRIOR_MANA_SHIELD_COST = 0
        endfunction

        function A688_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(bf.buffSource))*2.6/6*mybuff.buffTimeScale
            if haveSilence(bf.buffTarget) or (HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,1) and IsUnitBoss(bf.buffTarget)) then 
                set dmg = dmg*1.5
            endif 
            set damageIsAOE = true 
            set damageIsDOT = true 
            set damageTag_Arcane = true 
            set damageFlag = 'A688'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function A688_SPELLING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            set bf.remainingTime = bf.remainingTime+200
        endfunction
        function SPELL_S05L takes nothing returns nothing   //奥术诅咒
            local mybuff bf = 0
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_AW_ARCANECURSE,600)
                set bf.bonusResistance = -500
                set bf.periodTime = 100
                set bf.hasteAble = true 
                call bf.addPeriod(function A688_PERIOD)
                call bf.addSpelling(function A688_SPELLING)
                call bf.apply()
                if mybuff.getUnitBuff(spellCaster,BUFFTYPE_AW_GUARD) > 0 then 
                    call Taunt(spellCaster,FirstOfGroup(pick))
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\hiveNewModels\\SummonWaterElementalCaster.mdx",spellTargetX,spellTargetY))
        endfunction

        function A68O_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call AddUnitMana(bf.buffTarget,bf.shieldNowValue/bf.realData)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl",bf.buffTarget,"origin"))
        endfunction
        function SPELL_S05V takes nothing returns nothing   //棱光护盾
            local real saveMana = 0.0
            local real ap = I2R(ST_ABILITY_POWER.getTotalState(spellCaster))
            local real p = 1+ap/(4*I2R(UnitLevel(spellCaster))+0.01*GetUnitState(spellCaster,UNIT_STATE_MAX_MANA))
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_AW_ARCANESHIELD,1500)
            set bf.shieldBlockPercent = 1
            set bf.shieldMaxValue = p*GetUnitState(spellCaster,UNIT_STATE_MANA)
            set bf.realData = p
            set bf.shieldDestroy = true 
            call bf.addEnding(function A68O_END)
            call bf.apply()
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,1) then 
                set saveMana = saveMana+0.25
            endif 
            call SetUnitState(spellCaster,UNIT_STATE_MANA,saveMana*GetUnitState(spellCaster,UNIT_STATE_MANA))
        endfunction

        function A68P_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            call AddUnitMana(bf.buffTarget,0.15*GetUnitState(bf.buffTarget,UNIT_STATE_MAX_MANA))
        endfunction
        function A68P_SPELLING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if bf.intData > 0 then 
                return 
            endif 
            if castingSpell == 'S05L' or castingSpell == 'S05V' or castingSpell == 'S05O' or castingSpell == 'S05P' or castingSpell == 'S05Q' then 
                set bf.intData = castingSpell
            endif 
        endfunction
        function A68P_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if bf.intData == 0 then 
                return 
            endif 
            if GetUnitAbilityLevel(bf.buffTarget,bf.intData) == 0 then 
                return 
            endif 
            call BlzStartUnitAbilityCooldown(bf.buffTarget,bf.intData,RMaxBJ(0.01,BlzGetUnitAbilityCooldownRemaining(bf.buffTarget,bf.intData)-15))
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\hiveNewModels\\DeathPactTarget.mdx",bf.buffTarget,"origin"))
        endfunction
        function SPELL_S05W takes nothing returns nothing   //唤醒
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_AW_EVOKE,400)
            set bf.periodTime = 100
            set bf.intData = 0
            if HeroHaveTalent(spellCaster,HERO_PRIVATE_TALENT,4) then 
                set bf.bonusAbilityPower_P = 5000
            endif 
            call bf.addPeriod(function A68P_PERIOD)
            call bf.addSpelling(function A68P_SPELLING)
            call bf.addEnding(function A68P_END)
            call bf.apply()
        endfunction

        function AURA_RECYCLE_MISSILE_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real heal = I2R(ST_ABILITY_POWER.getTotalState(proj.target))*0.15
            if proj.intData < 15 then 
                set heal = RMaxBJ(1,heal*I2R(proj.intData+1)/15)
            endif 
            set healFlag = 'A689'
            set healIsExtra = true 
            set healAddCrit = -10000
            call UnitHealTarget(proj.target,proj.target,heal)
            call AddUnitMana(proj.target,proj.realData)
        endfunction
        function AURA_RECYCLE_SPELLING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local projectile proj = 0
            local real p = 0.25
            local real a = 0
            if alive(bf.buffSource) and bf.buffSource != null then 
                if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,4) then
                    set p = p+0.15
                endif 
                set proj = CreateProjectileToUnit(bf.buffTarget,bf.buffSource,500,0,"Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",function AURA_RECYCLE_MISSILE_HIT,null)
                set proj.flag = 'A689'
                set proj.realData = p*I2R(spellCost)
                set proj.intData = R2I(spellCooldown+0.5)
                set a = GetRandomReal(0,6.2832)
                set proj.bezier_points = 1
                set proj.bezier_x0 = GetUnitX(bf.buffTarget)+150*Cos(a)
                set proj.bezier_y0 = GetUnitY(bf.buffTarget)+150*Sin(a)
                call delayedLaunchMissile(proj,GetRandomInt(5,20))
            endif 
        endfunction
        function AURA_RECYCLE_STATE_CHECK takes nothing returns nothing
            if IsUnitType(aura.filterUnit,UNIT_TYPE_HERO) == false or aura.filterUnit == aura.checkingAura.bindUnit then 
                set aura.able = false 
                return 
            endif 
            set aura.able = true 
        endfunction
        function AURA_RECYCLE_STATE_SET takes nothing returns nothing
            local mybuff bf = aura.modifingAuraBuff
            call bf.addSpelling(function AURA_RECYCLE_SPELLING)
        endfunction
        
        function HERO_11_LEARN_S05M takes nothing returns nothing   //回收
            local aura ar = CreateAura(hero[10],ARCANE_WARRIOR_AURA_RECYCLE,900,0,BUFFTYPE_AW_RECYCLE,"war3campImported\\hiveNewModels\\SwiftnessAura.mdx")
            call ar.addAllySet(function AURA_RECYCLE_STATE_SET)
            call ar.addAllyChk(function AURA_RECYCLE_STATE_CHECK)
            set ar.removeWhenDeath = false 
        endfunction

        function A68A_SPELLING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            set bf.DESTROY = true 
            set bf.realData = bf.realData*1.5
        endfunction
        function A68A_END takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(bf.buffSource))*2.5*bf.realData
            set damageFlag = 'S05N'
            set damageTag_Arcane = true 
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call applySilence(bf.buffSource,bf.buffTarget,'ASI2')
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\arcaneshot_missile2.mdx",bf.buffTarget,"origin"))

            if HeroHaveTalent(bf.buffSource,HERO_PRIVATE_TALENT,4) and bf.boolData == false then 
                set bf = CreateBuff(bf.buffSource,bf.buffTarget,BUFFTYPE_AW_LASTWORDTWICE,300)
                set bf.realData = 0.5
                set bf.boolData = true
                set bf.bonusResistance = -500
                call bf.addEnding(function A68A_END)
                call bf.addSpelling(function A68A_SPELLING)
                call bf.apply()
            endif 
        endfunction
        function SPELL_S05N takes nothing returns nothing   //遗言
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_AW_LASTWORD,600)
            set bf.realData = 1
            set bf.boolData = false 
            set bf.bonusResistance = -500
            call bf.addEnding(function A68A_END)
            call bf.addSpelling(function A68A_SPELLING)
            call bf.apply()
            if mybuff.getUnitBuff(spellCaster,BUFFTYPE_AW_GUARD) > 0 then 
                call Taunt(spellCaster,spellTarget)
            endif 
        endfunction


        function A68B_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(bf.buffSource))*5/5*mybuff.buffTimeScale
            set damageIsDOT = true 
            set damageTag_Arcane = true 
            set damageFlag = 'A68B'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
            call applySilence(bf.buffSource,bf.buffTarget,'ASI0')
        endfunction
        function SPELL_S05O takes nothing returns nothing   //远古封印
            local mybuff bf = CreateBuff(spellCaster,spellTarget,BUFFTYPE_AW_ANCIENTSEAL,500)
            set bf.periodTime = 100
            set bf.hasteAble = true 
            set bf.bonusAttackSpeed = -3000
            set bf.bonusMoveSpeed_P = -3000
            call bf.addPeriod(function A68B_PERIOD)
            call bf.apply()
            if mybuff.getUnitBuff(spellCaster,BUFFTYPE_AW_GUARD) > 0 then 
                call Taunt(spellCaster,spellTarget)
            endif 
        endfunction

        function S05P_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(proj.source))*3
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(proj.target),GetUnitY(proj.target),200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Arcane = true 
                set damageIsAOE = true 
                set damageFlag = 'S05P'
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applySilence(proj.source,FirstOfGroup(pick),'ASI0')
                if mybuff.getUnitBuff(proj.source,BUFFTYPE_AW_GUARD) > 0 then 
                    call Taunt(proj.source,FirstOfGroup(pick))
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function SPELL_S05P takes nothing returns nothing   //秘法震荡
            local projectile proj = 0
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellTarget),GetUnitY(spellTarget),550,playerEnemy)
            if CountUnitsInGroup(pick) > 0 then 
                set proj = CreateProjectileToUnit(spellCaster,GetClosestUnit(spellCaster,pick),800,0,"war3campImported\\divinewrathmissile.mdx",function S05P_HIT,null)
                set proj.model_attach = "origin"
                set proj.flag = 'S05P'
                call proj.launch()
            endif 
            call DestroyGroup(pick)
            set pick = null 
        endfunction

        function SPELL_S05Q takes nothing returns nothing   //窃取魔法
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(spellCaster))*1
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,spellTargetX,spellTargetY,200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Arcane = true 
                set damageIsAOE = true 
                set damageFlag = 'S05Q'
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",FirstOfGroup(pick),"chest"))
                if mybuff.getUnitBuff(spellCaster,BUFFTYPE_AW_GUARD) > 0 then 
                    call Taunt(spellCaster,FirstOfGroup(pick))
                endif 
                call bufflist.listUnitBuffs(FirstOfGroup(pick),true,false,true)
                if bufflist.dispelMultiBuffs(3) then 
                    call AddUnitMana(spellCaster,0.05*GetUnitState(spellCaster,UNIT_STATE_MAX_MANA))
                endif 
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\enchantment.mdx",spellTargetX,spellTargetY))
        endfunction

        function S05R_DAMAGING_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            if damageAttackType == ATTACK_TYPE_NORMAL then 
                set damageFinalDamage = damageFinalDamage*1.15
            endif 
        endfunction
        function S05R_PERIOD takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            local mybuff bf 
            call GroupEnumUnitsInRangeEx(pick,x,y,250,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set bf = mybuff.create(caster,FirstOfGroup(pick),BUFFTYPE_AW_SILENCEAREA)
                set bf.fromAura = true 
                set bf.lastTime = 6
                call bf.addDmging_T(function S05R_DAMAGING_TARGET)
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
        endfunction
        function S05R_SILENCE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,x,y,250,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                call applySilence(caster,FirstOfGroup(pick),'ASI1')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
            call BlzSetSpecialEffectTimeScale(delayedDestroyEffect(AddSpecialEffectEX("war3campImported\\cots.mdl",x,y),56),0.25)
        endfunction
        function SPELL_S05R takes nothing returns nothing   //静默领域
            local delayedevent de = CreateDelayedEvent(5,400,function S05R_PERIOD)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveUnit("CASTER",spellCaster)
            set de = CreateDelayedEvent(200,10,function S05R_SILENCE)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveUnit("CASTER",spellCaster)
            set de = CreateDelayedEvent(1,1,function S05R_SILENCE)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveUnit("CASTER",spellCaster)
        endfunction

        
        function S05S_PERIOD takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local real dmg = I2R(ST_ABILITY_POWER.getTotalState(caster))*11/20
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,x,y,175,playerEnemy)
            set dmg = dmg/I2R(IMaxBJ(1,CountUnitsInGroup(pick)))
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Arcane = true 
                set damageFlag = 'S05S'
                set damageIsAOE = true 
                call UnitDamageTarget(caster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call applySilence(caster,FirstOfGroup(pick),'ASI0')
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
        endfunction
        function SPELL_S05S takes nothing returns nothing   //神秘之耀
            local delayedevent de = CreateDelayedEvent(10,20,function S05S_PERIOD)
            call de.saveReal("X",spellTargetX)
            call de.saveReal("Y",spellTargetY)
            call de.saveUnit("CASTER",spellCaster)
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\divinewrathtarget.mdl",spellTargetX,spellTargetY))
        endfunction

        function S05T_PERIOD takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local mybuff bf = 0
            local unit caster = de.loadUnit("CASTER")
            local real costRate = de.loadReal("COST")
            local real costMana = 0
            local real div = 0
            local real a = GetRandomReal(0,6.2832)
            local real d = SquareRoot(GetRandomReal(0,160000))
            local integer lastTime = de.loadInteger("TIME")
            local real x = GetUnitX(caster)
            local real y = GetUnitY(caster)
            local group pick = CreateGroup()
            if globalNowtime-lastTime >= 100 then 
                set costRate = costRate*1.25
                set lastTime = globalNowtime
            endif 
            set costMana = (I2R(UnitLevel(caster))+0.02*GetUnitState(caster,UNIT_STATE_MAX_MANA))/20*costRate
            if alive(caster) == false or GetUnitState(caster,UNIT_STATE_MANA) < costMana or caster == null then 
                set de.DESTROY = true 
            else 
                call AddUnitMana(caster,0-costMana)
                call GroupEnumUnitsInRangeEx(pick,x,y,600,playerHero)
                set div = I2R(IMaxBJ(1,CountUnitsInGroup(pick)))
                loop 
                    exitwhen FirstOfGroup(pick) == null 
                    set bf = CreateBuff(caster,FirstOfGroup(pick),BUFFTYPE_AW_MANAENTROPY,6)
                    if FirstOfGroup(pick) == caster then 
                        set bf.bonusHaste = 10000
                    else 
                        set bf.bonusHaste = 5000
                        call AddUnitMana(FirstOfGroup(pick),costMana*0.5/div)
                    endif 
                    call bf.apply()
                    call GroupRemoveUnit(pick,FirstOfGroup(pick))
                endloop
            endif 
            call DestroyGroup(pick)
            set pick = null 
            set caster = null 
            call de.saveReal("COST",costRate)
            call de.saveInteger("TIME",lastTime)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",x+d*Cos(a),y+d*Sin(a)))
        endfunction
        function SPELL_S05T takes nothing returns nothing   //魔熵
            local delayedevent de = CreateDelayedEvent(5,0,function S05T_PERIOD)
            call de.saveUnit("CASTER",spellCaster)
            call de.saveReal("COST",1)
            call de.saveInteger("TIME",globalNowtime)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl",spellCaster,"origin"))
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\enchantment.mdx",spellCaster,"origin"))
        endfunction

        
        function S05U_PERIOD takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dummy = de.loadUnit("DUMMY")
            local real x = GetUnitX(dummy)
            local real y = GetUnitY(dummy)
            local group pick = CreateGroup()
            local real p = GetHeroRealData(dummy,"P")
            local real dmg = I2R(unitGetAllBonusStateValue(ds,STATE_ABILITY_POWER))*1.5/6
            call GroupEnumUnitsInRangeEx(pick,x,y,175,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                if HeroHaveTalent(ds,HERO_PRIVATE_TALENT,4) then 
                    set p = RMinBJ(1.8,p+0.2)
                endif 
                set damageTag_Arcane = true
                set damageIsAOE = true 
                set damageFlag = 'S05U'
                call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveUnit(pick,FirstOfGroup(pick))
            endloop
            call SetHeroRealData(dummy,"P",p)
            set ds = null 
            set dummy = null 
            call DestroyGroup(pick)
            set pick = null 
        endfunction
        function S05U_HIT takes nothing returns nothing
            local real dmg = I2R(unitGetAllBonusStateValue(waveCaster,STATE_ABILITY_POWER))*1*waveWave.realData
            if IsUnitEnemy(waveTarget,PLAYER) then 
                set damageTag_Arcane = true 
                set damageIsAOE = true 
                set damageFlag = 'S05U'
                call UnitDamageTarget(waveCaster,waveTarget,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",waveTarget,"chest"))
            endif 
        endfunction
        function S05U_RELAUNCH takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dummy = de.loadUnit("DUMMY")
            local effect sfx = de.loadEffect("SFX")
            local real p = GetHeroRealData(dummy,"P")
            local projectile proj = CreateWaveToTarget(ds,ds,1000,175,0,"war3campImported\\ArcaneGlaive_2.mdx",function S05U_HIT,null)
            set proj.LAUNCH_UNIT = false 
            set proj.LAUNCH_LOC = true 
            set proj.realData = 1+p
            set proj.source_x = GetUnitX(dummy)
            set proj.source_y = GetUnitY(dummy)
            call proj.launch()
            call BlzSetSpecialEffectScale(proj.model,0.7)
            call DestroyEffectEX(sfx)
            call RemoveUnit(dummy)
            set ds = null 
            set dummy = null 
        endfunction
        function S05U_DEATH takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local delayedevent de = delayedevent.create(50,6,function S05U_PERIOD)
            call de.saveUnit("DUMMY",proj.dummy)
            call de.saveUnit("CASTER",proj.source)
            call de.saveEffect("SFX",proj.model)
            call de.addOnEnd(function S05U_RELAUNCH)
            call SetHeroRealData(proj.dummy,"P",0)
        endfunction
        function SPELL_S05U takes nothing returns nothing   //奥术魔刃
            local projectile proj = CreateWave(spellCaster,spellTargetX,spellTargetY,1000,175,0,"war3campImported\\ArcaneGlaive_2.mdx",function S05U_HIT,function S05U_DEATH)
            set proj.realData = 1
            set proj.ifDestroy = false 
            set proj.destroyAttach = false 
            call proj.launch()
            call BlzSetSpecialEffectScale(proj.model,0.7)
        endfunction
    // endregion 
    
    // region tinker 机械师
    ////////////////
    //HEROID = 3(4)
    ////////////////
        globals
            string array runeShellName
            string array runeShellDesc 
            string array runeShellIcon
            string array runeShellProj
            trigger triggerSwitchRuneShell = CreateTrigger()
            integer nowRuneShell = 0
            integer runeShellMax = 5
            integer runeShellCooldownCount = 0
        endglobals

        struct RuneShell 
            static method changeDesc takes nothing returns nothing
                call BlzSetAbilityTooltip('S04W',runeShellName[nowRuneShell],0)
                call BlzSetAbilityExtendedTooltip('S04W',runeShellDesc[nowRuneShell],0)
                call BlzSetAbilityIcon('S04W',runeShellIcon[nowRuneShell])
                call BlzSetAbilityActivatedIcon('S04W',runeShellIcon[nowRuneShell])
            endmethod

            static method loadNextRuneShell takes nothing returns nothing
                set nowRuneShell = ModuloInteger(nowRuneShell+1,5)
                call thistype.changeDesc()
            endmethod

            static method switch takes nothing returns nothing
                if HeroHaveTalent(hero[3],HERO_PRIVATE_TALENT,1) then 
                    return 
                endif 
                if GetIssuedOrderId() == ORDER_blackarrowoff and GetHeroIndex(GetTriggerUnit()) == 4 then 
                    call thistype.loadNextRuneShell()
                    call StoreInteger(gameCache,"EXTRA","RUNESHELL",nowRuneShell)
                endif 
            endmethod

            static method applyElement takes integer i returns nothing
                if i == 0 then 
                    set damageTag_Fire = true 
                elseif i == 1 then 
                    set damageTag_Cold = true 
                elseif i == 1 then 
                    set damageTag_Earth = true 
                elseif i == 1 then 
                    set damageTag_Shadow = true 
                elseif i == 1 then 
                    set damageTag_Lightning = true 
                endif 
            endmethod

            static method loadData takes nothing returns nothing
                call DestroyTimer(GetExpiredTimer())
                set nowRuneShell = GetStoredInteger(gameCache,"EXTRA","RUNESHELL")
                call thistype.changeDesc()
            endmethod

            static method onInit takes nothing returns nothing
                set runeShellName[0] = "火焰符文弹"
                set runeShellDesc[0] = "|cffadadff可在攻击时自动释放\n取消攻击\n冷却时间：|r|cff1eff006秒|r\n射出一枚火焰符文弹药，对目标造成|cffffcc00攻击力×1.1|r的物理伤害，并将其点燃，在6秒内受到|cffffcc00攻击×0.4|r的物理伤害。\n|cff888888符文弹药、火焰、攻击、持续效果、点燃|r"
                set runeShellIcon[0] = "ReplaceableTextures\\CommandButtons\\Auto\\BTNOrbOfFire.blp"
                set runeShellProj[0] = "war3campImported\\huoyandan.mdx"
                set runeShellName[1] = "冰霜符文弹"
                set runeShellDesc[1] = "|cffadadff可在攻击时自动释放\n取消攻击\n冷却时间：|r|cff1eff006秒|r\n射出一枚冰霜符文弹药，对目标造成|cffffcc00攻击力×1.4|r的物理伤害。弹药造成50%%的溅射效果，并使敌人被冰冻减速，持续5秒。\n|cff888888符文弹药、冰霜、攻击、冰冻减速|r"
                set runeShellIcon[1] = "ReplaceableTextures\\CommandButtons\\Auto\\BTNOrbOfFrost.blp"
                set runeShellProj[1] = "war3campImported\\hanbingdan.mdx"
                set runeShellName[2] = "酸蚀符文弹"
                set runeShellDesc[2] = "|cffadadff可在攻击时自动释放\n取消攻击\n冷却时间：|r|cff1eff006秒|r\n射出一枚酸蚀符文弹药，对目标造成|cffffcc00攻击力×1.3|r的物理伤害，并使其护甲降低|cffffcc00等级×0.6|r点，持续10秒。\n|cff888888符文弹药、自然、攻击、削弱|r"
                set runeShellIcon[2] = "ReplaceableTextures\\CommandButtons\\Auto\\BTNOrbOfVenom.blp"
                set runeShellProj[2] = "war3campImported\\suanyedan.mdx"
                set runeShellName[3] = "暗蚀符文弹"
                set runeShellDesc[3] = "|cffadadff可在攻击时自动释放\n取消攻击\n冷却时间：|r|cff1eff006秒|r\n射出一枚暗蚀符文弹药，对目标造成|cffffcc00攻击力×1.3|r的物理伤害，并使其法术抗性降低5%%，持续10秒。\n|cff888888符文弹药、暗影、攻击、削弱|r"
                set runeShellIcon[3] = "ReplaceableTextures\\CommandButtons\\Auto\\BTNOrbOfDarkness.blp"
                set runeShellProj[3] = "war3campImported\\anshidan.mdx"
                set runeShellName[4] = "闪电符文弹"
                set runeShellDesc[4] = "|cffadadff可在攻击时自动释放\n取消攻击\n冷却时间：|r|cff1eff006秒|r\n射出一枚闪电符文弹药，对目标造成|cffffcc00攻击力×1.3|r的物理伤害，并驱散1个有利效果。如果目标是普通敌人，还将被沉默3秒。\n|cff888888符文弹药、闪电、攻击、驱散、沉默|r"
                set runeShellIcon[4] = "ReplaceableTextures\\CommandButtons\\Auto\\BTNOrbOfLightning.blp"
                set runeShellProj[4] = "war3campImported\\shandiandan.mdx"

                call TriggerRegisterPlayerUnitEvent(triggerSwitchRuneShell,PLAYER,EVENT_PLAYER_UNIT_ISSUED_ORDER,null)
                call TriggerAddAction(triggerSwitchRuneShell,function thistype.switch)

                call TimerStart(CreateTimer(),1,false,function thistype.loadData)
            endmethod
        endstruct

        function A67E_DOT takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local real dmg = I2R(GetUnitAttack(bf.buffSource,0))*0.4*bf.realData/3*mybuff.buffTimeScale
            set damageTag_Fire = true 
            set damageIsDOT = true 
            set damageTag_Ignite = true 
            set damageFlag = 'A67E'
            call UnitDamageTarget(bf.buffSource,bf.buffTarget,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function S04W_AOE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = de.loadUnit("TARGET")
            local group pick = CreateGroup()
            local real dmg = de.loadReal("DAMAGE")
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(dt),GetUnitY(dt),200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                if FirstOfGroup(pick) != dt then 
                    set damageTag_Cold = true 
                    set damageIsAOE = true 
                    set damageFlag = 'S04W'
                    call UnitDamageTarget(ds,FirstOfGroup(pick),dmg,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                endif 
                call applyCold(ds,FirstOfGroup(pick),'ACO0')
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            set ds = null 
            set dt = null 
        endfunction
        function S04W_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local integer tp = proj.intData
            local real dmg = I2R(GetUnitAttack(proj.source,0))*proj.realData
            local real param = 1 
            local mybuff bf = 0
            local delayedevent de = 0
            if proj.boolData == false and HeroHaveTalent(proj.source,HERO_PRIVATE_TALENT,1) then 
                set proj.realData = proj.realData*1.2
            endif 
            if tp == 0 then 
                set param = 1.1
                set bf = CreateBuff(proj.source,proj.target,BUFFTYPE_TINKER_FIRERUNE,600)
                set bf.periodTime = 200
                set bf.hasteAble = true 
                set bf.realData = proj.realData+I2R(bf.remainingTime)/I2R(bf.lastTime)
                call bf.addPeriod(function A67E_DOT)
                call bf.apply()
            elseif tp == 1 then 
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",proj.target,"origin"))
                set param = 1.4
                set de = CreateDelayedEvent(1,1,function S04W_AOE)
                call de.saveUnit("CASTER",proj.source)
                call de.saveUnit("TARGET",proj.target)
                call de.saveReal("DAMAGE",dmg*param/2)
            elseif tp == 2 then 
                set param = 1.3
                set bf = CreateBuff(proj.source,proj.target,BUFFTYPE_TINKER_ACIDRUNE,1000)
                set bf.bonusArmor = 0-IMaxBJ(1,R2I(I2R(UnitLevel(proj.source)*3)/5+0.5))
                call bf.apply()
            elseif tp == 3 then 
                set param = 1.3
                set bf = CreateBuff(proj.source,proj.target,BUFFTYPE_TINKER_DARKRUNE,1000)
                set bf.bonusResistance = -500
                call bf.apply()
            elseif tp == 4 then 
                set param = 1.3
                call bufflist.listUnitBuffs(proj.target,true,false,true)
                call bufflist.dispel()
                if IsUnitBoss(proj.target) == false and IsUnitElite(proj.target) == false then 
                    call applySilence(proj.source,proj.target,'ASI1')
                endif 
            endif 
            call proj.applyDamageSet()
            call RuneShell.applyElement(tp)
            call UnitDamageTarget(proj.source,proj.target,dmg*param,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SZ4W_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))*2.6
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(proj.target),GetUnitY(proj.target),200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageFlag = 'SZ4W'
                set damageIsAOE = true 
                set damageTag_Fire = true 
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Weapons\\Mortar\\MortarMissile.mdl",GetUnitX(proj.target),GetUnitY(proj.target)))
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl",GetUnitX(proj.target),GetUnitY(proj.target)))
        endfunction

        function HERO_4_RETRAIN takes nothing returns nothing
            set nowRuneShell = 0
        endfunction

        function HERO_4_ATTACKING takes nothing returns nothing
            local mybuff bf 
            local projectile proj 
            local integer i
            local integer k 
            local delayedevent de 
            local unit ds = damageSource
            local unit dt = damageTarget
            local real haste = 1
            local real Qcd = 6
            local real a 
            local real d 
            
            if unitGetBonusState(ds,STATE_ATTACK_SPEED) >= 0 then 
                set haste = 10000/(10000+I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))
            else 
                set haste = (10000-I2R(unitGetAllBonusStateValue(ds,STATE_ATTACK_SPEED)))/10000
            endif 
                
            if GetUnitAbilityLevel(dt,'B67D') > 0 then 
                call UnitRemoveAbility(dt,'B67D')

                if HeroHaveTalent(ds,HERO_PRIVATE_TALENT,1) then 
                    set Qcd = Qcd-2
                endif 

                if HeroHaveTalent(ds,HERO_ULTIMATE_TALENT,12) then 
                    set runeShellCooldownCount = runeShellCooldownCount+1
                    if runeShellCooldownCount >= 5 then 
                        set runeShellCooldownCount = 0
                        set Qcd = Qcd+4
                    else 
                        set Qcd = 0
                    endif 
                endif 


                if mybuff.getUnitBuff(ds,BUFFTYPE_TINKER_OVERHEAT) > 0 and HeroHaveTalent(ds,HERO_ULTIMATE_TALENT,10) == false then 
                    set Qcd = Qcd/4
                endif 

                set spellCaster             = ds
                set spellTarget             = dt
                set castingSpell            = 'S04W'
                set spellAbilityLevel       = GetUnitAbilityLevel(spellCaster,castingSpell)
                set spellCooldown           = Qcd
                set spellCost               = BlzGetUnitAbilityManaCost(spellCaster,castingSpell,spellAbilityLevel-1)
                set spellTargetItem         = null 
                set SpellTargetDestructable = null 
                set spellTargetX            = 0
                set spellTargetY            = 0

                call Cast.execute()

                set attackingMissile.realData = 1
                set attackingMissile.boolData = false
                set attackingMissile.model_path = runeShellProj[nowRuneShell]
                set attackingMissile.flag = 'S04W'
                call attackingMissile.addOnHit(function S04W_HIT)
                if nowRuneShell == 0 then 
                    set attackingMissile.tag_Fire = true 
                elseif nowRuneShell == 1 then
                    set attackingMissile.tag_Cold = true 
                elseif nowRuneShell == 2 then 
                    set attackingMissile.tag_Earth = true 
                elseif nowRuneShell == 3 then 
                    set attackingMissile.tag_Shadow = true 
                elseif nowRuneShell == 4 then 
                    set attackingMissile.tag_Lightning = true 
                endif 
                set attackingMissile.intData = nowRuneShell
                call BlzStartUnitAbilityCooldown(ds,'S04W',Qcd*haste-0.01)
                
                if HeroHaveTalent(ds,HERO_PRIVATE_TALENT,1) then 
                    call RuneShell.loadNextRuneShell()
                endif 
            endif 

            set ds = null 
            set dt = null 
        endfunction

        function A67N_TO_A67R_ATTACKING takes nothing returns nothing
            local mybuff bf = 0
            local projectile proj = 0
            local integer i = 0
            local integer delay = 5
            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_FIRE)
            if bf > 0 and bf.DESTROY == false and bf.boolData == false then 
                set bf.boolData = true 
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif
                set i = 0
                set proj = CreateProjectileToUnit(damageSource,damageTarget,2500,0,runeShellProj[i],function S04W_HIT,null)
                set proj.flag = 'S04W'
                set proj.intData = i
                set proj.realData = 1
                set proj.boolData = false
                call delayedLaunchMissile(proj,delay)
                set delay = delay+10
            endif 
            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_COLD)
            if bf > 0 and bf.DESTROY == false and bf.boolData == false then 
                set bf.boolData = true 
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif
                set i = 1
                set proj = CreateProjectileToUnit(damageSource,damageTarget,2500,0,runeShellProj[i],function S04W_HIT,null)
                set proj.flag = 'S04W'
                set proj.intData = i
                set proj.realData = 1
                set proj.boolData = false
                call delayedLaunchMissile(proj,delay)
                set delay = delay+10
            endif 
            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_ACID)
            if bf > 0 and bf.DESTROY == false and bf.boolData == false then 
                set bf.boolData = true 
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif
                set i = 2
                set proj = CreateProjectileToUnit(damageSource,damageTarget,2500,0,runeShellProj[i],function S04W_HIT,null)
                set proj.flag = 'S04W'
                set proj.intData = i
                set proj.realData = 1
                set proj.boolData = false
                call delayedLaunchMissile(proj,delay)
                set delay = delay+10
            endif 
            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_DARK)
            if bf > 0 and bf.DESTROY == false and bf.boolData == false then 
                set bf.boolData = true 
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif
                set i = 3
                set proj = CreateProjectileToUnit(damageSource,damageTarget,2500,0,runeShellProj[i],function S04W_HIT,null)
                set proj.flag = 'S04W'
                set proj.intData = i
                set proj.realData = 1
                set proj.boolData = false
                call delayedLaunchMissile(proj,delay)
                set delay = delay+10
            endif 
            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_LIGHTNING)
            if bf > 0 and bf.DESTROY == false and bf.boolData == false then 
                set bf.boolData = true 
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif
                set i = 4
                set proj = CreateProjectileToUnit(damageSource,damageTarget,2500,0,runeShellProj[i],function S04W_HIT,null)
                set proj.flag = 'S04W'
                set proj.intData = i
                set proj.realData = 1
                set proj.boolData = false
                call delayedLaunchMissile(proj,delay)
                set delay = delay+10
            endif 
            set bf = mybuff.getUnitBuff(damageSource,BUFFTYPE_TINKER_LOADRUNESHELL_NUKE)
            if bf > 0 and bf.DESTROY == false and bf.boolData == false then 
                set bf.boolData = true 
                set bf.intData = bf.intData-1
                if bf.intData <= 0 then 
                    set bf.DESTROY = true 
                endif
                set i = 5
                set proj = CreateProjectileToUnit(damageSource,damageTarget,1000,0.15,"Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl",function SZ4W_HIT,null)
                set proj.flag = 'SZ4W'
                set proj.start_x = 50
                set proj.intData = i
                set proj.realData = 1
                set proj.boolData = false
                call delayedLaunchMissile(proj,delay)
                set delay = delay+10
            endif 
        endfunction
        function A67N_TO_A67R_PERIOD takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            set bf.boolData = false 
        endfunction

        function A67H_ATTACKING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            set bf.intData = bf.intData-1
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif   
        endfunction
        function TinkerApplyLockAndLoad takes unit whichUnit,integer stack returns nothing
            local mybuff bf = CreateBuff(whichUnit,whichUnit,BUFFTYPE_TINKER_LOCKANDLOAD,1000)
            if HeroHaveTalent(whichUnit,HERO_ULTIMATE_TALENT,10) then 
                set bf.bonusAttackSpeed = 5000
                set bf.lastTime = stack*100
            else 
                set bf.bonusAttackSpeed = 10000
                set bf.intData = bf.intData+5
                call bf.addAtking(function A67H_ATTACKING)
            endif 
            call bf.apply()
        endfunction

        function TINKER_LOAD_RUNESHELL takes unit whichUnit,bufftype whichBuff,integer stack returns mybuff
            local integer maxStack = 6
            local mybuff bf = 0 
            if whichUnit == null or whichBuff == 0 or stack == 0 then 
                return 0
            endif 
            set bf = CreateBuff(whichUnit,whichUnit,whichBuff,1000)
            set bf.boolData = false 
            set bf.periodTime = 10
            set bf.addTime = false 
            set bf.intData = IMinBJ(maxStack,bf.intData+stack)
            call bf.addAtking(function A67N_TO_A67R_ATTACKING)
            call bf.addPeriod(function A67N_TO_A67R_PERIOD)
            call bf.apply()
            return bf 
        endfunction

        function HERO_4_BEFOREDAMAGE_SOURCE takes nothing returns nothing
            if GetUnitAbilityLevel(damageMaster,'S050') > 0 then 
                if damageTag_Attack then 
                    set damageExtraCritTime = damageExtraCritTime+1
                    set damageCritChanceFix = damageCritChanceFix*0.9
                endif 
            endif
        endfunction

        function S04X_DOT takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local unit ds = de.loadUnit("CASTER")
            local unit dt = null 
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local effect sfx = de.loadEffect("SFX")
            local real sfxScale = de.loadReal("SCALE")
            local real dmg = I2R(GetUnitAttack(ds,0))*0.3
            local group pickA = CreateGroup()
            local group pickB = CreateGroup()
            call GroupEnumUnitsInRangeEx(pickA,x,y,300,playerEnemy)
            loop
                exitwhen FirstOfGroup(pickA) == null 
                if unitCheckCooldown(FirstOfGroup(pickA),'S04X') then 
                    call GroupAddUnit(pickB,FirstOfGroup(pickA))
                endif   
                call GroupRemoveFirstUnit(pickA)
            endloop 
            call DestroyGroup(pickA)
            if CountUnitsInGroup(pickB) > 0 then 
                set dt = GroupPickRandomUnitEx(pickB)

                set damageTag_Lightning = true 
                set damageFlag = 'SZ4X'
                call UnitDamageTarget(ds,dt,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIlb\\AIlbSpecialArt.mdl",dt,"origin"))
                call Lightning.createL2U(dt,"CLSB",x,y,100,0,0,50,50,50,false)

                if IsUnitBoss(dt) == false and IsUnitElite(dt) == false then 
                    call applySilence(ds,dt,'ASI0')
                endif 

                if HeroHaveTalent(ds,HERO_PRIVATE_TALENT,3) then 
                    call unitStartCooldown(dt,'S04X',66)
                else 
                    call unitStartCooldown(dt,'S04X',99)
                endif 
            endif 
            call DestroyGroup(pickB)

            set sfxScale = sfxScale-0.06
            call de.saveReal("SCALE",sfxScale)
            call BlzSetSpecialEffectScale(sfx,sfxScale)
            call BlzSetSpecialEffectHeightEX(sfx,100)

            set sfx = null 
            set ds = null 
            set dt = null 
            set pickA = null 
            set pickB = null 
        endfunction
        function S04X_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = proj.target_x
            local real y = proj.target_y
            local effect sfx = AddSpecialEffectEX("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y)
            local delayedevent de = CreateDelayedEvent(25,32,function S04X_DOT)
            local group pick = CreateGroup()
            local real dmg = I2R(GetUnitMaxAttack(proj.source,0))*2.5
            call GroupEnumUnitsInRangeEx(pick,x,y,300,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageTag_Lightning = true 
                set damageFlag = 'S04X'
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Items\\AIlb\\AIlbSpecialArt.mdl",FirstOfGroup(pick),"origin"))
                call applyStun(proj.source,FirstOfGroup(pick),'ATB1')
                call GroupRemoveFirstUnit(pick)
            endloop 
            call DestroyGroup(pick)
            call BlzSetSpecialEffectTimeScale(sfx,0.5)
            call BlzSetSpecialEffectScale(sfx,1.5)
            call DestroyEffectEX(sfx)
            set sfx = delayedDestroyEffect(AddSpecialEffectEX("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",x,y),802)
            call BlzSetSpecialEffectScale(sfx,2)
            call BlzSetSpecialEffectHeightEX(sfx,100)
            call de.saveUnit("CASTER",proj.source)
            call de.saveReal("X",x)
            call de.saveReal("Y",y)
            call de.saveEffect("SFX",sfx)
            call de.saveReal("SCALE",2)
            set sfx = null 
            set pick = null 
        endfunction
        function SPELL_S04X takes nothing returns nothing   //超电磁炮
            local projectile proj = CreateProjectileToLoc(spellCaster,spellTargetX,spellTargetY,3000,0,"war3campImported\\OrbOfLightning.mdx",null,function S04X_HIT)
            set proj.flag = 'S04X'
            call proj.launch()
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",proj.dummy,"chest")
            call SetUnitScale(proj.dummy,1.5,1.5,1.5)
            call UnitsAddLightningSFX(spellCaster,40,-10,25,proj.dummy,-20,40,50,"CLSB",0.75,0.5,false)
            call UnitsAddLightningSFX(spellCaster,40,-10,25,proj.dummy,-20,-40,50,"CLSB",0.75,0.5,false)
            call UnitsAddLightningSFX(spellCaster,40,-10,25,proj.dummy,25,50,50,"CLSB",0.75,0.5,false)
            call UnitsAddLightningSFX(spellCaster,40,-10,25,proj.dummy,25,-50,50,"CLSB",0.75,0.5,false)
            call UnitsAddLightningSFX(spellCaster,40,-10,25,proj.dummy,0,0,50,"FORK",1,0.5,false)
        endfunction

        function HERO_4_PRE_ATTACK takes nothing returns nothing
            if GetUnitAbilityLevel(eventAttacker,'S04Y') > 0 and BlzGetUnitAbilityCooldownRemaining(eventAttacker,'S04Y') == 0 then 
                call IssueNeutralImmediateOrderById(PLAYER,eventAttacker,ORDER_berserk)
                call delayedIssueTargetOrder(eventAttacker,ORDER_attack,eventAttackedUnit,1)
            endif 
        endfunction
        function SPELL_S04Y takes nothing returns nothing   //上膛
            call TinkerApplyLockAndLoad(spellCaster,4)
            call BlzEndUnitAbilityCooldown(spellCaster,'S04W')
        endfunction

        function S04Z_DOT takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local unit caster = de.loadUnit("CASTER")
            local real dmg = I2R(GetUnitMaxAttack(caster,0))*0.5
            local group newgroup = CreateGroup()
            call GroupEnumUnitsInRangeEx(newgroup,x,y,300,playerEnemy)
            loop 
                exitwhen FirstOfGroup(newgroup) == null 
                set damageTag_Fire = true
                set damageTag_Ignite = true 
                set damageIsAOE = true
                set damageIsDOT = true 
                set damageFlag = 'S04Z'
                call UnitDamageTarget(caster,FirstOfGroup(newgroup),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveUnit(newgroup,FirstOfGroup(newgroup))
            endloop
            call DestroyGroup(newgroup)
            set newgroup = null 
            set caster = null 
        endfunction
        function S04Z_SFX takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            local real x = de.loadReal("X")
            local real y = de.loadReal("Y")
            local real d 
            local real a 
            local integer i = 0
            loop 
                exitwhen i > 4
                set a = GetRandomReal(I2R(i)*1.25664,I2R(i+1)*1.25664)
                set d = SquareRoot(GetRandomReal(16,75625))
                call delayedDestroyEffect(AddSpecialEffectEX("Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeEmbers.mdl",x+d*Cos(a),y+d*Sin(a)),50)
                set i = i+1
            endloop
        endfunction
        function S04Z_HIT takes nothing returns nothing 
            local projectile proj = projectile.currentProjectile
            local real x = proj.target_x
            local real y = proj.target_y
            
            local delayedevent de = 0 
            local integer haste = 0
            local integer period = 100
            set haste = ST_HASTE.getTotalState(spellCaster)
            if haste > 0 then 
                set period = R2I(I2R(period*10000)/I2R(10000+haste))
            else 
                set period = R2I(I2R(period*(10000-haste)/10000))
            endif 
            set period = IMaxBJ(period,1)

            set de = CreateDelayedEvent(period,10,function S04Z_DOT)
            call de.saveReal("X",x)
            call de.saveReal("Y",y)
            call de.saveUnit("CASTER",proj.source)

            set de = CreateDelayedEvent(1,1,function S04Z_DOT)
            call de.saveReal("X",x)
            call de.saveReal("Y",y)
            call de.saveUnit("CASTER",proj.source)

            set de = CreateDelayedEvent(IMaxBJ(1,period/3),27,function S04Z_SFX)
            call de.saveReal("X",x)
            call de.saveReal("Y",y)
            set de = CreateDelayedEvent(1,1,function S04Z_SFX)
            call de.saveReal("X",x)
            call de.saveReal("Y",y)
        endfunction
        function SPELL_S04Z takes nothing returns nothing   //大燃烧弹
            local projectile proj = CreateProjectileToLoc(spellCaster,spellTargetX,spellTargetY,1000,0.2,"Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl",null,function S04Z_HIT)
            set proj.model_attach = "origin"
            set proj.flag = 'S04Z'
            set proj.start_z = 50
            call proj.launch()
            set proj.bindSFX_0 = AddSpecialEffectTargetEX("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl",proj.dummy,"origin")
            call SetUnitScale(proj.dummy,1.5,1.5,1.5)
        endfunction

        function SPELL_S051 takes nothing returns nothing   //死亡射线
            local mybuff bf = 0
            local real dmg = I2R(GetUnitMaxAttack(spellCaster,0))*5.5
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellTarget),GetUnitY(spellTarget),200,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Fire = true 
                set damageTag_Lightning = true 
                set damageTag_Shadow = true 
                set damageFlag = 'S051'
                if FirstOfGroup(pick) == spellTarget then 
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                else 
                    set damageIsAOE = true 
                    call UnitDamageTarget(spellCaster,FirstOfGroup(pick),dmg/2,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                endif 
                set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_TINKER_RADIATION,6000)
                set bf.bonusAttack_P = -1000
                set bf.bonusAttackSpeed = -1000
                call bf.apply()
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",spellTarget,"origin"))
            call DestroyEffectEX(AddSpecialEffectTargetEX("units\\nightelf\\SpiritOfVengeance\\SpiritOfVengeance.mdl",spellTarget,"origin"))
            call UnitsAddLightningSFX(spellCaster,40,-10,25,spellTarget,0,0,50,"AFOD",1,0.5,false)
            call UnitsAddLightningSFX(spellCaster,40,-10,25,spellTarget,0,0,50,"FORK",1,0.5,false)
            call UnitsAddLightningSFX(spellCaster,40,-10,25,spellTarget,0,0,50,"CLSB",1,0.5,false)
            set pick = null 
        endfunction

        function S052_ATTACKING takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local integer i = 0
            local projectile proj = 0
            if bf.DESTROY then 
                return 
            endif 
            loop
                exitwhen i >= runeShellMax
                set proj = CreateProjectileToUnit(damageSource,damageTarget,2500,0,runeShellProj[i],function S04W_HIT,null)
                set proj.flag = 'S04W'
                set proj.intData = i
                set proj.realData = 1
                set proj.boolData = true 
                call delayedLaunchMissile(proj,10*i+10)
                set i = i+1
            endloop
            set bf.intData = bf.intData-1
            if bf.intData <= 0 then 
                set bf.DESTROY = true 
            endif 
        endfunction
        function SPELL_S052 takes nothing returns nothing   //全弹发射
            local mybuff bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_TINKER_FULLSALVO,1000)
            call bf.addAtking(function S052_ATTACKING)
            set bf.intData = bf.intData+1
            call bf.apply()
            call DestroyEffectEX(AddSpecialEffectTargetEX("war3campImported\\hiveNewModels\\DisenchantMissile.mdx",spellCaster,"weapon"))
        endfunction

        function S053_EXPLODE takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local group pick = CreateGroup()
            local real dmg = I2R(GetUnitMaxAttack(proj.source,0))*10
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(proj.target),GetUnitY(proj.target),250,playerEnemy)
            loop
                exitwhen FirstOfGroup(pick) == null 
                set damageTag_Fire = true 
                set damageIsAOE = true 
                set damageFlag = 'S053'
                call UnitDamageTarget(proj.source,FirstOfGroup(pick),dmg,false,false,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                call GroupRemoveFirstUnit(pick)
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call KillUnit(proj.source)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(proj.target),GetUnitY(proj.target)))
            call DestroyEffectEX(AddSpecialEffectEX("war3campImported\\newgroundex.mdx",GetUnitX(proj.target),GetUnitY(proj.target)))
        endfunction
        function CHECK_STATE_nS0Q takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 25*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)*5/4
            call BlzSetUnitBaseDamage(checkingUnit,4*GetUnitLevel(owner.masterUnit)/9+6+R2I(I2R(GetUnitMaxAttack(owner.masterUnit,0))*0.2),0)
            call BlzSetUnitArmor(checkingUnit,5+8*GetUnitLevel(owner.masterUnit))
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function A67L_DELAYED_DAMAGE takes nothing returns nothing
            local delayedevent de = delayedevent.currentEvent
            set damageFlag = 'A67L'
            set damageIsExtra = true 
            call UnitDamageTarget(de.loadUnit("SOURCE"),de.loadUnit("TARGET"),de.loadReal("DAMAGE"),false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function A67L_PREDAMAGE_TARGET takes nothing returns nothing
            local mybuff bf = mybuff.currentBuff
            local delayedevent de = 0
            if bf.buffSource != null and alive(bf.buffSource) then 
                set de = delayedevent.create(1,1,function A67L_DELAYED_DAMAGE)
                call de.saveUnit("SOURCE",damageSource)
                call de.saveUnit("TARGET",bf.buffSource)
                call de.saveReal("DAMAGE",damageFinalDamage*0.5)
                set damageFinalDamage = damageFinalDamage*0.5
            else 
                set bf.DESTROY = true 
            endif 
        endfunction
        function SPELL_A67T takes nothing returns nothing
            local mybuff bf 
            local group pick = CreateGroup()
            call GroupEnumUnitsInRangeEx(pick,GetUnitX(spellCaster),GetUnitY(spellCaster),300,playerEnemy)
            loop 
                exitwhen FirstOfGroup(pick) == null 
                set damageIsAOE = true 
                set damageFlag = 'A67T'
                call UnitDamageTarget(spellCaster,FirstOfGroup(pick),I2R(GetUnitAttack(spellCaster,0))*5,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
                set bf = CreateBuff(spellCaster,FirstOfGroup(pick),BUFFTYPE_THUNDERCLAP,250)
                set bf.bonusAttackSpeed = -2500
                set bf.bonusMoveSpeed_P = -4500
                call bf.apply()
                call GroupRemoveUnit(pick,FirstOfGroup(pick))    
            endloop
            call DestroyGroup(pick)
            set pick = null 
            call DestroyEffectEX(AddSpecialEffectTargetEX("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",spellCaster,"origin"))
        endfunction
        function S053_SUMMON_GOLEM takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = proj.target_x
            local real y = proj.target_y
            local mybuff bf 
            local minion mini = minion.createWithFace(proj.source,'nS0Q',x,y,GetUnitFacing(proj.dummy))
            call ST_MAX_RESISTANCE.addState(mini.summon,STATE_MODE_PERCENTAGE,5000)
            call ST_RESISTANCE.addState(mini.summon,STATE_MODE_PERCENTAGE,10000)
            call delayedPauseUnit(mini.summon,160)
            call delayedPlayAnimation(mini.summon,"birth",160)
            set mini.remove = true 
            set mini.deathSFX = "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl"
            call UnitApplyTimedLife(mini.summon,'BTLF',28.4)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl",x,y))
            call unitCheckState(mini.summon)
            set bf = CreateBuff(mini.summon,proj.source,BUFFTYPE_TINKER_IRONSTORM,3000)
            call bf.addBefDmg_T(function A67L_PREDAMAGE_TARGET)
            call bf.apply()

            if HeroHaveTalent(proj.source,HERO_ULTIMATE_TALENT,11) then 
                call UnitAddAbilityEx(mini.summon,'A67T')
            endif 
        endfunction
        function CHECK_STATE_nS0S takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            call BlzSetUnitBaseDamage(checkingUnit,4*GetUnitLevel(owner.masterUnit)/9+6+R2I(I2R(GetUnitMaxAttack(owner.masterUnit,0))*0.15),0)
        endfunction
        function A67D_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))*7
            set damageFlag = 'A67D'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_A67D takes nothing returns nothing
            local unit target = null 
            local projectile proj = 0
            if (minion.getMinionByUnit(spellCaster).currentTarget != null and alive(minion.getMinionByUnit(spellCaster).currentTarget)) or (minion.getMinionByUnit(spellCaster).mast.lastTarget != null and alive(minion.getMinionByUnit(spellCaster).mast.lastTarget)) then 
                set target = minion.getMinionByUnit(spellCaster).currentTarget
                if target == null or alive(target) == false then 
                    set target = minion.getMinionByUnit(spellCaster).mast.lastTarget
                endif 
                set proj = CreateProjectileToUnit(spellCaster,target,1000,0,"Abilities\\Spells\\Other\\TinkerRocket\\TinkerRocketMissile.mdl",function A67D_HIT,null)
                set proj.flag = 'A67D'
                call proj.launch()
            endif 
            set target = null 
        endfunction
        function UNIT_nS0S_ATTACKED_SOURCE takes nothing returns nothing
            local projectile proj = 0
            local minion mini = minion.getMinionByUnit(damageSource)
            if HeroHaveTalent(mini.mast.masterUnit,HERO_ULTIMATE_TALENT,11) then 
                if globalNowtime-mini.intData >= 2500 then 
                    if random.get(damageSource,0.5+I2R(3000-globalNowtime+mini.intData)/500,'nS0S') then 
                        set proj = CreateProjectileToUnit(damageSource,damageTarget,900,0,"",function S053_EXPLODE,null)
                        set proj.resetHeight = false 
                        call proj.launchWithDummy(damageSource,false)
                        set mini.remove = false 
                    endif 
                endif 
            endif 
        endfunction
        function S053_SUMMON_AIRPLANE takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real x = proj.target_x
            local real y = proj.target_y
            local minion mini = minion.createWithFace(proj.source,'nS0S',x,y,GetUnitFacing(proj.dummy))
            set mini.remove = true 
            set mini.intData = globalNowtime
            set mini.deathSFX = "Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl"
            call UnitApplyTimedLife(mini.summon,'BTLF',30)
            call DestroyEffectEX(AddSpecialEffectEX("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl",x,y))
            call unitCheckState(mini.summon)
        endfunction
        function CHECK_STATE_nS0R takes nothing returns nothing
            local master owner = minion.getMinionByUnit(checkingUnit).mast
            local integer miniBonusLife = 25*GetUnitLevel(owner.masterUnit)+unitGetAllBonusStateValue(owner.masterUnit,STATE_LIFE)
            call BlzSetUnitBaseDamage(checkingUnit,4*GetUnitLevel(owner.masterUnit)/9+6+R2I(I2R(GetUnitMaxAttack(owner.masterUnit,0))*0.35),0)
            call BlzSetUnitArmor(checkingUnit,5+5*GetUnitLevel(owner.masterUnit))
            call unitAddState(checkingUnit,STATE_LIFE,miniBonusLife-GetHeroData(checkingUnit,"BONUSED_LIFE"))
            call SetHeroData(checkingUnit,"BONUSED_LIFE",miniBonusLife)
        endfunction
        function A67K_HIT takes nothing returns nothing
            local projectile proj = projectile.currentProjectile
            local real dmg = I2R(GetUnitAttack(proj.source,0))
            set damageTag_Attack = true 
            set damageFlag = 'A67K'
            call UnitDamageTarget(proj.source,proj.target,dmg,false,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
        endfunction
        function SPELL_A67K takes nothing returns nothing
            local unit target = null 
            local group pick = CreateGroup()
            local projectile proj = 0
            if (minion.getMinionByUnit(spellCaster).currentTarget != null and alive(minion.getMinionByUnit(spellCaster).currentTarget)) or (minion.getMinionByUnit(spellCaster).mast.lastTarget != null and alive(minion.getMinionByUnit(spellCaster).mast.lastTarget)) then 
                set target = minion.getMinionByUnit(spellCaster).currentTarget
                if target == null or alive(target) == false then 
                    set target = minion.getMinionByUnit(spellCaster).mast.lastTarget
                endif 
                call GroupEnumUnitsInRangeEx(pick,GetUnitX(target),GetUnitY(target),300,playerEnemy)
                loop
                    exitwhen FirstOfGroup(pick) == null 
                    set proj = CreateProjectileToUnit(spellCaster,FirstOfGroup(pick),2000,0,"Abilities\\Weapons\\Rifle\\RifleImpact.mdl",function A67K_HIT,null)
                    set proj.flag = 'A67K'
                    call proj.launch()
                    call GroupRemoveFirstUnit(pick)
                endloop
            endif 
            call DestroyGroup(pick)
            set pick = null 
            set target = null 
        endfunction
        function UNIT_nS0R_ATTACKED_SOURCE takes nothing returns nothing
            local projectile proj = 0
            local minion mini = minion.getMinionByUnit(damageSource)
            if HeroHaveTalent(mini.mast.masterUnit,HERO_ULTIMATE_TALENT,11) then 
                if globalNowtime-mini.intData >= 2500 then 
