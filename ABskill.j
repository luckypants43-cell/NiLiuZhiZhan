        set BUFFTYPE_ITEM_MANATIDE = bufftype.create('A67B','B67B',true,false,true)                    //法力之潮
        set BUFFTYPE_ITEM_INSIGHT = bufftype.create('A67C','B67C',true,false,true)                    //看破
        set BUFFTYPE_AMULET_BLOODSACRIFICE = bufftype.create('A65Q','B65X',true,false,true)                    //鲜血献祭
        set BUFFTYPE_AMULET_ELEMENTALFORM = bufftype.create('A65R','B65Y',true,false,true)                    //元素之体
        set BUFFTYPE_AMULET_UNSTOPPABLE = bufftype.create('A65S','B65Z',true,false,true)                    //霸体
        set BUFFTYPE_AMULET_HEROISM = bufftype.create('A65T','B660',true,false,true)                    //英勇
        set BUFFTYPE_AMULET_BLOODLUST = bufftype.create('A679','B679',true,false,true)                    //嗜血术
        set BUFFTYPE_AMULET_DRAGONSPIRITE = bufftype.create('A68N','B68N',true,false,true)                    //魔龙精气
        set BUFFTYPE_ITEM_RENEWAURA = bufftype.create('A68J','B68J',true,false,false)                    //愈合光环
        set BUFFTYPE_ITEM_DEATHANDDECAY = bufftype.create('A68Q','B68Q',false,true,false)                          //死亡凋零

        set BUFFTYPE_TAUNT = bufftype.create('ATAU','BTAU',false,true,false)                          //嘲讽
        set BUFFTYPE_DUAL = bufftype.create('A638','B63I',false,false,false)                          //对峙
        set BUFFTYPE_CAMPFIRE = bufftype.create('A63C','B63M',true,true,false)                          //精力充沛（营火）
        set BUFFTYPE_CURSEOFPAIN = bufftype.create('A63G','B63P',false,true,true)                          //痛苦诅咒
        set BUFFTYPE_SLOW = bufftype.create('A64C','B64M',false,true,true)                          //减速
