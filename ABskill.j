        if castingSpell == 'S035' then 
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_DK_RUNETAP,1000)
            set bf.bonusCritPower = 2000
            call bf.apply()
        endif 
        if castingSpell == 'S036' then 
            set bf = CreateBuff(spellCaster,spellCaster,BUFFTYPE_DK_RUNETAP,1200)
            set bf.bonusHaste = 2000
